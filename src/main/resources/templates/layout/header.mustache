                    <a href="/logout" class="px-3 py-2 text-xs text-red-400 hover:bg-red-500/10 rounded-lg transition-colors flex items-center gap-2 text-decoration-none">
                        <span class="material-symbols-outlined text-sm">logout</span> 로그아웃
                    </a>
