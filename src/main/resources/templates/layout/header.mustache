<header id="top-header" class="site-header">
    <div class="header-shell">
        <div class="header-main">
            <a href="/" class="header-brand" aria-label="tripleS 홈">
                <span class="sss-mascot-wrap" id="sss-mascot-wrap">
                    <img src="/images/sss-mascot.png" alt="" width="33" height="27" class="sss-mascot-wave" id="sss-mascot" decoding="async" aria-hidden="true">
                </span>
                <img src="/images/triples-wordmark-white.png" alt="tripleS" width="120" height="36" decoding="async">
            </a>
            <nav id="navbar" class="header-primary" aria-label="주 메뉴">
                {{#siteNavigation}}{{#direct}}<a class="header-nav-link" href="{{href}}">{{label}}</a>{{/direct}}{{^direct}}{{>navigation/desktop-section}}{{/direct}}{{/siteNavigation}}
            </nav>
        <div class="header-utilities" aria-label="빠른 메뉴">
            <a href="/sitemap">전체 메뉴</a>
        </div>
            <div class="header-actions">
                <div class="header-search-disclosure">
                    <button type="button" class="header-icon-button" id="header-search-btn" data-header-toggle aria-label="사이트 검색 열기" aria-expanded="false" aria-controls="header-search-panel"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
                    <div id="header-search-panel" class="header-search-panel" hidden>
                        <form action="/search" method="get" role="search" class="header-search">
                            <input name="keyword" required minlength="1" aria-label="사이트 전체 검색" type="search" placeholder="멤버·게시글 검색">
                            <button type="submit" aria-label="검색"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
                        </form>
                    </div>
                </div>
                {{#member}}
                <div class="header-disclosure header-account">
                    <button type="button" data-header-toggle aria-expanded="false" aria-controls="site-user-menu-panel"><span class="header-account-identity"><span class="header-account-name">{{userId}}님</span><span class="header-account-level">Lv.{{level}} · {{points}}P</span></span><span class="header-chevron" aria-hidden="true"></span></button>
                    <div id="site-user-menu-panel" class="header-dropdown" hidden>{{>navigation/account-links}}</div>
                </div>
                {{/member}}
                <button type="button" id="mobile-menu-btn" class="header-icon-button" data-header-toggle aria-label="메뉴 열기" aria-expanded="false" aria-controls="mobile-menu"><span id="mobile-menu-icon" aria-hidden="true"></span></button>
            </div>
        </div>
    </div>
    <div id="mobile-menu" hidden>
        <nav aria-label="모바일 주 메뉴">
            {{#siteNavigation}}{{#direct}}<a class="mobile-direct-link" href="{{href}}">{{label}}</a>{{/direct}}{{^direct}}{{>navigation/mobile-section}}{{/direct}}{{/siteNavigation}}
            <a class="mobile-sitemap-link" href="/sitemap">전체 메뉴 <span aria-hidden="true">↗</span></a>
            {{#member}}<div class="mobile-account"><p>{{userId}}님 <span>Lv.{{level}} · {{points}}P</span></p>{{>navigation/account-links}}</div>{{/member}}
        </nav>
    </div>
</header>
{{#msg}}<div class="header-flash" role="status"><span>{{msg}}</span><button type="button" aria-label="알림 닫기" onclick="this.parentElement.remove()">×</button></div>{{/msg}}
