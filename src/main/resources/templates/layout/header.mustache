<style>
@keyframes sss-mascot-wave {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    25% { transform: translateY(-2.5px) rotate(3deg); }
    50% { transform: translateY(0.5px) rotate(-1deg); }
    75% { transform: translateY(-1.5px) rotate(2deg); }
}
@keyframes sss-mascot-fly-in {
    0% {
        transform: translate(92px, 14px) rotate(18deg) scale(0.72);
        opacity: 0;
    }
    12% { opacity: 1; }
    45% {
        transform: translate(48px, 20px) rotate(4deg) scale(0.88);
    }
    72% {
        transform: translate(14px, 6px) rotate(-6deg) scale(0.96);
    }
    100% {
        transform: translate(0, 0) rotate(-2deg) scale(1);
        opacity: 1;
    }
}
@keyframes sss-mascot-trail-fade {
    0% { opacity: 0.55; transform: translate(var(--tx), var(--ty)) scale(0.78) rotate(12deg); }
    100% { opacity: 0; transform: translate(calc(var(--tx) * 0.35), calc(var(--ty) * 0.55)) scale(0.9) rotate(0deg); }
}
.sss-mascot-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 27px;
    width: 33px;
    flex-shrink: 0;
}
.sss-mascot-wave {
    height: 27px;
    width: auto;
    transform-origin: center center;
    will-change: transform;
}
.sss-mascot-wrap.is-ready .sss-mascot-wave {
    animation: sss-mascot-wave 2.8s ease-in-out infinite;
}
.sss-mascot-wrap.is-intro .sss-mascot-wave {
    animation: sss-mascot-fly-in 0.85s cubic-bezier(0.22, 0.9, 0.28, 1) forwards;
}
.sss-mascot-trail {
    position: absolute;
    left: 0;
    top: 0;
    height: 27px;
    width: auto;
    pointer-events: none;
    opacity: 0;
    z-index: 0;
}
.sss-mascot-wrap.is-intro .sss-mascot-trail {
    animation: sss-mascot-trail-fade 0.7s ease-out forwards;
}
.sss-mascot-wrap .sss-mascot-wave { position: relative; z-index: 1; }
@media (prefers-reduced-motion: reduce) {
    .sss-mascot-wrap.is-ready .sss-mascot-wave,
    .sss-mascot-wrap.is-intro .sss-mascot-wave,
    .sss-mascot-wrap.is-intro .sss-mascot-trail { animation: none; }
}
</style>
