{{/member}}

    <!-- 비로그인 시 메뉴 -->
{{^member}}
        <div class="flex items-center gap-2">
            <a href="/login" class="px-3 py-1.5 text-xs text-[#b9cac4] hover:text-[#00f5d4] font-medium text-decoration-none transition-colors">로그인</a>
            <a href="/signup" class="px-3 py-1.5 text-xs bg-[#00f5d4] text-[#0d0e12] hover:bg-[#00f5d4]/80 rounded-full font-semibold text-decoration-none transition-all shadow-md">회원가입</a>
        </div>
    {{/member}}
        </div>
    </div>
</header>

        <!-- Flash Message 알림 메시지 영역 -->
        {{#msg}}
            <div class="max-w-7xl mx-auto px-4 mt-4">
                <div class="bg-primary-container/10 border border-primary-container/30 text-primary-container px-4 py-3 rounded-xl flex items-center justify-between text-xs">
                    <span>{{msg}}</span>
                    <button type="button" class="bg-transparent border-0 text-primary-container cursor-pointer font-bold text-base" onclick="this.parentElement.remove();">&times;</button>
                </div>
            </div>
        {{/msg}}

        <!-- 스크롤 시 상단 헤더 보이기/숨기기 스크립트 -->
        <script>
            let lastScrollTop = 0;
            const header = document.getElementById("top-header");

            window.addEventListener("scroll", function () {
                let currentScroll = window.pageYOffset || document.documentElement.scrollTop;

                if (currentScroll > lastScrollTop && currentScroll > 100) {
                    // 아래로 스크롤 시 헤더 올리기
                    header.style.transform = "translateY(-100%)";
                } else {
                    // 위로 스크롤 시 헤더 다시 내리기
                    header.style.transform = "translateY(0)";
                }
                lastScrollTop = currentScroll <= 0 ? 0 : currentScroll;
            }, false);
        </script>