        <span class="sss-mascot-wrap" id="sss-mascot-wrap">
            <img src="/images/sss-mascot.png" alt="" width="24" height="20" class="sss-mascot-wave block" id="sss-mascot" decoding="async" aria-hidden="true">
        </span>
        <img src="/images/triples-wordmark-white.png" alt="tripleS" width="86" height="20" class="w-auto block" decoding="async">
    </a>
