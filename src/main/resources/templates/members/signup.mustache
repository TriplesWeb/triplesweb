<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>회원가입 페이지</title>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;600&amp;family=Sora:wght@400;600;700;800&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <!-- Tailwind Script -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>
{{>layout/header}}
<main class="flex-1 flex items-center justify-center px-4 sm:px-6 py-12 z-10 relative">
<div class="w-full max-w-md relative">
    <div class="absolute -inset-1 rounded-3xl bg-gradient-to-b from-primary-container/20 via-transparent to-secondary-container/30 blur-xl opacity-75 pointer-events-none"></div>
    <div class="relative bg-surface-container/90 border border-outline-variant/50 rounded-3xl p-8 sm:p-10 backdrop-blur-2xl shadow-2xl neon-border-glow flex-wrap">
        <div class="flex flex-col items-center text-center mb-8">
            <h1 class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight mb-2">회원가입</h1>
        </div>
        {{#errormessage}}
        <div class="mb-6 p-3.5 rounded-xl bg-error-container/20 border border-error/40 flex items-start gap-3">
            <span class="material-symbols-outlined text-error text-[20px] flex-shrink-0 mt-0.5" data-icon="error">error</span>
            <div class="flex-1">
                <p class="font-body-sm text-body-sm text-error font-medium">아이디 또는 비밀번호가 이미 있습니다.</p>
                <p class="font-label-sm text-label-sm text-on-surface-variant/80 mt-0.5">형식에 맞게 아이디를 설정해주세요.</p>
            </div>
        </div>
        {{/errormessage}}
        <form action="/signup" method="post" class="space-y-5">
            <input type="hidden" id="email" name="email" />
            <div class="space-y-2">
                <label for="userid" class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">아이디</label>
                <div class="relative group">
                    <div class="absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary-container transition-colors">
                        <span class="material-symbols-outlined text-[20px]" data-icon="person">person</span>
                    </div>
                    <input type="text" class="form-control w-full pl-11 pr-4 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-black placeholder:text-outline/100 focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" id="userid" name="userId" required="" />
                </div>
            </div>
            <div class="space-y-2">
                <label for="password" class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">비밀번호</label>
                <div class="relative group">
                    <div class="absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary-container transition-colors">
                        <span class="material-symbols-outlined text-[20px]" data-icon="lock">lock</span>
                    </div>
                    <input type="password" class="form-control w-full pl-11 pr-4 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-black focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" id="password" name="password" required="" />
                </div>
            </div>
            <div class="space-y-2">
                <label for="email" class="form-label-md font-label-md text-label-md text-on-surface-variant font-medium">이메일</label>
                <div class="flex items-center gap-2">
                    <div class="relative group flex-1">
                    <div class="absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary-container transition-colors">
                        <span class="material-symbols-outlined text-[20px]" data-icon="email">email</span>
                    </div>
                    <input type="text" class="form-control w-full pl-11 pr-4 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-black focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" id="email-local" name="emailLocal" placeholder="이메일 아이디" />
                    </div>
                <span class="ext-on-surface-variant text-[20px] font-bold shrink-0">@</span>
                <div class="relative group">
                    <select class="form-select w-full pl-11 pr-4 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-black placeholder:text-outline/100 focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" id="email-domain" name="emailDomain" required="">
                        <option value="">도메인 선택</option>
                        <option value="gmail.com">gmail.com</option>
                        <option value="naver.com">naver.com</option>
                        <option value="daum.net">daum.net</option>
                    </select>
                </div>
                </div>
            </div>
            <div class="space-y-2">
            <label for="address"  class="form-label-md font-label-md text-label-md text-body-md text-on-surface-variant font-medium">주소 (선택)</label>
            <div class="relative group">
                <div class="absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary-container transition-colors">
                    <span class="material-symbols-outlined text-[20px]" data-icon="home">home</span>
                </div>
                <input type="text" id="address" name="address" class="form-control w-full pl-11 pr-4 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-black focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" />
            </div>
                <button type="button" class="btn btn-secondary " onclick="searchAddress()">주소 검색</button>
            </div>
            <div class="space-y-3 pt-3">
                <!-- Primary Submit Button -->
                <button class="w-full py-3.5 px-6 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm font-bold tracking-tight transition-all duration-200 btn-glow active:scale-[0.98] flex items-center justify-center gap-2" type="submit">
                    <span>회원가입</span>
                </button>
                <a class="w-full py-3 px-6 rounded-full bg-surface-container-high/40 hover:bg-surface-container-high border border-outline-variant/40 hover:border-outline-variant text-on-surface font-body-md text-body-md font-medium text-center transition-all duration-200 block" href="/login">
                    로그인으로
                </a>
            </div>

    </form>
    </div>
</div>
</main>
<script>
    // 주소 검색
    function searchAddress() {
        new daum.Postcode({
            oncomplete: function(data) {
                document.getElementById("address").value = data.address;
            }
        }).open();
    }
        document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector("form");
        form.addEventListener("submit", function (event) {
        event.preventDefault();
            const emailLocal = document.getElementById("email-local").value.trim();
            const emailDomain = document.getElementById("email-domain").value.trim();

            if (!emailLocal || !emailDomain) {
                alert("이메일을 정확히 입력해주세요.");
                return;
            }

            const fullEmail = `${emailLocal}@${emailDomain}`;
            document.getElementById("email").value = fullEmail;
            this.submit();
        });
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>