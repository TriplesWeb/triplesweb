<!DOCTYPE html>
<html lang="ko" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 내 정보 수정</title>

    <!-- Google Fonts & Tailwind CSS & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            DEFAULT: '#00f5d4',
                            dark: '#006c5c',
                        },
                        darkbg: '#07080b',
                        cardbg: 'rgba(26, 27, 32, 0.7)',
                        bordercol: 'rgba(58, 74, 70, 0.3)',
                    }
                }
            }
        }
    </script>

    <!-- 외부 공통 스타일 및 라이브러리 -->
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />

    <style>
        body {
            background-color: #07080b;
            color: #e3e2e8;
            font-family: 'Inter', sans-serif !important;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* 아이콘 폰트 오염 방지 */
        #top-header *:not(.material-symbols-outlined),
        #navbar *:not(.material-symbols-outlined),
        .nav-dropdown-btn,
        .nav-item-link {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
        }

        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined' !important;
            font-weight: normal;
            font-style: normal;
            font-size: 16px;
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }

        /* 배경 은은한 빛 효과 (Ambient Glow) */
        .ambient-glow-container {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }
        .glow-accent-1 {
            position: absolute;
            top: -8rem;
            left: -8rem;
            width: 24rem;
            height: 24rem;
            border-radius: 9999px;
            background-color: rgba(104, 7, 186, 0.1);
            filter: blur(120px);
        }
        .glow-accent-2 {
            position: absolute;
            top: 33.33%;
            right: -8rem;
            width: 30rem;
            height: 30rem;
            border-radius: 9999px;
            background-color: rgba(0, 245, 212, 0.05);
            filter: blur(140px);
        }

        .main-content {
            flex: 1;
            max-width: 48rem;
            width: 100%;
            margin: 0 auto;
            padding: 3rem 1rem;
            z-index: 10;
        }

        /* 글래스모피즘 카드 */
        .mypage-card {
            background: rgba(26, 27, 32, 0.7);
            border: 1px solid rgba(58, 74, 70, 0.3);
            border-radius: 1rem;
            padding: 2.5rem;
            backdrop-filter: blur(12px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .form-control {
            background-color: rgba(13, 14, 18, 0.8) !important;
            border: 1px solid rgba(58, 74, 70, 0.4) !important;
            color: #e3e2e8 !important;
            border-radius: 0.5rem !important;
        }

        .form-control:focus {
            border-color: #00f5d4 !important;
            box-shadow: 0 0 0 2px rgba(0, 245, 212, 0.2) !important;
        }

        .form-label {
            color: #b9cac4;
            font-size: 0.9rem;
        }

        /* 버튼 디자인 통일 */
        .btn-custom-primary {
            background-color: #00f5d4;
            border: none;
            color: #07080b;
            font-weight: 600;
            border-radius: 9999px;
            padding: 0.5rem 1.25rem;
            transition: all 0.2s;
        }
        .btn-custom-primary:hover {
            background-color: #00dabf;
            color: #07080b;
        }

        .btn-custom-secondary {
            background-color: rgba(41, 42, 46, 0.8);
            border: 1px solid rgba(58, 74, 70, 0.4);
            color: #e3e2e8;
            border-radius: 9999px;
            padding: 0.5rem 1.25rem;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
            cursor: pointer;
        }
        .btn-custom-secondary:hover {
            background-color: rgba(58, 74, 70, 0.8);
            color: #ffffff;
        }
    </style>
</head>
<body class="dark">
<div class="ambient-glow-container">
    <div class="glow-accent-1"></div>
    <div class="glow-accent-2"></div>
</div>

{{>layout/header}}

<div class="main-content">
    <div class="mypage-card">
        <div class="flex items-center gap-2 mb-6 pb-4 border-b border-[#3a4a46]/30">
            <span class="w-2.5 h-2.5 rounded-full bg-[#00f5d4] shadow-[0_0_8px_#00f5d4]"></span>
            <h2 class="text-2xl font-bold font-['Sora'] text-white m-0">내 정보 수정</h2>
        </div>

        <form method="post" action="/mypage_edit" class="space-y-4">
            <div class="mb-3">
                <label class="form-label font-medium mb-1 block">이메일</label>
                <input type="text" class="form-control w-full py-2.5 px-3" name="email" value="{{member.email}}" required />
            </div>

            <div class="mb-3">
                <label class="form-label font-medium mb-1 block">주소</label>
                <input type="text" class="form-control w-full py-2.5 px-3" name="address" value="{{member.address}}" required />
            </div>

            <div class="mb-4">
                <label class="form-label font-medium mb-1 block">비밀번호 변경 (선택)</label>
                <input type="password" class="form-control w-full py-2.5 px-3" name="password" placeholder="변경할 경우에만 입력하세요" />
            </div>

            <div class="flex items-center justify-end gap-2 pt-3">
                <button type="button" onclick="history.back()" class="btn-custom-secondary">뒤로가기</button>
                <button type="submit" class="btn-custom-primary">수정 완료</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>