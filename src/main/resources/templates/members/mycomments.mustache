<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <title>내가 작성한 댓글</title>
    <style>
        .comment-content {
        color: black !important;
        }
        .mycomment-title {
        color: gray !important;
        }
    </style>

</head>
<body>
{{>layout/header}}
<div class="container mt-5">
    <h3 class="mb-3">내가 작성한 댓글</h3>

    {{#resultList}}
        <div class="card mb-3">
            <div class="card-body">
                <div class="mb-2">
                    <span class="badge bg-primary">{{boardName}}</span>
                </div>
                <h5 class="card-title mb-1">
                    <a href="/{{category}}/{{id}}" class="text-decoration-none mycomment-title">
                        내가 댓글 남긴 게시글: {{title}}
                    </a>
                </h5>
                <p class="card-text comment-content ">{{{body}}}</p>
                <p class="text-end text-muted" style="font-size: 0.9rem;">
                    작성자: {{userId}}
                </p>
            </div>
        </div>
    {{/resultList}}

    {{^resultList}}
        <p class="text-muted">작성한 댓글이 없습니다.</p>
    {{/resultList}}

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
