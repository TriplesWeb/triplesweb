<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <title>내가 작성한 글</title>
    <style>
        .highlight {
            font-weight: bold;
            color: #1abc9c;
        }
        .card {
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .board-tag {
            font-size: 0.85rem;
            color: black;
            margin-bottom: 6px;
        }
    </style>
</head>
<body class="other-page">
{{>layout/header}}

<div class="container mt-5">
    <h3 class="mb-3">내가 작성한 글</h3>

    {{#resultList}}
        <div class="card mb-3">
            <div class="card-body">
                <div class="board-tag">
                    <span class="badge bg-primary">{{boardName}}</span>
                </div>
                <h5 class="card-title">
                    <a href="/{{category}}/{{id}}" class="text-decoration-none text-dark">
                        {{{title}}}
                    </a>
                </h5>
                <p class="card-text">{{{content}}}</p>
                <p class="text-end text-muted" style="font-size: 0.9rem;">
                    작성자: {{userId}}
                </p>
            </div>
        </div>
    {{/resultList}}

    {{^resultList}}
        <p class="text-muted">작성한 글이 없습니다.</p>
    {{/resultList}}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
