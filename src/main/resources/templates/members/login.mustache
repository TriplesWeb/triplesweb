
<!DOCTYPE html>
<html class="dark" lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>로그인 | tripleS 커뮤</title>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;600&amp;family=Sora:wght@400;600;700;800&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <!-- Tailwind Script -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
            line-height: 1;
        }
        .neon-border-glow {
            box-shadow: 0 0 25px -4px rgba(0, 245, 212, 0.25), 0 20px 48px -8px rgba(121, 40, 202, 0.35);
        }
        .btn-glow:hover {
            box-shadow: 0 0 24px 0 rgba(0, 245, 212, 0.55);
        }
        .ambient-radial-cyan {
            background: radial-gradient(circle at 15% 25%, rgba(0, 245, 212, 0.08) 0%, transparent 60%);
        }
        .ambient-radial-purple {
            background: radial-gradient(circle at 85% 75%, rgba(104, 7, 186, 0.16) 0%, transparent 65%);
        }
    </style>
</head>
<body>
{{>layout/header}}

<main class="flex-1 flex items-center justify-center px-4 sm:px-6 py-12 z-10 relative">
    <!-- Outer Ambient Glow Box around Card -->
    <div class="w-full max-w-md relative">
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-b from-primary-container/20 via-transparent to-secondary-container/30 blur-xl opacity-75 pointer-events-none"></div>
        <!-- Glassmorphic Login Card -->
        <div class="relative bg-surface-container/90 border border-outline-variant/50 rounded-3xl p-8 sm:p-10 backdrop-blur-2xl shadow-2xl neon-border-glow">
            <!-- Card Header Badge & Identity -->
            <div class="flex flex-col items-center text-center mb-8">
                <h1 class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight mb-2">로그인</h1>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-xs">tripleS 커뮤니티에 오신 것을 환영합니다</p>
            </div>
            <!-- Error Alert Banner (Conditional Demonstration Block) -->
            {{#errorMessage}}
            <div class="mb-6 p-3.5 rounded-xl bg-error-container/20 border border-error/40 flex items-start gap-3">
                <span class="material-symbols-outlined text-error text-[20px] flex-shrink-0 mt-0.5" data-icon="error">error</span>
                <div class="flex-1">
                    <p class="font-body-sm text-body-sm text-error font-medium">아이디 또는 비밀번호가 잘못되었습니다.</p>
                    <p class="font-label-sm text-label-sm text-on-surface-variant/80 mt-0.5">입력하신 계정 정보를 다시 한 번 확인해 주세요.</p>
                </div>
            </div>
            {{/errorMessage}}
            <!-- Login Form -->
            <form action="/login" class="space-y-5" method="post">
                <!-- ID Field -->
                <div class="space-y-2">
                    <label class="block font-label-md text-label-md text-on-surface-variant font-medium" for="userId">아이디</label>
                    <div class="relative group">
                        <div class="absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary-container transition-colors">
                            <span class="material-symbols-outlined text-[20px]" data-icon="person">person</span>
                        </div>
                        <input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-black placeholder:text-outline/100 focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" id="userId" name="userId" placeholder="아이디를 입력하세요" required="" type="text"/>
                    </div>
                </div>
                <!-- Password Field -->
                <div class="space-y-2">
                    <label class="block font-label-md text-label-md text-on-surface-variant font-medium" for="password">비밀번호</label>
                    <div class="relative group">
                        <div class="absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary-container transition-colors">
                            <span class="material-symbols-outlined text-[20px]" data-icon="lock">lock</span>
                        </div>
                        <input class="w-full pl-11 pr-11 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-black focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" id="password" name="password" placeholder="비밀번호를 입력하세요" required="" type="password"/>
                        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface focus:outline-none transition-colors" id="togglePassword" title="비밀번호 보기" type="button">
                            <span class="material-symbols-outlined text-[20px]" data-icon="visibility">visibility</span>
                        </button>
                    </div>
                </div>
                <!-- Remember & Forgot Options -->
                <div class="flex items-center justify-between pt-1 font-body-sm text-body-sm">
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                        <input class="w-4 h-4 rounded bg-surface-container-lowest border-outline-variant/60 text-primary-container focus:ring-0 focus:ring-offset-0 focus:outline-none transition" name="rememberId" type="checkbox"/>
                        <span class="text-on-surface-variant hover:text-on-surface transition-colors">아이디 저장</span>
                    </label>
                    <a class="text-on-surface-variant hover:text-primary-container transition-colors" href="#">비밀번호 찾기</a>
                </div>
                <!-- CTA Actions Cluster -->
                <div class="space-y-3 pt-3">
                    <!-- Primary Submit Button -->
                    <button class="w-full py-3.5 px-6 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm font-bold tracking-tight transition-all duration-200 btn-glow active:scale-[0.98] flex items-center justify-center gap-2" type="submit">
                        <span>로그인</span>
                        <span class="material-symbols-outlined text-[20px]" data-icon="arrow_forward">arrow_forward</span>
                    </button>
                    <!-- Secondary Signup Button -->
                    <a class="w-full py-3 px-6 rounded-full bg-surface-container-high/40 hover:bg-surface-container-high border border-outline-variant/40 hover:border-outline-variant text-on-surface font-body-md text-body-md font-medium text-center transition-all duration-200 block" href="/signup">
                        회원가입으로
                    </a>
                </div>
            </form>
        </div>
    </div>
</main>
</body>
</html>