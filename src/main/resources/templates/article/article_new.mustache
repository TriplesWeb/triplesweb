<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>트리플에스 커뮤니티 - {{categoryName}} 게시판</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* 에디터 내부 영역 스타일 및 미디어 미리보기 서식 정리 */
        #content {
            min-height: 250px;
            max-height: 500px;
            overflow-y: auto;
            outline: none;
        }
        .content-media {
            position: relative;
            display: inline-block;
            margin: 0.5rem 0;
            max-width: 100%;
        }
        .content-media img, .content-media video {
            max-width: 100%;
            border-radius: 0.75rem;
            display: block;
        }
        .content-media .remove-btn, .preview-item .remove-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.6);
            border: none;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
        }
        .preview-item {
            position: relative;
            width: 90px;
            height: 90px;
            border-radius: 0.75rem;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: #111;
        }
        .preview-item img, .preview-item video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col">
{{>layout/header}}

<meta name="_csrf" content="{{_csrf.token}}">
<meta name="_csrf_header" content="{{_csrf.headerName}}">
<div id="editorRoot" data-category="{{category}}"></div>
<main class="flex-1 flex items-center justify-center px-4 sm:px-6 py-12 z-10 relative">
    <div class="w-full max-w-2xl relative">
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-b from-primary-container/20 via-transparent to-secondary-container/30 blur-xl opacity-75 pointer-events-none"></div>
        <div class="relative bg-surface-container/95 border border-outline-variant/50 rounded-3xl p-6 sm:p-10 backdrop-blur-2xl shadow-2xl">
        {{#errorMessage}}
            <div class="mb-6 p-3.5 rounded-xl bg-error-container/20 border border-error/40 flex items-start gap-3">
                <span class="material-symbols-outlined text-error text-[20px] flex-shrink-0 mt-0.5" data-icon="error">error</span>
                <div class="flex-1">
                    <p class="font-body-sm text-body-sm text-error font-medium">{{errorMessage}}</p>
                </div>
            </div>
        {{/errorMessage}}

            <form id="articleForm" action="/article/{{category}}/new" method="post" enctype="multipart/form-data" onsubmit="return beforeSubmit(this)" class="space-y-5">
                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">작성자</label>
                    <div class="relative group">
                        <div class="absolute left-4 top-1/2 -translate-y-1/2 text-black">
                            <span class="material-symbols-outlined text-[20px]" data-icon="person">person</span>
                        </div>

                        <input type="text" class="w-full px-11 pr-4 py-3 bg-surface-container-lowest/50 border border-outline-variant/40 rounded-xl font-body-md text-body-md focus:outline-none" name="userid" value="로그인 필요" readonly>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">제목</label>
                    <div class="relative group">
                        <input type="text" class="w-full px-3 pr-4 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md placeholder:text-outline/60 focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all text-black" name="title" required>
                    </div>
                </div>
                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">내용</label>
                    <div id="content" contenteditable="true" class="w-full p-4 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" aria-multiline="true"></div>
                    <input type="hidden" name="content" id="hiddenContent" />
                </div>


                {{#showObjektPicker}}
                <section class="space-y-3 rounded-xl border border-teal-400/30 bg-teal-400/[0.04] p-4">
                    <h3 class="font-semibold text-teal-200">연결할 오브젝트 선택</h3>
                    <p class="text-xs text-slate-400">교환·거래 게시글에 연결할 오브젝트를 최대 20개까지 선택할 수 있습니다.</p>
                    <div id="objektPickerGrid" class="grid max-h-72 grid-cols-2 gap-3 overflow-y-auto sm:grid-cols-4">
                        {{#objektOptions}}
                        <label class="cursor-pointer rounded-lg border border-white/10 p-2 hover:border-teal-300/50">
                            <input type="checkbox" name="selectedObjektIds" value="{{id}}" class="mb-2">
                            <img src="{{thumbnailImage}}" alt="{{collectionId}}" loading="lazy" class="mb-2 aspect-[2/3] w-full rounded object-cover">
                            <span class="block truncate text-xs font-semibold">{{collectionId}}</span>
                            <span class="block truncate text-[11px] text-slate-400">{{member}} · {{collectionNo}}</span>
                        </label>
                        {{/objektOptions}}
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <p class="text-xs text-slate-400">선택 <strong id="selectedObjektCount" class="text-teal-200">0</strong> / 20개</p>
                        {{#objektPickerHasMore}}
                        <button id="loadMoreObjekts" type="button" data-next-page="1" class="rounded-lg border border-teal-300/40 px-4 py-2 text-xs font-semibold text-teal-200 hover:bg-teal-300/10">다음 오브젝트 20개 불러오기</button>
                        {{/objektPickerHasMore}}
                    </div>
                </section>
                {{/showObjektPicker}}

                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">첨부 파일 (이미지 또는 영상)</label>
                    <div class="relative group">
                        <input type="file" name="uploadFiles" id="fileInput" multiple accept="image/*,video/*" class="w-full py-2.5 px-4 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl text-sm text-on-surface-variant file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary-container file:text-on-primary hover:file:opacity-90 cursor-pointer" />
                    </div>
                </div>
                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">미리보기</label>
                    <div id="previewArea" class="flex flex-wrap gap-3 p-3 bg-surface-container-lowest/40 border border-outline-variant/30 rounded-xl min-h-[80px]"> </div>
                </div>
                {{#_csrf}}
                    <input type="hidden" name="{{parameterName}}" value="{{token}}">
                {{/_csrf}}
                <div class="flex items-center gap-3 pt-4">
                    <button type="submit" class="flex-1 py-3.5 px-6 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm font-bold tracking-tight transition-all duration-200 btn-glow active:scale-[0.98] flex items-center justify-center gap-2">작성하기</button>
                    <a href="/article/{{category}}" class="px-6 py-3.5 rounded-full bg-surface-container-high/40 hover:bg-surface-container-high border border-outline-variant/40 hover:border-outline-variant text-on-surface font-body-md text-body-md font-medium text-center transition-all duration-200">
                        목록으로
                    </a>
                </div>
        </form>
    </div>
    </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    window.beforeSubmit = function(form) {
    const titleInput    = form.querySelector('input[name="title"]');
    const contentDiv    = document.getElementById('content');
    const hiddenContent = document.getElementById('hiddenContent');
    const rawContent = (contentDiv?.innerHTML || '').trim();

    // 본문 HTML을 hidden으로 동기화
    hiddenContent.value = rawContent;
    const titleOk = !!(titleInput && titleInput.value.trim());

    const hasText  = rawContent.replace(/<br\s*\/?>/gi, '').replace(/\s/g, '') !== '';
    const hasImg   = /<img\s[^>]*src=['"][^'"]+['"][^>]*>/i.test(rawContent);
    const hasVideo = /<video\s[^>]*>.*?<\/video>/i.test(rawContent) || /<source\s[^>]*src=['"][^'"]+['"][^>]*>/i.test(rawContent);

    if (!titleOk) {
            alert('제목을 입력해 주세요.');
            return false;
        }
    if (!hasText && !hasImg && !hasVideo) {
            alert('내용을 입력해 주세요.');
            return false;
        }

        return true;
  };

   document.addEventListener('DOMContentLoaded', () => {
     const form          = document.getElementById('articleForm');       // ← id 일치 필수
     const contentDiv    = document.getElementById('content');
     const hiddenContent = document.getElementById('hiddenContent');
     const fileInput     = document.getElementById('fileInput');
     const previewArea   = document.getElementById('previewArea');
     const category = document.getElementById('editorRoot')?.dataset.category || 'category';

     if (!form || !contentDiv || !fileInput || !previewArea) {
       console.error('필수 엘리먼트(id) 누락 확인 필요');
       return;
     }

     const UPLOAD_ENDPOINT = `/api/article/${category}/uploadFile`;
     const FALLBACK_IMG    = '/images/no-image.png';

     // CSRF (있는 경우에만 헤더 세팅)
     const _csrf  = document.querySelector('meta[name="_csrf"]')?.content;
     const _ch    = document.querySelector('meta[name="_csrf_header"]')?.content;
     const buildHeaders = () => (_csrf && _ch) ? { [_ch]: _csrf } : {};

     // ---- helpers ----
     const pick = (o, ks) => ks.find(k => o && o[k]) ? o[ks.find(k => o && o[k])] : null;

     function toUploadsUrl(pathLike) {
       if (!pathLike) return null;
       try {
         const u = new URL(pathLike, location.origin);
         const p = u.pathname.startsWith('/uploads/') ? u.pathname : '/uploads' + (u.pathname.startsWith('/') ? '' : '/') + u.pathname;
         return p.replace(/\/{2,}/g, '/');
       } catch {
         const p = pathLike.startsWith('/uploads/') ? pathLike : '/uploads/' + pathLike.replace(/^\/+/, '');
         return p.replace(/\/{2,}/g, '/');
       }
     }

     function normalizeUploadResponse(payload, mime) {
       const rawUrl  = pick(payload, ['url','path','publicUrl','location','href']);
       const rawName = pick(payload, ['savedName','storedName','name','filename']);
       const url = toUploadsUrl(rawUrl || rawName);
       const storedName = (url || '').replace(/^\/uploads\//,'');
       const fileType = payload.fileType || (mime?.startsWith('video') ? 'video/mp4' : 'image/jpeg');
       return { url, storedName, fileType };
     }

     function insertNodeAtCaret(container, node) {
       const sel = window.getSelection?.();
       if (sel && sel.rangeCount) {
         let range = sel.getRangeAt(0);
         if (!container.contains(range.commonAncestorContainer)) container.appendChild(node);
         else { range.deleteContents(); range.insertNode(node); }
         const r = document.createRange(); r.setStartAfter(node); r.collapse(true);
         sel.removeAllRanges(); sel.addRange(r);
       } else container.appendChild(node);
     }

     function insertMediaAtCaret(url, mime, key) {
       // 본문
       const wrap = document.createElement('div'); wrap.className='content-media'; wrap.dataset.key=key;
       let media;
       if (mime?.startsWith('video')) {
         media = document.createElement('video'); media.controls = true;
         const src = document.createElement('source'); src.src=url; src.type=mime; media.appendChild(src);
       } else {
         media = document.createElement('img'); media.src=url; media.alt='image';
         media.onerror = function(){ this.onerror=null; this.src=FALLBACK_IMG; };
       }
       const removeBtn = document.createElement('button');
       removeBtn.type='button'; removeBtn.className='remove-btn';
       removeBtn.innerHTML='<i class="bi bi-x" style="font-size:16px;color:#fff;"></i>';
       removeBtn.addEventListener('click', () => {
         wrap.remove();
         previewArea.querySelector(`[data-key="${key}"]`)?.remove();
         form.querySelector(`input[name="uploadedFiles"][data-key="${key}"]`)?.remove();
       });
       wrap.appendChild(media); wrap.appendChild(removeBtn);
       insertNodeAtCaret(contentDiv, wrap);

       // 미리보기
       const thumbBox = document.createElement('div'); thumbBox.className='preview-item'; thumbBox.dataset.key=key;
       const thumb = mime?.startsWith('video') ? document.createElement('video') : document.createElement('img');
       thumb.src=url; if (thumb.tagName==='VIDEO') thumb.controls=true;
       thumb.onerror=function(){ this.onerror=null; this.src=FALLBACK_IMG; };
       const tr = document.createElement('button');
       tr.type='button'; tr.className='remove-btn';
       tr.innerHTML='<i class="bi bi-x" style="font-size:18px;color:#dc3545;"></i>';
       tr.addEventListener('click', () => removeBtn.click());
       thumbBox.appendChild(thumb); thumbBox.appendChild(tr);
       previewArea.appendChild(thumbBox);
     }

     function addHiddenUploadedFile(storedName, key) {
       const hidden = document.createElement('input');
       hidden.type='hidden'; hidden.name='uploadedFiles'; hidden.value=storedName; hidden.dataset.key=key;
       form.appendChild(hidden);
     }

     async function uploadOne(file) {
       const fd = new FormData(); fd.append('file', file);
       const res = await fetch(UPLOAD_ENDPOINT, { method:'POST', body:fd, headers:buildHeaders() });

       // 🔴 여기! 응답 실패면 바로 중단(중요)
       if (!res.ok) {
         const txt = await res.text().catch(()=>String(res.status));
         throw new Error(`HTTP ${res.status} - ${txt.substring(0,200)}`);
       }

       const ct = res.headers.get('content-type') || '';
       const payload = ct.includes('application/json') ? await res.json() : { url: await res.text() };
       const { url, storedName } = normalizeUploadResponse(payload, file.type);
       if (!url) throw new Error('업로드 응답에 url이 없습니다.');

       const key = storedName || url;
       insertMediaAtCaret(url, file.type, key);
       addHiddenUploadedFile(storedName, key);
     }

     fileInput.addEventListener('change', async (e) => {
       const files = Array.from(e.target.files || []);
       for (const f of files) {
         try { await uploadOne(f); }
         catch (err) { console.error(err); alert('업로드 실패: ' + (err.message || err)); }
       }
       fileInput.value = '';
     });
   });
</script>



<script>
document.addEventListener('DOMContentLoaded', () => {
  const grid = document.getElementById('objektPickerGrid');
  const loadButton = document.getElementById('loadMoreObjekts');
  const countLabel = document.getElementById('selectedObjektCount');
  if (!grid) return;
  const form = document.getElementById('articleForm');
  const category = document.getElementById('editorRoot')?.dataset.category || 'trade';
  const refreshCount = () => {
    const checks = [...grid.querySelectorAll('input[name="selectedObjektIds"]')];
    const selected = checks.filter(input => input.checked).length;
    if (countLabel) countLabel.textContent = String(selected);
    checks.forEach(input => { input.disabled = !input.checked && selected >= 20; });
  };
  grid.addEventListener('change', event => {
    if (event.target.matches('input[name="selectedObjektIds"]')) refreshCount();
  });
  if (loadButton) {
    loadButton.addEventListener('click', async () => {
      const page = Number(loadButton.dataset.nextPage || '1');
      loadButton.disabled = true;
      loadButton.textContent = '불러오는 중…';
      try {
        const response = await fetch('/article/' + encodeURIComponent(category) + '/objekts?page=' + page, { credentials: 'same-origin' });
        if (!response.ok) throw new Error(response.status === 403 ? '관리자 로그인이 필요합니다.' : '오브젝트를 불러오지 못했습니다.');
        const data = await response.json();
        (data.items || []).forEach(item => {
          const label = document.createElement('label');
          label.className = 'cursor-pointer rounded-lg border border-white/10 p-2 hover:border-teal-300/50';
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.name = 'selectedObjektIds';
          checkbox.value = String(item.id ?? item.collectionId ?? '');
          checkbox.className = 'mb-2';
          const img = document.createElement('img');
          img.src = item.thumbnailImage || item.frontImage || '';
          img.alt = item.collectionId || '오브젝트';
          img.loading = 'lazy';
          img.className = 'mb-2 aspect-[2/3] w-full rounded object-cover';
          const title = document.createElement('span');
          title.className = 'block truncate text-xs font-semibold';
          title.textContent = item.collectionId || '이름 없는 오브젝트';
          const meta = document.createElement('span');
          meta.className = 'block truncate text-[11px] text-slate-400';
          meta.textContent = (item.member || item.memberName || '') + ' · ' + (item.collectionNo || '');
          label.append(checkbox, img, title, meta);
          grid.appendChild(label);
        });
        refreshCount();
        if (!data.hasMore) loadButton.remove();
        else {
          loadButton.dataset.nextPage = String(data.nextPage);
          loadButton.disabled = false;
          loadButton.textContent = '다음 오브젝트 20개 불러오기';
        }
      } catch (error) {
        alert(error.message || '오브젝트를 불러오지 못했습니다.');
        loadButton.disabled = false;
        loadButton.textContent = '다시 시도';
      }
    });
  }
  if (form) form.addEventListener('submit', event => {
    if (grid.querySelectorAll('input[name="selectedObjektIds"]:checked').length > 20) {
      event.preventDefault();
      alert('오브젝트는 최대 20개까지 선택할 수 있습니다.');
    }
  });
  refreshCount();
});
</script>

</body>
</html>
