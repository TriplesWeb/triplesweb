{{#showObjektPicker}}
<section class="space-y-3 rounded-xl border border-teal-400/30 bg-teal-400/[0.04] p-4" id="objektPickerSection"
         data-objekt-api="{{boardBase}}/objekt-options"
         data-initial-search="{{objektInitialSearch}}"
         data-trade-split="{{#isTradeObjektSplit}}true{{/isTradeObjektSplit}}{{^isTradeObjektSplit}}false{{/isTradeObjektSplit}}"
         data-default-open="true">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h3 class="font-semibold text-teal-200">
                {{#isTradeObjektSplit}}Have / Want{{/isTradeObjektSplit}}
                {{^isTradeObjektSplit}}{{#isSellListingWant}}구매 오브젝트{{/isSellListingWant}}{{^isSellListingWant}}판매 오브젝트{{/isSellListingWant}}{{/isTradeObjektSplit}}
            </h3>
            {{#isTradeObjektSplit}}
            <p class="mt-1 text-xs text-slate-400">Have와 Want를 각각 1개 이상 선택하세요.</p>
            {{/isTradeObjektSplit}}
            {{^isTradeObjektSplit}}
            <p class="mt-1 text-xs text-slate-400">오브젝트를 1개 이상 선택하세요.</p>
            {{/isTradeObjektSplit}}
        </div>
        <button type="button" id="objektPickerToggle"
                class="inline-flex items-center gap-1.5 rounded-full border border-teal-300/50 bg-teal-400/10 px-4 py-2 text-xs font-semibold text-teal-100 hover:bg-teal-400/20"
                aria-expanded="true" aria-controls="objektPickerPanel">
            오브젝트 선택
        </button>
    </div>
    <p id="objektSelectedSummary" class="text-xs text-slate-400" aria-live="polite">선택된 오브젝트 0개</p>
    <p id="objektPickerError" class="text-sm text-error font-medium" hidden role="alert"></p>

    {{#isTradeObjektSplit}}
    <nav class="site-section-tabs" role="tablist" aria-label="선택 구역">
        <button type="button" role="tab" id="objektSideHave" class="site-section-tab is-active" data-side="have" aria-selected="true">Have에 담기</button>
        <button type="button" role="tab" id="objektSideWant" class="site-section-tab" data-side="want" aria-selected="false">Want에 담기</button>
    </nav>
    {{/isTradeObjektSplit}}

    {{#isSell}}
    <nav class="site-section-tabs" role="tablist" aria-label="판매 또는 구매">
        <button type="button" role="tab" id="sellListingHaveBtn" class="site-section-tab{{^isSellListingWant}} is-active{{/isSellListingWant}}" data-sell-side="have" aria-selected="{{^isSellListingWant}}true{{/isSellListingWant}}{{#isSellListingWant}}false{{/isSellListingWant}}">판매</button>
        <button type="button" role="tab" id="sellListingWantBtn" class="site-section-tab{{#isSellListingWant}} is-active{{/isSellListingWant}}" data-sell-side="want" aria-selected="{{#isSellListingWant}}true{{/isSellListingWant}}{{^isSellListingWant}}false{{/isSellListingWant}}">구매</button>
    </nav>
    <input type="hidden" name="sellListingSide" id="sellListingSide" value="{{#isSellListingWant}}want{{/isSellListingWant}}{{^isSellListingWant}}have{{/isSellListingWant}}">
    {{/isSell}}

    <div id="objektPickerPanel" class="space-y-3">
        {{>partials/objekt-workspace}}

        <div id="objektSelectedInputs">
            {{#isTradeObjektSplit}}
            {{#objektHaveSelected}}
            <input type="hidden" name="selectedHaveObjektIds" value="{{id}}" data-objekt-id="{{id}}" data-side="have">
            {{/objektHaveSelected}}
            {{#objektWantSelected}}
            <input type="hidden" name="selectedWantObjektIds" value="{{id}}" data-objekt-id="{{id}}" data-side="want">
            {{/objektWantSelected}}
            {{/isTradeObjektSplit}}
            {{^isTradeObjektSplit}}
            {{#objektSelected}}
            <input type="hidden" name="selectedObjektIds" value="{{id}}" data-objekt-id="{{id}}">
            {{/objektSelected}}
            {{/isTradeObjektSplit}}
        </div>
        <div id="objektOptionsScroll" class="max-h-72 overflow-y-auto">
            <div id="objektOptionsList" class="grid grid-cols-2 gap-3 sm:grid-cols-4"></div>
            <div id="objektOptionsSentinel" class="h-2 w-full" aria-hidden="true"></div>
        </div>
        <p id="objektPickerStatus" class="mt-1 text-xs text-slate-400" aria-live="polite">오브젝트를 불러오는 중...</p>
    </div>

    {{#isTradeObjektSplit}}
    <div class="objekt-compose-deal market-feed-deal" aria-label="Have와 Want 선택 구역">
        <div class="market-feed-side" data-side="have">
            <span class="market-feed-side-label">HAVE</span>
            <div id="objektHavePreview" class="market-feed-strip objekt-compose-strip">
                {{#objektHaveSelected}}
                <span class="market-feed-thumb{{^thumbnailImage}} is-empty{{/thumbnailImage}}" data-objekt-id="{{id}}" data-side="have" data-season="{{season}}" {{#thumbnailImage}}{{^collectionNo}}title="{{cardTitle}}"{{/collectionNo}}{{/thumbnailImage}} {{#collectionNo}}title="{{#season}}{{season}} · {{/season}}{{cardTitle}}"{{/collectionNo}}>
                    {{#thumbnailImage}}<img src="{{thumbnailImage}}" alt="" loading="lazy">{{/thumbnailImage}}
                    {{^thumbnailImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/thumbnailImage}}
                    <button type="button" class="objekt-compose-remove" aria-label="선택 해제">×</button>
                </span>
                {{/objektHaveSelected}}
                {{^objektHaveSelected}}
                <p class="objekt-trade-zone-empty" id="objektHaveEmptyHint">Have 오브젝트를 선택하세요</p>
                {{/objektHaveSelected}}
            </div>
        </div>
        <span class="market-feed-swap" aria-hidden="true">⇌</span>
        <div class="market-feed-side" data-side="want" id="objektWantZone">
            <span class="market-feed-side-label">WANT</span>
            <div id="objektWantPreview" class="market-feed-strip objekt-compose-strip">
                {{#objektWantSelected}}
                <span class="market-feed-thumb{{^thumbnailImage}} is-empty{{/thumbnailImage}}" data-objekt-id="{{id}}" data-side="want" data-season="{{season}}">
                    {{#thumbnailImage}}<img src="{{thumbnailImage}}" alt="" loading="lazy">{{/thumbnailImage}}
                    {{^thumbnailImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/thumbnailImage}}
                    <button type="button" class="objekt-compose-remove" aria-label="선택 해제">×</button>
                </span>
                {{/objektWantSelected}}
                {{^objektWantSelected}}
                <p class="objekt-trade-zone-empty" id="objektWantEmptyHint">Want 오브젝트를 선택하세요</p>
                {{/objektWantSelected}}
            </div>
        </div>
    </div>
    {{/isTradeObjektSplit}}

    {{#isSell}}
    <div class="objekt-compose-deal market-feed-deal is-single" aria-label="선택 오브젝트">
        <div class="market-feed-side" data-side="sell">
            <span class="market-feed-side-label" id="objektSellSideLabel">{{#isSellListingWant}}WANT{{/isSellListingWant}}{{^isSellListingWant}}HAVE{{/isSellListingWant}}</span>
            <div id="objektSellPreview" class="market-feed-strip objekt-compose-strip">
                {{#objektSelected}}
                <span class="market-feed-thumb{{^thumbnailImage}} is-empty{{/thumbnailImage}}" data-objekt-id="{{id}}" data-side="sell" data-season="{{season}}">
                    {{#thumbnailImage}}<img src="{{thumbnailImage}}" alt="" loading="lazy">{{/thumbnailImage}}
                    {{^thumbnailImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/thumbnailImage}}
                    <button type="button" class="objekt-compose-remove" aria-label="선택 해제">×</button>
                </span>
                {{/objektSelected}}
                {{^objektSelected}}
                <p class="objekt-trade-zone-empty" id="objektSellEmptyHint">오브젝트를 선택하세요</p>
                {{/objektSelected}}
            </div>
        </div>
    </div>
    {{/isSell}}
</section>
{{/showObjektPicker}}
