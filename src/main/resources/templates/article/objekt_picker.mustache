{{#showObjektPicker}}
<section class="space-y-3 rounded-xl border border-teal-400/30 bg-teal-400/[0.04] p-4" id="objektPickerSection"
         data-objekt-api="{{boardBase}}/objekt-options"
         data-initial-search="{{objektInitialSearch}}"
         data-trade-split="{{#isTradeObjektSplit}}true{{/isTradeObjektSplit}}{{^isTradeObjektSplit}}false{{/isTradeObjektSplit}}"
         data-default-open="true">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h3 class="font-semibold text-teal-200">
                {{#isTradeObjektSplit}}Have / Want{{/isTradeObjektSplit}}
                {{^isTradeObjektSplit}}{{#isSellListingWant}}구매 오브젝트{{/isSellListingWant}}{{^isSellListingWant}}판매 오브젝트{{/isSellListingWant}}{{/isTradeObjektSplit}}
            </h3>
            {{#isTradeObjektSplit}}
            <p class="mt-1 text-xs text-slate-400">Have와 Want를 각각 1개 이상 선택하세요. 합쳐 최대 20개.</p>
            {{/isTradeObjektSplit}}
            {{^isTradeObjektSplit}}
            <p class="mt-1 text-xs text-slate-400">오브젝트를 1개 이상 선택하세요. 최대 20개.</p>
            {{/isTradeObjektSplit}}
        </div>
        <button type="button" id="objektPickerToggle"
                class="inline-flex items-center gap-1.5 rounded-full border border-teal-300/50 bg-teal-400/10 px-4 py-2 text-xs font-semibold text-teal-100 hover:bg-teal-400/20"
                aria-expanded="true" aria-controls="objektPickerPanel">
            오브젝트 선택
        </button>
    </div>
    <p id="objektSelectedSummary" class="text-xs text-slate-400" aria-live="polite">선택된 오브젝트 0개</p>
    <p id="objektPickerError" class="text-sm text-error font-medium" hidden role="alert"></p>

    {{#isTradeObjektSplit}}
    <div class="objekt-compose-deal market-feed-deal" aria-label="Have와 Want 선택 구역">
        <div class="market-feed-side" data-side="have">
            <span class="market-feed-side-label">HAVE</span>
            <div id="objektHavePreview" class="market-feed-strip objekt-compose-strip">
                {{#objektHaveSelected}}
                <span class="market-feed-thumb{{^thumbnailImage}} is-empty{{/thumbnailImage}}" data-objekt-id="{{id}}" data-side="have" data-season="{{season}}" {{#thumbnailImage}}{{^collectionNo}}title="{{cardTitle}}"{{/collectionNo}}{{/thumbnailImage}} {{#collectionNo}}title="{{#season}}{{season}} · {{/season}}{{cardTitle}}"{{/collectionNo}}>
                    {{#thumbnailImage}}<img src="{{thumbnailImage}}" alt="" loading="lazy">{{/thumbnailImage}}
                    {{^thumbnailImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/thumbnailImage}}
                    <button type="button" class="objekt-compose-remove" aria-label="선택 해제">×</button>
                </span>
                {{/objektHaveSelected}}
                {{^objektHaveSelected}}
                <p class="objekt-trade-zone-empty" id="objektHaveEmptyHint">Have 오브젝트를 선택하세요</p>
                {{/objektHaveSelected}}
            </div>
        </div>
        <span class="market-feed-swap" aria-hidden="true">⇌</span>
        <div class="market-feed-side" data-side="want" id="objektWantZone">
            <span class="market-feed-side-label">WANT</span>
            <div id="objektWantPreview" class="market-feed-strip objekt-compose-strip">
                {{#objektWantSelected}}
                <span class="market-feed-thumb{{^thumbnailImage}} is-empty{{/thumbnailImage}}" data-objekt-id="{{id}}" data-side="want" data-season="{{season}}">
                    {{#thumbnailImage}}<img src="{{thumbnailImage}}" alt="" loading="lazy">{{/thumbnailImage}}
                    {{^thumbnailImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/thumbnailImage}}
                    <button type="button" class="objekt-compose-remove" aria-label="선택 해제">×</button>
                </span>
                {{/objektWantSelected}}
                {{^objektWantSelected}}
                <p class="objekt-trade-zone-empty" id="objektWantEmptyHint">Have를 고른 뒤 Want를 선택하세요</p>
                {{/objektWantSelected}}
            </div>
        </div>
    </div>
    {{/isTradeObjektSplit}}

    {{#isSell}}
    <div class="objekt-side-toggle" role="group" aria-label="판매 또는 구매">
        <button type="button" id="sellListingHaveBtn" class="objekt-side-btn{{^isSellListingWant}} is-active{{/isSellListingWant}}" data-sell-side="have" aria-pressed="{{^isSellListingWant}}true{{/isSellListingWant}}{{#isSellListingWant}}false{{/isSellListingWant}}">판매</button>
        <button type="button" id="sellListingWantBtn" class="objekt-side-btn{{#isSellListingWant}} is-active{{/isSellListingWant}}" data-sell-side="want" aria-pressed="{{#isSellListingWant}}true{{/isSellListingWant}}{{^isSellListingWant}}false{{/isSellListingWant}}">구매</button>
    </div>
    <input type="hidden" name="sellListingSide" id="sellListingSide" value="{{#isSellListingWant}}want{{/isSellListingWant}}{{^isSellListingWant}}have{{/isSellListingWant}}">
    <div class="objekt-compose-deal market-feed-deal is-single" aria-label="선택 오브젝트">
        <div class="market-feed-side" data-side="sell">
            <span class="market-feed-side-label" id="objektSellSideLabel">{{#isSellListingWant}}WANT{{/isSellListingWant}}{{^isSellListingWant}}HAVE{{/isSellListingWant}}</span>
            <div id="objektSellPreview" class="market-feed-strip objekt-compose-strip">
                {{#objektSelected}}
                <span class="market-feed-thumb{{^thumbnailImage}} is-empty{{/thumbnailImage}}" data-objekt-id="{{id}}" data-side="sell" data-season="{{season}}">
                    {{#thumbnailImage}}<img src="{{thumbnailImage}}" alt="" loading="lazy">{{/thumbnailImage}}
                    {{^thumbnailImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/thumbnailImage}}
                    <button type="button" class="objekt-compose-remove" aria-label="선택 해제">×</button>
                </span>
                {{/objektSelected}}
                {{^objektSelected}}
                <p class="objekt-trade-zone-empty" id="objektSellEmptyHint">오브젝트를 선택하세요</p>
                {{/objektSelected}}
            </div>
        </div>
    </div>
    {{/isSell}}

    <div id="objektPickerPanel" class="space-y-3">
        {{#isTradeObjektSplit}}
        <div class="objekt-side-toggle" role="group" aria-label="선택 구역">
            <button type="button" id="objektSideHave" class="objekt-side-btn is-active" data-side="have" aria-pressed="true">Have에 담기</button>
            <button type="button" id="objektSideWant" class="objekt-side-btn" data-side="want" aria-pressed="false" disabled>Want에 담기</button>
        </div>
        {{/isTradeObjektSplit}}
        <p class="text-xs text-slate-400">시즌·클래스·멤버로 필터하거나 검색한 뒤 체크하세요.</p>

        <div class="market-member-filter objekt-picker-market-filter" aria-label="오브젝트 필터">
            <input type="hidden" id="objektFilterMember" value="">
            <input type="hidden" id="objektFilterSeason" value="">
            <input type="hidden" id="objektFilterClass" value="">
            <div class="market-filter-bar" role="group" aria-label="시즌·클래스 필터">
                <div class="objekt-filter relative" id="objekt-season-dropdown">
                    <span class="objekt-filter-label">시즌</span>
                    <button type="button" id="objekt-season-toggle" class="objekt-filter-control" aria-haspopup="true" aria-expanded="false" aria-controls="objekt-season-menu" aria-label="시즌">
                        <span id="objekt-season-label" class="truncate">전체</span>
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                    <div id="objekt-season-menu" class="objekt-dropdown-menu hidden" hidden>
                        <label class="objekt-choice">
                            <input type="checkbox" value="all" class="season-checkbox" checked>
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">전체 시즌</span>
                        </label>
                        {{#objektSeasonOptions}}
                        <label class="objekt-choice">
                            <input type="checkbox" value="{{.}}" class="season-checkbox">
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">{{.}}</span>
                        </label>
                        {{/objektSeasonOptions}}
                    </div>
                </div>
                <div class="objekt-filter relative" id="objekt-class-dropdown">
                    <span class="objekt-filter-label">클래스</span>
                    <button type="button" id="objekt-class-toggle" class="objekt-filter-control" aria-haspopup="true" aria-expanded="false" aria-controls="objekt-class-menu" aria-label="클래스">
                        <span id="objekt-class-label" class="truncate">전체</span>
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                    <div id="objekt-class-menu" class="objekt-dropdown-menu hidden" hidden>
                        <label class="objekt-choice">
                            <input type="checkbox" value="all" class="class-checkbox" checked>
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">전체 클래스</span>
                        </label>
                        {{#objektClassOptions}}
                        <label class="objekt-choice">
                            <input type="checkbox" value="{{.}}" class="class-checkbox">
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">{{.}}</span>
                        </label>
                        {{/objektClassOptions}}
                    </div>
                </div>
            </div>
            <div class="market-member-picker" id="objekt-member-picker-wrap">
                <div class="member-portrait-picker" id="objekt-member-picker" role="group" aria-label="멤버 선택">
                    {{>partials/member-portrait-picker}}
                </div>
            </div>
            <div class="objekt-search-row objekt-picker-search-row">
                <div class="objekt-search site-search">
                    <span class="objekt-search-glyph" aria-hidden="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
                    </span>
                    <label class="w-full min-w-0">
                        <input type="search" id="objektFilterSearch" placeholder="멤버·시즌·번호·설명 검색..." aria-label="오브젝트 검색" autocomplete="off" class="objekt-search-input site-search__input">
                    </label>
                </div>
                <button type="button" id="objektFilterReset" class="objekt-reset-button" hidden>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10a9 9 0 1 1 2.6 8.4M3 4v6h6"/></svg>
                    초기화
                </button>
            </div>
        </div>

        <div id="objektSelectedInputs">
            {{#isTradeObjektSplit}}
            {{#objektHaveSelected}}
            <input type="hidden" name="selectedHaveObjektIds" value="{{id}}" data-objekt-id="{{id}}" data-side="have">
            {{/objektHaveSelected}}
            {{#objektWantSelected}}
            <input type="hidden" name="selectedWantObjektIds" value="{{id}}" data-objekt-id="{{id}}" data-side="want">
            {{/objektWantSelected}}
            {{/isTradeObjektSplit}}
            {{^isTradeObjektSplit}}
            {{#objektSelected}}
            <input type="hidden" name="selectedObjektIds" value="{{id}}" data-objekt-id="{{id}}">
            {{/objektSelected}}
            {{/isTradeObjektSplit}}
        </div>
        <div id="objektOptionsList" class="grid max-h-72 grid-cols-2 gap-3 overflow-y-auto sm:grid-cols-4"></div>
        <div class="mt-1 flex flex-wrap items-center justify-between gap-2">
            <p id="objektPickerStatus" class="text-xs text-slate-400" aria-live="polite">오브젝트를 불러오는 중...</p>
            <button id="loadMoreObjekts" type="button"
                    class="rounded-full border border-teal-300/40 px-3 py-1.5 text-[11px] font-semibold text-teal-200 hover:bg-teal-300/10">
                오브젝트 더 보기
            </button>
        </div>
    </div>
</section>
{{/showObjektPicker}}
