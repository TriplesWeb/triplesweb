{{#showObjektPicker}}
<section class="space-y-3 rounded-xl border border-teal-400/30 bg-teal-400/[0.04] p-4" id="objektPickerSection"
         data-objekt-api="/article/{{category}}/objekt-options"
         data-initial-search="{{objektInitialSearch}}"
         data-trade-split="{{#isTradeObjektSplit}}true{{/isTradeObjektSplit}}{{^isTradeObjektSplit}}false{{/isTradeObjektSplit}}">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h3 class="font-semibold text-teal-200">교환/거래 오브젝트</h3>
            {{#isTradeObjektSplit}}
            <p class="mt-1 text-xs text-slate-400">Have와 Want를 각각 1개 이상 선택하세요. 합쳐 최대 20개.</p>
            {{/isTradeObjektSplit}}
            {{^isTradeObjektSplit}}
            <p class="mt-1 text-xs text-slate-400">최대 20개까지 연결할 수 있습니다.</p>
            {{/isTradeObjektSplit}}
        </div>
        <button type="button" id="objektPickerToggle"
                class="inline-flex items-center gap-1.5 rounded-full border border-teal-300/50 bg-teal-400/10 px-4 py-2 text-xs font-semibold text-teal-100 hover:bg-teal-400/20"
                aria-expanded="false" aria-controls="objektPickerPanel">
            오브젝트 선택
        </button>
    </div>
    <p id="objektSelectedSummary" class="text-xs text-slate-400" aria-live="polite">선택된 오브젝트 0개</p>

    {{#isTradeObjektSplit}}
    <div class="objekt-trade-zones" aria-label="Have와 Want 선택 구역">
        <div class="objekt-trade-zone" data-zone="have">
            <div class="objekt-trade-zone-head">
                <span class="objekt-trade-zone-label">Have</span>
                <span class="objekt-trade-zone-hint">가진 오브젝트</span>
            </div>
            <div id="objektHavePreview" class="objekt-trade-zone-cards">
                {{#objektHaveSelected}}
                <div class="objekt-trade-chip" data-objekt-id="{{id}}" data-side="have" data-season="{{season}}">
                    {{#thumbnailImage}}<img src="{{thumbnailImage}}" alt="" loading="lazy">{{/thumbnailImage}}
                    <span class="objekt-trade-chip-title">{{#season}}<small class="objekt-trade-season">{{season}}</small> {{/season}}{{#cardTitle}}{{cardTitle}}{{/cardTitle}}{{^cardTitle}}{{collectionId}}{{/cardTitle}}</span>
                    <button type="button" class="objekt-trade-chip-remove" aria-label="선택 해제">×</button>
                </div>
                {{/objektHaveSelected}}
            </div>
        </div>
        <div class="objekt-trade-zone-divider" aria-hidden="true">↔</div>
        <div class="objekt-trade-zone" data-zone="want" id="objektWantZone">
            <div class="objekt-trade-zone-head">
                <span class="objekt-trade-zone-label">Want</span>
                <span class="objekt-trade-zone-hint">원하는 오브젝트</span>
            </div>
            <div id="objektWantPreview" class="objekt-trade-zone-cards">
                {{#objektWantSelected}}
                <div class="objekt-trade-chip" data-objekt-id="{{id}}" data-side="want" data-season="{{season}}">
                    {{#thumbnailImage}}<img src="{{thumbnailImage}}" alt="" loading="lazy">{{/thumbnailImage}}
                    <span class="objekt-trade-chip-title">{{#season}}<small class="objekt-trade-season">{{season}}</small> {{/season}}{{#cardTitle}}{{cardTitle}}{{/cardTitle}}{{^cardTitle}}{{collectionId}}{{/cardTitle}}</span>
                    <button type="button" class="objekt-trade-chip-remove" aria-label="선택 해제">×</button>
                </div>
                {{/objektWantSelected}}
                {{^objektWantSelected}}
                <p class="objekt-trade-zone-empty" id="objektWantEmptyHint">Have를 고른 뒤 Want를 선택하세요</p>
                {{/objektWantSelected}}
            </div>
        </div>
    </div>
    {{/isTradeObjektSplit}}

    {{#isSell}}
    <input type="hidden" name="sellListingSide" value="{{#isSellListingWant}}want{{/isSellListingWant}}{{^isSellListingWant}}have{{/isSellListingWant}}">
    {{/isSell}}

    <div id="objektPickerPanel" class="hidden space-y-3" hidden>
        {{#isTradeObjektSplit}}
        <div class="objekt-side-toggle" role="group" aria-label="선택 구역">
            <button type="button" id="objektSideHave" class="objekt-side-btn is-active" data-side="have" aria-pressed="true">Have에 담기</button>
            <button type="button" id="objektSideWant" class="objekt-side-btn" data-side="want" aria-pressed="false" disabled>Want에 담기</button>
        </div>
        {{/isTradeObjektSplit}}
        <p class="text-xs text-slate-400">멤버·시즌·종류·정렬·클래스로 필터하거나 검색한 뒤 체크하세요.</p>

        <div class="objekt-picker-filter-bar">
            <div class="objekt-picker-filter-row">
            <div class="objekt-filter relative" id="objekt-member-dropdown">
                <span class="objekt-filter-label">멤버</span>
                <input type="hidden" id="objektFilterMember" value="">
                <button type="button" class="objekt-filter-control" id="objekt-member-toggle" aria-expanded="false" aria-controls="objekt-member-menu">
                    <span id="objekt-member-label" class="truncate">전체</span>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                </button>
                <div id="objekt-member-menu" class="objekt-dropdown-menu absolute top-full left-0 mt-2 min-w-[9rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" hidden>
                    <button type="button" class="objekt-choice" data-value=""><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">전체</span></button>
                    {{#objektMemberOptions}}
                    <button type="button" class="objekt-choice" data-value="{{.}}"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">{{.}}</span></button>
                    {{/objektMemberOptions}}
                    {{#hasOtherObjektOption}}
                    <button type="button" class="objekt-choice" data-value="__other__"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">기타 옵젝</span></button>
                    {{/hasOtherObjektOption}}
                </div>
            </div>
            <div class="objekt-filter relative" id="objekt-season-dropdown">
                <span class="objekt-filter-label">시즌</span>
                <input type="hidden" id="objektFilterSeason" value="">
                <button type="button" class="objekt-filter-control" id="objekt-season-toggle" aria-expanded="false" aria-controls="objekt-season-menu">
                    <span id="objekt-season-label" class="truncate">전체</span>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                </button>
                <div id="objekt-season-menu" class="objekt-dropdown-menu absolute top-full left-0 mt-2 min-w-[9rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" hidden>
                    <button type="button" class="objekt-choice" data-value=""><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">전체</span></button>
                    {{#objektSeasonOptions}}
                    <button type="button" class="objekt-choice" data-value="{{.}}"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">{{.}}</span></button>
                    {{/objektSeasonOptions}}
                </div>
            </div>
            <div class="objekt-filter relative" id="objekt-kind-dropdown">
                <span class="objekt-filter-label">종류</span>
                <div class="objekt-filter-control objekt-kind-combo">
                    <input type="hidden" id="objektFilterKind" value="all">
                    <input type="text"
                           id="objekt-kind-select"
                           class="objekt-kind-select"
                           value="전체"
                           placeholder="전체"
                           autocomplete="off"
                           spellcheck="false"
                           role="combobox"
                           aria-expanded="false"
                           aria-controls="objekt-kind-menu"
                           aria-autocomplete="list"
                           aria-label="옵젝 종류 필터 (입력 또는 선택)">
                    <button type="button" class="objekt-kind-toggle" id="objekt-kind-toggle" aria-label="종류 목록 열기" tabindex="-1">
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                </div>
                <div id="objekt-kind-menu" class="objekt-dropdown-menu hidden absolute top-full left-0 mt-2 min-w-[9rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" hidden role="listbox" aria-label="종류 목록">
                    <button type="button" class="objekt-kind-option" data-value="all" role="option">전체</button>
                    {{#objektKindOptions}}
                    <button type="button" class="objekt-kind-option" data-value="{{.}}" role="option">{{.}}</button>
                    {{/objektKindOptions}}
                    <p class="objekt-kind-empty" id="objekt-kind-empty" hidden>일치하는 종류 없음</p>
                </div>
            </div>
            <div class="objekt-filter relative" id="objekt-sort-dropdown">
                <span class="objekt-filter-label">정렬</span>
                <input type="hidden" id="objektFilterSort" value="latest">
                <button type="button" class="objekt-filter-control" id="objekt-sort-toggle" aria-expanded="false" aria-controls="objekt-sort-menu">
                    <span id="objekt-sort-label" class="truncate">최신순</span>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                </button>
                <div id="objekt-sort-menu" class="objekt-dropdown-menu absolute top-full left-0 mt-2 min-w-[10rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" hidden>
                    <button type="button" class="objekt-choice" data-value="latest"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">최신순</span></button>
                    <button type="button" class="objekt-choice" data-value="oldest"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">오래된순</span></button>
                    <button type="button" class="objekt-choice" data-value="number_low"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">번호 낮은순</span></button>
                    <button type="button" class="objekt-choice" data-value="number_high"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">번호 높은순</span></button>
                    <button type="button" class="objekt-choice" data-value="first_member"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">첫 멤버</span></button>
                    <button type="button" class="objekt-choice" data-value="last_member"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">마지막 멤버</span></button>
                    <button type="button" class="objekt-choice" data-value="mint_low"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">민팅 적은순</span></button>
                    <button type="button" class="objekt-choice" data-value="mint_high"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">민팅 많은순</span></button>
                </div>
            </div>
            </div>
            <div class="objekt-picker-search-row">
            <div class="header-search objekt-picker-search" role="search">
                <input type="search" id="objektFilterSearch" placeholder="멤버·시즌·번호 검색" aria-label="오브젝트 검색" autocomplete="off">
                <button type="button" id="objektFilterSearchBtn" class="header-search-submit" aria-label="검색"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
            </div>
            <button type="button" id="objektFilterReset" class="objekt-picker-reset">초기화</button>
            </div>
            <div class="objekt-picker-class-row">
                <div class="objekt-filter relative" id="objekt-class-dropdown">
                    <span class="objekt-filter-label">클래스</span>
                    <input type="hidden" id="objektFilterClass" value="">
                    <button type="button" class="objekt-filter-control" id="objekt-class-toggle" aria-expanded="false" aria-controls="objekt-class-menu">
                        <span id="objekt-class-label" class="truncate">전체</span>
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                    <div id="objekt-class-menu" class="objekt-dropdown-menu absolute top-full left-0 mt-2 min-w-[9rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" hidden>
                        <button type="button" class="objekt-choice" data-value=""><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">전체</span></button>
                        {{#objektClassOptions}}
                        <button type="button" class="objekt-choice" data-value="{{.}}"><span class="objekt-choice-mark" aria-hidden="true"></span><span class="objekt-choice-text">{{.}}</span></button>
                        {{/objektClassOptions}}
                    </div>
                </div>
            </div>
        </div>

        <div id="objektSelectedInputs">
            {{#isTradeObjektSplit}}
            {{#objektHaveSelected}}
            <input type="hidden" name="selectedHaveObjektIds" value="{{id}}" data-objekt-id="{{id}}" data-side="have">
            {{/objektHaveSelected}}
            {{#objektWantSelected}}
            <input type="hidden" name="selectedWantObjektIds" value="{{id}}" data-objekt-id="{{id}}" data-side="want">
            {{/objektWantSelected}}
            {{/isTradeObjektSplit}}
            {{^isTradeObjektSplit}}
            {{#objektSelected}}
            <input type="hidden" name="selectedObjektIds" value="{{id}}" data-objekt-id="{{id}}">
            {{/objektSelected}}
            {{/isTradeObjektSplit}}
        </div>
        <div id="objektOptionsList" class="grid max-h-72 grid-cols-2 gap-3 overflow-y-auto sm:grid-cols-4"></div>
        <div class="mt-1 flex flex-wrap items-center justify-between gap-2">
            <p id="objektPickerStatus" class="text-xs text-slate-400" aria-live="polite">오브젝트를 불러오는 중...</p>
            <button id="loadMoreObjekts" type="button"
                    class="rounded-full border border-teal-300/40 px-3 py-1.5 text-[11px] font-semibold text-teal-200 hover:bg-teal-300/10">
                오브젝트 더 보기
            </button>
        </div>
    </div>
</section>
{{/showObjektPicker}}
