<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 - 인기글</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col">
{{>layout/header}}

<main class="flex-1 flex items-start justify-center px-4 sm:px-6 py-6 z-10 relative">
    <div class="w-full max-w-4xl relative">
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-b from-primary-container/20 via-transparent to-secondary-container/30 blur-xl opacity-75 pointer-events-none"></div>
        <div class="article-board-shell relative bg-surface-container/95 border border-outline-variant/50 rounded-3xl p-6 sm:p-10 backdrop-blur-2xl shadow-2xl">
            <div class="flex items-center justify-between mb-8 pb-4 border-b border-outline-variant/30">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-red-400 text-3xl">local_fire_department</span>
                    <h1 class="font-headline-lg text-headline-md font-bold text-on-surface tracking-tight">인기글</h1>
                </div>
            </div>

            <div class="w-full overflow-hidden rounded-2xl border border-outline-variant/40 bg-surface-container-lowest/40 mb-8">
                <div class="article-board-heading grid grid-cols-12 gap-4 px-6 py-3.5 bg-surface-container-high/60 border-b border-outline-variant/40 text-on-surface-variant font-semibold text-sm text-center">
                    <div class="col-span-1">순위</div>
                    <div class="col-span-5 text-left">제목</div>
                    <div class="col-span-2">게시판</div>
                    <div class="col-span-2">작성자</div>
                    <div class="col-span-1">날짜</div>
                    <div class="col-span-1">추천</div>
                </div>
                <div class="divide-y divide-outline-variant/20">
                    {{#articleList}}
                        <div class="article-board-row grid grid-cols-12 gap-4 px-6 py-4 items-center text-center text-sm text-on-surface hover:bg-surface-container-highest/30 transition-colors">
                            <div class="col-span-1 text-outline font-mono">{{displayId}}</div>
                            <div class="col-span-5 text-left font-medium truncate">
                                <a href="/article/{{category}}/{{id}}" class="hover:text-primary-container transition-colors">{{title}}</a>
                            </div>
                            <div class="col-span-2 text-on-surface-variant truncate">{{category}}</div>
                            <div class="col-span-2 text-on-surface-variant truncate">{{userId}}</div>
                            <div class="col-span-1 text-xs text-outline">{{formattedDate}}</div>
                            <div class="col-span-1 text-primary-container font-semibold">{{likesCount}}</div>
                        </div>
                    {{/articleList}}
                    {{^articleList}}
                        <div class="py-16 text-center">
                            <span class="material-symbols-outlined text-outline text-4xl mb-2">inbox</span>
                            <p class="text-on-surface-variant font-medium">인기글이 없습니다.</p>
                        </div>
                    {{/articleList}}
                </div>
            </div>
            <div class="flex justify-end">
                <a href="/" class="py-2 px-5 rounded-xl bg-surface-container-high/40 hover:bg-surface-container-high border border-outline-variant/40 text-on-surface-variant hover:text-on-surface text-sm font-medium transition-all">홈으로</a>
            </div>
        </div>
    </div>
</main>

{{>layout/footer}}
</body>
</html>
