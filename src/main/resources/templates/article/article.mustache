{{>layout/v2/head-open}}

    <title>트리플에스 커뮤니티 - {{categoryName}} 게시판</title>
    
    
<link rel="stylesheet" href="/css/v2-pages.css?v=1">
</head><body class="v2-body site-page article-page bg-surface text-on-surface min-h-screen flex flex-col">
{{>layout/v2/header}}

<main class="flex-1 flex items-start justify-center px-4 sm:px-6 py-6 z-10 relative">
    <div class="w-full max-w-4xl relative">
        <!-- 배경 글로우 효과 -->
        <div class="absolute -inset-1 rounded-3xl from-primary-container/20 via-transparent to-secondary-container/30 blur-xl opacity-75 pointer-events-none"></div>

        <!-- 메인 컨테이너 카드 -->
        <div class="article-board-shell {{#hideRecommendations}}article-board-no-likes{{/hideRecommendations}} relative bg-surface-container/95 border border-outline-variant/50 rounded-3xl p-6 sm:p-10">

            <!-- 상단 헤더 타이틀 -->
            <div class="article-board-title flex items-center justify-between mb-8 pb-4 border-b border-outline-variant/30">
                <div class="flex items-center gap-3">
                    <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:#8decd9;flex-shrink:0"><path d="M20 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.95L3 21l1.95-4.5A9 9 0 0 1 4 12.5 8.5 8.5 0 1 1 20 11.5Z"/><path d="M8 10h8M8 14h5"/></svg>
                    <h1 class="font-headline-lg text-headline-md font-bold text-on-surface tracking-tight">
                        {{categoryName}} 게시판
                    </h1>
                </div>
            </div>

            {{#isMarketBoard}}
            <nav class="market-tabs" aria-label="교환/거래 게시판 분류">
                <a href="/article/trade" {{#isTrade}}aria-current="page"{{/isTrade}}>교환</a>
                <a href="/article/sell" {{#isSell}}aria-current="page"{{/isSell}}>거래</a>
            </nav>
            <section class="market-member-filter" aria-label="멤버별 검색">
                <div class="market-side-seg" role="group" aria-label="Have Want 구분">
                    <a class="market-side-link{{#isObjektSideAll}} is-active{{/isObjektSideAll}}" href="/article/{{category}}?objektSide=all{{#selectedMember}}&amp;member={{selectedMember}}{{/selectedMember}}{{#searchKeyword}}&amp;type={{#isSearchTitle}}title{{/isSearchTitle}}{{#isSearchContent}}content{{/isSearchContent}}{{#isSearchWriter}}writer{{/isSearchWriter}}&amp;keyword={{searchKeyword}}{{/searchKeyword}}">전체</a>
                    <a class="market-side-link{{#isObjektSideHave}} is-active{{/isObjektSideHave}}" href="/article/{{category}}?objektSide=have{{#selectedMember}}&amp;member={{selectedMember}}{{/selectedMember}}{{#searchKeyword}}&amp;type={{#isSearchTitle}}title{{/isSearchTitle}}{{#isSearchContent}}content{{/isSearchContent}}{{#isSearchWriter}}writer{{/isSearchWriter}}&amp;keyword={{searchKeyword}}{{/searchKeyword}}">Have</a>
                    {{#isTrade}}
                    <a class="market-side-link{{#isObjektSideWant}} is-active{{/isObjektSideWant}}" href="/article/{{category}}?objektSide=want{{#selectedMember}}&amp;member={{selectedMember}}{{/selectedMember}}{{#searchKeyword}}&amp;type={{#isSearchTitle}}title{{/isSearchTitle}}{{#isSearchContent}}content{{/isSearchContent}}{{#isSearchWriter}}writer{{/isSearchWriter}}&amp;keyword={{searchKeyword}}{{/searchKeyword}}">Want</a>
                    {{/isTrade}}
                </div>
                <div class="member-portrait-picker" id="market-member-picker" role="group" aria-label="멤버 선택">
                    {{>partials/member-portrait-picker}}
                </div>
            </section>
            {{/isMarketBoard}}

            <!-- 게시판 테이블 영역 -->
            <div class="article-board-list w-full overflow-hidden rounded-2xl border border-outline-variant/40 bg-surface-container-lowest/40 mb-8">

                <!-- 테이블 헤더 -->
                <div class="article-board-heading grid grid-cols-12 gap-4 px-6 py-3.5 bg-surface-container-high/60 border-b border-outline-variant/40 text-on-surface-variant font-semibold text-sm text-center">
                    <div class="col-span-1">번호</div>
                    <div class="col-span-6 text-left">제목</div>
                    <div class="col-span-2">작성자</div>
                    <div class="col-span-2">날짜</div>
                    {{^hideRecommendations}}<div class="col-span-1">추천</div>{{/hideRecommendations}}
                </div>

                <!-- 테이블 바디 (게시글 목록 루프) -->
                <div class="divide-y divide-outline-variant/20">
                    {{#articleList}}
                        <div class="article-board-row grid grid-cols-12 gap-4 px-6 py-4 items-center text-center text-sm text-on-surface hover:bg-surface-container-highest/30 transition-colors">
                            <div class="col-span-1 text-outline font-mono">{{displayId}}</div>
                            {{#isMarketBoard}}
                            <div class="article-board-swap col-span-2">
                                {{#hasMemberSwap}}
                                <span class="article-swap">
                                    {{#hasHaveLead}}<span class="article-swap-name" style="--artist-color:{{haveLeadColor}}">{{haveLeadName}}</span>{{#hasHaveMore}} 외 {{haveMoreCount}}명{{/hasHaveMore}}{{/hasHaveLead}}
                                    {{#showTradeSwap}} <span class="article-swap-arrow" aria-hidden="true">&lt;-&gt;</span> {{/showTradeSwap}}
                                    {{#hasWantLead}}<span class="article-swap-name" style="--artist-color:{{wantLeadColor}}">{{wantLeadName}}</span>{{#hasWantMore}} 외 {{wantMoreCount}}명{{/hasWantMore}}{{/hasWantLead}}
                                </span>
                                {{/hasMemberSwap}}
                            </div>
                            {{/isMarketBoard}}
                            <div class="article-board-subject {{#isMarketBoard}}col-span-4{{/isMarketBoard}}{{^isMarketBoard}}col-span-6{{/isMarketBoard}} text-left font-medium truncate">
                                <a href="/article/{{#category}}{{category}}{{/category}}{{^category}}trade{{/category}}/{{id}}" class="hover:text-primary-container transition-colors">
                                    {{title}}
                                </a>
                            </div>
                            <div class="article-board-author col-span-2 text-on-surface-variant truncate">{{userId}}</div>
                            <div class="article-board-date col-span-2 text-xs text-outline">{{formattedDate}}</div>
                            {{^hideRecommendations}}<div class="article-board-likes col-span-1 text-primary-container font-semibold">{{likesCount}}</div>{{/hideRecommendations}}
                        </div>
                    {{/articleList}}

                    <!-- 게시글이 없을 경우 -->
                    {{^articleList}}
                        <div class="py-16 text-center">
                            <span class="material-symbols-outlined text-outline text-4xl mb-2" data-icon="inbox">inbox</span>
                            <p class="text-on-surface-variant font-medium">등록된 게시글이 없습니다.</p>
                        </div>
                    {{/articleList}}
                </div>
            </div>

            <!-- 하단 컨트롤 영역 (왼쪽: 검색 기능 / 오른쪽: 글쓰기 버튼) -->
            <div class="article-board-controls flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">

                <!-- 왼쪽: 게시글 검색 폼 -->
                <form action="/article/{{category}}" method="get" class="article-board-search flex items-center gap-2 w-full sm:w-auto">
                    <label class="site-search-field article-board-search-type shrink-0">
                        <select name="type" aria-label="검색 유형">
                            <option value="title" {{#isSearchTitle}}selected{{/isSearchTitle}}>제목</option>
                            <option value="content" {{#isSearchContent}}selected{{/isSearchContent}}>내용</option>
                            <option value="writer" {{#isSearchWriter}}selected{{/isSearchWriter}}>작성자</option>
                        </select>
                    </label>
                    {{#isMarketBoard}}
                    <input type="hidden" name="member" value="{{selectedMember}}">
                    <input type="hidden" name="objektSide" value="{{selectedObjektSide}}">
                    {{/isMarketBoard}}
                    <div class="site-search-field article-board-search-keyword relative flex-1 sm:w-60">
                        <input type="search" name="keyword" value="{{searchKeyword}}" placeholder="검색어를 입력하세요" aria-label="게시글 검색어" autocomplete="off" />
                        <button type="submit" aria-label="게시글 검색" class="site-search-submit">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
                        </button>
                    </div>
                </form>

                <!-- 오른쪽: 권한별 글쓰기 버튼 -->
                <div class="flex items-center justify-end w-full sm:w-auto">
                    {{#isAdmin}}
                            <a href="/article/{{category}}/new" class="md-btn md-btn-filled py-2.5 px-5 rounded-full bg-primary-container text-on-primary font-headline-sm text-sm font-bold tracking-tight transition-all duration-200 btn-glow active:scale-[0.98] flex items-center gap-1.5 shadow-md">
                                <span class="material-symbols-outlined text-[18px]" data-icon="edit">edit</span>
                                <span>글 쓰기</span>
                            </a>
                        {{/isAdmin}}

                </div>
            </div>

        </div>
    </div>
</main>

<script src="/js/member-portrait-picker.js?v=10"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const picker = document.getElementById("market-member-picker");
        if (picker && window.MemberPortraitPicker) {
            window.MemberPortraitPicker.bindMultiSelect(picker, {
                multi: false,
                onChange: function (values) {
                    const url = new URL(window.location.href);
                    if (values.length) url.searchParams.set("member", values[0]);
                    else url.searchParams.delete("member");
                    window.location.href = url.pathname + url.search;
                }
            });
        }
        // 테이블의 tbody 안에 있는 모든 행(tr)을 가져옵니다.
        const rows = document.querySelectorAll(".table-article tr");

        // 행들을 순회하면서 첫 번째 칸(글 순서 칸)의 텍스트를 1부터 차례대로 다시 적어줍니다.
        rows.forEach((row, index) => {
            const seqCell = row.querySelector("th"); // 혹은 번호가 들어있는 th/td 셀
            if (seqCell && !row.querySelector(".text-center")) { // "게시글이 없습니다" 행은 제외
                // 위에서부터 1, 2, 3... 으로 매기고 싶다면 index + 1
                // 최신 글이 1번이 되게 하고 싶다면 (전체 개수 - index) 등 응용 가능
                seqCell.innerText = index + 1;
            }
        });
    });
</script>
{{>layout/v2/footer}}

