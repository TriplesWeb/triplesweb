{{>layout/head-open}}

    <title>트리플에스 커뮤니티 - {{categoryName}} 게시판</title>
    <link rel="stylesheet" href="{{#asset}}/css/article-page.css{{/asset}}">
</head><body class="site-page article-page bg-surface text-on-surface min-h-screen flex flex-col">

{{>layout/header}}

{{#_csrf}}
<meta name="_csrf" content="{{token}}">
<meta name="_csrf_header" content="{{headerName}}">
{{/_csrf}}

<main class="flex-1 flex flex-col items-center justify-center px-4 sm:px-6 py-12 z-10 relative">
    <div class="w-full max-w-3xl relative">
        <!-- 배경 글로우 효과 -->
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-b from-primary-container/20 via-transparent to-secondary-container/30 blur-xl opacity-75 pointer-events-none"></div>

        <!-- 메인 게시글 컨테이너 카드 -->
        <div class="article-detail-shell relative bg-surface-container/95 border border-outline-variant/50 rounded-3xl overflow-hidden backdrop-blur-2xl shadow-2xl">
            <nav class="site-back site-back--bar" aria-label="게시판 목록으로">
                <a href="{{boardBase}}">← {{categoryName}}</a>
            </nav>
            <div class="p-6 sm:p-10">

            <!-- 게시글 헤더 (작성자 및 날짜) -->
            <div class="article-detail-meta flex items-center justify-between pb-6 mb-6 border-b border-outline-variant/30">
                <div class="flex items-center gap-2 text-on-surface-variant font-medium">
                    <span class="material-symbols-outlined text-[20px]" data-icon="person">person</span>
                    <span>작성자: <strong class="text-on-surface">{{article.userId}}</strong></span>
                </div>
                <div class="text-xs text-outline font-mono">
                    {{formattedDate}}
                </div>
            </div>

            {{#isMarketBoard}}
            {{#showMarketTitle}}
            <div class="mb-4">
                <h1 class="text-lg sm:text-xl font-semibold text-on-surface tracking-tight leading-snug">
                    {{article.title}}
                </h1>
            </div>
            {{/showMarketTitle}}
            {{/isMarketBoard}}
            {{^isMarketBoard}}
            <div class="mb-6">
                <h1 class="text-2xl sm:text-3xl font-bold text-on-surface tracking-tight leading-snug">
                    {{article.title}}
                </h1>
            </div>
            {{/isMarketBoard}}

            {{#errorMessage}}
            <p class="mt-4 rounded-xl border border-error/40 bg-error-container/10 px-4 py-3 text-sm text-error" role="alert">{{errorMessage}}</p>
            {{/errorMessage}}

            {{#isMarketBoard}}
            {{#hasLinkedObjekts}}
            <section class="my-4 rounded-2xl border border-teal-400/30 bg-teal-400/[0.04] p-4" aria-label="{{#isTradeObjektSplit}}Have와 Want{{/isTradeObjektSplit}}{{^isTradeObjektSplit}}선택 오브젝트{{/isTradeObjektSplit}}">
                {{#hasMemberSwap}}
                <p class="objekt-trade-summary">
                    {{#hasHaveLead}}<span class="article-swap-name" style="--artist-color:{{haveLeadColor}}">{{haveLeadName}}</span>{{#hasHaveMore}} 외 {{haveMoreCount}}명{{/hasHaveMore}}{{/hasHaveLead}}
                    {{#showTradeSwap}} <span class="article-swap-arrow">&lt;-&gt;</span> {{/showTradeSwap}}
                    {{#hasWantLead}}<span class="article-swap-name" style="--artist-color:{{wantLeadColor}}">{{wantLeadName}}</span>{{#hasWantMore}} 외 {{wantMoreCount}}명{{/hasWantMore}}{{/hasWantLead}}
                </p>
                {{/hasMemberSwap}}
                {{#isTradeObjektSplit}}
                <div class="objekt-detail-deal market-feed-deal">
                    <div class="market-feed-side" data-side="have">
                        <span class="market-feed-side-label">HAVE</span>
                        <div class="market-feed-strip">
                            {{#linkedHaveObjekts}}
                            <a href="/cosmo/objekt/detail/{{objektKey}}" class="market-feed-thumb{{^hasImage}} is-empty{{/hasImage}}" {{#previewTip}}data-tip="{{previewTip}}" title="{{previewTip}}"{{/previewTip}}>
                                {{#hasImage}}<img src="{{#thumbnailImage}}{{thumbnailImage}}{{/thumbnailImage}}{{^thumbnailImage}}{{frontImage}}{{/thumbnailImage}}" alt="" loading="lazy" onerror="this.onerror=null;this.src='{{frontImage}}'">{{/hasImage}}
                                {{^hasImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/hasImage}}
                            </a>
                            {{/linkedHaveObjekts}}
                            {{^hasLinkedHaveObjekts}}
                            <span class="market-feed-side-empty">—</span>
                            {{/hasLinkedHaveObjekts}}
                        </div>
                    </div>
                    <span class="market-feed-swap" aria-hidden="true">⇌</span>
                    <div class="market-feed-side" data-side="want">
                        <span class="market-feed-side-label">WANT</span>
                        <div class="market-feed-strip">
                            {{#linkedWantObjekts}}
                            <a href="/cosmo/objekt/detail/{{objektKey}}" class="market-feed-thumb{{^hasImage}} is-empty{{/hasImage}}" {{#previewTip}}data-tip="{{previewTip}}" title="{{previewTip}}"{{/previewTip}}>
                                {{#hasImage}}<img src="{{#thumbnailImage}}{{thumbnailImage}}{{/thumbnailImage}}{{^thumbnailImage}}{{frontImage}}{{/thumbnailImage}}" alt="" loading="lazy" onerror="this.onerror=null;this.src='{{frontImage}}'">{{/hasImage}}
                                {{^hasImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/hasImage}}
                            </a>
                            {{/linkedWantObjekts}}
                            {{^hasLinkedWantObjekts}}
                            <span class="market-feed-side-empty">—</span>
                            {{/hasLinkedWantObjekts}}
                        </div>
                    </div>
                </div>
                {{/isTradeObjektSplit}}
                {{^isTradeObjektSplit}}
                <div class="objekt-detail-deal market-feed-deal is-single">
                    <div class="market-feed-side" data-side="{{#hasWantLead}}{{^hasHaveLead}}want{{/hasHaveLead}}{{/hasWantLead}}{{#hasHaveLead}}have{{/hasHaveLead}}">
                        <span class="market-feed-side-label">{{#hasWantLead}}{{^hasHaveLead}}WANT{{/hasHaveLead}}{{/hasWantLead}}{{#hasHaveLead}}HAVE{{/hasHaveLead}}</span>
                        <div class="market-feed-strip">
                            {{#linkedObjekts}}
                            <a href="/cosmo/objekt/detail/{{objektKey}}" class="market-feed-thumb{{^hasImage}} is-empty{{/hasImage}}" {{#previewTip}}data-tip="{{previewTip}}" title="{{previewTip}}"{{/previewTip}}>
                                {{#hasImage}}<img src="{{#thumbnailImage}}{{thumbnailImage}}{{/thumbnailImage}}{{^thumbnailImage}}{{frontImage}}{{/thumbnailImage}}" alt="" loading="lazy" onerror="this.onerror=null;this.src='{{frontImage}}'">{{/hasImage}}
                                {{^hasImage}}<span>{{#collectionNo}}{{collectionNo}}{{/collectionNo}}{{^collectionNo}}{{cardTitle}}{{/collectionNo}}</span>{{/hasImage}}
                            </a>
                            {{/linkedObjekts}}
                        </div>
                    </div>
                </div>
                {{/isTradeObjektSplit}}
            </section>
            {{/hasLinkedObjekts}}

            {{#hasMarketDescription}}
            <div class="mt-5 space-y-2">
                <p class="text-sm font-medium text-on-surface-variant">설명</p>
                <div class="detail-content text-on-surface/90 font-body-md text-base leading-relaxed">
                    {{{article.content}}}
                </div>
            </div>
            {{/hasMarketDescription}}
            {{/isMarketBoard}}

            {{^isMarketBoard}}
            {{#hasLinkedObjekts}}
            <section class="my-6 rounded-2xl border border-teal-400/30 bg-teal-400/[0.04] p-4">
                <h2 class="mb-3 font-semibold text-teal-200">연결 오브젝트</h2>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                    {{#linkedObjekts}}
                    <a href="/cosmo/objekt/detail/{{objektKey}}" class="overflow-hidden rounded-xl border border-white/10 bg-black/20">
                        <img src="{{thumbnailImage}}" alt="{{collectionId}}" loading="lazy" class="aspect-[2/3] w-full object-cover" onerror="this.onerror=null;this.src='{{frontImage}}'">
                        <div class="p-2 objekt-trade-card-meta">{{#season}}<p class="objekt-trade-season">{{season}}</p>{{/season}}<p class="objekt-trade-card-title">{{#cardTitle}}{{cardTitle}}{{/cardTitle}}{{^cardTitle}}{{collectionId}}{{/cardTitle}}</p><p class="objekt-trade-member mt-1" style="--artist-color:{{memberColor}}">{{memberName}}</p><p class="mt-0.5 text-xs objekt-trade-no">{{collectionNo}}</p></div>
                    </a>
                    {{/linkedObjekts}}
                </div>
            </section>
            {{/hasLinkedObjekts}}
            <hr class="border-outline-variant/30 my-6" />
            <div class="detail-content text-on-surface/90 font-body-md text-base leading-relaxed min-h-[200px]">
                {{{article.content}}}
            </div>
            {{/isMarketBoard}}

            <!-- 하단 푸터 (추천 및 수정/삭제/목록 버튼) -->
            <div class="mt-10 pt-6 border-t border-outline-variant/35 flex flex-col gap-6">

                <!-- 추천 버튼 영역 -->
                {{#isLikeAllowed}}
                    <div class="flex justify-center">
                        <button class="py-2.5 px-6 rounded-full border border-error/50 bg-error-container/10 hover:bg-error-container/20 text-error font-medium text-sm transition-all flex items-center gap-2 active:scale-95" type="button" id="likeButton">
                            <span class="material-symbols-outlined text-[18px]" data-icon="favorite">favorite</span>
                            <span>추천</span>
                            <span id="likeCount" class="font-bold">{{likeCount}}</span>
                        </button>
                    </div>
                {{/isLikeAllowed}}

                <!-- 버튼 그룹 (수정, 삭제, 목록으로) -->
                <div class="article-detail-actions flex items-center justify-between pt-2">
                    <div class="flex items-center gap-2">
{{#isOwner}}
                                <a href="{{boardBase}}/{{article.id}}/edit" class="py-2 px-4 rounded-xl bg-surface-container-high hover:bg-surface-container-highest border border-outline-variant/40 text-on-surface text-sm font-medium transition-all">
                                    수정하기
                                </a>
                                <form method="post" action="{{boardBase}}/{{article.id}}/delete" onsubmit="return confirm('정말 삭제하시겠습니까?')" class="inline">
                                    {{#_csrf}}
                                    <input type="hidden" name="{{parameterName}}" value="{{token}}">
                                    {{/_csrf}}
                                    <button type="submit" class="py-2 px-4 rounded-xl bg-error-container/20 hover:bg-error-container/30 border border-error/30 text-error text-sm font-medium transition-all">
                                        삭제하기
                                    </button>
                                </form>
{{/isOwner}}
                    </div>

                    <a href="{{boardBase}}" class="site-back-link">← 목록으로</a>
                </div>

            </div>
            </div>
        </div>
    </div>

    <!-- 댓글 영역 컨테이너 -->
    <div class="w-full max-w-3xl mt-6">
        <script src="{{#asset}}/js/site-ui.js{{/asset}}"></script>
        {{>comment/_comments}}
    </div>
</main>

<script>
    (function () {
        const likeBtn = document.getElementById('likeButton');
        const likeCountElem = document.getElementById('likeCount');
        if (!likeBtn || !likeCountElem) return;

        let pending = false;
        likeBtn.addEventListener('click', function () {
            if (pending) return;
            pending = true;
            const headers = (window.SiteUi && window.SiteUi.csrfHeaders)
                ? window.SiteUi.csrfHeaders({ 'Content-Type': 'application/json' })
                : { 'Content-Type': 'application/json' };

            fetch('{{boardBase}}/{{article.id}}/like', {
                method: 'POST',
                credentials: 'same-origin',
                headers
            })
                .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(ok => {
                    // 서버는 좋아요 카운터 +1만 수행 (토글 아님)
                    if (ok) {
                        const n = parseInt(likeCountElem.textContent, 10) || 0;
                        likeCountElem.textContent = String(n + 1);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('추천 처리 중 오류가 발생했습니다');
                })
                .finally(() => { pending = false; });
        });
    })();
</script>
{{>layout/page-end}}
