<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 - {{categoryName}} 게시판 (글 수정)</title>

    <!-- 폰트 및 아이콘 연결 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Tailwind CSS 스크립트 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/member-portrait-picker.css?v=6">

    <style>
        .objekt-picker-member-block {
            padding: 10px;
            border: 1px solid rgba(48, 54, 74, .9);
            border-radius: 12px;
            background: rgba(16, 18, 26, .72);
        }
        .objekt-picker-member-block .mpp-toolbar { margin-bottom: 8px; }
        .objekt-picker-member-block .mpp-toolbar-title { font-size: 12px; color: #9aa3b5; }
        .objekt-picker-member-block .mpp-toolbar-meta { font-size: 11px; }
        /* 에디터 영역 스타일 */
        #content {
            min-height: 250px;
            max-height: 500px;
            overflow-y: auto;
            outline: none;
        }
        .content-media {
            position: relative;
            display: inline-block;
            margin: 0.5rem 0;
            max-width: 100%;
        }
        .content-media img, .content-media video {
            max-width: 100%;
            border-radius: 0.75rem;
            display: block;
        }
        .content-media .remove-btn, .preview-item .remove-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.7);
            border: none;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: background 0.2s;
        }
        .preview-item {
            position: relative;
            width: 90px;
            height: 90px;
            border-radius: 0.75rem;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: #111;
        }
        .preview-item img, .preview-item video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .objekt-option[hidden] { display: none !important; }
        .objekt-picker-filter-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px;
        }
        .objekt-picker-filter {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 32px;
            padding: 3px 8px;
            border: 1px solid rgba(48, 54, 74, .9);
            border-radius: 8px;
            background: rgba(26, 29, 40, .88);
        }
        .objekt-picker-filter-label {
            color: #9aa3b5;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }
        .objekt-picker-filter-control {
            min-width: 72px;
            min-height: 26px;
            border: 0;
            border-radius: 6px;
            background: #00e8cb;
            color: #071513;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            cursor: pointer;
        }
        .objekt-picker-search {
            flex: 1 1 120px;
            min-width: 110px;
            min-height: 32px;
            display: flex;
            align-items: center;
            padding: 0 8px;
            border: 1px solid rgba(48, 54, 74, .9);
            border-radius: 8px;
            background: rgba(10, 12, 18, .72);
        }
        .objekt-picker-search-input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: #f1f5f9;
            font-size: 12px;
        }
        .objekt-picker-reset {
            min-height: 32px;
            padding: 0 10px;
            border: 1px solid rgba(0, 245, 212, .35);
            border-radius: 8px;
            background: transparent;
            color: #7df9e8;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .objekt-picker-reset:hover { background: rgba(0, 245, 212, .08); }
    </style>
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col">

{{>layout/header}}

{{#_csrf}}
<meta name="_csrf" content="{{token}}">
<meta name="_csrf_header" content="{{headerName}}">
{{/_csrf}}

<div id="editorRoot" data-category="{{article.category}}"></div>

<main class="flex-1 flex items-center justify-center px-4 sm:px-6 py-12 z-10 relative">
    <div class="w-full max-w-2xl relative">
        <!-- 배경 글로우 효과 -->
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-b from-primary-container/20 via-transparent to-secondary-container/30 blur-xl opacity-75 pointer-events-none"></div>

        <!-- 메인 수정 카드 컨테이너 -->
        <div class="relative bg-surface-container/95 border border-outline-variant/50 rounded-3xl p-6 sm:p-10 backdrop-blur-2xl shadow-2xl">

            <h1 class="font-headline-lg text-headline-md font-bold text-on-surface tracking-tight mb-6">
                게시글 수정
            </h1>

            {{#errorMessage}}
                <div class="mb-6 p-3.5 rounded-xl bg-error-container/20 border border-error/40 flex items-start gap-3">
                    <span class="material-symbols-outlined text-error text-[20px] flex-shrink-0 mt-0.5" data-icon="error">error</span>
                    <div class="flex-1">
                        <p class="font-body-sm text-body-sm text-error font-medium">{{errorMessage}}</p>
                    </div>
                </div>
            {{/errorMessage}}

            <form id="editForm" action="/article/{{article.category}}/{{article.id}}" method="post" enctype="multipart/form-data" onsubmit="return beforeSubmit(this)" class="space-y-5">
                <input type="hidden" name="id" value="{{article.id}}">

                <!-- 작성자 -->
                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">작성자</label>
                    <input type="text" class="w-full px-4 py-3 bg-surface-container-lowest/50 border border-outline-variant/40 rounded-xl font-body-md text-body-md text-black focus:outline-none" name="userid" value="{{article.userId}}" readonly>
                </div>

                <!-- 제목 -->
                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">제목</label>
                    <input type="text" class="w-full px-4 py-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md placeholder:text-outline/60 focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all text-black" name="title" value="{{article.title}}" required>
                </div>

                <!-- 내용 -->
                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">내용</label>
                    <div id="content" contenteditable="true" class="w-full p-4 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" aria-multiline="true">
                        {{{article.content}}}
                    </div>
                    <input type="hidden" name="content" id="hiddenContent">
                </div>

                {{>article/objekt_picker}}

                <!-- 첨부 파일 -->
                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">첨부 파일 (이미지 또는 영상)</label>
                    <input type="file" id="fileInput" name="__fileChooser" multiple accept="image/*,video/*" class="w-full py-2.5 px-4 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl text-sm text-on-surface-variant file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary-container file:text-on-primary hover:file:opacity-90 cursor-pointer" />
                </div>

                <!-- 미리보기 -->
                <div class="space-y-2">
                    <label class="form-label block font-label-md text-label-md text-on-surface-variant font-medium">미리보기</label>
                    <div id="previewArea" class="flex flex-wrap gap-3 p-3 bg-surface-container-lowest/40 border border-outline-variant/30 rounded-xl min-h-[80px]"></div>
                </div>

                {{#_csrf}}
                    <input type="hidden" name="{{parameterName}}" value="{{token}}">
                {{/_csrf}}

                <!-- 버튼 그룹 -->
                <div class="flex items-center gap-3 pt-4">
                    <button type="submit" class="flex-1 py-3.5 px-6 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm font-bold tracking-tight transition-all duration-200 btn-glow active:scale-[0.98] flex items-center justify-center gap-2">수정하기</button>
                    <a href="/article/{{category}}" class="px-6 py-3.5 rounded-full bg-surface-container-high/40 hover:bg-surface-container-high border border-outline-variant/40 hover:border-outline-variant text-on-surface font-body-md text-body-md font-medium text-center transition-all duration-200">
                        목록으로
                    </a>
                </div>
            </form>
        </div>
    </div>
</main>

{{>layout/footer}}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/article-content.js"></script>
<script>
    /* -------------------- helpers -------------------- */
    function savedFromUrl(u) {
        if (!u) return null;
        try {
            const s = u.replace(/^"(.*)"$/, '$1');
            const relative = window.ArticleContent?.toRelativeUploadUrl(s) || s;
            if (relative.startsWith('/uploads/')) return relative.substring('/uploads/'.length);
            const url = s.startsWith('http') ? s : new URL(s, location.origin).href;
            const i = url.indexOf('/uploads/');
            return i >= 0 ? url.substring(i + '/uploads/'.length) : null;
        } catch { return null; }
    }
    function toUploadsUrl(url) {
        let u = (url || '').trim().replace(/^"(.*)"$/, '$1');
        if (/^https?:\/\//i.test(u)) {
            const i = u.indexOf('/uploads/');
            return i >= 0 ? u.substring(i) : u;
        }
        if (u.startsWith('/uploads/')) return u;
        if (u.startsWith('/')) return u;
        return '/uploads/' + u.replace(/^\/+/, '');
    }
    function isVideoType(mimeOrUrl) {
        if (!mimeOrUrl) return false;
        if (typeof mimeOrUrl === 'string' && mimeOrUrl.includes('/')) return mimeOrUrl.startsWith('video');
        const u = String(mimeOrUrl).toLowerCase();
        return /\.(mp4|mov|m4v|avi|mkv|webm)(\?|#|$)/.test(u);
    }
    function basenamePath(p) {
        if (!p) return '';
        const s = String(p).replace(/\\/g, '/');
        const i = s.lastIndexOf('/');
        return i >= 0 ? s.substring(i + 1) : s;
    }
    function cssAttrContains(value) {
        return String(value || '').replace(/\\/g, '\\\\').replace(/"/g, '\\"');
    }

    /* -------------------- main -------------------- */
    document.addEventListener('DOMContentLoaded', () => {
        const category = document.getElementById('editorRoot')?.dataset.category || 'category';
        const UPLOAD_ENDPOINT = `/api/article/${category}/uploadFile`;

        const editForm      = document.getElementById('editForm');
        const contentDiv    = document.getElementById('content');
        const hiddenContent = document.getElementById('hiddenContent');
        const fileInput     = document.getElementById('fileInput');
        const previewArea   = document.getElementById('previewArea');

        // DB savedName은 파일명만, 본문 URL은 images/.../파일명 경로 → 둘 다 매핑
        const fileIdMap = Object.create(null);
        {{#files}}
        {
            const id = {{id}};
            const name = "{{savedName}}";
            if (name) {
                fileIdMap[name] = id;
                fileIdMap[basenamePath(name)] = id;
            }
        }
        {{/files}}

        function lookupFileId(saved) {
            if (!saved) return null;
            if (fileIdMap[saved] != null) return String(fileIdMap[saved]);
            const base = basenamePath(saved);
            if (base && fileIdMap[base] != null) return String(fileIdMap[base]);
            for (const [key, id] of Object.entries(fileIdMap)) {
                if (saved.endsWith('/' + key) || key.endsWith('/' + saved) || saved.endsWith(key)) {
                    return String(id);
                }
            }
            return null;
        }

        const _csrf  = document.querySelector('meta[name="_csrf"]')?.content;
        const _ch    = document.querySelector('meta[name="_csrf_header"]')?.content;
        const buildHeaders = () => (_csrf && _ch) ? { [_ch]: _csrf } : {};

        let syncingPreview = false;
        const mo = new MutationObserver(() => {
            if (syncingPreview) return;
            syncPreviewFromContent();
        });
        mo.observe(contentDiv, { childList: true, subtree: true, attributes: true, attributeFilter: ['src'] });

        enhanceContentMediaFromDOM();
        syncPreviewFromContent();

        document.body.addEventListener('click', (e) => {
            const btn = e.target.closest('.remove-btn');
            if (!btn) return;
            e.preventDefault();

            const wrapper = btn.closest('.content-media') || btn.closest('.preview-item');
            const media = wrapper?.querySelector('img, video') || null;
            const source = media?.tagName?.toLowerCase() === 'video'
                ? (media.querySelector('source') || media)
                : media;

            let fileId = btn.dataset.fileId || media?.dataset.fileId || null;
            let saved = btn.dataset.savedName || media?.dataset.savedName || null;

            if (!saved) {
                const src = media?.currentSrc || media?.src || source?.src || '';
                saved = savedFromUrl(src);
            }
            if (!fileId) fileId = lookupFileId(saved);

            removeMediaEverywhere(saved);

            if (fileId) {
                if (!editForm.querySelector(`input[name="deletedFiles"][value="${fileId}"]`)) {
                    const hid = document.createElement('input');
                    hid.type = 'hidden';
                    hid.name = 'deletedFiles';
                    hid.value = fileId;
                    editForm.appendChild(hid);
                }
            } else if (saved) {
                const base = basenamePath(saved);
                editForm.querySelectorAll('input[name="uploadedFiles"]').forEach(up => {
                    const v = up.value || '';
                    if (v === saved || v === base || basenamePath(v) === base) up.remove();
                });
            }
        });

        fileInput.addEventListener('change', async (e) => {
            const files = Array.from(e.target.files || []);
            for (const f of files) {
                try {
                    const fd = new FormData();
                    fd.append('file', f);
                    const res = await fetch(UPLOAD_ENDPOINT, { method: 'POST', body: fd, headers: buildHeaders() });
                    if (!res.ok) {
                        const txt = await res.text().catch(() => String(res.status));
                        throw new Error(`HTTP ${res.status} - ${txt.substring(0, 200)}`);
                    }
                    const ct = res.headers.get('content-type') || '';
                    const payload = ct.includes('application/json') ? await res.json() : { url: await res.text() };
                    const url = payload.url || payload.path || payload.location || payload.href
                        || (payload.savedName ? ('/uploads/' + payload.savedName) : null);
                    if (!url) throw new Error('업로드 응답에 url 없음');

                    const { saved } = insertMedia(url, f.type);

                    const hi = document.createElement('input');
                    hi.type = 'hidden';
                    hi.name = 'uploadedFiles';
                    hi.value = saved;
                    editForm.appendChild(hi);
                } catch (err) {
                    console.error(err);
                    alert('업로드 실패: ' + (err.message || err));
                }
            }
            fileInput.value = '';
        });

        window.beforeSubmit = function(form) {
            const cleaned = window.ArticleContent?.cleanEditorHtml(contentDiv.innerHTML) || contentDiv.innerHTML.trim();
            hiddenContent.value = cleaned;

            const title = form.querySelector('input[name="title"]')?.value?.trim() || '';
            if (!title) { alert('제목을 입력해주세요.'); return false; }

            const body = hiddenContent.value;
            const hasText  = body.replace(/<br\s*\/?>/gi, '').replace(/\s/g, '') !== '';
            const hasImg   = /<img\s[^>]*src=['"][^'"]+['"][^>]*>/i.test(body);
            const hasVideo = /<video\s[^>]*>.*?<\/video>/i.test(body) || /<source\s[^>]*src=['"][^'"]+['"][^>]*>/i.test(body);

            if (!hasText && !hasImg && !hasVideo) {
                alert('내용을 입력해주세요.');
                return false;
            }
            return window.confirm('이 글을 수정하시겠습니까?');
        };

        function attachRemoveBtn(host, saved, fileId) {
            let btn = host.querySelector('.remove-btn');
            if (!btn) {
                btn = document.createElement('span');
                btn.className = 'remove-btn';
                btn.innerHTML = `<i class="bi bi-x" style="font-size:16px;color:#fff;"></i>`;
                host.appendChild(btn);
            }
            if (saved) btn.dataset.savedName = saved;
            if (fileId) btn.dataset.fileId = String(fileId);
            return btn;
        }

        function enhanceContentMediaFromDOM() {
            syncingPreview = true;
            try {
                contentDiv.querySelectorAll('img, video').forEach(el => {
                    const src = el.currentSrc || el.src || el.querySelector('source')?.src || '';
                    const saved = savedFromUrl(src);
                    if (!saved) return;

                    let wrapper = el.closest('.content-media');
                    if (!wrapper) {
                        wrapper = document.createElement('div');
                        wrapper.className = 'content-media';
                        el.parentNode.insertBefore(wrapper, el);
                        wrapper.appendChild(el);
                    }
                    el.dataset.savedName = saved;
                    const id = lookupFileId(saved);
                    if (id) el.dataset.fileId = id;
                    attachRemoveBtn(wrapper, saved, id);
                });
            } finally {
                syncingPreview = false;
            }
        }

        function syncPreviewFromContent() {
            syncingPreview = true;
            try {
                previewArea.innerHTML = '';
                contentDiv.querySelectorAll('img, video').forEach(el => {
                    const isImg = el.tagName.toLowerCase() === 'img';
                    const src = isImg
                        ? (el.currentSrc || el.src)
                        : (el.currentSrc || el.src || el.querySelector('source')?.src || '');
                    const saved = el.dataset.savedName || savedFromUrl(src);
                    const fileId = el.dataset.fileId || lookupFileId(saved);

                    const thumbBox = document.createElement('div');
                    thumbBox.className = 'preview-item';

                    let pv;
                    if (isImg) {
                        pv = document.createElement('img');
                        pv.src = src;
                    } else {
                        pv = document.createElement('video');
                        pv.controls = true;
                        pv.src = src;
                    }
                    if (saved) pv.dataset.savedName = saved;
                    if (fileId) pv.dataset.fileId = fileId;
                    thumbBox.appendChild(pv);
                    if (saved) attachRemoveBtn(thumbBox, saved, fileId);
                    previewArea.appendChild(thumbBox);
                });
            } finally {
                syncingPreview = false;
            }
        }

        function removeMediaEverywhere(saved) {
            if (!saved) return;
            const needle = cssAttrContains(saved);
            const base = cssAttrContains(basenamePath(saved));
            const selectors = [
                `img[src*="/uploads/${needle}"]`,
                `video[src*="/uploads/${needle}"]`,
                `video source[src*="/uploads/${needle}"]`,
                `img[src*="${base}"]`,
                `video[src*="${base}"]`,
                `video source[src*="${base}"]`
            ].join(', ');

            syncingPreview = true;
            try {
                contentDiv.querySelectorAll(selectors).forEach(node => {
                    const v = node.tagName.toLowerCase() === 'source' ? node.parentElement : node;
                    (v.closest('.content-media') || v).remove();
                });
                previewArea.querySelectorAll(selectors).forEach(node => {
                    node.closest('.preview-item')?.remove() || node.remove();
                });
            } finally {
                syncingPreview = false;
            }
            syncPreviewFromContent();
        }

        function insertMedia(url, mimeOrType) {
            const mediaUrl = toUploadsUrl(url);
            const saved = savedFromUrl(mediaUrl) || (mediaUrl.split('/uploads/')[1] || '');

            syncingPreview = true;
            try {
                const wrapper = document.createElement('div');
                wrapper.className = 'content-media';

                let media;
                const treatAsVideo = isVideoType(mimeOrType || mediaUrl);
                if (treatAsVideo) {
                    media = document.createElement('video');
                    media.controls = true;
                    const src = document.createElement('source');
                    src.src = mediaUrl;
                    src.type = (typeof mimeOrType === 'string' && mimeOrType.includes('/')) ? mimeOrType : '';
                    media.appendChild(src);
                } else {
                    media = document.createElement('img');
                    media.src = mediaUrl;
                }
                media.dataset.savedName = saved;
                wrapper.appendChild(media);
                attachRemoveBtn(wrapper, saved, null);
                contentDiv.appendChild(wrapper);
            } finally {
                syncingPreview = false;
            }
            syncPreviewFromContent();
            return { saved };
        }
    });
</script>
<script src="/js/member-portrait-picker.js?v=5"></script>
<script src="/js/article-objekt-picker.js?v=3"></script>
</body>
</html>