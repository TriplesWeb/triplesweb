<!DOCTYPE html>
<html lang="ko">
<head>
{{>layout/favicon}}
{{>layout/gravity-fonts}}
<link rel="stylesheet" href="/css/gravity-page.css?v=2">
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>역대 그래비티 - 트리플에스 커뮤니티</title>
</head>
<body class="min-h-screen flex flex-col">
<div class="gv-glow gv-glow-violet"></div>
<div class="gv-glow gv-glow-mint"></div>
{{>layout/header}}
<main class="gravity-page">
    <section class="gv-kicker">
        <div><strong>COSMO GRAVITY</strong> · 역대 그래비티</div>
        {{>cosmo/partials/gravity-admin-controls}}
    </section>
    <p id="gravityAdminHint" class="about-admin-hint" hidden>관리자 모드: COSMO 계정 연결을 관리할 수 있습니다.</p>
    <p id="gravityAdminMessage" role="status" class="gv-muted" hidden></p>
    {{#gravityListError}}<p role="status" class="gv-notice">{{gravityListError}}</p>{{/gravityListError}}

    <section class="gv-hero">
        <div class="gv-panel gv-headline">
            <div>
                <h1>역대 그래비티 <span>(Grand Gravity)</span></h1>
                <p>tripleS의 투표와 역대 그래비티 공식 결과를 확인하세요.</p>
            </div>
            <div class="gv-pills">
                <a class="gv-pill" href="/cosmo/objekt">오브젝트</a>
                <a class="gv-pill is-active" href="/cosmo/gravity"><span class="gv-dot"></span>역대 그래비티</a>
            </div>
        </div>
        {{#hasGravityList}}
        <div class="gv-stats">
            <article class="gv-panel gv-stat"><span>불러온 그래비티</span><strong>{{gravityCount}}<em>건</em></strong></article>
            <article class="gv-panel gv-stat"><span>진행 중</span><strong>{{gravityOngoing}}<em>건</em></strong></article>
            <article class="gv-panel gv-stat"><span>예정</span><strong>{{gravityUpcoming}}<em>건</em></strong></article>
            {{#hasGravityComo}}<article class="gv-panel gv-stat"><span>목록 COMO 합계</span><strong>{{gravityComoTotal}}</strong></article>{{/hasGravityComo}}
        </div>
        {{/hasGravityList}}
    </section>

    {{#hasGravityList}}
    <section>
        <div class="gv-section-title">
            <h2>최근 그래비티</h2>
            <div>
                <button type="button" class="gv-icon-btn" id="gvPrev" aria-label="이전">←</button>
                <button type="button" class="gv-icon-btn" id="gvNext" aria-label="다음">→</button>
            </div>
        </div>
        <div class="gv-track" id="gvTrack">
            {{#gravityHighlights}}
            <article class="gv-panel gv-highlight">
                <div>
                    <div class="gv-meta">{{>cosmo/partials/gravity-status}}{{#type}}<span class="gv-badge">{{type}}</span>{{/type}}</div>
                    <h3><a href="{{detailUrl}}">{{title}}</a></h3>
                    <div class="gv-period">{{periodLabel}} <span class="gv-timezone">한국 시간</span></div>
                    {{#description}}<p class="gv-muted">{{description}}</p>{{/description}}
                </div>
                <div class="gv-foot">
                    <div>
                        {{#hasComo}}<span class="gv-muted">총 사용 COMO</span><div class="gv-como">{{comoUsed}}</div>{{/hasComo}}
                    </div>
                    <a class="gv-link" href="{{detailUrl}}">투표 및 결과 보기</a>
                </div>
            </article>
            {{/gravityHighlights}}
        </div>
    </section>

    <section class="gv-panel gv-toolbar">
        <div class="gv-filters">
            <select id="gvStatus" aria-label="진행 상태">
                <option value="">진행 상태: 전체</option>
                <option value="진행 중">진행 중</option>
                <option value="예정">예정</option>
                <option value="종료">종료</option>
            </select>
            <select id="gvType" aria-label="유형"><option value="">유형: 전체</option></select>
            <select id="gvSort" aria-label="정렬">
                <option value="newest">정렬: 최신순</option>
                <option value="oldest">정렬: 오래된 순</option>
                <option value="como">정렬: COMO 많은 순</option>
            </select>
            <input id="gvSearch" class="gv-search" type="search" placeholder="그래비티 제목 검색" aria-label="그래비티 제목 검색">
        </div>
        <div class="gv-toolbar-meta">
            <span>표시 중 <strong id="gvVisible">{{gravityCount}}</strong> / {{gravityCount}}</span>
            <button type="button" class="gv-text-btn" id="gvReset">필터 초기화</button>
        </div>
    </section>

    <section class="gv-grid" id="gvGrid">
        {{#gravityList}}
        <article class="gv-panel gv-card" data-status="{{statusLabel}}" data-type="{{type}}" data-title="{{title}}" data-id="{{id}}" data-como="{{comoUsed}}">
            <div>
                {{#bannerImageUrl}}<img src="{{bannerImageUrl}}" alt="" loading="lazy" referrerpolicy="no-referrer">{{/bannerImageUrl}}
                <div class="gv-meta">
                    {{>cosmo/partials/gravity-status}}
                    {{#type}}<span class="gv-badge">{{type}}</span>{{/type}}
                </div>
                <h3><a href="{{detailUrl}}">{{title}}</a></h3>
                <div class="gv-period">{{periodLabel}} <span class="gv-timezone">한국 시간</span></div>
                {{#description}}<p>{{description}}</p>{{/description}}
            </div>
            <div class="gv-foot">
                <div>{{#hasComo}}<span class="gv-muted">총 사용 COMO </span><span class="gv-como">{{comoUsed}}</span>{{/hasComo}}</div>
                <a class="gv-link" href="{{detailUrl}}">결과 보기</a>
            </div>
        </article>
        {{/gravityList}}
    </section>
    <p id="gvNone" class="gv-panel gv-empty" hidden>조건에 맞는 그래비티가 없습니다.</p>
    {{/hasGravityList}}
    {{#emptyList}}<p class="gv-panel gv-empty">등록된 그래비티가 없습니다.</p>{{/emptyList}}
</main>
{{>cosmo/partials/gravity-admin-login}}
{{>layout/footer}}
<script src="/js/about-admin-auth.js?v=1"></script>
<script src="/js/gravity-connect.js?v=4"></script>
<script>
(function () {
    const grid = document.getElementById('gvGrid');
    if (!grid) return;
    const cards = [...grid.querySelectorAll('.gv-card')];
    const status = document.getElementById('gvStatus');
    const type = document.getElementById('gvType');
    const sort = document.getElementById('gvSort');
    const search = document.getElementById('gvSearch');
    const visible = document.getElementById('gvVisible');
    const none = document.getElementById('gvNone');
    const types = [...new Set(cards.map(card => card.dataset.type).filter(Boolean))].sort();
    types.forEach(value => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        type.appendChild(option);
    });
    function apply() {
        const query = search.value.trim().toLowerCase();
        const shown = cards.filter(card => {
            const okStatus = !status.value || card.dataset.status === status.value;
            const okType = !type.value || card.dataset.type === type.value;
            const okQuery = !query || (card.dataset.title || '').toLowerCase().includes(query);
            card.hidden = !(okStatus && okType && okQuery);
            return !card.hidden;
        });
        const ranked = [...cards].sort((a, b) => {
            if (sort.value === 'como') return Number(b.dataset.como || 0) - Number(a.dataset.como || 0);
            const delta = Number(b.dataset.id || 0) - Number(a.dataset.id || 0);
            return sort.value === 'oldest' ? -delta : delta;
        });
        ranked.forEach(card => grid.appendChild(card));
        visible.textContent = String(shown.length);
        none.hidden = shown.length !== 0;
    }
    [status, type, sort, search].forEach(input => input.addEventListener('input', apply));
    document.getElementById('gvReset').addEventListener('click', () => {
        status.value = '';
        type.value = '';
        sort.value = 'newest';
        search.value = '';
        apply();
    });
    const track = document.getElementById('gvTrack');
    document.getElementById('gvPrev').addEventListener('click', () => track.scrollBy({ left: -360, behavior: 'smooth' }));
    document.getElementById('gvNext').addEventListener('click', () => track.scrollBy({ left: 360, behavior: 'smooth' }));
})();
</script>
</body>
</html>
