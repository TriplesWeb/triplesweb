<!DOCTYPE html><html lang="ko"><head>{{>layout/favicon}}<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{memberName}} 오브젝트</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="/css/style.css"></head><body class="min-h-screen bg-[#0d0e12] text-white">{{>layout/header}}<main class="mx-auto max-w-7xl px-4 py-8"><a href="/cosmo/objekt" class="text-sm text-teal-300">← 전체 오브젝트</a><h1 class="mt-4 text-3xl font-bold">{{memberName}} 오브젝트</h1><p class="mt-2 text-sm text-slate-400">총 {{objektCount}}개 · {{pageDisplay}} / {{totalPages}} 페이지</p><div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">{{#objekts}}<article class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]"><a href="/cosmo/objekt/detail/{{id}}"><img src="{{thumbnailImage}}" alt="{{collectionId}}" loading="lazy" class="aspect-[2/3] w-full object-cover"></a><div class="p-3"><a href="/cosmo/objekt/detail/{{id}}" class="font-semibold hover:text-teal-300">{{collectionId}}</a><p class="mt-1 text-xs text-slate-400">{{season}} · {{class}} · {{collectionNo}}</p></div></article>{{/objekts}}{{^objekts}}<p class="col-span-full py-12 text-center text-slate-400">이 멤버의 오브젝트가 없습니다.</p>{{/objekts}}</div><nav class="flex justify-center gap-4 py-8">{{#hasPreviousPage}}<a class="rounded-lg border border-white/20 px-4 py-2" href="/cosmo/objekt/member?name={{encodedMemberName}}&page={{previousPage}}">이전</a>{{/hasPreviousPage}}<span class="py-2 text-sm text-slate-400">{{pageDisplay}} / {{totalPages}}</span>{{#hasNextPage}}<a class="rounded-lg border border-white/20 px-4 py-2" href="/cosmo/objekt/member?name={{encodedMemberName}}&page={{nextPage}}">다음</a>{{/hasNextPage}}</nav></main></body></html>