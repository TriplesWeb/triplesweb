<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{memberName}} 오브젝트</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen bg-[#0d0e12] text-white">
{{>layout/header}}
<main class="mx-auto max-w-7xl px-4 py-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div><a href="/cosmo/objekt" class="text-sm text-teal-300">← 전체 오브젝트</a>
            <h1 class="mt-2 text-3xl font-bold">{{memberName}} 오브젝트</h1>
            <p class="mt-2 text-sm text-slate-400">총 {{objektCount}}개 · 페이지당 최대 20개</p></div>
        <a href="/cosmo/objekt/favorites" class="rounded-xl border border-teal-400/40 px-4 py-2 text-sm text-teal-200">찜한 오브젝트</a>
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        {{#objekts}}
        <a href="/cosmo/objekt/detail/{{id}}" class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] transition hover:border-teal-300/60">
            <img src="{{thumbnailImage}}" alt="{{collectionId}}" loading="lazy" class="aspect-[2/3] w-full object-cover" onerror="this.onerror=null;this.src='{{frontImage}}'">
            <div class="p-3"><p class="truncate font-semibold">{{collectionId}}</p><p class="mt-1 text-xs text-slate-400">{{season}} · {{class}}</p><p class="mt-1 text-xs text-teal-200">{{collectionNo}}</p></div>
        </a>
        {{/objekts}}
    </div>
    {{^objekts}}
    <p class="rounded-2xl border border-white/10 p-8 text-center text-slate-400">이 멤버의 오브젝트가 없습니다.</p>
    {{/objekts}}
    <nav class="flex items-center justify-center gap-4 py-8">
        {{#hasPreviousPage}}<a class="rounded-lg border border-slate-600 px-4 py-2" href="/cosmo/objekt/member?name={{encodedMemberName}}&page={{previousPage}}">이전</a>{{/hasPreviousPage}}
        <span class="text-sm text-slate-400">{{pageDisplay}} / {{totalPages}} 페이지</span>
        {{#hasNextPage}}<a class="rounded-lg border border-slate-600 px-4 py-2" href="/cosmo/objekt/member?name={{encodedMemberName}}&page={{nextPage}}">다음</a>{{/hasNextPage}}
    </nav>
</main>
</body></html>
