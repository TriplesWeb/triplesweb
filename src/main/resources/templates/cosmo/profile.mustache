<!DOCTYPE html>
<html lang="ko">
<head>
{{>layout/favicon}}
{{>layout/gravity-fonts}}
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{requestedNickname}} · COSMO 닉네임 상세</title>
<link rel="stylesheet" href="/css/gravity-page.css?v=2">
<link rel="stylesheet" href="/css/archive-page.css?v=3">
<link rel="stylesheet" href="/css/member-portrait-picker.css?v=6">
<link rel="stylesheet" href="/css/cosmo-collection.css?v=3">
<link rel="stylesheet" href="/css/cosmo-profile.css?v=3">
</head>
<body class="collection-page min-h-screen flex flex-col">
{{>layout/header}}
<main class="gravity-page cosmo-profile">
<a href="/cosmo/collection?nickname={{requestedNickname}}" class="collection-detail-link">← 내 오브젝트 검색</a>
{{#profileError}}<section class="gv-panel gv-headline" role="status"><h1>닉네임 상세</h1><p>{{profileError}}</p></section>{{/profileError}}
{{#hasProfile}}
<section class="gv-panel profile-hero">
    <div class="profile-identity">
        {{#hasProfileImage}}<img class="profile-avatar" src="{{profileImageUrl}}" alt="" referrerpolicy="no-referrer">{{/hasProfileImage}}
        {{^hasProfileImage}}<div class="profile-avatar profile-avatar-fallback" aria-hidden="true">S</div>{{/hasProfileImage}}
        <div><p class="profile-eyebrow">COSMO PROFILE</p><h1>{{nickname}}</h1><p class="ar-muted">오브젝트로 함께 쌓아가는 컬렉션</p></div>
    </div>
    <dl class="profile-totals">
        <div><dt>보유 오브젝트</dt><dd>{{ownedCount}}<span>개</span></dd></div>
        <div><dt>수집한 종류</dt><dd>{{uniqueCount}}<span>종</span></dd></div>
        <div><dt>수집한 멤버</dt><dd>{{memberCount}}<span>명</span></dd></div>
    </dl>
</section>
<section class="profile-member-picker" aria-labelledby="progress-member-heading">
    <div class="mpp-toolbar">
        <div>
            <p class="mpp-toolbar-title" id="progress-member-heading">멤버별 오브젝트 종류</p>
            <p class="mpp-toolbar-meta" id="progress-member-meta">{{#hasProgressMember}}{{selectedMember}} 선택됨{{/hasProgressMember}}{{^hasProgressMember}}멤버를 고르면 전체 종류 수집 현황을 볼 수 있어요.{{/hasProgressMember}}</p>
        </div>
        <div class="mpp-toolbar-actions">
            <a class="mpp-tool-btn" href="{{profileUrl}}">전체 현황</a>
        </div>
    </div>
    <div class="member-portrait-picker" id="profile-member-picker" role="group" aria-label="멤버별 오브젝트 종류">
        {{>partials/member-portrait-picker}}
    </div>
</section>
{{^hasProgressMember}}
<section class="profile-progress-section" aria-labelledby="member-progress-heading">
    <div class="profile-section-heading"><h2 id="member-progress-heading">멤버별 수집 현황</h2><p>tripleS · Welcome·Zero 제외 · 중복을 제외한 종류 기준</p></div>
    <div class="profile-member-grid">
    {{#memberProgress}}
    <article class="ar-panel profile-member" style="--member-color: {{color}}">
        <div class="profile-member-name">{{#hasImage}}<img src="{{image}}" alt="" loading="lazy">{{/hasImage}}<h3>{{member}}</h3></div>
        {{#hasTotal}}<p class="profile-percent"><strong>{{percent}}<span>%</span></strong> 수집</p>
        <div class="profile-progress-track" role="progressbar" aria-label="{{member}} 수집률" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"><span style="width:{{percent}}%"></span></div>
        <p class="ar-muted">{{owned}} / {{total}}종 · 보유 {{copies}}개</p>{{/hasTotal}}
        {{^hasTotal}}<p class="ar-muted">전체 목록 준비 중 · 보유 {{copies}}개</p>{{/hasTotal}}
        <a class="collection-action-btn" href="{{progressUrl}}">수집 현황 보기</a>
    </article>
    {{/memberProgress}}
    </div>
    {{^hasMemberProgress}}<p class="gv-panel gv-empty">표시할 tripleS 멤버 수집 현황이 없습니다.</p>{{/hasMemberProgress}}
</section>
<div class="profile-breakdown-grid">
    <section class="ar-panel profile-breakdown"><h2>시즌별</h2>
    {{#seasonStats}}<div class="profile-breakdown-row"><span>{{label}}</span><div class="profile-progress-track"><span style="width:{{percent}}%"></span></div><strong>{{count}}개</strong><span>{{percent}}%</span></div>{{/seasonStats}}
    {{^hasStats}}<p class="ar-muted">아직 보유한 오브젝트가 없습니다.</p>{{/hasStats}}</section>
    <section class="ar-panel profile-breakdown"><h2>클래스별</h2>
    {{#classStats}}<div class="profile-breakdown-row"><span>{{label}}</span><div class="profile-progress-track"><span style="width:{{percent}}%"></span></div><strong>{{count}}개</strong><span>{{percent}}%</span></div>{{/classStats}}
    {{^hasStats}}<p class="ar-muted">아직 보유한 오브젝트가 없습니다.</p>{{/hasStats}}</section>
</div>
{{/hasProgressMember}}
{{#hasProgressMember}}
<section class="profile-checklist" aria-labelledby="checklist-heading">
    <div class="profile-section-heading"><div><h2 id="checklist-heading">{{selectedMember}} · 오브젝트 수집 목록</h2><p>{{checklistTotal}}종 중 {{checklistOwned}}종 보유 · {{checklistMissing}}종 미보유</p></div>
        <label class="profile-hide-complete" data-hide-complete-label hidden><input type="checkbox" data-hide-complete>완료한 시즌 숨기기</label>
    </div>
    <p class="profile-checklist-legend"><span class="is-owned">● 보유</span><span>○ 미보유</span> · 클래스별 낮은 번호순</p>
    {{#checklistSeasons}}
    <section class="ar-panel profile-checklist-season" data-checklist-season data-complete="{{complete}}">
        <header class="profile-season-heading"><h3>{{season}}</h3><p>{{owned}} / {{total}}종 <strong>{{percent}}%</strong></p></header>
        {{#groups}}
        <details class="profile-checklist-group" {{#open}}open{{/open}}>
            <summary><span>{{klass}}</span><strong>{{owned}} / {{total}}종</strong>{{#complete}}<span class="profile-group-complete">✓ 완료</span>{{/complete}}{{^complete}}<span>{{missing}}종 미보유</span>{{/complete}}<span class="profile-group-toggle">펼치기 / 접기</span></summary>
            <div class="profile-checklist-grid">
            {{#cards}}
                <a href="{{detailUrl}}" class="profile-checklist-card {{#owned}}is-owned{{/owned}}{{^owned}}is-missing{{/owned}}" aria-label="{{name}} · {{#owned}}보유 {{copies}}개{{/owned}}{{^owned}}미보유{{/owned}}">
                    <div class="profile-checklist-image">{{#hasImage}}<img src="{{image}}" alt="{{name}}" loading="lazy" decoding="async" referrerpolicy="no-referrer">{{/hasImage}}{{^hasImage}}<span>이미지 준비 중</span>{{/hasImage}}
                    <span class="profile-checklist-status">{{#owned}}✓ 보유{{/owned}}{{^owned}}미보유{{/owned}}</span></div>
                    <div class="profile-checklist-caption"><strong>{{number}}</strong>{{#owned}}<span>{{copies}}개 보유</span>{{/owned}}{{^owned}}<span>아직 미보유</span>{{/owned}}</div>
                </a>
            {{/cards}}
            </div>
        </details>
        {{/groups}}
    </section>
    {{/checklistSeasons}}
    {{^hasChecklist}}<p class="gv-panel gv-empty">이 멤버의 전체 오브젝트 목록을 아직 불러오지 못했습니다.</p>{{/hasChecklist}}
</section>
{{/hasProgressMember}}
{{/hasProfile}}
</main>
{{>layout/footer}}
<script src="/js/member-portrait-picker.js?v=5"></script>
<script src="/js/cosmo-profile.js?v=2" defer></script>
<script>
(() => {
  const picker = document.getElementById('profile-member-picker');
  const base = {{#profileUrl}}"{{profileUrl}}"{{/profileUrl}}{{^profileUrl}}""{{/profileUrl}};
  if (!picker || !base || !window.MemberPortraitPicker) return;
  MemberPortraitPicker.bindMultiSelect(picker, {
    multi: false,
    onChange: (values) => {
      const member = values[0] || '';
      window.location.href = member
        ? base + '?member=' + encodeURIComponent(member)
        : base;
    }
  });
})();
</script>
</body></html>
