<!DOCTYPE html>
<html lang="ko">
<head>
{{>layout/favicon}}
{{>layout/gravity-fonts}}
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{requestedNickname}} · COSMO 닉네임 상세</title>
<link rel="stylesheet" href="/css/gravity-page.css?v=2">
<link rel="stylesheet" href="/css/archive-page.css?v=3">
<link rel="stylesheet" href="/css/member-portrait-picker.css?v=11">
<link rel="stylesheet" href="/css/cosmo-collection.css?v=10">
<link rel="stylesheet" href="/css/cosmo-profile.css?v=10">
</head>
<body class="collection-page min-h-screen flex flex-col">
{{>layout/header}}
<main class="gravity-page cosmo-profile">
<a href="/cosmo/collection?nickname={{requestedNickname}}" class="collection-detail-link">← 내 오브젝트 검색</a>
{{#profileError}}<section class="gv-panel gv-headline" role="status"><h1>닉네임 상세</h1><p>{{profileError}}</p></section>{{/profileError}}
{{#hasProfile}}
<section class="gv-panel profile-hero">
    <div class="profile-identity">
        {{#hasProfileImage}}<img class="profile-avatar" src="{{profileImageUrl}}" alt="" referrerpolicy="no-referrer">{{/hasProfileImage}}
        {{^hasProfileImage}}<div class="profile-avatar profile-avatar-fallback" aria-hidden="true">S</div>{{/hasProfileImage}}
        <div><p class="profile-eyebrow">COSMO PROFILE</p><h1>{{nickname}}</h1><p class="ar-muted">오브젝트로 함께 쌓아가는 컬렉션</p></div>
    </div>
    <dl class="profile-totals">
        <div><dt>보유 오브젝트</dt><dd>{{ownedCount}}<span>개</span></dd></div>
        <div><dt>수집한 종류</dt><dd>{{uniqueCount}}<span>종</span></dd></div>
        <div><dt>수집한 멤버</dt><dd>{{memberCount}}<span>명</span></dd></div>
    </dl>
</section>

<nav class="profile-progress-tabs" aria-label="수집 현황 보기">
    <a class="profile-progress-tab{{#isOverviewTab}} is-active{{/isOverviewTab}}" href="{{overviewUrl}}" {{#isOverviewTab}}aria-current="page"{{/isOverviewTab}}>전체 현황</a>
    <a class="profile-progress-tab" href="{{transfersUrl}}">전송 내역</a>
    <a class="profile-progress-tab{{#isMembersTab}} is-active{{/isMembersTab}}" href="{{membersTabUrl}}" {{#isMembersTab}}aria-current="page"{{/isMembersTab}}>멤버별 상세</a>
</nav>

{{#isOverviewTab}}
<section class="profile-progress-section" aria-labelledby="member-progress-heading">
    <div class="profile-section-heading"><h2 id="member-progress-heading">멤버별 수집 현황</h2><p>tripleS · Welcome·Zero 제외 · 유닛은 구성 멤버에 합산 · 미수집도 함께 표시</p></div>
    <div class="profile-member-grid">
    {{#memberProgress}}
    <article class="ar-panel profile-member{{#isEmpty}} is-empty{{/isEmpty}}" style="--member-color: {{color}}">
        <div class="profile-member-name">{{#hasImage}}<img src="{{image}}" alt="" loading="lazy">{{/hasImage}}<h3>{{member}}</h3></div>
        {{#hasTotal}}<p class="profile-percent"><strong>{{percent}}<span>%</span></strong> 수집</p>
        <div class="profile-progress-track" role="progressbar" aria-label="{{member}} 수집률" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"><span style="width:{{percent}}%"></span></div>
        <p class="ar-muted">{{owned}} / {{total}}종 · 보유 {{copies}}개</p>{{/hasTotal}}
        {{^hasTotal}}<p class="ar-muted">전체 목록 준비 중 · 보유 {{copies}}개</p>{{/hasTotal}}
        <a class="profile-progress-link" href="{{progressUrl}}"><span aria-hidden="true">→</span> 수집 현황</a>
    </article>
    {{/memberProgress}}
    </div>
    {{^hasMemberProgress}}<p class="gv-panel gv-empty">표시할 멤버 수집 현황이 없습니다.</p>{{/hasMemberProgress}}
</section>
{{#hasOtherProgress}}
<section class="profile-progress-section" aria-labelledby="other-progress-heading">
    <div class="profile-section-heading"><h2 id="other-progress-heading">기타 옵젝 현황</h2><p>zenith 등 멤버에 속하지 않는 종류를 한곳에 모았습니다</p></div>
    <div class="profile-member-grid profile-other-grid">
    {{#otherProgress}}
    <article class="ar-panel profile-member profile-other{{#isEmpty}} is-empty{{/isEmpty}}" style="--member-color: {{color}}">
        <div class="profile-member-name"><h3>{{member}}</h3></div>
        {{#hasTotal}}<p class="profile-percent"><strong>{{percent}}<span>%</span></strong> 수집</p>
        <div class="profile-progress-track" role="progressbar" aria-label="기타 옵젝 수집률" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"><span style="width:{{percent}}%"></span></div>
        <p class="ar-muted">{{owned}} / {{total}}종 · 보유 {{copies}}개</p>{{/hasTotal}}
        {{^hasTotal}}<p class="ar-muted">전체 목록 준비 중 · 보유 {{copies}}개</p>{{/hasTotal}}
        <a class="profile-progress-link" href="{{progressUrl}}"><span aria-hidden="true">→</span> 수집 현황</a>
    </article>
    {{/otherProgress}}
    </div>
</section>
{{/hasOtherProgress}}
<div class="profile-breakdown-grid">
    <section class="ar-panel profile-breakdown"><h2>시즌별</h2>
    {{#seasonStats}}<div class="profile-breakdown-row{{#isEmpty}} is-empty{{/isEmpty}}"><span>{{label}}</span><div class="profile-progress-track"><span style="width:{{percent}}%"></span></div><strong>{{owned}} / {{total}}</strong><span>{{percent}}%</span></div>{{/seasonStats}}
    {{^hasStats}}<p class="ar-muted">아직 표시할 시즌 현황이 없습니다.</p>{{/hasStats}}</section>
    <section class="ar-panel profile-breakdown"><h2>클래스별</h2>
    {{#classStats}}<div class="profile-breakdown-row{{#isEmpty}} is-empty{{/isEmpty}}"><span>{{label}}</span><div class="profile-progress-track"><span style="width:{{percent}}%"></span></div><strong>{{owned}} / {{total}}</strong><span>{{percent}}%</span></div>{{/classStats}}
    {{^hasStats}}<p class="ar-muted">아직 표시할 클래스 현황이 없습니다.</p>{{/hasStats}}</section>
</div>
{{/isOverviewTab}}

{{#isMembersTab}}
<section class="profile-member-picker" aria-labelledby="progress-member-heading">
    <div class="objekt-member-picker-panel" id="profile-member-panel">
        <div class="mpp-toolbar">
            <div class="mpp-toolbar-heading">
                <span class="mpp-toolbar-title" id="progress-member-heading">멤버 선택</span>
                <span class="mpp-toolbar-meta" id="progress-member-meta">{{#isOtherGroup}}기타 옵젝{{/isOtherGroup}}{{^isOtherGroup}}{{#hasProgressMember}}{{selectedMember}} 선택됨{{/hasProgressMember}}{{^hasProgressMember}}멤버를 고르면 전체 종류 수집 현황을 볼 수 있어요.{{/hasProgressMember}}{{/isOtherGroup}}</span>
            </div>
            <div class="mpp-toolbar-actions" role="group" aria-label="오브젝트 분류">
                <a class="mpp-tool-btn" href="{{membersTabUrl}}" aria-pressed="{{#isAllGroup}}true{{/isAllGroup}}{{^isAllGroup}}false{{/isAllGroup}}">전체</a>
                <a class="mpp-tool-btn" href="{{membersTabUrl}}&amp;group=members" aria-pressed="{{#isMembersGroup}}true{{/isMembersGroup}}{{^isMembersGroup}}false{{/isMembersGroup}}">멤버</a>
                <a class="mpp-tool-btn" href="{{membersTabUrl}}&amp;group=other" aria-pressed="{{#isOtherGroup}}true{{/isOtherGroup}}{{^isOtherGroup}}false{{/isOtherGroup}}">기타 옵젝</a>
            </div>
        </div>
        <div class="member-portrait-picker" id="profile-member-picker" role="group" aria-label="멤버별 오브젝트 종류" {{#isOtherGroup}}hidden{{/isOtherGroup}}>
            {{>partials/member-portrait-picker}}
        </div>
        <p class="objekt-other-notice" {{^isOtherGroup}}hidden{{/isOtherGroup}}>zenith 등 멤버와 연결되지 않은 그룹·기타 오브젝트 전체 종류입니다. 미보유는 어둡게 표시됩니다.</p>
    </div>
</section>
{{#hasChecklist}}
<section class="profile-checklist" aria-labelledby="checklist-heading">
    <div class="profile-section-heading"><div><h2 id="checklist-heading">{{selectedMember}} · {{#isOwnershipOwned}}보유{{/isOwnershipOwned}}{{#isOwnershipMissing}}미보유{{/isOwnershipMissing}}{{#isOwnershipAll}}수집{{/isOwnershipAll}} 오브젝트</h2>{{#isOwnershipSubset}}<p>{{checklistVisible}}종 · 클래스별 목록</p>{{/isOwnershipSubset}}{{^isOwnershipSubset}}<p>{{checklistTotal}}종 중 {{checklistOwned}}종 보유 · {{checklistMissing}}종 미보유{{#isOwnershipOwned}} · 보유 {{checklistVisible}}종 표시{{/isOwnershipOwned}}{{#isOwnershipMissing}} · 미보유 {{checklistVisible}}종 표시{{/isOwnershipMissing}}</p>{{/isOwnershipSubset}}</div>
        {{#isOwnershipAll}}<label class="profile-hide-complete" data-hide-complete-label hidden><input type="checkbox" data-hide-complete>완료한 시즌 숨기기</label>{{/isOwnershipAll}}
    </div>
    {{#hasOwnershipFilter}}
    <nav class="profile-ownership-tabs" aria-label="보유 여부 모아보기">
        <a class="profile-ownership-tab{{#isOwnershipAll}} is-active{{/isOwnershipAll}}" href="{{ownershipAllUrl}}" {{#isOwnershipAll}}aria-current="page"{{/isOwnershipAll}}>전체</a>
        <a class="profile-ownership-tab{{#isOwnershipOwned}} is-active{{/isOwnershipOwned}}" href="{{ownershipOwnedUrl}}" {{#isOwnershipOwned}}aria-current="page"{{/isOwnershipOwned}}>보유</a>
        <a class="profile-ownership-tab{{#isOwnershipMissing}} is-active{{/isOwnershipMissing}}" href="{{ownershipMissingUrl}}" {{#isOwnershipMissing}}aria-current="page"{{/isOwnershipMissing}}>미보유</a>
    </nav>
    {{/hasOwnershipFilter}}
    {{#isOwnershipSubset}}
    {{^checklistClasses}}<p class="gv-panel gv-empty">이 조건에 해당하는 오브젝트가 없습니다.</p>{{/checklistClasses}}
    <div class="profile-ownership-list">
    {{#checklistClasses}}
    <section class="ar-panel profile-owned-class">
        <header class="profile-section-heading"><h3>{{klass}}</h3><p>{{count}}종</p></header>
        <div class="profile-checklist-grid">
        {{#cards}}
        <a href="{{detailUrl}}" class="profile-checklist-card {{#owned}}is-owned{{/owned}}{{^owned}}is-missing{{/owned}}" aria-label="{{name}}">
            <div class="profile-checklist-image">{{#hasImage}}<img src="{{image}}" alt="{{name}}" loading="lazy" decoding="async" referrerpolicy="no-referrer">{{/hasImage}}{{^hasImage}}<span>이미지 준비 중</span>{{/hasImage}}</div>
            <div class="profile-checklist-caption"><strong>{{number}}</strong><span>{{season}}{{#owned}} · {{copies}}개{{/owned}}</span></div>
        </a>
        {{/cards}}
        </div>
    </section>
    {{/checklistClasses}}
    </div>
    {{/isOwnershipSubset}}
    {{#isOwnershipAll}}
    <div class="profile-season-grid">
    {{#checklistSeasons}}
    <section class="ar-panel profile-checklist-season" data-checklist-season data-complete="{{complete}}">
        <details class="profile-season-fold">
        <summary class="profile-season-heading"><h3>{{season}}</h3><p>{{owned}} / {{total}}종 <strong>{{percent}}%</strong></p><span class="profile-group-toggle">펼치기 / 접기</span></summary>
        {{#groups}}
        <details class="profile-checklist-group">
            <summary><span>{{klass}}</span><strong>{{owned}} / {{total}}종</strong>{{#complete}}<span class="profile-group-complete">✓ 완료</span>{{/complete}}{{^complete}}<span>{{missing}}종 미보유</span>{{/complete}}<span class="profile-group-toggle">펼치기 / 접기</span></summary>
            <div class="profile-checklist-grid">
            {{#cards}}
                <a href="{{detailUrl}}" class="profile-checklist-card {{#owned}}is-owned{{/owned}}{{^owned}}is-missing{{/owned}}" aria-label="{{name}} · {{#owned}}보유 {{copies}}개{{/owned}}{{^owned}}미보유{{/owned}}">
                    <div class="profile-checklist-image">{{#hasImage}}<img src="{{image}}" alt="{{name}}" loading="lazy" decoding="async" referrerpolicy="no-referrer">{{/hasImage}}{{^hasImage}}<span>이미지 준비 중</span>{{/hasImage}}
                    <span class="profile-checklist-status">{{#owned}}✓ 보유{{/owned}}{{^owned}}미보유{{/owned}}</span></div>
                    <div class="profile-checklist-caption"><strong>{{number}}</strong>{{#owned}}<span>{{copies}}개 보유</span>{{/owned}}{{^owned}}<span>아직 미보유</span>{{/owned}}</div>
                </a>
            {{/cards}}
            </div>
        </details>
        {{/groups}}
        </details>
    </section>
    {{/checklistSeasons}}
    </div>
    {{/isOwnershipAll}}
</section>
{{/hasChecklist}}
{{^hasChecklist}}
{{^isOtherGroup}}
{{^hasProgressMember}}
<p class="gv-panel gv-empty">위에서 멤버를 선택하면 해당 멤버의 전체 종류 수집 현황을 볼 수 있습니다.</p>
{{/hasProgressMember}}
{{#hasProgressMember}}
<p class="gv-panel gv-empty">이 멤버의 전체 오브젝트 목록을 아직 불러오지 못했습니다.</p>
{{/hasProgressMember}}
{{/isOtherGroup}}
{{#isOtherGroup}}
<p class="gv-panel gv-empty">표시할 기타 옵젝 종류가 없습니다.</p>
{{/isOtherGroup}}
{{/hasChecklist}}
{{/isMembersTab}}
{{/hasProfile}}
</main>
{{>layout/footer}}
{{#isMembersTab}}
<script src="/js/member-portrait-picker.js?v=6"></script>
<script src="/js/cosmo-profile.js?v=3" defer></script>
<script>
(() => {
  const picker = document.getElementById('profile-member-picker');
  const base = {{#profileUrl}}"{{profileUrl}}"{{/profileUrl}}{{^profileUrl}}""{{/profileUrl}};
  if (!picker || !base || !window.MemberPortraitPicker) return;
  const ownership = new URLSearchParams(window.location.search).get('ownership') || '';
  const ownershipQuery = (ownership === 'owned' || ownership === 'missing') ? '&ownership=' + encodeURIComponent(ownership) : '';
  MemberPortraitPicker.bindMultiSelect(picker, {
    multi: false,
    onChange: (values) => {
      const member = values[0] || '';
      window.location.href = member
        ? base + '?tab=members&member=' + encodeURIComponent(member) + ownershipQuery
        : base + '?tab=members' + ownershipQuery;
    }
  });
})();
</script>
{{/isMembersTab}}
</body></html>

