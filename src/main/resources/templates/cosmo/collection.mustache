{{>layout/head-open}}

<link rel="stylesheet" href="{{#asset}}/css/gravity-page.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/archive-page.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/member-portrait-picker.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/cosmo-collection.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/objekt-grid-cols.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/scroll-top.css{{/asset}}">
<title>{{#nickname}}{{nickname}} 보유 오브젝트{{/nickname}}{{^nickname}}코스모 아이디 검색{{/nickname}}</title>
</head><body class="site-page collection-page min-h-screen flex flex-col">
{{>layout/header}}
<main class="gravity-page">
    <section class="gv-kicker"><div><strong>COSMO</strong> · 닉네임 컬렉션</div></section>
    <section class="gv-panel gv-headline collection-search-hero">
        <h1>코스모 아이디 검색</h1>
        <p>닉네임을 검색하면 보유 오브젝트와 시리얼 번호를 확인할 수 있습니다.</p>
        <form class="ar-filters collection-nickname-form" method="get" action="/cosmo/collection" style="margin-top:1rem" data-saved-nickname="{{#hasCollection}}{{nickname}}{{/hasCollection}}">
            <label class="ar-search-wrap">
                <span class="material-symbols-outlined">search</span>
                <input class="ar-search" id="collection-nickname-input" type="search" name="nickname" value="{{query}}" placeholder="닉네임 입력" aria-label="COSMO 닉네임" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="collection-nickname-suggest" aria-autocomplete="list">
                <div id="collection-nickname-suggest" class="collection-nickname-suggest" hidden role="listbox" aria-label="연관닉"></div>
            </label>
            <button class="ar-submit" type="submit">검색</button>
        </form>
    </section>
    {{#collectionError}}<p class="gv-notice" role="status">{{collectionError}}</p>{{/collectionError}}
    {{#hasCollection}}
    <section class="gv-panel gv-headline">
        <div class="cosmo-account-profile">
            {{#hasProfileImage}}<img src="{{profileImageUrl}}" alt="" referrerpolicy="no-referrer">{{/hasProfileImage}}
            <div>
                <h1>{{nickname}}</h1>
                <p>보유 오브젝트 <strong>{{ownedCount}}</strong>개{{#hasActiveFilters}} · 필터 결과 <strong id="collection-filtered-count">{{filteredCount}}</strong>개{{/hasActiveFilters}}</p>
                {{#profileUrl}}<a class="collection-action-btn" href="{{profileUrl}}?tab=overview">프로필 보기</a>{{/profileUrl}}
            </div>
        </div>
    </section>
    <section class="collection-filter-panel" aria-label="보유 오브젝트 필터">
        <form class="collection-filter-form" method="get" action="/cosmo/collection" id="collection-filter-form">
            <input type="hidden" name="nickname" value="{{nickname}}">
            <input type="hidden" name="page" value="0">
            <input type="hidden" name="group" id="collection-group-input" value="{{selectedGroup}}">
            <input type="hidden" name="member" id="collection-member-input" value="{{selectedMember}}">
            <input type="hidden" name="kind" id="collection-kind-input" value="{{selectedKind}}">
            <input type="hidden" name="sort" id="collection-sort-input" value="{{selectedSort}}">
            <div class="collection-filter-workspace">
            <div class="objekt-member-picker-panel{{^isOtherGroup}}{{^selectedMember}} is-collapsed{{/selectedMember}}{{/isOtherGroup}}" id="collection-member-panel">
                <div class="mpp-toolbar">
                    <button type="button" class="objekt-member-toggle" id="collection-member-toggle" aria-expanded="false" aria-controls="collection-member-picker" {{#isOtherGroup}}hidden{{/isOtherGroup}}>
                        <span>
                            <span class="mpp-toolbar-title">멤버</span>
                            <span class="mpp-toolbar-meta" id="collection-member-meta">{{#isOtherGroup}}기타 옵젝{{/isOtherGroup}}{{^isOtherGroup}}{{#selectedMember}}{{selectedMember}}{{/selectedMember}}{{^selectedMember}}{{#isMembersGroup}}전체 멤버{{/isMembersGroup}}{{^isMembersGroup}}전체 오브젝트{{/isMembersGroup}}{{/selectedMember}}{{/isOtherGroup}}</span>
                        </span>
                        <span class="material-symbols-outlined objekt-member-toggle-caret" aria-hidden="true">expand_more</span>
                    </button>
                    <div class="mpp-toolbar-actions" role="group" aria-label="오브젝트 분류">
                        <button type="button" class="mpp-tool-btn collection-group-tab" data-objekt-group="all" aria-pressed="{{#isAllGroup}}true{{/isAllGroup}}{{^isAllGroup}}false{{/isAllGroup}}">전체</button>
                        <button type="button" class="mpp-tool-btn collection-group-tab" data-objekt-group="members" aria-pressed="{{#isMembersGroup}}true{{/isMembersGroup}}{{^isMembersGroup}}false{{/isMembersGroup}}">멤버</button>
                        <button type="button" class="mpp-tool-btn collection-group-tab" data-objekt-group="other" aria-pressed="{{#isOtherGroup}}true{{/isOtherGroup}}{{^isOtherGroup}}false{{/isOtherGroup}}">기타 옵젝</button>
                    </div>
                </div>
                <div class="member-portrait-picker" id="collection-member-picker" role="group" aria-label="멤버 필터" {{#isOtherGroup}}hidden{{/isOtherGroup}}>
                    {{>partials/member-portrait-picker}}
                </div>
                <p class="objekt-other-notice" id="collection-other-notice" {{^isOtherGroup}}hidden{{/isOtherGroup}}>멤버와 연결되지 않은 그룹·기타 오브젝트를 모아 보여줍니다.</p>
            </div>
            <div class="objekt-filter-bar collection-filter-bar relative">
                <div class="objekt-filter relative" id="collection-season-dropdown">
                    <span class="objekt-filter-label">시즌</span>
                    <button type="button" class="objekt-filter-control" id="collection-season-toggle" aria-expanded="false" aria-controls="collection-season-menu">
                        <span id="collection-season-label" class="truncate">전체</span>
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                    <div id="collection-season-menu" class="objekt-dropdown-menu absolute top-full left-0 mt-2 rounded-xl border z-50 p-2" hidden>
                        <label class="objekt-choice">
                            <input type="checkbox" value="all" class="season-checkbox" {{^hasSeasonFilter}}checked{{/hasSeasonFilter}}>
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">전체 시즌</span>
                        </label>
                        {{#seasonChoices}}
                        <label class="objekt-choice">
                            <input type="checkbox" name="season" value="{{value}}" class="season-checkbox" {{#selected}}checked{{/selected}}>
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">{{value}}</span>
                        </label>
                        {{/seasonChoices}}
                    </div>
                </div>
                <div class="objekt-filter relative" id="collection-class-dropdown">
                    <span class="objekt-filter-label">클래스</span>
                    <button type="button" class="objekt-filter-control" id="collection-class-toggle" aria-expanded="false" aria-controls="collection-class-menu">
                        <span id="collection-class-label" class="truncate">전체</span>
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                    <div id="collection-class-menu" class="objekt-dropdown-menu absolute top-full left-0 mt-2 rounded-xl border z-50 p-2 max-h-60 overflow-y-auto" hidden>
                        <label class="objekt-choice">
                            <input type="checkbox" value="all" class="class-checkbox" {{^hasClassFilter}}checked{{/hasClassFilter}}>
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">전체 클래스</span>
                        </label>
                        {{#classChoices}}
                        <label class="objekt-choice">
                            <input type="checkbox" name="class" value="{{value}}" class="class-checkbox" {{#selected}}checked{{/selected}}>
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">{{value}}</span>
                        </label>
                        {{/classChoices}}
                    </div>
                </div>
                <div class="objekt-filter relative" id="collection-kind-dropdown">
                    <span class="objekt-filter-label">종류</span>
                    <div class="objekt-filter-control objekt-kind-combo">
                        <input type="text"
                               id="collection-kind-select"
                               class="objekt-kind-select"
                               value="{{selectedKindLabel}}"
                               placeholder="전체"
                               autocomplete="off"
                               spellcheck="false"
                               role="combobox"
                               aria-expanded="false"
                               aria-controls="collection-kind-menu"
                               aria-autocomplete="list"
                               aria-label="옵젝 종류 필터 (입력 또는 선택)">
                        <button type="button" class="objekt-kind-toggle" id="collection-kind-toggle" aria-label="종류 목록 열기" tabindex="-1">
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_drop_down</span>
                        </button>
                    </div>
                    <div id="collection-kind-menu" class="objekt-dropdown-menu hidden absolute top-full left-0 mt-2 min-w-[9rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" hidden role="listbox" aria-label="종류 목록">
                        <button type="button" class="objekt-kind-option" data-value="all" role="option">전체</button>
                        {{#kindOptions}}
                        <button type="button" class="objekt-kind-option" data-value="{{.}}" role="option">{{.}}</button>
                        {{/kindOptions}}
                        <p class="objekt-kind-empty" id="collection-kind-empty" hidden>일치하는 종류 없음</p>
                    </div>
                </div>
                <div class="objekt-filter relative" id="collection-sort-dropdown">
                    <span class="objekt-filter-label">정렬</span>
                    <button type="button" class="objekt-filter-control" id="collection-sort-toggle" aria-haspopup="listbox" aria-expanded="false" aria-controls="collection-sort-menu">
                        <span id="collection-sort-label" class="truncate">최신순</span>
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                    <div id="collection-sort-menu" class="objekt-dropdown-menu collection-sort-menu absolute top-full left-0 mt-2 min-w-[10rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" hidden role="listbox" aria-label="정렬 목록">
                        <button type="button" class="objekt-kind-option" data-value="latest" role="option">최신순</button>
                        <button type="button" class="objekt-kind-option" data-value="oldest" role="option">오래된순</button>
                        <button type="button" class="objekt-kind-option" data-value="number_low" role="option">번호 낮은순</button>
                        <button type="button" class="objekt-kind-option" data-value="number_high" role="option">번호 높은순</button>
                        <button type="button" class="objekt-kind-option" data-value="first_member" role="option">첫 멤버</button>
                        <button type="button" class="objekt-kind-option" data-value="last_member" role="option">마지막 멤버</button>
                        <button type="button" class="objekt-kind-option" data-value="mint_low" role="option">민팅 적은순</button>
                        <button type="button" class="objekt-kind-option" data-value="mint_high" role="option">민팅 많은순</button>
                    </div>
                </div>
                <div class="objekt-search-row">
                    <div class="objekt-cols-control" id="collection-cols-dropdown" data-objekt-cols-filter>
                        <button type="button" class="objekt-cols-toggle" data-objekt-cols-toggle aria-label="열 수" aria-expanded="false" aria-haspopup="listbox" aria-controls="collection-cols-menu">
                            <span class="objekt-cols-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                            <span class="objekt-cols-sr" data-objekt-cols-label>2열</span>
                        </button>
                        <div id="collection-cols-menu" class="objekt-dropdown-menu absolute top-full left-0 mt-2 rounded-xl border z-50 p-1.5" data-objekt-cols-menu hidden role="listbox" aria-label="열 수">
                            <button type="button" class="objekt-kind-option" data-objekt-cols-option="2" role="option">2열</button>
                            <button type="button" class="objekt-kind-option" data-objekt-cols-option="3" role="option">3열</button>
                            <button type="button" class="objekt-kind-option" data-objekt-cols-option="4" role="option">4열</button>
                            <button type="button" class="objekt-kind-option" data-objekt-cols-option="5" role="option">5열</button>
                        </div>
                    </div>
                    <div class="objekt-search site-search">
                        <label class="w-full min-w-0">
                            <input type="search" name="q" value="{{searchQuery}}" placeholder="전체 오브젝트에서 검색..." aria-label="보유 오브젝트 검색" autocomplete="off" class="objekt-search-input site-search__input">
                        </label>
                        <button type="submit" class="objekt-search-button site-search__submit" aria-label="검색">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        </button>
                    </div>
                    <a class="objekt-reset-button" href="/cosmo/collection?nickname={{nicknameEncoded}}">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10a9 9 0 1 1 2.6 8.4M3 4v6h6"/></svg>
                        초기화
                    </a>
                </div>
            </div>
            </div>
        </form>
    </section>
    <section class="ar-grid collection-grid" id="collection-grid" aria-label="보유 오브젝트"
             data-objekt-grid data-cols="2"
             data-loaded="{{loadedCount}}" data-filtered="{{filteredCount}}" data-owned="{{ownedCount}}">
        {{#cards}}
        <article class="card ar-panel ar-card collection-card">
            <div class="indicator collection-image-wrap">
            <span class="indicator-item indicator-start indicator-top collection-card-serial">{{#hasSerial}}#{{serial}}{{/hasSerial}}{{^hasSerial}}시리얼 확인 중{{/hasSerial}}</span>
            {{#hasImage}}<img class="collection-image" src="{{thumbnailImage}}" alt="{{collectionId}}" referrerpolicy="no-referrer" loading="lazy" decoding="async">{{/hasImage}}
            {{^hasImage}}<span class="ar-muted">이미지 준비 중</span>{{/hasImage}}
            </div>
            <div class="card-body collection-card-body">
                <div class="collection-card-badges">
                    <span class="badge badge-sm collection-card-season" data-season-color="{{season}}"{{#seasonColor}} style="background:{{seasonColor}}"{{/seasonColor}}>{{season}}</span>
                    {{#hasDetail}}<a class="collection-title-link" href="{{detailUrl}}" title="{{collectionId}}">{{#cardTitle}}{{cardTitle}}{{/cardTitle}}{{^cardTitle}}{{collectionId}}{{/cardTitle}}</a>{{/hasDetail}}
                    {{^hasDetail}}<span class="collection-card-title" title="{{collectionId}}">{{#cardTitle}}{{cardTitle}}{{/cardTitle}}{{^cardTitle}}{{collectionId}}{{/cardTitle}}</span>{{/hasDetail}}
                    <span class="badge badge-sm badge-neutral collection-card-class">{{objektClass}}</span>
                </div>
                <div class="collection-card-foot">
                    <span class="collection-card-member truncate">{{member}}</span>
                    <span class="collection-card-no">{{collectionNo}}</span>
                </div>
            </div>
        </article>
        {{/cards}}
    </section>
    <p class="gv-panel gv-empty{{#hasCards}} is-hidden{{/hasCards}}" id="collection-empty">이 조건에 표시할 보유 오브젝트가 없습니다.</p>
    <div class="collection-scroll-footer" id="collection-scroll-sentinel"
         data-has-more="{{#hasMore}}true{{/hasMore}}{{^hasMore}}false{{/hasMore}}"
         data-loading="{{#loading}}true{{/loading}}{{^loading}}false{{/loading}}"
         data-next-page="{{nextPage}}">
        <p id="collection-scroll-status" class="collection-scroll-status" aria-live="polite"></p>
        <span id="collection-scroll-spinner" class="collection-scroll-spinner is-hidden" aria-hidden="true"></span>
    </div>
    {{/hasCollection}}
</main>
<script src="{{#asset}}/js/member-portrait-picker.js{{/asset}}"></script>
<script src="{{#asset}}/js/objekt-kind-combo.js{{/asset}}"></script>
<script src="{{#asset}}/js/objekt-grid-cols.js{{/asset}}"></script>
<script type="application/json" id="collection-kind-by-class">{{{kindByClassJson}}}</script>
<script src="{{#asset}}/js/collection-nickname-suggest.js{{/asset}}"></script>
<script>
(() => {
  const form = document.getElementById('collection-filter-form');
  const picker = document.getElementById('collection-member-picker');
  const panel = document.getElementById('collection-member-panel');
  const toggle = document.getElementById('collection-member-toggle');
  const memberInput = document.getElementById('collection-member-input');
  const groupInput = document.getElementById('collection-group-input');
  const meta = document.getElementById('collection-member-meta');
  const otherNotice = document.getElementById('collection-other-notice');
  const tabs = document.querySelectorAll('.collection-group-tab');
  const grid = document.getElementById('collection-grid');
  const empty = document.getElementById('collection-empty');
  const sentinel = document.getElementById('collection-scroll-sentinel');
  const statusEl = document.getElementById('collection-scroll-status');
  const spinner = document.getElementById('collection-scroll-spinner');
  const filteredCountEl = document.getElementById('collection-filtered-count');
  let filtersReady = false;
  let filterTimer;
  let listAbort;
  let lastFirstPageKey = '';
  let listGeneration = 0;
  let loadedCount = Number(grid?.dataset.loaded || grid?.querySelectorAll('.collection-card').length || 0);
  let filteredCount = Number(grid?.dataset.filtered || 0);
  let ownedCount = Number(grid?.dataset.owned || 0);
  let nextPage = Number(sentinel?.dataset.nextPage || 1);
  let hasMore = sentinel?.dataset.hasMore === 'true';
  let pending = sentinel?.dataset.loading === 'true';
  let loading = false;
  let pollTimer;
  let loadError = '';
  let sentinelVisible = false;
  let lastKindValue = document.getElementById('collection-kind-input')?.value || 'all';
  let kindCombo = null;
  let pendingKindReset = false;
  let activeFilters = new URLSearchParams(window.location.search);
  activeFilters.delete('page');

  function selectedClassValues() {
    return [...document.querySelectorAll('#collection-class-menu .class-checkbox')]
      .filter((box) => box.value !== 'all' && box.checked)
      .map((box) => box.value);
  }

  function kindByClassMap() {
    const node = document.getElementById('collection-kind-by-class');
    if (!node) return {};
    try {
      const parsed = JSON.parse(node.textContent || '{}');
      return parsed && typeof parsed === 'object' ? parsed : {};
    } catch (_) {
      return {};
    }
  }

  const kindClassMap = kindByClassMap();

  function syncKindToClasses() {
    if (!kindCombo?.syncToClasses) return lastKindValue;
    const next = kindCombo.syncToClasses(selectedClassValues(), kindClassMap);
    if (next && next !== lastKindValue) {
      lastKindValue = next;
      pendingKindReset = true;
    }
    return lastKindValue;
  }

  function setGroup(group, clearMember) {
    const next = group || 'all';
    if (groupInput) groupInput.value = next;
    tabs.forEach((tab) => tab.setAttribute('aria-pressed', tab.dataset.objektGroup === next ? 'true' : 'false'));
    if (picker) picker.hidden = next === 'other';
    if (toggle) toggle.hidden = next === 'other';
    if (otherNotice) otherNotice.hidden = next !== 'other';
    if (clearMember) {
      if (window.MemberPortraitPicker) MemberPortraitPicker.clear(picker);
      if (memberInput) memberInput.value = '';
    }
    if (meta) {
      if (next === 'other') meta.textContent = '기타 옵젝';
      else if (memberInput && memberInput.value) meta.textContent = memberInput.value;
      else meta.textContent = next === 'members' ? '전체 멤버' : '전체 오브젝트';
    }
    panel?.classList.toggle('is-filtered', next !== 'all' || Boolean(memberInput?.value));
  }

  function currentFilterParams() {
    const params = new URLSearchParams(new FormData(form));
    params.delete('page');
    return params;
  }

  function scheduleApplyFilters(delayMs) {
    if (!filtersReady || !grid) return;
    clearTimeout(filterTimer);
    const wait = delayMs == null ? 0 : delayMs;
    if (wait <= 0) applyFilters();
    else filterTimer = setTimeout(applyFilters, wait);
  }

  function syncFilterAddress(params) {
    const address = new URL(location.href);
    address.search = params.toString();
    history.replaceState(null, '', address.pathname + address.search);
  }

  if (form && window.MemberPortraitPicker) {
    if (picker) {
      MemberPortraitPicker.bindMultiSelect(picker, {
        multi: false,
        onChange: (values) => {
          if (memberInput) memberInput.value = values[0] || '';
          setGroup(values[0] ? 'members' : (groupInput?.value === 'other' ? 'other' : 'all'), false);
          scheduleApplyFilters();
        }
      });
    }
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      setGroup(tab.dataset.objektGroup || 'all', true);
      scheduleApplyFilters();
    }));
    toggle?.addEventListener('click', () => {
      const collapsed = panel.classList.toggle('is-collapsed');
      toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    });
    setGroup(groupInput?.value || 'all', false);
  }
  function closeMenus(except) {
    document.querySelectorAll('.objekt-dropdown-menu').forEach((other) => {
      if (other !== except) other.hidden = true;
    });
    document.querySelectorAll('#collection-filter-form .objekt-filter').forEach((filter) => {
      if (!except || !filter.contains(except)) filter.classList.remove('is-open');
    });
    except?.closest('.objekt-filter')?.classList.toggle('is-open', Boolean(except) && !except.hidden);
  }

  if (form) {
    bindChoiceMenu('season', 'collection-season');
    bindChoiceMenu('class', 'collection-class');
    bindSingleMenu('collection-sort', 'collection-sort-input', 'latest');
    kindCombo = window.ObjektKindCombo?.bindKindCombo({
      input: document.getElementById('collection-kind-select'),
      menu: document.getElementById('collection-kind-menu'),
      toggle: document.getElementById('collection-kind-toggle'),
      hiddenInput: document.getElementById('collection-kind-input'),
      empty: document.getElementById('collection-kind-empty'),
      closeOthers() {
        closeMenus(document.getElementById('collection-kind-menu'));
      },
      onChange(value) {
        if (value === lastKindValue) return;
        lastKindValue = value;
        scheduleApplyFilters();
      }
    });
    syncKindToClasses();
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      kindCombo?.commit(document.getElementById('collection-kind-select')?.value);
      applyFilters();
    });
    form.querySelector('input[name="q"]')?.addEventListener('input', () => scheduleApplyFilters(200));
  }

  function bindSingleMenu(prefix, inputId, fallback) {
    const menu = document.getElementById(prefix + '-menu');
    const toggleBtn = document.getElementById(prefix + '-toggle');
    const label = document.getElementById(prefix + '-label');
    const input = document.getElementById(inputId);
    const root = document.getElementById(prefix + '-dropdown');
    if (!menu || !toggleBtn || !input || !form) return;
    const choices = () => [...menu.querySelectorAll('.objekt-kind-option')];
    function sync() {
      const current = input.value || fallback;
      choices().forEach((choice) => {
        const selected = choice.dataset.value === current;
        choice.classList.toggle('is-active', selected);
        choice.setAttribute('aria-selected', selected ? 'true' : 'false');
        if (selected && label) label.textContent = choice.textContent.trim() || '전체';
      });
      const active = current && current !== fallback;
      root?.classList.toggle('is-filtered', active);
      if (label && current === fallback) {
        label.textContent = prefix.endsWith('sort') ? '최신순' : '전체';
      }
    }
    function applyChoice(choice) {
      input.value = choice.dataset.value || fallback;
      sync();
      scheduleApplyFilters();
    }
    choices().forEach((choice) => {
      choice.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        event.preventDefault();
        applyChoice(choice);
      });
      choice.addEventListener('click', (event) => {
        event.stopPropagation();
        applyChoice(choice);
        menu.hidden = true;
        toggleBtn.setAttribute('aria-expanded', 'false');
        closeMenus();
      });
    });
    toggleBtn.addEventListener('click', () => {
      const open = menu.hasAttribute('hidden');
      menu.hidden = !open;
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      closeMenus(open ? menu : null);
    });
    if (!input.value) input.value = fallback;
    sync();
  }

  function bindChoiceMenu(type, prefix) {
    const menu = document.getElementById(prefix + '-menu');
    const toggleBtn = document.getElementById(prefix + '-toggle');
    const label = document.getElementById(prefix + '-label');
    const root = document.getElementById(prefix + '-dropdown');
    if (!menu || !toggleBtn || !form) return;
    const boxes = () => [...menu.querySelectorAll('.' + type + '-checkbox')];
    const textOf = (box) => box.closest('label')?.querySelector('.objekt-choice-text')?.textContent.trim() || '';
    function syncLabel() {
      const all = menu.querySelector('.' + type + '-checkbox[value="all"]');
      const chosen = boxes().filter((box) => box.checked && box !== all);
      if (!label) return;
      if (!chosen.length || (all && all.checked)) label.textContent = '전체';
      else if (chosen.length === 1) label.textContent = textOf(chosen[0]);
      else label.textContent = textOf(chosen[0]) + ' 외 ' + (chosen.length - 1) + '개';
      root?.classList.toggle('is-filtered', chosen.length > 0 && !(all && all.checked));
    }
    boxes().forEach((box) => box.addEventListener('change', () => {
      const all = menu.querySelector('.' + type + '-checkbox[value="all"]');
      if (box.value === 'all' && box.checked) boxes().forEach((other) => { if (other !== box) other.checked = false; });
      else if (box.value !== 'all' && box.checked && all) all.checked = false;
      const chosen = boxes().some((other) => other.value !== 'all' && other.checked);
      if (all && !chosen) all.checked = true;
      syncLabel();
      if (type === 'class') syncKindToClasses();
      scheduleApplyFilters();
    }));
    toggleBtn.addEventListener('click', () => {
      const open = menu.hasAttribute('hidden');
      menu.hidden = !open;
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      closeMenus(open ? menu : null);
    });
    syncLabel();
  }

  document.addEventListener('click', (event) => {
    if (event.target.closest('.objekt-filter')) return;
    closeMenus();
  });

  filtersReady = Boolean(form && grid && sentinel);
  if (filtersReady && pendingKindReset) {
    pendingKindReset = false;
    scheduleApplyFilters();
  }
  if (!filtersReady) return;

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function seasonBadgeColor(item) {
    const fromItem = typeof item?.seasonColor === 'string' ? item.seasonColor.trim() : '';
    if (fromItem) return fromItem;
    return window.SeasonChips?.colorFor(item?.season) || '#A4B7B4';
  }

  function updateStatus() {
    if (empty) empty.classList.toggle('is-hidden', loadedCount > 0 || pending);
    if (filteredCountEl) filteredCountEl.textContent = String(filteredCount);
    if (!statusEl) return;
    if (loadError) statusEl.textContent = loadError;
    else if (loading || pending) statusEl.textContent = '불러오는 중…';
    else if (hasMore) statusEl.textContent = '스크롤하면 더 불러옵니다';
    else if (loadedCount > 0) statusEl.textContent = `모두 불러왔습니다 · ${loadedCount} / ${filteredCount || ownedCount}`;
    else statusEl.textContent = '';
    spinner?.classList.toggle('is-hidden', !loading);
  }

  function cardTitleFrom(collectionId, season) {
    const title = (collectionId || '').trim();
    const prefix = (season || '').trim();
    if (!title || !prefix) return title;
    if (title.toLowerCase().startsWith(prefix.toLowerCase() + ' ')) {
      return title.slice(prefix.length).trim() || title;
    }
    return title;
  }

  function buildCard(item) {
    const collectionId = item.collectionId || '오브젝트';
    const title = escapeHtml(item.cardTitle || cardTitleFrom(collectionId, item.season) || collectionId);
    const member = escapeHtml(item.member || '');
    const klass = escapeHtml(item.objektClass || item.class || '');
    const collectionNo = escapeHtml(item.collectionNo || '');
    const serial = item.hasSerial
      ? `<span class="ar-id" aria-label="시리얼 ${escapeHtml(item.serial)}">#${escapeHtml(item.serial)}</span>`
      : '<span class="ar-id">시리얼 확인 중</span>';
    const image = item.hasImage
      ? `<img class="collection-image" src="${escapeHtml(item.thumbnailImage)}" alt="${escapeHtml(collectionId)}" referrerpolicy="no-referrer" loading="lazy" decoding="async">`
      : '<span class="ar-muted">이미지 준비 중</span>';
    const heading = item.hasDetail
      ? `<a class="collection-title-link" href="${escapeHtml(item.detailUrl)}" title="${escapeHtml(collectionId)}">${title}</a>`
      : `<span class="collection-card-title" title="${escapeHtml(collectionId)}">${title}</span>`;
    const season = escapeHtml(item.season || '');
    const seasonStyle = item.season ? ` style="background:${escapeHtml(seasonBadgeColor(item))}"` : '';
    return `<article class="card ar-panel ar-card collection-card">
      <div class="indicator collection-image-wrap"><span class="indicator-item indicator-start indicator-top collection-card-serial">${serial}</span>${image}</div>
      <div class="card-body collection-card-body">
        <div class="collection-card-badges">
          <span class="badge badge-sm collection-card-season" data-season-color="${season}"${seasonStyle}>${season}</span>
          ${heading}
          <span class="badge badge-sm badge-neutral collection-card-class">${klass}</span>
        </div>
        <div class="collection-card-foot">
          <span class="collection-card-member truncate">${member}</span>
          <span class="collection-card-no">${collectionNo}</span>
        </div>
      </div>
    </article>`;
  }

  function firstPageKey(items) {
    return items.map((item) => [
      item.serial || '',
      item.collectionId || '',
      item.collectionNo || '',
      item.thumbnailImage || ''
    ].join('\t')).join('\n');
  }

  function renderCards(items, replace) {
    if (replace) {
      grid.replaceChildren();
      loadedCount = 0;
    }
    if (!items.length) return;
    const wrap = document.createElement('div');
    wrap.innerHTML = items.map(buildCard).join('');
    const fragment = document.createDocumentFragment();
    while (wrap.firstChild) fragment.appendChild(wrap.firstChild);
    grid.appendChild(fragment);
    loadedCount += items.length;
  }

  async function applyFilters() {
    if (!grid) return;
    const request = ++listGeneration;
    clearTimeout(pollTimer);
    listAbort?.abort();
    listAbort = new AbortController();
    loadError = '';
    loading = true;
    hasMore = false;
    pending = false;
    updateStatus();
    const params = currentFilterParams();
    params.set('page', '0');
    try {
      const res = await fetch(`/cosmo/collection/more?${params.toString()}`, {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
        cache: 'no-store',
        signal: listAbort.signal
      });
      if (!res.ok) throw new Error('load failed');
      const data = await res.json();
      if (request !== listGeneration) return;
      const items = Array.isArray(data.items) ? data.items : [];
      const key = firstPageKey(items);
      if (key !== lastFirstPageKey) {
        renderCards(items, true);
        lastFirstPageKey = key;
      } else {
        loadedCount = items.length;
      }
      filteredCount = Number(data.filteredCount ?? filteredCount);
      ownedCount = Number(data.ownedCount ?? ownedCount);
      hasMore = Boolean(data.hasMore);
      pending = Boolean(data.loading);
      nextPage = data.nextPage == null ? 1 : Number(data.nextPage);
      grid.dataset.loaded = String(loadedCount);
      grid.dataset.filtered = String(filteredCount);
      grid.dataset.owned = String(ownedCount);
      params.delete('page');
      activeFilters = new URLSearchParams(params);
      syncFilterAddress(params);
    } catch (error) {
      if (request !== listGeneration || (error && error.name === 'AbortError')) return;
      hasMore = false;
      pending = false;
      loadError = '검색 결과를 바꾸지 못했습니다. 잠시 후 다시 시도해 주세요.';
    } finally {
      if (request !== listGeneration) return;
      loading = false;
      updateStatus();
      if (pending || (hasMore && sentinelVisible)) {
        pollTimer = setTimeout(loadMore, 400);
      }
    }
  }

  async function loadMore() {
    if ((!hasMore && !pending) || loading) return;
    const request = listGeneration;
    clearTimeout(pollTimer);
    listAbort?.abort();
    listAbort = new AbortController();
    loadError = "";
    loading = true;
    updateStatus();
    try {
      const params = new URLSearchParams(activeFilters);
      params.set('page', String(pending ? 0 : nextPage));
      const res = await fetch(`/cosmo/collection/more?${params.toString()}`, {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
        cache: 'no-store',
        signal: listAbort.signal
      });
      if (!res.ok) throw new Error('load failed');
      const data = await res.json();
      if (request !== listGeneration) return;
      const items = Array.isArray(data.items) ? data.items : [];
      const stillLoading = pending || data.loading;
      const key = firstPageKey(items);
      // While upstream pages arrive, sorting and filters can move cards.
      // Replace the first page until loading finishes, then append stable pages.
      if (stillLoading) {
        if (key !== lastFirstPageKey) {
          renderCards(items, true);
          lastFirstPageKey = key;
        }
      } else if (items.length) {
        renderCards(items, false);
      }
      filteredCount = Number(data.filteredCount ?? filteredCount);
      ownedCount = Number(data.ownedCount ?? ownedCount);
      hasMore = Boolean(data.hasMore);
      pending = Boolean(data.loading);
      nextPage = data.nextPage == null ? nextPage + 1 : Number(data.nextPage);
      grid.dataset.loaded = String(loadedCount);
      grid.dataset.filtered = String(filteredCount);
      grid.dataset.owned = String(ownedCount);
    } catch (error) {
      if (request !== listGeneration || (error && error.name === 'AbortError')) return;
      hasMore = false;
      pending = false;
      loadError = '더 불러오지 못했습니다. 페이지를 새로고침해 주세요.';
    } finally {
      if (request !== listGeneration) return;
      loading = false;
      updateStatus();
      if (pending || (hasMore && sentinelVisible)) {
        pollTimer = setTimeout(loadMore, 400);
      }
    }
  }

  updateStatus();
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      sentinelVisible = entries.some((entry) => entry.isIntersecting);
      if (sentinelVisible) loadMore();
    }, { rootMargin: '400px 0px' });
    io.observe(sentinel);
  } else if (hasMore || pending) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'collection-load-more';
    btn.textContent = '더 보기';
    btn.addEventListener('click', loadMore);
    sentinel.appendChild(btn);
  }
  if (pending) pollTimer = setTimeout(loadMore, 400);
  window.addEventListener('pagehide', () => {
    clearTimeout(pollTimer);
    listAbort?.abort();
  }, { once: true });
})();
</script>
