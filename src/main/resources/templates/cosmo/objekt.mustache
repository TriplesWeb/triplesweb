<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 오브젝트</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS 스크립트 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/member-portrait-picker.css?v=12">
    <style>
        .objekt-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.25rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }
        .objekt-head-copy {
            min-width: 0;
        }
        .objekt-head-kicker {
            margin: 0 0 .35rem;
            color: #6ee7d8;
            font-family: Sora, Inter, sans-serif;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .22em;
            text-transform: uppercase;
        }
        .objekt-head-title {
            margin: 0;
            color: #f3f4f8;
            font-family: Sora, Inter, sans-serif;
            font-size: clamp(1.55rem, 2.4vw, 1.95rem);
            font-weight: 800;
            letter-spacing: -.03em;
            line-height: 1.1;
        }
        .objekt-head-sub {
            margin: .35rem 0 0;
            color: #8b93a7;
            font-size: .82rem;
            font-weight: 500;
        }
        .objekt-fav-link {
            display: inline-flex;
            flex-shrink: 0;
            align-items: center;
            gap: .4rem;
            min-height: 2.35rem;
            padding: 0 .95rem;
            border: 1px solid rgba(244, 114, 182, .28);
            border-radius: 999px;
            background: rgba(244, 114, 182, .06);
            color: #f9a8d4;
            font-size: .78rem;
            font-weight: 650;
            text-decoration: none;
            transition: border-color .18s ease, background .18s ease, color .18s ease;
        }
        .objekt-fav-link:hover {
            border-color: rgba(244, 114, 182, .55);
            background: rgba(244, 114, 182, .12);
            color: #fce7f3;
        }

        .objekt-workspace {
            display: grid;
            gap: .85rem;
            padding: 1rem;
            border: 1px solid rgba(72, 82, 108, .32);
            border-radius: 18px;
            background:
                radial-gradient(120% 80% at 0% 0%, rgba(0, 232, 203, .05), transparent 42%),
                linear-gradient(160deg, rgba(20, 23, 33, .96), rgba(14, 16, 24, .94));
        }
        .objekt-member-picker-panel {
            margin: 0;
            padding: 0 0 .85rem;
            border: 0;
            border-bottom: 1px solid rgba(255,255,255,.06);
            border-radius: 0;
            background: transparent;
            box-shadow: none;
        }
        .objekt-member-picker-panel .mpp-toolbar { margin-bottom: 0; }
        .objekt-member-picker-panel:not(.is-collapsed) .mpp-toolbar { margin-bottom: .75rem; }
        .objekt-member-toggle {
            display: flex;
            flex: 1 1 auto;
            min-width: 0;
            align-items: center;
            gap: .55rem;
            margin: 0;
            border: 0;
            background: transparent;
            padding: 0;
            color: inherit;
            text-align: left;
            cursor: pointer;
        }
        .objekt-member-toggle .mpp-toolbar-title,
        .objekt-member-toggle .mpp-toolbar-meta {
            display: block;
        }
        .objekt-member-toggle:hover .mpp-toolbar-title,
        .objekt-member-toggle[aria-expanded="true"] .mpp-toolbar-title {
            color: #7df9e8;
        }
        .objekt-member-toggle-caret {
            flex: 0 0 auto;
            margin-left: .15rem;
            color: #6ee7d8;
            font-size: 1.2rem;
            line-height: 1;
            transition: transform .18s ease;
        }
        .objekt-member-toggle[aria-expanded="true"] .objekt-member-toggle-caret {
            transform: rotate(180deg);
        }
        .objekt-member-checks {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
        .objekt-filter-bar {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            align-items: center;
            gap: .55rem .65rem;
            padding: 0;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
        }
        .objekt-filter {
            display: flex;
            width: 100%;
            min-width: 0;
            height: 2.65rem;
            align-items: center;
            gap: .5rem;
            padding: .25rem .25rem .25rem .75rem;
            border: 1px solid rgba(58, 66, 88, .72);
            border-radius: 999px;
            background: rgba(10, 12, 18, .55);
            transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
        }
        .objekt-filter:focus-within,
        .objekt-filter:hover {
            border-color: rgba(0, 245, 212, .38);
            background: rgba(0, 245, 212, .04);
        }
        .objekt-filter-label {
            flex: 0 0 auto;
            color: #8b93a7;
            font-size: .72rem;
            font-weight: 650;
            letter-spacing: .04em;
            text-transform: uppercase;
        }
        .objekt-filter-control {
            display: inline-flex;
            flex: 1 1 auto;
            align-items: center;
            justify-content: space-between;
            gap: .2rem;
            box-sizing: border-box;
            min-width: 0;
            width: auto;
            height: 2.1rem;
            margin: 0;
            border: 0;
            border-radius: 999px;
            background: rgba(255,255,255,.045);
            padding: 0 .35rem 0 .75rem;
            color: #e8ebf2;
            font-size: .82rem;
            font-weight: 600;
            line-height: 1;
            transition: background .18s ease, color .18s ease;
        }
        .objekt-filter-control:hover { background: rgba(255,255,255,.07); }
        .objekt-filter button.objekt-filter-control { cursor: pointer; }
        .objekt-filter-control > .truncate { min-width: 0; }
        .objekt-filter-caret {
            flex: 0 0 auto;
            color: #6ee7d8;
            font-size: 1.1rem !important;
            line-height: 1 !important;
            pointer-events: none;
        }
        .objekt-filter.is-filtered {
            border-color: rgba(0, 245, 212, .55);
            background: rgba(0, 245, 212, .08);
        }
        .objekt-filter.is-filtered .objekt-filter-label { color: #7df9e8; }
        .objekt-search.is-filtered {
            border-color: rgba(0, 245, 212, .55);
            box-shadow: 0 0 0 3px rgba(0, 245, 212, .08);
        }
        .objekt-member-picker-panel.is-filtered .mpp-toolbar-meta {
            color: #7df9e8;
        }

        .objekt-filter-select-wrap {
            position: relative;
            min-width: 0;
            padding-right: .25rem;
        }
        .objekt-filter-select-wrap select,
        .objekt-filter-select-wrap select:hover,
        .objekt-filter-select-wrap select:focus {
            appearance: none !important;
            -webkit-appearance: none !important;
            width: 100%;
            min-width: 0;
            height: 2.1rem;
            margin: 0;
            border: 0 !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            padding: 0 1.35rem 0 0 !important;
            color: #e8ebf2 !important;
            font-size: .82rem;
            font-weight: 600;
            line-height: 2.1rem;
            cursor: pointer;
        }
        .objekt-filter-select-wrap .objekt-filter-caret {
            position: absolute;
            top: 50%;
            right: .2rem;
            transform: translateY(-50%);
        }

        .objekt-kind-combo {
            min-width: 0;
            gap: 0;
            padding: 0 .2rem 0 .65rem;
        }
        .objekt-filter input.objekt-kind-select,
        .objekt-filter input.objekt-kind-select:hover,
        .objekt-filter input.objekt-kind-select:focus,
        .objekt-filter input.objekt-kind-select:focus-visible {
            appearance: none !important;
            -webkit-appearance: none !important;
            width: 100%;
            min-width: 0;
            max-width: none;
            flex: 1 1 auto;
            height: 2.1rem;
            margin: 0;
            border: 0 !important;
            border-radius: 0 !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            background-color: transparent !important;
            padding: 0 !important;
            color: #e8ebf2 !important;
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: .8rem;
            font-weight: 650;
            letter-spacing: .02em;
            line-height: 2.1rem;
            text-transform: uppercase;
            caret-color: #6ee7d8;
        }
        .objekt-filter input.objekt-kind-select::placeholder {
            color: #6b7388 !important;
            opacity: 1;
            text-transform: none;
            font-family: inherit;
            font-weight: 600;
            letter-spacing: 0;
        }
        .objekt-kind-toggle {
            display: inline-flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 1.45rem;
            height: 1.45rem;
            border: 0;
            border-radius: 999px;
            background: transparent;
            color: #6ee7d8;
            cursor: pointer;
        }
        .objekt-kind-toggle:hover { background: rgba(255,255,255,.06); }
        .objekt-kind-toggle .material-symbols-outlined {
            font-size: 1.1rem;
            line-height: 1;
        }
        .objekt-kind-option {
            display: block;
            width: 100%;
            padding: .45rem .7rem;
            border: 0;
            border-radius: .5rem;
            background: transparent;
            color: #e8ebf2;
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: .82rem;
            text-align: left;
            cursor: pointer;
        }
        #sort-menu .objekt-kind-option,
        #sort-dropdown .objekt-kind-option,
        #objekt-sort-toggle,
        #sort-label {
            font-family: Inter, "Noto Sans KR", -apple-system, sans-serif !important;
            font-weight: 650 !important;
            letter-spacing: 0 !important;
            text-transform: none !important;
        }
        .objekt-choice {
            position: relative;
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .5rem .7rem;
            border-radius: .55rem;
            color: #e8ebf2;
            font-family: Inter, "Noto Sans KR", -apple-system, sans-serif;
            font-size: .9rem;
            font-weight: 650;
            cursor: pointer;
        }
        .objekt-choice:hover { background: #1a1d28; }
        .objekt-choice input {
            appearance: none !important;
            -webkit-appearance: none !important;
            position: absolute !important;
            width: 0 !important;
            height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0 !important;
            opacity: 0 !important;
            pointer-events: none !important;
            background: transparent !important;
            box-shadow: none !important;
        }
        .objekt-choice-mark {
            display: grid;
            place-items: center;
            width: 1.15rem;
            height: 1.15rem;
            flex: 0 0 auto;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            color: transparent;
            font-size: 1.15rem;
            font-weight: 800;
            line-height: 1;
        }
        .objekt-choice-mark::before { content: "✓"; }
        .objekt-choice:has(input:checked) {
            background: rgba(0, 245, 212, .16);
            color: #f3fffb;
        }
        .objekt-choice:has(input:checked) .objekt-choice-mark {
            color: #7df9e8;
            background: transparent;
            border: 0;
            box-shadow: none;
            text-shadow: 0 0 8px rgba(125, 249, 232, .55);
        }
        #objekt-member-toggle[hidden] { display: none !important; }
        .objekt-kind-option:hover,
        .objekt-kind-option:focus-visible,
        .objekt-kind-option.is-active {
            background: rgba(0, 245, 212, .1);
            color: #7df9e8;
        }
        .objekt-kind-option[hidden] { display: none; }
        #objekt-sort-toggle[hidden],
        #sort-native-control[hidden] { display: none; }
        #sort-dropdown > .objekt-sort-control {
            display: flex;
            flex: 1 1 0;
            min-width: 0;
        }
        #objekt-sort-toggle,
        #sort-native-control { flex: 1 1 0; width: 100%; min-width: 0; max-width: none; }
        #sort-menu {
            left: auto;
            right: 0;
            min-width: min(100%, calc(100vw - 2rem));
            width: max-content;
            max-width: calc(100vw - 2rem);
        }
        .objekt-kind-empty {
            padding: .55rem .7rem;
            color: #8b93a7;
            font-size: .78rem;
        }
        .objekt-kind-empty[hidden] { display: none; }
        .objekt-filter-control:focus-visible,
        .objekt-search-input:focus-visible {
            outline: 2px solid #00f5d4;
            outline-offset: 2px;
        }
        .objekt-search-row {
            display: flex;
            grid-column: 1 / -1;
            flex-wrap: wrap;
            align-items: center;
            gap: .55rem;
            width: 100%;
            margin-top: .15rem;
            padding-top: .85rem;
            border-top: 1px solid rgba(255,255,255,.06);
        }
        .objekt-search {
            display: flex;
            flex: 1 1 16rem;
            min-width: 12rem;
            min-height: 2.75rem;
            align-items: center;
            gap: .55rem;
            padding: 0 .95rem;
            border: 1px solid rgba(58, 66, 88, .72);
            border-radius: 999px;
            background: rgba(8, 10, 16, .72);
            transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
        }
        .objekt-search-button {
            display: inline-flex;
            flex: 0 0 auto;
            min-height: 2.75rem;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: 0 1.15rem;
            border: 0;
            border-radius: 999px;
            background: #00e8cb;
            color: #071513;
            font-size: .82rem;
            font-weight: 750;
            letter-spacing: .01em;
            cursor: pointer;
            box-shadow: 0 8px 22px rgba(0, 232, 203, .16);
            transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
        }
        .objekt-search-button:hover {
            background: #39f7df;
            box-shadow: 0 10px 26px rgba(0, 232, 203, .22);
            transform: translateY(-1px);
        }
        .objekt-search-button:active { transform: translateY(0); }
        .objekt-search-button:focus-visible {
            outline: 2px solid #00f5d4;
            outline-offset: 3px;
        }
        .objekt-reset-button {
            display: inline-flex;
            flex: 0 0 auto;
            min-height: 2.75rem;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: 0 1rem;
            border: 1px solid rgba(120, 130, 155, .35);
            border-radius: 999px;
            background: transparent;
            color: #a4adbf;
            font-size: .82rem;
            font-weight: 650;
            letter-spacing: .01em;
            cursor: pointer;
            transition: background .18s ease, border-color .18s ease, color .18s ease;
        }
        .objekt-reset-button:hover {
            border-color: rgba(180, 190, 210, .45);
            background: rgba(255,255,255,.04);
            color: #e8ebf2;
        }
        .objekt-reset-button:focus-visible {
            outline: 2px solid #a4adbf;
            outline-offset: 3px;
        }
        .objekt-search:focus-within {
            border-color: rgba(0, 217, 189, .7);
            background: rgba(8, 10, 16, .92);
            box-shadow: 0 0 0 3px rgba(0, 245, 212, .08);
        }
        .objekt-group-tab[aria-pressed="true"] { background: rgba(0,245,212,.14); color: #9cffe9; border-color: rgba(0,245,212,.5); }
        #objekt-member-picker[hidden], .objekt-other-notice[hidden] { display: none; }
        .objekt-other-notice { margin: .85rem 0 .15rem; color: #b9cac4; font-size: .82rem; line-height: 1.6; }
        .objekt-search-input {
            width: 100%;
            min-width: 0;
            border: 0 !important;
            outline: 0 !important;
            box-shadow: none !important;
            background: transparent !important;
            color: #f1f5f9 !important;
            font-size: .9rem;
        }
        .objekt-search-input::placeholder { color: #6b7388; }
        .objekt-dropdown-menu {
            min-width: 12rem;
            border-color: #343b51;
            background: #171a24;
            box-shadow: 0 18px 40px rgba(0,0,0,.42);
        }
        .objekt-card-grid { gap: 16px; }
        .objekt-card {
            border-color: rgba(67,75,100,.52);
            background: linear-gradient(160deg, #191c27, #11131b);
            box-shadow: 0 8px 22px rgba(0,0,0,.2);
        }
        .objekt-card:hover {
            border-color: rgba(0,245,212,.58);
            box-shadow: 0 14px 32px rgba(0,0,0,.34), 0 0 0 1px rgba(0,245,212,.06);
        }
        .objekt-open-detail {
            appearance: none;
            display: block;
            width: 100%;
            padding: 0;
            border: 0;
            background: transparent;
            cursor: pointer;
            text-align: left;
        }
        .objekt-detail-modal {
            position: fixed;
            inset: 0;
            z-index: 80;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: rgba(6, 8, 14, 0.72);
            backdrop-filter: blur(8px);
        }
        .objekt-detail-modal.is-open {
            display: flex;
        }
        .objekt-detail-panel {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
            gap: 1.25rem;
            width: min(52rem, 100%);
            max-height: min(90vh, 44rem);
            overflow: auto;
            padding: 1.1rem;
            border-radius: 1.25rem;
            border: 1px solid rgba(255,255,255,.1);
            background: linear-gradient(165deg, #1a1d28, #10131b);
            box-shadow: 0 24px 60px rgba(0,0,0,.45);
        }
        .objekt-detail-media {
            position: relative;
            margin: 0;
            border-radius: 1rem;
            overflow: hidden;
            background: #12141c;
            border: 1px solid rgba(255,255,255,.08);
        }
        .objekt-detail-media-btn {
            appearance: none;
            display: block;
            width: 100%;
            padding: 0;
            border: 0;
            background: transparent;
            cursor: zoom-in;
        }
        .objekt-detail-media-btn.is-flippable {
            cursor: pointer;
        }
        .objekt-detail-media-btn:disabled {
            cursor: default;
        }
        .objekt-detail-media img {
            display: block;
            width: 100%;
            aspect-ratio: 2 / 3;
            object-fit: cover;
        }
        .objekt-detail-face {
            position: absolute;
            right: .65rem;
            bottom: .65rem;
            border-radius: 999px;
            background: rgba(0,0,0,.65);
            color: #fff;
            font-size: .68rem;
            font-weight: 700;
            padding: .28rem .55rem;
            pointer-events: none;
        }
        .objekt-detail-body {
            display: flex;
            flex-direction: column;
            gap: .85rem;
            min-width: 0;
        }
        .objekt-detail-close {
            position: absolute;
            top: .7rem;
            right: .7rem;
            appearance: none;
            width: 2.1rem;
            height: 2.1rem;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.12);
            background: rgba(0,0,0,.35);
            color: #e8edf5;
            font-size: 1.2rem;
            line-height: 1;
            cursor: pointer;
        }
        .objekt-detail-kicker {
            margin: 0;
            color: #6ee7d8;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .18em;
            text-transform: uppercase;
        }
        .objekt-detail-title {
            margin: .2rem 0 0;
            padding-right: 2.2rem;
            color: #f3f4f8;
            font-size: clamp(1.15rem, 2vw, 1.45rem);
            font-weight: 800;
            line-height: 1.25;
            word-break: break-word;
        }
        .objekt-detail-meta {
            margin: 0;
            display: grid;
            gap: .45rem;
        }
        .objekt-detail-meta div {
            display: flex;
            justify-content: space-between;
            gap: .75rem;
            padding-bottom: .45rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            font-size: .86rem;
        }
        .objekt-detail-meta dt { color: #8b93a7; margin: 0; }
        .objekt-detail-meta dd { margin: 0; color: #e8edf5; font-weight: 600; text-align: right; }
        .objekt-detail-desc {
            margin: 0;
            color: #b7c0d0;
            font-size: .88rem;
            line-height: 1.65;
            white-space: pre-wrap;
        }
        .objekt-detail-desc.is-empty { color: #6b7388; }
        .objekt-description-editor { border: 1px solid #ffffff18; border-radius: .8rem; background: #ffffff04; padding: .7rem .8rem; }
        .objekt-description-editor[hidden] { display: none !important; }
        .objekt-description-editor summary { cursor: pointer; color: #8decd9; font-size: .78rem; font-weight: 650; }
        .objekt-description-editor form { display: grid; gap: .6rem; margin-top: .8rem; }
        .objekt-description-editor label { color: #b9cac4; font-size: .75rem; }
        .objekt-description-editor textarea { width: 100%; resize: vertical; border: 1px solid #ffffff20; border-radius: .6rem; background: #0d1015; padding: .65rem; color: #e8f3ef; font: inherit; font-size: .82rem; }
        .objekt-description-buttons { display: flex; gap: .5rem; }
        .objekt-description-buttons button { padding: .45rem .8rem; border: 1px solid #00f5d440; border-radius: .5rem; background: #00f5d415; color: #8decd9; cursor: pointer; font-size: .78rem; }
        .objekt-description-buttons button:last-child { color: #ffb4ab; background: transparent; border-color: #ffb4ab40; }
        .objekt-description-editor p { color: #b9cac4; font-size: .75rem; margin: 0; }
        .objekt-description-editor :focus-visible { outline: 2px solid #8bf5dc; outline-offset: 2px; }
        .objekt-description-editor button:disabled { opacity: .5; cursor: wait; }
        .objekt-detail-actions {
            display: grid;
            gap: .5rem;
            margin-top: auto;
        }
        .objekt-detail-actions a,
        .objekt-detail-actions button {
            display: block;
            width: 100%;
            text-align: center;
            border-radius: .85rem;
            padding: .72rem 1rem;
            font-size: .88rem;
            font-weight: 700;
            text-decoration: none;
        }
        .objekt-fav-toggle {
            appearance: none;
            border: 1px solid rgba(244, 114, 182, .4);
            background: rgba(244, 114, 182, .1);
            color: #f9a8d4;
            cursor: pointer;
        }
        .objekt-fav-toggle.is-on {
            background: rgba(244, 114, 182, .22);
            color: #fce7f3;
        }
        .objekt-detail-actions .objekt-member-link {
            border: 1px solid rgba(255,255,255,.12);
            color: #d7dde8;
            background: transparent;
        }
        .objekt-detail-actions .objekt-trade-link {
            background: #00f5d4;
            color: #071513;
        }
        .objekt-detail-actions .objekt-full-link {
            border: 1px solid rgba(0, 245, 212, .35);
            color: #6ee7d8;
            background: rgba(0, 245, 212, .06);
            font-weight: 650;
        }
        @media (max-width: 760px) {
            .objekt-detail-panel {
                grid-template-columns: 1fr;
                max-height: 92vh;
            }
            .objekt-detail-media {
                max-width: 16rem;
                margin: 0 auto;
            }
            .objekt-workspace { padding: .85rem; gap: .75rem; }
            .objekt-filter-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .objekt-filter { height: auto; min-height: 2.65rem; justify-content: space-between; border-radius: 14px; }
            .objekt-filter-control { max-width: none; }
            .objekt-filter-select-wrap,
            .objekt-kind-combo { max-width: none; }
            .objekt-search { flex: 1 1 100%; }
            .objekt-search-button,
            .objekt-reset-button { flex: 1 1 calc(50% - .55rem); }
            .objekt-card-grid { gap: 10px; }
        }
        @media (max-width: 420px) {
            .objekt-filter-bar { grid-template-columns: 1fr; }
            .objekt-head { align-items: flex-start; }
            .objekt-fav-link { padding: 0 .8rem; }
        }
    </style>
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen flex flex-col gap-3">
{{>layout/header}}
<main class="main-content w-full max-w-[1440px] mx-auto px-4 sm:px-6 py-6 mb-auto">
    <section class="card-box w-full bg-[#16181f]/85 backdrop-blur-xl border border-[#303646]/80 rounded-2xl p-4 sm:p-6 shadow-[0_18px_50px_rgba(0,0,0,0.22)] relative z-30">
        <div class="objekt-head">
            <div class="objekt-head-copy">
                <p class="objekt-head-kicker">Collection</p>
                <h2 class="objekt-head-title">오브젝트</h2>
                <p class="objekt-head-sub">Objekt Archive</p>
            </div>
            <a href="/cosmo/objekt/favorites" class="objekt-fav-link">
                <span class="material-symbols-outlined text-[1rem]" aria-hidden="true">favorite</span>
                찜 목록
            </a>
        </div>
        <form id="objekt-search-form" action="/cosmo/objekt" method="get">
        <input type="hidden" name="page" value="0">
        <input type="hidden" name="group" id="objekt-member-group" value="{{selectedGroup}}">

        <div class="objekt-workspace">
        <div class="objekt-member-picker-panel is-collapsed" id="member-dropdown">
            <div class="mpp-toolbar">
                <button type="button" class="objekt-member-toggle" id="objekt-member-toggle" aria-expanded="false" aria-controls="objekt-member-picker" {{#isOtherGroup}}hidden{{/isOtherGroup}}>
                    <span>
                        <span class="mpp-toolbar-title">멤버</span>
                        <span class="mpp-toolbar-meta" id="member-label">전체 멤버</span>
                    </span>
                    <span class="material-symbols-outlined objekt-member-toggle-caret" aria-hidden="true">expand_more</span>
                </button>
                <div class="mpp-toolbar-actions" role="group" aria-label="오브젝트 분류">
                    <button type="button" class="mpp-tool-btn objekt-group-tab" id="objekt-member-clear" data-objekt-group="all" aria-pressed="false">전체</button>
                    <button type="button" class="mpp-tool-btn objekt-group-tab" data-objekt-group="members" aria-pressed="false">멤버</button>
                    <button type="button" class="mpp-tool-btn objekt-group-tab" data-objekt-group="other" aria-pressed="false">기타 옵젝</button>
                </div>
            </div>
            <div class="objekt-member-checks" id="member-options" aria-hidden="true">
                {{#memberPickerOptions}}
                <input type="checkbox" name="member" value="{{value}}" class="member-checkbox" data-mpp-value="{{value}}" {{#active}}checked{{/active}}>
                {{/memberPickerOptions}}
            </div>
            <div class="member-portrait-picker" id="objekt-member-picker" role="group" aria-label="멤버 다중 선택">
                {{>partials/member-portrait-picker}}
            </div>
            <p class="objekt-other-notice" id="objekt-other-notice" {{^isOtherGroup}}hidden{{/isOtherGroup}}>멤버와 연결되지 않은 그룹·기타 오브젝트를 모아 보여줍니다.</p>
        </div>

        <div class="objekt-filter-bar relative">

            <div class="objekt-filter relative" id="season-dropdown">
                <span class="objekt-filter-label">시즌</span>
                <button type="button" onclick="toggleDropdown('season-menu')" class="objekt-filter-control">
                    <span id="season-label" class="truncate">전체</span>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                </button>
                <div id="season-menu" class="objekt-dropdown-menu hidden absolute top-full left-0 mt-2 rounded-xl border z-50 p-2 max-h-60 overflow-y-auto">
                    <label class="objekt-choice">
                        <input type="checkbox" value="all" class="season-checkbox" checked>
                        <span class="objekt-choice-mark" aria-hidden="true"></span>
                        <span class="objekt-choice-text">전체 시즌</span>
                    </label>
                    <div id="season-options">
                        {{#seasonOptions}}
                        <label class="objekt-choice">
                            <input type="checkbox" name="season" value="{{.}}" class="season-checkbox">
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">{{.}}</span>
                        </label>
                        {{/seasonOptions}}
                    </div>
                </div>
            </div>

            <div class="objekt-filter relative" id="kind-dropdown">
                <span class="objekt-filter-label">종류</span>
                <div class="objekt-filter-control objekt-kind-combo">
                    <input type="text"
                           name="kind"
                           id="objekt-kind-input"
                           class="objekt-kind-select"
                           value="{{selectedKind}}"
                           placeholder="all"
                           autocomplete="off"
                           spellcheck="false"
                           role="combobox"
                           aria-expanded="false"
                           aria-controls="kind-menu"
                           aria-autocomplete="list"
                           aria-label="옵젝 종류 필터 (입력 또는 선택)">
                    <button type="button" class="objekt-kind-toggle" id="objekt-kind-toggle" aria-label="종류 목록 열기" tabindex="-1">
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_drop_down</span>
                    </button>
                </div>
                <div id="kind-menu" class="objekt-dropdown-menu hidden absolute top-full left-0 mt-2 min-w-[9rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" role="listbox" aria-label="종류 목록">
                    <button type="button" class="objekt-kind-option" data-value="all" role="option">all</button>
                    {{#objektNumbers}}
                    <button type="button" class="objekt-kind-option" data-value="{{.}}" role="option">{{.}}</button>
                    {{/objektNumbers}}
                    <p class="objekt-kind-empty" id="kind-empty" hidden>일치하는 종류 없음</p>
                </div>
            </div>

            <div class="objekt-filter relative" id="class-dropdown">
                <span class="objekt-filter-label">클래스</span>
                <button type="button" onclick="toggleDropdown('class-menu')" class="objekt-filter-control">
                    <span id="class-label" class="truncate">전체</span>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                </button>
                <div id="class-menu" class="objekt-dropdown-menu hidden absolute top-full left-0 mt-2 rounded-xl border z-50 p-2 max-h-60 overflow-y-auto">
                    <label class="objekt-choice">
                        <input type="checkbox" value="all" class="class-checkbox" checked>
                        <span class="objekt-choice-mark" aria-hidden="true"></span>
                        <span class="objekt-choice-text">전체 클래스</span>
                    </label>
                    <div id="class-options">
                        {{#classOptions}}
                        <label class="objekt-choice">
                            <input type="checkbox" name="class" value="{{.}}" class="class-checkbox">
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">{{.}}</span>
                        </label>
                        {{/classOptions}}
                    </div>
                </div>
            </div>

            <div class="objekt-filter relative" id="sort-dropdown">
                <span class="objekt-filter-label">정렬</span>
                <div class="objekt-sort-control">
                    <button type="button" id="objekt-sort-toggle" class="objekt-filter-control" aria-label="정렬" aria-haspopup="listbox" aria-expanded="false" aria-controls="sort-menu" hidden>
                        <span id="sort-label">최신순</span>
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                    <label id="sort-native-control" class="objekt-filter-control objekt-filter-select-wrap">
                    <select name="sort" class="objekt-sort-select" aria-label="정렬">
                        <option value="latest">최신순</option>
                        <option value="oldest">오래된순</option>
                        <option value="number_low">번호 낮은순</option>
                        <option value="number_high">번호 높은순</option>
                        <option value="first_member">첫 멤버</option>
                        <option value="last_member">마지막 멤버</option>
                        <option value="mint_low">민팅 적은순</option>
                        <option value="mint_high">민팅 많은순</option>
                    </select>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </label>
                </div>
                <div id="sort-menu" class="objekt-dropdown-menu hidden absolute top-full left-0 mt-2 min-w-[10rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" role="listbox" aria-label="정렬 목록"></div>
            </div>

            <div class="objekt-search-row">
                <div class="objekt-search">
                    <span class="material-symbols-outlined text-[#6ee7d8] text-xl pointer-events-none" aria-hidden="true">search</span>
                    <label class="w-full min-w-0">
                        <input type="search" name="search" value="{{searchQuery}}" placeholder="전체 오브젝트에서 검색..." aria-label="전체 오브젝트 검색" autocomplete="off" class="objekt-search-input">
                    </label>
                </div>
                <button type="submit" id="objekt-search-submit" class="objekt-search-button">
                    <span class="material-symbols-outlined text-lg" aria-hidden="true">search</span>
                    검색
                </button>
                <button type="button" id="objekt-reset" class="objekt-reset-button">
                    <span class="material-symbols-outlined text-lg" aria-hidden="true">restart_alt</span>
                    초기화
                </button>
            </div>

        </div>
        </div>
        </form>
    </section>

    <div class="mt-5 flex items-center justify-between gap-3 px-1">
        <p id="objekt-result-summary" class="text-sm text-slate-400"
           data-result-count="{{objektCount}}" data-all-count="{{objektAllCount}}" data-loaded="{{objektPageCount}}">
            검색 결과 <strong class="text-[#00f5d4]">{{objektCount}}</strong>개
            <span class="text-slate-500">(전체 {{objektAllCount}}개 중 · <span id="objekt-loaded-count">{{objektPageCount}}</span>개 표시)</span>
        </p>
    </div>
    {{#objektError}}
    <div class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">{{objektError}}</div>
    {{/objektError}}
    <div id="objekt-empty" class="hidden mt-8 rounded-2xl border border-white/10 bg-white/[0.03] p-10 text-center text-slate-400">검색 조건에 맞는 오브젝트가 없습니다.</div>
    <div id="objekt-card-grid" class="objekt-card-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 py-2 mt-3">
        {{#objekts}}
        <article class="objekt-card objekt-item group relative border rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1"
                 data-objekt-key="{{id}}"
                 data-season="{{seasonKey}}" data-class="{{classKey}}" data-artist="{{artist}}" data-collection-no="{{collectionNo}}"
                 data-number="{{numberValue}}" data-date="{{createdAt}}" data-member="{{member}}" data-search="{{searchText}}">
            <button type="button" class="objekt-open-detail relative block aspect-[2/3] w-full overflow-hidden bg-[#1c1f2e]" aria-label="{{collectionId}} 상세 보기">
                <img src="{{thumbnailImage}}" alt="{{collectionId}}" loading="lazy" class="objekt-image h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" onerror="this.onerror=null;this.src='{{frontImage}}';">
                <span class="absolute left-2 top-2 rounded-md border border-white/15 bg-black/65 px-2 py-1 text-[10px] font-semibold text-white backdrop-blur">{{class}}</span>
                <span class="absolute right-2 top-2 rounded-md bg-[#00e8cb] px-2 py-1 text-[10px] font-bold text-[#071513]">{{season}}</span>
            </button>
            <div class="p-3">
                <a href="/cosmo/objekt/detail/{{id}}" class="objekt-detail-link block truncate text-sm font-semibold text-slate-100 hover:text-[#00f5d4]" title="{{collectionId}}">{{collectionId}}</a>
                <div class="mt-1 flex items-center justify-between gap-2 text-xs text-slate-400">
                    <a href="/cosmo/objekt/member?name={{member}}" class="objekt-member-chip truncate text-teal-200 hover:underline">{{member}}</a><span class="shrink-0 font-mono">{{collectionNo}}</span>
                </div>
                {{#mintCountKnown}}<p class="mt-2 text-xs text-slate-300">발행량 {{mintCount}}개</p>{{/mintCountKnown}}
            </div>
        </article>
        {{/objekts}}
    </div>
    <div id="objekt-scroll-sentinel" class="flex flex-col items-center justify-center gap-2 py-8" aria-live="polite"
         data-has-more="{{#hasNextPage}}true{{/hasNextPage}}{{^hasNextPage}}false{{/hasNextPage}}"
         data-next-page="{{nextPage}}">
        <p id="objekt-scroll-status" class="text-sm text-slate-500">{{#hasNextPage}}스크롤하면 더 불러옵니다{{/hasNextPage}}{{^hasNextPage}}{{#objektCount}}모두 불러왔습니다{{/objektCount}}{{/hasNextPage}}</p>
        <div id="objekt-scroll-spinner" class="hidden h-6 w-6 animate-spin rounded-full border-2 border-[#00f5d4]/30 border-t-[#00f5d4]" aria-hidden="true"></div>
    </div>
</main>

<div id="objektDetailModal" class="objekt-detail-modal" hidden aria-hidden="true">
        <div class="objekt-detail-panel" role="dialog" aria-modal="true" aria-labelledby="objektDetailTitle" tabindex="-1">
        <button type="button" class="objekt-detail-close" id="objektDetailClose" aria-label="닫기">&times;</button>
        <figure class="objekt-detail-media">
            <button type="button" class="objekt-detail-media-btn" id="objektDetailFlip" aria-label="앞면">
                <img id="objektDetailImage" src="" alt="" data-front="" data-back="" data-showing-back="false">
                <span class="objekt-detail-face" id="objektDetailFace">앞면</span>
            </button>
        </figure>
        <div class="objekt-detail-body">
            <div>
                <p class="objekt-detail-kicker">OBJEKT</p>
                <h2 class="objekt-detail-title" id="objektDetailTitle">—</h2>
            </div>
            <dl class="objekt-detail-meta">
                <div><dt>멤버</dt><dd id="objektDetailMember">—</dd></div>
                <div><dt>시즌</dt><dd id="objektDetailSeason">—</dd></div>
                <div><dt>클래스</dt><dd id="objektDetailClass">—</dd></div>
                <div><dt>번호</dt><dd id="objektDetailNo">—</dd></div>
            </dl>
            <p class="objekt-detail-desc is-empty" id="objektDetailDesc">불러오는 중…</p>
            <details id="objektDescriptionEditor" class="objekt-description-editor" hidden>
                <summary>관리자 · 상세 설명 편집</summary>
                <form id="objektDescriptionForm">
                    <label for="objektModalDescription">상세 설명</label>
                    <textarea id="objektModalDescription" name="description" rows="4" maxlength="10000" placeholder="상세 설명을 입력해 주세요."></textarea>
                    <div class="objekt-description-buttons"><button type="submit">저장</button><button type="button" id="objektDescriptionDelete">설명 삭제</button></div>
                    <p id="objektDescriptionStatus" role="status" aria-live="polite"></p>
                </form>
            </details>
            <div class="objekt-detail-actions">
                <button type="button" class="objekt-fav-toggle" id="objektDetailFavorite">♡ 찜하기</button>
                <a class="objekt-member-link" id="objektDetailMemberLink" href="/cosmo/objekt">이 멤버의 오브젝트 더 보기</a>
                <a class="objekt-trade-link" id="objektDetailTradeLink" href="/article/trade/new">교환 게시글 작성</a>
                <a class="objekt-member-link" id="objektDetailSellLink" href="/article/sell/new">거래 게시글 작성</a>
                <a class="objekt-full-link" id="objektDetailFullLink" href="/cosmo/objekt">상세 페이지 보기</a>
            </div>
        </div>
    </div>
</div>

<script src="/js/member-portrait-picker.js?v=4"></script>
<script>
(() => {
    const form = document.getElementById('objekt-search-form');
    const kindSelect = document.querySelector('.objekt-kind-select');
    const sortSelect = document.querySelector('.objekt-sort-select');
    const sortToggle = document.getElementById('objekt-sort-toggle');
    const sortMenu = document.getElementById('sort-menu');
    const sortLabel = document.getElementById('sort-label');

    function closeSortMenu() {
        sortMenu.classList.add('hidden');
        sortToggle.setAttribute('aria-expanded', 'false');
    }

    function syncSortMenu() {
        sortLabel.textContent = sortSelect.selectedOptions[0].textContent;
        sortMenu.querySelectorAll('[role="option"]').forEach((option) => {
            const selected = option.dataset.value === sortSelect.value;
            option.classList.toggle('is-active', selected);
            option.setAttribute('aria-selected', String(selected));
            option.tabIndex = selected ? 0 : -1;
        });
    }

    function openSortMenu(index) {
        closeKindMenu();
        ['season-menu', 'class-menu'].forEach(id => document.getElementById(id)?.classList.add('hidden'));
        sortMenu.classList.remove('hidden');
        sortToggle.setAttribute('aria-expanded', 'true');
        const options = [...sortMenu.querySelectorAll('[role="option"]')];
        const focusIndex = index ?? options.findIndex(option => option.dataset.value === sortSelect.value);
        options.forEach((option, i) => { option.tabIndex = i === focusIndex ? 0 : -1; });
        options[focusIndex]?.focus();
    }

    [...sortSelect.options].forEach((option) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'objekt-kind-option';
        button.dataset.value = option.value;
        button.textContent = option.textContent;
        button.setAttribute('role', 'option');
        button.addEventListener('click', () => {
            const changed = sortSelect.value !== option.value;
            sortSelect.value = option.value;
            syncSortMenu();
            closeSortMenu();
            sortToggle.focus();
            if (changed) sortSelect.dispatchEvent(new Event('change', { bubbles: true }));
        });
        sortMenu.appendChild(button);
    });

    sortToggle.addEventListener('click', () => {
        if (sortMenu.classList.contains('hidden')) openSortMenu();
        else closeSortMenu();
    });
    document.getElementById('sort-dropdown').addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            event.preventDefault();
            closeSortMenu();
            sortToggle.focus();
        } else if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
            event.preventDefault();
            const options = [...sortMenu.querySelectorAll('[role="option"]')];
            const current = options.indexOf(document.activeElement);
            const selected = options.findIndex(option => option.dataset.value === sortSelect.value);
            const index = event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1
                : current < 0 ? selected
                : (current + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
            openSortMenu(index);
        } else if (event.key === 'Tab') {
            closeSortMenu();
            sortToggle.focus();
        }
    });
    document.getElementById('sort-dropdown').addEventListener('focusout', (event) => {
        if (!event.currentTarget.contains(event.relatedTarget)) closeSortMenu();
    });
    const cards = Array.from(document.querySelectorAll('.objekt-item'));
    const empty = document.getElementById('objekt-empty');
    const memberRoot = document.getElementById('member-dropdown');
    const memberLabel = document.getElementById('member-label');

    const params = new URLSearchParams(window.location.search);
    const kindMenu = document.getElementById('kind-menu');
    const kindToggle = document.getElementById('objekt-kind-toggle');
    const kindEmpty = document.getElementById('kind-empty');
    const kindOptions = kindMenu ? [...kindMenu.querySelectorAll('.objekt-kind-option')] : [];
    let kindActiveIndex = -1;

    function normalizeKindValue(raw) {
        const value = String(raw || '').trim();
        if (!value || value.toLowerCase() === 'all') return 'all';
        return value.toUpperCase();
    }

    function setKindValue(raw) {
        if (!kindSelect) return;
        kindSelect.value = normalizeKindValue(raw);
        markActiveFilters();
    }

    function filterKindOptions(query) {
        const q = normalizeKindValue(query);
        const needle = q === 'all' ? '' : q.toLowerCase();
        let shown = 0;
        kindOptions.forEach((opt) => {
            const value = String(opt.dataset.value || '').toLowerCase();
            const match = !needle || value.includes(needle);
            opt.hidden = !match;
            if (match) shown += 1;
        });
        if (kindEmpty) kindEmpty.hidden = shown > 0;
        kindActiveIndex = -1;
        kindOptions.forEach((opt) => opt.classList.remove('is-active'));
        return shown;
    }

    function openKindMenu(showAll) {
        if (!kindMenu || !kindSelect) return;
        closeSortMenu();
        filterKindOptions(showAll ? '' : kindSelect.value);
        kindMenu.classList.remove('hidden');
        kindSelect.setAttribute('aria-expanded', 'true');
        document.getElementById('season-menu')?.classList.add('hidden');
        document.getElementById('class-menu')?.classList.add('hidden');
    }

    function closeKindMenu() {
        if (!kindMenu || !kindSelect) return;
        kindMenu.classList.add('hidden');
        kindSelect.setAttribute('aria-expanded', 'false');
        kindActiveIndex = -1;
        kindOptions.forEach((opt) => opt.classList.remove('is-active'));
    }

    function visibleKindOptions() {
        return kindOptions.filter((opt) => !opt.hidden);
    }

    function moveKindActive(delta) {
        const visible = visibleKindOptions();
        if (!visible.length) return;
        kindActiveIndex = (kindActiveIndex + delta + visible.length) % visible.length;
        visible.forEach((opt, i) => opt.classList.toggle('is-active', i === kindActiveIndex));
        visible[kindActiveIndex]?.scrollIntoView({ block: 'nearest' });
    }

    const initialKind = normalizeKindValue(params.get('kind') || kindSelect?.value || 'all');
    if (kindSelect) kindSelect.value = initialKind;
    sortSelect.value = params.get('sort') || 'latest';
    if (!sortSelect.value) sortSelect.value = 'latest';
    syncSortMenu();
    sortSelect.addEventListener('change', syncSortMenu);
    document.getElementById('sort-native-control').hidden = true;
    sortToggle.hidden = false;

    if (kindSelect && kindMenu) {
        kindSelect.addEventListener('focus', () => openKindMenu(false));
        kindSelect.addEventListener('click', () => openKindMenu(false));
        kindSelect.addEventListener('input', () => {
            openKindMenu(false);
            markActiveFilters();
        });
        kindSelect.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (kindMenu.classList.contains('hidden')) openKindMenu(false);
                else moveKindActive(1);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (kindMenu.classList.contains('hidden')) openKindMenu(false);
                else moveKindActive(-1);
            } else if (e.key === 'Enter') {
                e.preventDefault();
                const visible = visibleKindOptions().filter((opt) => opt.dataset.value !== 'all');
                if (!kindMenu.classList.contains('hidden') && kindActiveIndex >= 0) {
                    const allVisible = visibleKindOptions();
                    if (allVisible[kindActiveIndex]) {
                        setKindValue(allVisible[kindActiveIndex].dataset.value);
                        closeKindMenu();
                        return;
                    }
                }
                const typed = normalizeKindValue(kindSelect.value);
                const exact = kindOptions.find((opt) => normalizeKindValue(opt.dataset.value) === typed);
                if (exact) setKindValue(exact.dataset.value);
                else if (visible.length === 1) setKindValue(visible[0].dataset.value);
                else setKindValue(typed);
                closeKindMenu();
            } else if (e.key === 'Escape') {
                closeKindMenu();
            }
        });
        kindSelect.addEventListener('blur', () => {
            // 옵션 클릭이 blur보다 먼저 처리되도록 약간 지연
            setTimeout(() => {
                if (!kindMenu.contains(document.activeElement) && document.activeElement !== kindToggle) {
                    setKindValue(kindSelect.value);
                    closeKindMenu();
                }
            }, 120);
        });
        kindToggle?.addEventListener('mousedown', (e) => e.preventDefault());
        kindToggle?.addEventListener('click', () => {
            if (kindMenu.classList.contains('hidden')) {
                kindSelect.focus();
                openKindMenu(true);
            } else {
                closeKindMenu();
            }
        });
        kindOptions.forEach((opt) => {
            opt.addEventListener('mousedown', (e) => e.preventDefault());
            opt.addEventListener('click', () => {
                setKindValue(opt.dataset.value);
                closeKindMenu();
            });
        });
    }

    function updateDropdownLabel(type) {
        const checks = [...document.querySelectorAll(`.${type}-checkbox:checked`)];
        const all = document.querySelector(`.${type}-checkbox[value="all"]`);
        const target = document.getElementById(`${type}-label`);
        if (!target) return;
        const chosen = checks.filter(cb => cb !== all);
        const labelOf = (box) => box.closest('label')?.querySelector('.objekt-choice-text')?.textContent.trim() || '';
        if (!chosen.length || (all && all.checked)) target.textContent = '전체';
        else if (chosen.length === 1) target.textContent = labelOf(chosen[0]);
        else target.textContent = `${labelOf(chosen[0])} 외 ${chosen.length - 1}개`;
    }

    const memberGroupInput = document.getElementById('objekt-member-group');
    function syncMemberGroup() {
        const group = memberGroupInput.value;
        document.querySelectorAll('[data-objekt-group]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.objektGroup === group)));
        document.getElementById('objekt-member-picker').hidden = group === 'other';
        document.getElementById('objekt-other-notice').hidden = group !== 'other';
        const memberToggle = document.getElementById('objekt-member-toggle');
        if (memberToggle) memberToggle.hidden = group === 'other';
    }
    function syncMemberLabel() {
        const chosen = [...document.querySelectorAll('.member-checkbox:checked')];
        if (!memberLabel) return;
        if (!chosen.length) {
            memberLabel.textContent = memberGroupInput.value === 'other' ? '기타 옵젝' : memberGroupInput.value === 'members' ? '전체 멤버' : '전체 오브젝트';
            return;
        }
        const first = chosen[0].value;
        memberLabel.textContent = chosen.length === 1
            ? first
            : `${first} 외 ${chosen.length - 1}명`;
    }

    function syncMemberChecks(values, { apply = false } = {}) {
        if (apply) memberGroupInput.value = 'members';
        const selected = new Set((values || []).map(v => String(v).toLocaleLowerCase()));
        document.querySelectorAll('.member-checkbox').forEach((cb) => {
            cb.checked = selected.has(String(cb.value).toLocaleLowerCase());
        });
        syncMemberGroup();
        syncMemberLabel();
        if (typeof markActiveFilters === 'function') markActiveFilters();
    }

    // 멤버 초상화 다중선택
    const selectedMembers = [...document.querySelectorAll('.member-checkbox:checked')].map(box => box.value);
    if (window.MemberPortraitPicker && memberRoot) {
        MemberPortraitPicker.bindMultiSelect(memberRoot, {
            multi: true,
            onChange: (values) => syncMemberChecks(values, { apply: true })
        });
        memberRoot.querySelectorAll('.mpp-item').forEach((btn) => {
            const value = (btn.dataset.value || '').toLocaleLowerCase();
            const active = selectedMembers.some(v => String(v).toLocaleLowerCase() === value);
            MemberPortraitPicker.setActive(btn, active);
        });
        syncMemberChecks(
            MemberPortraitPicker.selectedValues(memberRoot)
        );
    } else {
        syncMemberGroup(); syncMemberLabel();
    }

    const memberToggle = document.getElementById('objekt-member-toggle');
    function setMemberPickerOpen(open) {
        memberRoot.classList.toggle('is-collapsed', !open);
        if (memberToggle) {
            memberToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
    }
    setMemberPickerOpen(selectedMembers.length > 0 || memberGroupInput.value === 'members');
    document.querySelectorAll('[data-objekt-group]').forEach(button => button.addEventListener('click', () => {
        const group = button.dataset.objektGroup;
        memberGroupInput.value = group;
        if (group !== 'members') {
            window.MemberPortraitPicker?.clear(memberRoot);
            syncMemberChecks([]);
        } else { syncMemberGroup(); syncMemberLabel(); }
        setMemberPickerOpen(group === 'members');
        markActiveFilters();
    }));
    memberToggle?.addEventListener('click', () => {
        if (memberGroupInput.value === 'other') {
            memberGroupInput.value = 'members'; syncMemberGroup(); syncMemberLabel();
            setMemberPickerOpen(true); markActiveFilters(); return;
        }
        setMemberPickerOpen(memberRoot.classList.contains('is-collapsed'));
    });

    // 시즌·클래스 드롭다운 (기존 다중선택 유지)
    ['season', 'class'].forEach(type => {
        const selected = params.getAll(type).map(v => v.toLocaleLowerCase());
        const boxes = [...document.querySelectorAll(`.${type}-checkbox`)];
        boxes.forEach(cb => {
            if (cb.value === 'all') return;
            cb.checked = selected.includes(cb.value.toLocaleLowerCase());
        });
        const all = document.querySelector(`.${type}-checkbox[value="all"]`);
        if (all) all.checked = selected.length === 0;
        boxes.forEach(cb => cb.addEventListener('change', () => {
            if (cb.value === 'all' && cb.checked) {
                boxes.forEach(other => { if (other !== cb) other.checked = false; });
            } else if (cb.value !== 'all' && cb.checked && all) {
                all.checked = false;
            }
            const chosen = boxes.some(other => other.value !== 'all' && other.checked);
            if (all && !chosen) all.checked = true;
            updateDropdownLabel(type);
            markActiveFilters();
        }));
        updateDropdownLabel(type);
    });

    function markActiveFilters() {
        const seasonText = document.getElementById('season-label')?.textContent.trim();
        document.getElementById('season-dropdown')?.classList.toggle('is-filtered', !!seasonText && seasonText !== '전체');
        const classText = document.getElementById('class-label')?.textContent.trim();
        document.getElementById('class-dropdown')?.classList.toggle('is-filtered', !!classText && classText !== '전체');
        const kindValue = normalizeKindValue(kindSelect?.value);
        kindSelect?.closest('.objekt-filter')?.classList.toggle('is-filtered', kindValue !== 'all');
        sortSelect.closest('.objekt-filter')?.classList.toggle('is-filtered', sortSelect.value && sortSelect.value !== 'latest');
        const searchValue = (form.querySelector('input[name="search"]')?.value || '').trim();
        document.querySelector('.objekt-search')?.classList.toggle('is-filtered', searchValue.length > 0);
        const memberOn = memberGroupInput.value !== 'all' || document.querySelectorAll('.member-checkbox:checked').length > 0;
        memberRoot?.classList.toggle('is-filtered', memberOn);
    }
    markActiveFilters();
    form.addEventListener('change', () => {
        markActiveFilters();
    });

    window.toggleDropdown = function(id) {
        closeKindMenu();
        closeSortMenu();
        document.querySelectorAll('[id$="-menu"]').forEach(menu => {
            if (menu.id !== id) menu.classList.add('hidden');
        });
        document.getElementById(id)?.classList.toggle('hidden');
    };

    window.addEventListener('click', e => {
        if (!e.target.closest('#sort-dropdown')) closeSortMenu();
        if (!e.target.closest('#season-dropdown') && !e.target.closest('#class-dropdown') && !e.target.closest('#kind-dropdown')) {
            ['season-menu', 'class-menu'].forEach(id => document.getElementById(id)?.classList.add('hidden'));
            closeKindMenu();
        }
    });

    form.addEventListener('submit', () => {
        const page = form.querySelector('input[name="page"]');
        if (page) page.value = '0';
        if (kindSelect) kindSelect.value = normalizeKindValue(kindSelect.value);
        // 미선택(전체)일 때는 member 파라미터를 보내지 않는다.
        document.querySelectorAll('.member-checkbox').forEach((cb) => {
            if (!cb.checked) cb.disabled = true;
        });
    });

    document.getElementById('objekt-reset').addEventListener('click', () => {
        window.location.href = '/cosmo/objekt';
    });

    const grid = document.getElementById('objekt-card-grid');
    const summary = document.getElementById('objekt-result-summary');
    const loadedEl = document.getElementById('objekt-loaded-count');
    const sentinel = document.getElementById('objekt-scroll-sentinel');
    const statusEl = document.getElementById('objekt-scroll-status');
    const spinner = document.getElementById('objekt-scroll-spinner');

    let loadedCount = Number(summary?.dataset.loaded || cards.length || 0);
    let resultCount = Number(summary?.dataset.resultCount || 0);
    let allCount = Number(summary?.dataset.allCount || 0);
    let nextPage = Number(sentinel?.dataset.nextPage || 1);
    let hasMore = sentinel?.dataset.hasMore === 'true';
    let loading = false;

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function attr(value) {
        return escapeHtml(value);
    }

    const detailModal = document.getElementById('objektDetailModal');
    const detailImage = document.getElementById('objektDetailImage');
    const detailFlip = document.getElementById('objektDetailFlip');
    const detailFace = document.getElementById('objektDetailFace');
    const detailTitle = document.getElementById('objektDetailTitle');
    const detailMember = document.getElementById('objektDetailMember');
    const detailSeason = document.getElementById('objektDetailSeason');
    const detailClass = document.getElementById('objektDetailClass');
    const detailNo = document.getElementById('objektDetailNo');
    const detailDesc = document.getElementById('objektDetailDesc');
    const detailFavorite = document.getElementById('objektDetailFavorite');
    const detailMemberLink = document.getElementById('objektDetailMemberLink');
    const detailFullLink = document.getElementById('objektDetailFullLink');
    const detailClose = document.getElementById('objektDetailClose');
    const detailTradeLink = document.getElementById('objektDetailTradeLink');
    const detailSellLink = document.getElementById('objektDetailSellLink');
    const descriptionEditor = document.getElementById('objektDescriptionEditor');
    const descriptionForm = document.getElementById('objektDescriptionForm');
    const descriptionInput = document.getElementById('objektModalDescription');
    const descriptionStatus = document.getElementById('objektDescriptionStatus');
    const descriptionDelete = document.getElementById('objektDescriptionDelete');
    let descriptionUrl = '', descriptionSaving = false, detailRequest = 0;
    let activeObjektKey = '';
    let detailLoading = false;

    function csrfHeaders(extra) {
        const headers = new Headers(extra || {});
        headers.set('Accept', 'application/json');
        if (window.AboutAdminAuth && typeof window.AboutAdminAuth.applyAuthHeaders === 'function') {
            return window.AboutAdminAuth.applyAuthHeaders(headers);
        }
        const match = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/);
        if (match) headers.set('X-XSRF-TOKEN', decodeURIComponent(match[1]));
        return headers;
    }

    function setFavoriteButton(on) {
        if (!detailFavorite) return;
        detailFavorite.classList.toggle('is-on', Boolean(on));
        detailFavorite.textContent = on ? '♥ 찜 해제' : '♡ 찜하기';
        detailFavorite.dataset.favorite = on ? 'true' : 'false';
    }

    function resetModalFlip(front, back, hasBack) {
        if (!detailImage || !detailFlip || !detailFace) return;
        const frontUrl = front || '';
        const backUrl = hasBack ? (back || '') : '';
        detailImage.dataset.front = frontUrl;
        detailImage.dataset.back = backUrl;
        detailImage.dataset.showingBack = 'false';
        detailImage.src = frontUrl;
        detailFace.textContent = '앞면';
        detailFlip.disabled = !hasBack;
        detailFlip.classList.toggle('is-flippable', Boolean(hasBack));
        detailFlip.setAttribute('aria-label', hasBack ? '이미지 클릭 시 뒷면으로 전환' : '앞면');
    }

    function flipModalImage() {
        if (!detailImage || !detailFlip || detailFlip.disabled) return;
        const showingBack = detailImage.dataset.showingBack === 'true';
        const next = showingBack ? detailImage.dataset.front : detailImage.dataset.back;
        if (!next) return;
        detailImage.src = next;
        detailImage.dataset.showingBack = showingBack ? 'false' : 'true';
        if (detailFace) detailFace.textContent = showingBack ? '앞면' : '뒷면';
        detailFlip.setAttribute('aria-label', showingBack ? '이미지 클릭 시 뒷면으로 전환' : '이미지 클릭 시 앞면으로 전환');
    }

    function fillDetailModal(data) {
        const key = data.objektKey || data.id || activeObjektKey;
        activeObjektKey = key;
        if (detailTitle) detailTitle.textContent = data.collectionId || '—';
        if (detailMember) detailMember.textContent = data.member || '—';
        if (detailSeason) detailSeason.textContent = data.season || '—';
        if (detailClass) detailClass.textContent = data.class || '—';
        if (detailNo) detailNo.textContent = data.collectionNo || '—';
        if (detailDesc) {
            const text = (data.description || '').trim();
            detailDesc.textContent = text || '아직 등록된 상세 설명이 없습니다.';
            detailDesc.classList.toggle('is-empty', !text);
        }
        if (detailImage) detailImage.alt = data.collectionId || '';
        resetModalFlip(data.frontImage || data.thumbnailImage || '', data.backImage || '', Boolean(data.hasBack));
        setFavoriteButton(Boolean(data.isFavorite));
        if (detailMemberLink) detailMemberLink.href = data.memberUrl || '/cosmo/objekt';
        if (detailFullLink) detailFullLink.href = data.detailUrl || ('/cosmo/objekt/detail/' + encodeURIComponent(key));
        if (detailFavorite) detailFavorite.dataset.key = key;
        if (detailTradeLink) detailTradeLink.href = data.tradeUrl || '/article/trade/new';
        if (detailSellLink) detailSellLink.href = data.sellUrl || '/article/sell/new';
        descriptionEditor.hidden = !data.isAdmin;
        descriptionEditor.open = false;
        descriptionInput.value = data.description || '';
        descriptionStatus.textContent = '';
        descriptionUrl = data.descriptionUrl || '';

    }

    function closeDetailModal() {
        if (!detailModal) return;
        detailModal.classList.remove('is-open');
        if (window.AboutModal) {
            window.AboutModal.closeModal(detailModal);
        } else {
            detailModal.hidden = true;
            detailModal.classList.remove('flex');
            document.body.style.overflow = '';
        }
        detailModal.setAttribute('aria-hidden', 'true');
        activeObjektKey = ''; detailRequest++;
    }

    function openDetailModalShell() {
        if (!detailModal) return;
        detailModal.hidden = false;
        detailModal.classList.add('is-open');
        detailModal.setAttribute('aria-hidden', 'false');
        if (window.AboutModal) {
            window.AboutModal.openModal(detailModal, { focusSelector: '#objektDetailClose' });
            detailModal.classList.add('is-open');
        } else {
            detailModal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            detailClose?.focus();
        }
    }

    async function openObjektDetail(key) {
        if (!key || detailLoading) return;
        detailLoading = true;
        const request = ++detailRequest;
        descriptionEditor.hidden = true;
        openDetailModalShell();
        if (detailDesc) {
            detailDesc.textContent = '불러오는 중…';
            detailDesc.classList.add('is-empty');
        }
        if (detailTitle) detailTitle.textContent = '불러오는 중…';
        try {
            const res = await fetch('/cosmo/objekt/detail/' + encodeURIComponent(key), {
                headers: csrfHeaders({ Accept: 'application/json' }),
                credentials: 'same-origin',
                cache: 'no-store'
            });
            if (!res.ok) throw new Error('detail failed');
            const data = await res.json();
            if (request === detailRequest) fillDetailModal(data);
        } catch (_) {
            if (detailDesc) {
                detailDesc.textContent = '상세 정보를 불러오지 못했습니다.';
                detailDesc.classList.add('is-empty');
            }
        } finally {
            detailLoading = false;
        }
    }

    async function saveModalDescription(clear) {
        if (descriptionSaving || !descriptionUrl || descriptionEditor.hidden) return;
        if (clear && !window.confirm('이 오브젝트의 상세 설명을 삭제하시겠습니까?')) return;
        if (!clear && !descriptionForm.reportValidity()) return;
        const key = activeObjektKey;
        descriptionSaving = true;
        const buttons = descriptionForm.querySelectorAll('button');
        buttons.forEach(button => button.disabled = true);
        descriptionStatus.textContent = clear ? '삭제 중…' : '저장 중…';
        try {
            const response = await fetch(descriptionUrl, {
                method: 'POST', headers: csrfHeaders(), credentials: 'same-origin',
                body: new URLSearchParams({description: clear ? '' : descriptionInput.value})
            });
            if (!response.ok) throw new Error();
            const data = await response.json();
            if (typeof data.description !== 'string') throw new Error();
            if (activeObjektKey !== key) return;
            descriptionInput.value = data.description;
            detailDesc.textContent = data.description || '아직 등록된 상세 설명이 없습니다.';
            detailDesc.classList.toggle('is-empty', !data.description);
            descriptionStatus.textContent = clear ? '상세 설명을 삭제했습니다.' : '상세 설명을 저장했습니다.';
        } catch {
            if (activeObjektKey === key) descriptionStatus.textContent = '저장하지 못했습니다. 관리자 로그인 상태를 확인한 뒤 다시 시도해 주세요.';
        } finally {
            descriptionSaving = false; buttons.forEach(button => button.disabled = false);
        }
    }
    descriptionForm?.addEventListener('submit', event => { event.preventDefault(); saveModalDescription(false); });
    descriptionDelete?.addEventListener('click', () => saveModalDescription(true));

    function shouldOpenModalFromEvent(event) {
        if (event.defaultPrevented) return false;
        if (event.button != null && event.button !== 0) return false;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
        return true;
    }

    grid?.addEventListener('click', (event) => {
        const memberChip = event.target.closest('.objekt-member-chip');
        if (memberChip) return;
        const card = event.target.closest('.objekt-card[data-objekt-key]');
        if (!card) return;
        const openHit = event.target.closest('.objekt-open-detail, .objekt-detail-link');
        if (!openHit && !event.target.closest('.objekt-card')) return;
        if (!openHit) return;
        if (!shouldOpenModalFromEvent(event)) return;
        event.preventDefault();
        openObjektDetail(card.dataset.objektKey);
    });

    detailClose?.addEventListener('click', closeDetailModal);
    detailModal?.addEventListener('click', (event) => {
        if (event.target === detailModal) closeDetailModal();
    });
    detailFlip?.addEventListener('click', flipModalImage);
    detailFavorite?.addEventListener('click', async () => {
        const key = detailFavorite.dataset.key || activeObjektKey;
        if (!key) return;
        detailFavorite.disabled = true;
        try {
            const res = await fetch('/cosmo/objekt/detail/' + encodeURIComponent(key) + '/favorite', {
                method: 'POST',
                headers: csrfHeaders({ Accept: 'application/json' }),
                credentials: 'same-origin'
            });
            if (!res.ok) throw new Error('favorite failed');
            const data = await res.json();
            setFavoriteButton(Boolean(data.isFavorite));
        } catch (_) {
            /* keep previous state */
        } finally {
            detailFavorite.disabled = false;
        }
    });

    function updateSummary() {
        if (loadedEl) loadedEl.textContent = String(loadedCount);
        if (empty) empty.classList.toggle('hidden', loadedCount > 0);
        if (!statusEl) return;
        if (loading) statusEl.textContent = '불러오는 중…';
        else if (hasMore) statusEl.textContent = '스크롤하면 더 불러옵니다';
        else if (loadedCount > 0) statusEl.textContent = `모두 불러왔습니다 · ${loadedCount} / ${resultCount}`;
        else statusEl.textContent = '';
        spinner?.classList.toggle('hidden', !loading);
    }

    function buildCard(item) {
        const collectionId = item.collectionId || '';
        const member = item.member || item.memberName || '';
        const collectionNo = item.collectionNo || item.collectionNumber || '';
        const id = item.id || '';
        const thumb = item.thumbnailImage || item.frontImage || '';
        const front = item.frontImage || thumb;
        const klass = item.class || item.classKey || '';
        const season = item.season || item.seasonKey || '';
        return `<article class="objekt-card objekt-item group relative border rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1"
                 data-objekt-key="${attr(id)}"
                 data-season="${attr(item.seasonKey || season)}" data-class="${attr(item.classKey || klass)}" data-artist="${attr(item.artist || '')}" data-collection-no="${attr(collectionNo)}"
                 data-number="${attr(item.numberValue || '')}" data-date="${attr(item.createdAt || '')}" data-member="${attr(member)}" data-search="${attr(item.searchText || '')}">
            <button type="button" class="objekt-open-detail relative block aspect-[2/3] w-full overflow-hidden bg-[#1c1f2e]" aria-label="${attr(collectionId)} 상세 보기">
                <img src="${attr(thumb)}" alt="${attr(collectionId)}" loading="lazy" decoding="async" class="objekt-image h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" onerror="this.onerror=null;this.src='${attr(front)}';">
                <span class="absolute left-2 top-2 rounded-md border border-white/15 bg-black/65 px-2 py-1 text-[10px] font-semibold text-white backdrop-blur">${escapeHtml(klass)}</span>
                <span class="absolute right-2 top-2 rounded-md bg-[#00e8cb] px-2 py-1 text-[10px] font-bold text-[#071513]">${escapeHtml(season)}</span>
            </button>
            <div class="p-3">
                <a href="/cosmo/objekt/detail/${attr(id)}" class="objekt-detail-link block truncate text-sm font-semibold text-slate-100 hover:text-[#00f5d4]" title="${attr(collectionId)}">${escapeHtml(collectionId)}</a>
                <div class="mt-1 flex items-center justify-between gap-2 text-xs text-slate-400">
                    <a href="/cosmo/objekt/member?name=${encodeURIComponent(member)}" class="objekt-member-chip truncate text-teal-200 hover:underline">${escapeHtml(member)}</a><span class="shrink-0 font-mono">${escapeHtml(collectionNo)}</span>
                </div>
                ${Number.isFinite(item.mintCount) ? `<p class="mt-2 text-xs text-slate-300">발행량 ${escapeHtml(String(item.mintCount))}개</p>` : ''}
            </div>
        </article>`;
    }

    function currentFilterParams() {
        const params = new URLSearchParams(new FormData(form));
        params.delete('page');
        // FormData에 미체크 member가 없을 수 있음 — 체크된 것만 유지
        return params;
    }

    async function loadMore() {
        if (!hasMore || loading || !grid) return;
        loading = true;
        updateSummary();
        try {
            const params = currentFilterParams();
            params.set('page', String(nextPage));
            const res = await fetch(`/cosmo/objekt/more?${params.toString()}`, {
                headers: { Accept: 'application/json' },
                credentials: 'same-origin',
                cache: 'no-store'
            });
            if (!res.ok) throw new Error('load failed');
            const data = await res.json();
            const items = Array.isArray(data.items) ? data.items : [];
            if (items.length) {
                const wrap = document.createElement('div');
                wrap.innerHTML = items.map(buildCard).join('');
                const fragment = document.createDocumentFragment();
                while (wrap.firstChild) fragment.appendChild(wrap.firstChild);
                grid.appendChild(fragment);
            }
            loadedCount += items.length;
            resultCount = Number(data.resultCount ?? resultCount);
            allCount = Number(data.allCount ?? allCount);
            hasMore = Boolean(data.hasMore) && items.length > 0;
            nextPage = data.nextPage == null ? nextPage + 1 : Number(data.nextPage);
            if (summary) {
                summary.dataset.loaded = String(loadedCount);
                summary.dataset.resultCount = String(resultCount);
                summary.dataset.allCount = String(allCount);
            }
        } catch (_) {
            hasMore = false;
            if (statusEl) statusEl.textContent = '더 불러오지 못했습니다. 잠시 후 다시 스크롤해 주세요.';
        } finally {
            loading = false;
            updateSummary();
        }
    }

    if (empty) empty.classList.toggle('hidden', cards.length > 0);
    updateSummary();

    if (sentinel && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
            if (entries.some((entry) => entry.isIntersecting)) loadMore();
        }, { rootMargin: '400px 0px' });
        io.observe(sentinel);
    } else if (hasMore) {
        // 구형 브라우저: 수동 버튼으로 대체
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'rounded-lg border border-slate-600 px-4 py-2 text-sm text-white hover:border-teal-400';
        btn.textContent = '더 보기';
        btn.addEventListener('click', loadMore);
        sentinel?.appendChild(btn);
    }
})();
</script>
</body>
</html>
