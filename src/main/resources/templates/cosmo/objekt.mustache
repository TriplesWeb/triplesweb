{{>layout/head-open}}
    <title>트리플에스 커뮤니티 오브젝트</title>

    <link rel="stylesheet" href="{{#asset}}/css/member-portrait-picker.css{{/asset}}">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{#asset}}/css/objekt-filter.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/objekt-page.css{{/asset}}">
    <!-- Tailwind CSS 스크립트 -->
    <link rel="stylesheet" href="{{#asset}}/css/objekt.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/objekt-grid-cols.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/objekt-serial.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/objekt-modal.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/scroll-top.css{{/asset}}">
    <script src="{{#asset}}/js/about-modal.js{{/asset}}" defer></script>
    <script src="{{#asset}}/js/objekt-serial.js{{/asset}}" defer></script>
    <script src="{{#asset}}/js/objekt-issued.js{{/asset}}" defer></script>
</head><body class="site-page bg-[#0d0e12] text-[#e3e2e8] min-h-screen flex flex-col gap-3">
{{>layout/header}}
<main class="main-content w-full max-w-[1440px] mx-auto px-4 sm:px-6 py-6 mb-auto">
    <section class="card-box w-full bg-[#16181f]/85 backdrop-blur-xl border border-[#303646]/80 rounded-2xl p-4 sm:p-6 shadow-[0_18px_50px_rgba(0,0,0,0.22)] relative z-30">
        <div class="objekt-head">
            <div class="objekt-head-copy">
                <p class="objekt-head-kicker">Collection</p>
                <h2 class="objekt-head-title">오브젝트</h2>
                <p class="objekt-head-sub">Objekt Archive</p>
            </div>
            <a href="/cosmo/objekt/favorites" class="objekt-fav-link">
                <span class="material-symbols-outlined text-[1rem]" aria-hidden="true">favorite</span>
                찜 목록
            </a>
        </div>
        <form id="objekt-search-form" action="/cosmo/objekt" method="get">
        <input type="hidden" name="page" value="0">
        <input type="hidden" name="group" id="objekt-member-group" value="{{selectedGroup}}">

        <div class="objekt-workspace">
        <div class="objekt-member-picker-panel is-collapsed" id="member-dropdown">
            <div class="mpp-toolbar">
                <button type="button" class="objekt-member-toggle" id="objekt-member-toggle" aria-expanded="false" aria-controls="objekt-member-picker" {{#isOtherGroup}}hidden{{/isOtherGroup}}>
                    <span>
                        <span class="mpp-toolbar-title">멤버</span>
                        <span class="mpp-toolbar-meta" id="member-label">전체 멤버</span>
                    </span>
                    <span class="material-symbols-outlined objekt-member-toggle-caret" aria-hidden="true">expand_more</span>
                </button>
                <div class="mpp-toolbar-actions" role="group" aria-label="오브젝트 분류">
                    <button type="button" class="mpp-tool-btn objekt-group-tab" id="objekt-member-clear" data-objekt-group="all" aria-pressed="false">전체 / 멤버</button>
                    <button type="button" class="mpp-tool-btn objekt-group-tab" data-objekt-group="other" aria-pressed="false">기타 옵젝</button>
                </div>
            </div>
            <div class="objekt-member-checks" id="member-options" aria-hidden="true">
                {{#memberPickerOptions}}
                <input type="checkbox" name="member" value="{{value}}" class="member-checkbox" data-mpp-value="{{value}}" {{#active}}checked{{/active}}>
                {{/memberPickerOptions}}
            </div>
            <div class="member-portrait-picker" id="objekt-member-picker" role="group" aria-label="멤버 다중 선택">
                {{>partials/member-portrait-picker}}
            </div>
            <p class="objekt-other-notice" id="objekt-other-notice" {{^isOtherGroup}}hidden{{/isOtherGroup}}>멤버와 연결되지 않은 그룹·기타 오브젝트를 모아 보여줍니다.</p>
        </div>

        <div class="objekt-filter-bar relative">

            <div class="objekt-filter relative" id="season-dropdown">
                <span class="objekt-filter-label">시즌</span>
                <button type="button" id="season-toggle" class="objekt-filter-control" aria-haspopup="true" aria-expanded="false" aria-controls="season-menu" aria-label="시즌">
                    <span id="season-label" class="truncate">전체</span>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                </button>
                <div id="season-menu" class="objekt-dropdown-menu hidden">
                    <label class="objekt-choice">
                        <input type="checkbox" value="all" class="season-checkbox" checked>
                        <span class="objekt-choice-mark" aria-hidden="true"></span>
                        <span class="objekt-choice-text">전체 시즌</span>
                    </label>
                    <div id="season-options">
                        {{#seasonOptions}}
                        <label class="objekt-choice">
                            <input type="checkbox" name="season" value="{{.}}" class="season-checkbox">
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">{{.}}</span>
                        </label>
                        {{/seasonOptions}}
                    </div>
                </div>
            </div>

            <div class="objekt-filter relative" id="class-dropdown">
                <span class="objekt-filter-label">클래스</span>
                <button type="button" id="class-toggle" class="objekt-filter-control" aria-haspopup="true" aria-expanded="false" aria-controls="class-menu" aria-label="클래스">
                    <span id="class-label" class="truncate">전체</span>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                </button>
                <div id="class-menu" class="objekt-dropdown-menu hidden">
                    <label class="objekt-choice">
                        <input type="checkbox" value="all" class="class-checkbox" checked>
                        <span class="objekt-choice-mark" aria-hidden="true"></span>
                        <span class="objekt-choice-text">전체 클래스</span>
                    </label>
                    <div id="class-options">
                        {{#classOptions}}
                        <label class="objekt-choice">
                            <input type="checkbox" name="class" value="{{.}}" class="class-checkbox">
                            <span class="objekt-choice-mark" aria-hidden="true"></span>
                            <span class="objekt-choice-text">{{.}}</span>
                        </label>
                        {{/classOptions}}
                    </div>
                </div>
            </div>

            <div class="objekt-filter relative" id="kind-dropdown">
                <span class="objekt-filter-label">종류</span>
                <div class="objekt-filter-control objekt-kind-combo">
                    <input type="text"
                           name="kind"
                           id="objekt-kind-input"
                           class="objekt-kind-select"
                           value="{{selectedKindLabel}}"
                           placeholder="전체"
                           autocomplete="off"
                           spellcheck="false"
                           role="combobox"
                           aria-expanded="false"
                           aria-controls="kind-menu"
                           aria-autocomplete="list"
                           aria-label="옵젝 종류 필터 (입력 또는 선택)">
                    <button type="button" class="objekt-kind-toggle" id="objekt-kind-toggle" aria-label="종류 목록 열기" tabindex="-1">
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                </div>
                <div id="kind-menu" class="objekt-dropdown-menu hidden absolute top-full left-0 mt-2 min-w-[9rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" role="listbox" aria-label="종류 목록">
                    <button type="button" class="objekt-kind-option" data-value="all" role="option">전체</button>
                    {{#objektNumbers}}
                    <button type="button" class="objekt-kind-option" data-value="{{.}}" role="option">{{.}}</button>
                    {{/objektNumbers}}
                    <p class="objekt-kind-empty" id="kind-empty" hidden>일치하는 종류 없음</p>
                </div>
            </div>

            <div class="objekt-filter relative" id="sort-dropdown">
                <span class="objekt-filter-label">정렬</span>
                <div class="objekt-sort-control">
                    <button type="button" id="objekt-sort-toggle" class="objekt-filter-control" aria-label="정렬" aria-haspopup="listbox" aria-expanded="false" aria-controls="sort-menu" hidden>
                        <span id="sort-label">최신순</span>
                        <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </button>
                    <label id="sort-native-control" class="objekt-filter-control objekt-filter-select-wrap">
                    <select name="sort" class="objekt-sort-select" aria-label="정렬">
                        <option value="latest">최신순</option>
                        <option value="oldest">오래된순</option>
                        <option value="number_low">번호 낮은순</option>
                        <option value="number_high">번호 높은순</option>
                        <option value="first_member">첫 멤버</option>
                        <option value="last_member">마지막 멤버</option>
                        <option value="mint_low">민팅 적은순</option>
                        <option value="mint_high">민팅 많은순</option>
                    </select>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                    </label>
                </div>
                <div id="sort-menu" class="objekt-dropdown-menu hidden absolute top-full left-0 mt-2 min-w-[10rem] max-h-60 overflow-y-auto rounded-xl border z-50 p-1.5" role="listbox" aria-label="정렬 목록">
                    <button type="button" class="objekt-kind-option" data-value="latest" role="option">최신순</button>
                    <button type="button" class="objekt-kind-option" data-value="oldest" role="option">오래된순</button>
                    <button type="button" class="objekt-kind-option" data-value="number_low" role="option">번호 낮은순</button>
                    <button type="button" class="objekt-kind-option" data-value="number_high" role="option">번호 높은순</button>
                    <button type="button" class="objekt-kind-option" data-value="first_member" role="option">첫 멤버</button>
                    <button type="button" class="objekt-kind-option" data-value="last_member" role="option">마지막 멤버</button>
                    <button type="button" class="objekt-kind-option" data-value="mint_low" role="option">민팅 적은순</button>
                    <button type="button" class="objekt-kind-option" data-value="mint_high" role="option">민팅 많은순</button>
                </div>
            </div>

            <div class="objekt-search-row">
                <div class="objekt-search site-search">
                    <span class="objekt-search-glyph" aria-hidden="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
                    </span>
                    <label class="w-full min-w-0">
                        <input type="search" name="search" value="{{searchQuery}}" placeholder="멤버·시즌·번호·설명 검색..." aria-label="전체 오브젝트 검색" autocomplete="off" class="objekt-search-input site-search__input">
                    </label>
                </div>
                <button type="button" id="objekt-reset" class="objekt-reset-button" hidden>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10a9 9 0 1 1 2.6 8.4M3 4v6h6"/></svg>
                    초기화
                </button>
            </div>

        </div>
        </div>
        </form>
    </section>

    <div class="objekt-result-bar mt-5 flex items-center justify-between gap-3 px-1">
        <p id="objekt-result-summary" class="text-sm text-slate-400 min-w-0"
           data-result-count="{{objektCount}}" data-all-count="{{objektAllCount}}" data-loaded="{{objektPageCount}}">
            <span>검색 결과</span>
            <strong class="text-[#00f5d4]">{{objektCount}}</strong>
            <span>개</span>
        </p>
        <div class="objekt-cols-control" id="objekt-cols-dropdown" data-objekt-cols-filter>
            <button type="button" class="objekt-cols-toggle" data-objekt-cols-toggle aria-label="열 수" aria-expanded="false" aria-haspopup="listbox" aria-controls="objekt-cols-menu">
                <span class="objekt-cols-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                <span class="objekt-cols-sr" data-objekt-cols-label>2열</span>
            </button>
            <div id="objekt-cols-menu" class="objekt-dropdown-menu hidden absolute top-full right-0 mt-2 rounded-xl border z-50 p-1.5" data-objekt-cols-menu hidden role="listbox" aria-label="열 수">
                <button type="button" class="objekt-kind-option" data-objekt-cols-option="2" role="option">2열</button>
                <button type="button" class="objekt-kind-option" data-objekt-cols-option="3" role="option">3열</button>
                <button type="button" class="objekt-kind-option" data-objekt-cols-option="4" role="option">4열</button>
                <button type="button" class="objekt-kind-option" data-objekt-cols-option="5" role="option">5열</button>
                <button type="button" class="objekt-kind-option" data-objekt-cols-option="6" role="option">6열</button>
                <button type="button" class="objekt-kind-option" data-objekt-cols-option="7" role="option">7열</button>
                <button type="button" class="objekt-kind-option" data-objekt-cols-option="8" role="option">8열</button>
            </div>
        </div>
    </div>
    {{#objektError}}
    <div class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">{{objektError}}</div>
    {{/objektError}}
    <div id="objekt-empty" class="hidden mt-8 rounded-2xl border border-white/10 bg-white/[0.03] p-10 text-center text-slate-400">검색 조건에 맞는 오브젝트가 없습니다.</div>
    <div id="objekt-card-grid" class="objekt-card-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 py-2 mt-3" data-objekt-grid data-cols="2">
        {{#objekts}}
        <article class="card objekt-card objekt-item group relative border rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1"
                 data-objekt-key="{{publicKey}}"
                 data-season="{{seasonKey}}" data-class="{{classKey}}" data-artist="{{artist}}" data-collection-no="{{collectionNo}}"
                 data-number="{{numberValue}}" data-date="{{createdAt}}" data-member="{{member}}" data-search="{{searchText}}"{{#mintCountKnown}} data-supply-count="{{mintCount}}" data-supply-done="true"{{/mintCountKnown}}>
            <button type="button" class="objekt-open-detail" aria-label="{{collectionId}} 상세 보기">
                <img src="{{thumbnailImage}}" alt="{{collectionId}}" loading="lazy" class="objekt-image" onerror="this.onerror=null;this.src='{{frontImage}}';">
            </button>
            <div class="card-body objekt-card-body">
                <div class="objekt-card-badges">
                    <span class="badge badge-sm objekt-card-season" style="background:{{seasonColor}}">{{season}}</span>
                    <a href="/cosmo/objekt/detail/{{publicKey}}" class="objekt-detail-link" title="{{collectionId}}">{{#cardTitle}}{{cardTitle}}{{/cardTitle}}{{^cardTitle}}{{collectionId}}{{/cardTitle}}</a>
                </div>
                <div class="objekt-card-foot">
                    <a href="{{memberHref}}" class="objekt-member-chip" style="--artist-color:{{memberColor}}">
                        {{#hasMemberLogo}}<img class="objekt-member-logo" src="{{memberLogo}}" alt="" aria-hidden="true">{{/hasMemberLogo}}{{^hasMemberLogo}}<span class="objekt-member-logo" aria-hidden="true"></span>{{/hasMemberLogo}}
                        <span class="objekt-member-name">{{member}}</span>
                    </a>
                    {{#class}}<span class="badge badge-sm badge-neutral objekt-card-class">{{class}}</span>{{/class}}
                </div>
                <p class="objekt-card-supply" data-supply-count>{{#mintCountKnown}}발행량 {{mintCount}}개{{/mintCountKnown}}{{^mintCountKnown}}발행량 확인 중{{/mintCountKnown}}</p>
            </div>
        </article>
        {{/objekts}}
    </div>
    <div id="objekt-scroll-sentinel" class="flex flex-col items-center justify-center gap-2 py-8" aria-live="polite"
         data-has-more="{{#hasNextPage}}true{{/hasNextPage}}{{^hasNextPage}}false{{/hasNextPage}}"
         data-next-page="{{nextPage}}">
        <p id="objekt-scroll-status" class="text-sm text-slate-500">{{#hasNextPage}}스크롤하면 더 불러옵니다{{/hasNextPage}}{{^hasNextPage}}{{#objektCount}}모두 불러왔습니다{{/objektCount}}{{/hasNextPage}}</p>
        <div id="objekt-scroll-spinner" class="hidden h-6 w-6 animate-spin rounded-full border-2 border-[#00f5d4]/30 border-t-[#00f5d4]" aria-hidden="true"></div>
    </div>
</main>

<div id="objektDetailModal" class="objekt-detail-modal" hidden aria-hidden="true">
        <div class="objekt-detail-panel" role="dialog" aria-modal="true" aria-labelledby="objektDetailTitle" tabindex="-1">
        <button type="button" class="objekt-detail-close" id="objektDetailClose" aria-label="닫기">&times;</button>
        <figure class="objekt-detail-media">
            <div class="objekt-detail-media-stage">
                <img id="objektDetailImage" src="" alt="" data-front="" data-back="" data-motion="" data-showing-back="false">
                <video id="objektDetailVideo" hidden muted loop playsinline webkit-playsinline preload="none"></video>
                <button type="button" class="objekt-detail-media-btn" id="objektDetailFlip" aria-label="오브젝트 이미지">
                    <span class="objekt-detail-face" id="objektDetailFace" hidden>앞면</span>
                </button>
            </div>
        </figure>
        <div class="objekt-detail-body">
            <div class="objekt-detail-heading">
                <div>
                    <p class="objekt-detail-kicker">OBJEKT</p>
                    <h2 class="objekt-detail-title" id="objektDetailTitle">—</h2>
                </div>
                <button type="button" class="objekt-fav-toggle" id="objektDetailFavorite" aria-label="찜하기" aria-pressed="false">
                    <span class="objekt-fav-icon" aria-hidden="true">♡</span>
                    <span class="objekt-fav-count" id="objektDetailFavoriteCount">0</span>
                </button>
            </div>
            <dl class="objekt-detail-meta">
                <div><dt>멤버</dt><dd><a class="objekt-detail-member-link" id="objektDetailMember">—</a></dd></div>
                <div><dt>시즌</dt><dd id="objektDetailSeason">—</dd></div>
                <div><dt>클래스</dt><dd id="objektDetailClass">—</dd></div>
                <div><dt>번호</dt><dd id="objektDetailNo">—</dd></div>
                <div><dt>발행량</dt><dd id="objektIssuedCount" aria-live="polite">확인 중</dd></div>
            </dl>
            <section class="objekt-detail-story" aria-labelledby="objektDetailStoryTitle">
                <div class="objekt-detail-story-head">
                    <h3 class="objekt-detail-story-title" id="objektDetailStoryTitle">상세 설명</h3>
                    <button type="button" class="objekt-description-edit" id="objektDescriptionEdit" hidden>수정하기</button>
                </div>
                <p class="objekt-detail-desc is-empty" id="objektDetailDesc">불러오는 중…</p>
                <form id="objektDescriptionForm" class="objekt-description-editor" hidden>
                    <label class="objekt-description-label" for="objektModalDescription">상세 설명</label>
                    <fieldset id="objektDescriptionScope" class="objekt-description-scope" hidden>
                        <legend>적용 범위</legend>
                        <div class="objekt-description-share" data-share="members">
                            <div class="objekt-description-share-head">
                                <p class="objekt-description-share-title">공유할 멤버</p>
                                <button type="button" id="objektDescriptionMembersToggle" class="objekt-description-share-toggle" aria-expanded="false" aria-controls="objektDescriptionMembersPanel">
                                    <span id="objektDescriptionMembersSummary">이 멤버만</span>
                                    <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                                </button>
                            </div>
                            <div id="objektDescriptionMembersPanel" class="objekt-description-share-panel" hidden>
                                <div class="objekt-description-share-actions">
                                    <button type="button" data-share-members="all">전체</button>
                                    <button type="button" data-share-members="current">이 멤버만</button>
                                </div>
                                <div id="objektDescriptionMembers" class="objekt-description-share-list" role="group" aria-label="공유할 멤버"></div>
                            </div>
                        </div>
                        <div class="objekt-description-share" data-share="numbers">
                            <div class="objekt-description-share-head">
                                <p class="objekt-description-share-title">적용할 번호 <span id="objektDescriptionSeasonLabel"></span></p>
                                <button type="button" id="objektDescriptionNumbersToggle" class="objekt-description-share-toggle" aria-expanded="false" aria-controls="objektDescriptionNumbersPanel">
                                    <span id="objektDescriptionNumbersSummary">이 번호만</span>
                                    <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                                </button>
                            </div>
                            <div id="objektDescriptionNumbersPanel" class="objekt-description-share-panel" hidden>
                                <div id="objektDescriptionNumbers" class="objekt-description-share-list is-numbers" role="group" aria-label="적용할 번호"></div>
                            </div>
                        </div>
                        <p id="objektDescriptionScopeHint"></p>
                    </fieldset>
                    <textarea id="objektModalDescription" name="description" rows="6" maxlength="10000" placeholder="상세 설명을 입력해 주세요."></textarea>
                    <div class="objekt-description-buttons"><button type="submit">저장</button><button type="button" id="objektDescriptionDelete">설명 삭제</button></div>
                    <p id="objektDescriptionStatus" role="status" aria-live="polite"></p>
                </form>
                <p class="objekt-detail-event" id="objektDetailEvent" hidden></p>
            </section>

            <p id="objektFavoriteStatus" role="status" aria-live="polite" hidden></p>
            <div class="objekt-detail-actions">
                <a class="objekt-member-link" id="objektDetailMemberLink" href="/cosmo/objekt">이 멤버의 오브젝트 더 보기</a>
