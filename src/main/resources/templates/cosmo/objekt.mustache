<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 오브젝트</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS 스크립트 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="../../static/css/style.css">
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen flex flex-col gap-3">
{{>layout/header}}
<main class="main-content max-w-7xl mx-auto px-4 py-4 mb-auto">
    <div class="card-box w-full bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl py-4 shadow-xl relative z-30">
        <h2 class="text-2xl font-bold text-[#e3e2e8] mb-6 flex items-center gap-2">
            <span class="inline-block translate-x-[50px] translate-y-[20px]">오브젝트</span></h2>
        <div class="bg-[#12141c] border border-[#222634] rounded-xl py-4 flex flex-wrap items-center gap-3 shadow-lg relative translate-y-[6px] ">

            <!-- 1. 시즌 다중 선택 필터 (너비 확장 및 독립 스크립트 연동) -->
            <div class="relative flex gap-2 items-center border border-[#2c3144] rounded-lg px-3.5 py-2 transition-colors cursor-pointer w-auto bg-[#1a1d28]" id="season-dropdown">
                <span class="shrink-0 mr-2 text-sm text-gray-400">시즌</span>
                <!-- 드롭다운 토글 버튼 -->
                <button type="button" onclick="toggleDropdown('season-menu')" class="flex items-center justify-between bg-[#00f5d4] border border-[#2c3144] rounded-lg px-3 py-2 hover:border-[#404863] transition-colors cursor-pointer w-full text-sm text-black font-medium">
                    <span id="season-label" class="truncate">all</span>
                    <span class="material-symbols-outlined text-xs text-black">arrow_drop_down</span>
                </button>

                <!-- 체크박스 목록 메뉴 -->
                <div id="season-menu" class="hidden absolute top-full left-0 mt-1 w-full bg-[#16181f] border border-[#2c3144] rounded-xl shadow-2xl z-50 p-2 max-h-60 overflow-y-auto">
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="all" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" checked onchange="handleSeasonAll(this)">
                        <span>all</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="atom01" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" onchange="handleSeasonItem()">
                        <span>Atom 01</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="binary01" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" onchange="handleSeasonItem()">
                        <span>Binary 01</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="cream01" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" onchange="handleSeasonItem()">
                        <span>Cream 01</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="Divine01" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" onchange="handleSeasonItem()">
                        <span>Divine 01</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="ever01" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" onchange="handleSeasonItem()">
                        <span>Ever 01</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="atom02" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" onchange="handleSeasonItem()">
                        <span>Atom 02</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="binary02" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" onchange="handleSeasonItem()">
                        <span>Binary 02</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="cream02" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 season-checkbox" onchange="handleSeasonItem()">
                        <span>Cream 02</span>
                    </label>
                </div>
            </div>

            <!-- 2. 종류 필터 -->
            <div class="flex gap-2 items-center justify-between bg-[#1a1d28] border border-[#2c3144] rounded-lg px-5 py-2 transition-colors cursor-pointer w-auto">
                <span class="objekt-collection shrink-0 mr-2 text-sm text-gray-400">종류</span>
                <label class="w-full">
                    <select class="bg-[#00f5d4] w-full text-black font-medium rounded-md focus:outline-none cursor-pointer text-sm py-2 px-5">
                        <option value="all">all</option>
                        <option value="example">example1</option>
                    </select>
                </label>
            </div>

            <!-- 3. 클래스 다중 선택 필터 (너비 확장 및 독립 스크립트 연동) -->
            <div class="relative flex gap-2 items-center border border-[#2c3144] rounded-lg px-2 py-2 transition-colors cursor-pointer w-auto" id="class-dropdown">
                <span class="shrink-0 mr-2 text-sm text-gray-400">클래스</span>
                <!-- 드롭다운 토글 버튼 -->
                <button type="button" onclick="toggleDropdown('class-menu')" class="flex items-center justify-between bg-[#00f5d4] border border-[#2c3144] rounded-lg px-3 py-2 hover:border-[#404863] transition-colors cursor-pointer w-full text-sm text-black font-medium">
                    <span id="class-label" class="truncate">all</span>
                    <span class="material-symbols-outlined text-xs text-black">arrow_drop_down</span>
                </button>

                <!-- 체크박스 목록 메뉴 -->
                <div id="class-menu" class="hidden absolute top-full left-0 mt-1 w-full bg-[#16181f] border border-[#2c3144] rounded-xl shadow-2xl z-50 p-2 max-h-60 overflow-y-auto">
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="all" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" checked onchange="handleClassAll(this)">
                        <span>all</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="welcome" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" onchange="handleClassItem()">
                        <span>Welcome</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="first" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" onchange="handleClassItem()">
                        <span>First</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="special" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" onchange="handleClassItem()">
                        <span>Special</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="double" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" onchange="handleClassItem()">
                        <span>Double</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="premier" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" onchange="handleClassItem()">
                        <span>Premier</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="motion" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" onchange="handleClassItem()">
                        <span>Motion</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="unit" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" onchange="handleClassItem()">
                        <span>Unit</span>
                    </label>
                    <label class="flex items-center gap-2 px-2.5 py-2 hover:bg-[#1a1d28] rounded-md cursor-pointer text-sm text-white">
                        <input type="checkbox" value="zero" class="rounded border-[#2c3144] bg-[#1a1d28] text-[#00f5d4] focus:ring-0 class-checkbox" onchange="handleClassItem()">
                        <span>Zero</span>
                    </label>
                </div>
            </div>

            <!-- 4. 정렬 필터 -->
            <div class="flex gap-2 items-center bg-[#1a1d28] justify-between border border-[#2c3144] rounded-lg px-5 py-2 transition-colors cursor-pointer w-auto">
                <span class="objekt-sort shrink-0 mr-2 text-sm text-gray-400">정렬</span>
                <label class="w-full">
                    <select class="bg-[#00f5d4] w-full text-black rounded-md font-medium focus:outline-none cursor-pointer text-sm py-2 px-5">
                        <option value="latest">최신순</option>
                        <option value="oldest">오래된순</option>
                        <option value="number_low">번호 낮은순</option>
                        <option value="number_high">번호 높은순</option>
                        <option value="first_member">첫 멤버</option>
                        <option value="last_member">마지막 멤버</option>
                        <option value="mint_low">민팅 적은순</option>
                        <option value="mint_high">민팅 많은순</option>
                    </select>
                </label>
            </div>

            <!-- 5. 검색 입력창 -->
            <div class="flex items-center bg-[#1a1d28] border border-[#2c3144] rounded-lg py-2 hover:border-[#404863] transition-colors flex-1">
                <span class="material-symbols-outlined text-[#636b83] text-base pointer-events-none">
                    search
                </span>
                <label class="w-full">
                    <input type="text" placeholder="검색.." class="w-full bg-transparent pl-6 pr-2 text-sm text-white placeholder-[#585f75] focus:outline-none">
                </label>
            </div>

        </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 py-2 mt-6">
        <div class="group relative bg-[#151722] border border-[#252838] rounded-2xl overflow-hidden hover:border-[#404868] transition-all duration-300 shadow-lg hover:-translate-y-1">
            <!-- 이미지 & 세로 텍스트 바 -->
            <div class="relative aspect-[2/3] w-full overflow-hidden bg-[#1c1f2e]">
                <img alt="objekt" src="/uploads/images/objekts/jiyeoncc364.jpg" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
        </div>
    </div>
</main>
</body>
<script>
    // 드롭다운 토글 (지정한 메뉴 ID만 열고 닫기)
    function toggleDropdown(id) {
        document.querySelectorAll('[id$="-menu"]').forEach(menu => {
            if (menu.id !== id) menu.classList.add('hidden');
        });
        const menu = document.getElementById(id);
        if (menu) menu.classList.toggle('hidden');
    }

    // 화면 다른 곳을 누르면 드롭다운 모두 닫기
    window.addEventListener('click', function(e) {
        if (!e.target.closest('#season-dropdown') && !e.target.closest('#class-dropdown')) {
            document.getElementById('season-menu').classList.add('hidden');
            document.getElementById('class-menu').classList.add('hidden');
        }
    });

    // --- 시즌 필터 관련 로직 ---
    function handleSeasonAll(allCheckbox) {
        const checkboxes = document.querySelectorAll('.season-checkbox');
        checkboxes.forEach(cb => {
            if (cb !== allCheckbox) cb.checked = false;
        });
        updateSeasonLabel();
    }

    function handleSeasonItem() {
        const allCheckbox = document.querySelector('.season-checkbox[value="all"]');
        const checkedItems = document.querySelectorAll('.season-checkbox:not([value="all"]):checked');

        if (checkedItems.length === 0) {
            allCheckbox.checked = true;
        } else {
            allCheckbox.checked = false;
        }
        updateSeasonLabel();
    }

    function updateSeasonLabel() {
        const checked = document.querySelectorAll('.season-checkbox:checked');
        const label = document.getElementById('season-label');
        const allCheckbox = document.querySelector('.season-checkbox[value="all"]');

        if (checked.length === 0 || allCheckbox.checked) {
            label.textContent = 'all';
        } else if (checked.length === 1) {
            label.textContent = checked[0].nextElementSibling.textContent.trim();
        } else {
            label.textContent = `${checked[0].nextElementSibling.textContent.trim()} 외 ${checked.length - 1}개`;
        }
    }

    // --- 클래스 필터 관련 로직 ---
    function handleClassAll(allCheckbox) {
        const checkboxes = document.querySelectorAll('.class-checkbox');
        checkboxes.forEach(cb => {
            if (cb !== allCheckbox) cb.checked = false;
        });
        updateClassLabel();
    }

    function handleClassItem() {
        const allCheckbox = document.querySelector('.class-checkbox[value="all"]');
        const checkedItems = document.querySelectorAll('.class-checkbox:not([value="all"]):checked');

        if (checkedItems.length === 0) {
            allCheckbox.checked = true;
        } else {
            allCheckbox.checked = false;
        }
        updateClassLabel();
    }

    function updateClassLabel() {
        const checked = document.querySelectorAll('.class-checkbox:checked');
        const label = document.getElementById('class-label');
        const allCheckbox = document.querySelector('.class-checkbox[value="all"]');

        if (checked.length === 0 || allCheckbox.checked) {
            label.textContent = 'all';
        } else if (checked.length === 1) {
            label.textContent = checked[0].nextElementSibling.textContent.trim();
        } else {
            label.textContent = `${checked[0].nextElementSibling.textContent.trim()} 외 ${checked.length - 1}개`;
        }
    }
</script>
</html>