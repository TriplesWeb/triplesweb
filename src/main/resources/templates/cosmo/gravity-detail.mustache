<!DOCTYPE html>
<html lang="ko">
<head>
{{>layout/favicon}}
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>그래비티 - 트리플에스 커뮤니티</title>
<script src="https://cdn.tailwindcss.com?plugins=forms"></script>
<script src="/js/tailwind.config.js"></script>
<link rel="stylesheet" href="/css/style.css">
<style>body{background:#0d0e12;color:#e3e2e8} .gravity-card{background:#16181f;border:1px solid #ffffff18;border-radius:16px;padding:24px} .gravity-card a{color:#00f5d4} .gravity-notice{border:1px solid #fbbf2440;background:#fbbf2408;padding:16px;border-radius:12px}</style>
</head><body class="min-h-screen flex flex-col">
{{>layout/header}}
<main class="flex-1 max-w-6xl w-full mx-auto px-4 py-8 space-y-6">

<a href="/cosmo/gravity" class="text-[#00f5d4]">← 그래비티 목록</a>
{{#detailError}}<p role="status" class="gravity-notice">{{detailError}}</p>{{/detailError}}
{{#gravity}}
<section class="gravity-card space-y-4">
{{#bannerImageUrl}}<img src="{{bannerImageUrl}}" alt="" referrerpolicy="no-referrer" class="w-full max-h-80 object-contain rounded-lg">{{/bannerImageUrl}}
<p class="text-xs text-[#00f5d4]">{{type}} · #{{id}}</p>
<h1 class="text-3xl font-bold">{{title}}</h1><p class="text-gray-400">{{description}}</p>
<p class="text-sm">{{entireStartDate}} ~ {{entireEndDate}}</p>
{{#result}}<p>공식 총 사용 COMO: {{totalComoUsed}}</p>{{/result}}
</section>
{{/gravity}}
<nav class="flex gap-3 flex-wrap">
{{#polls}}<a href="?pollId={{id}}" class="gravity-card text-sm" {{#selected}}aria-current="page"{{/selected}}>{{title}}</a>{{/polls}}
</nav>
{{#selectedPoll}}<h2 class="text-xl font-bold">{{title}}</h2><p class="text-sm text-gray-400">{{startDate}} ~ {{endDate}} · 결과 공개 {{revealDate}}</p>{{/selectedPoll}}
{{#hasOfficialResults}}
<section class="gravity-card space-y-4"><h2 class="text-lg font-bold">COSMO 공식 결과</h2>
{{#officialResults}}<p>총 사용 COMO: {{totalComoUsed}}</p>
{{#voteResults}}<div class="border-t border-white/10 pt-3"><p class="text-[#00f5d4]">{{rank}}위</p>
{{#votedChoice}}<p>{{choiceName}} · {{comoUsed}} COMO</p>{{/votedChoice}}
{{#votedSlots}}<p>{{slotName}}: {{slotChoiceName}} · {{comoUsed}} COMO</p>{{/votedSlots}}
</div>{{/voteResults}}{{/officialResults}}
</section>{{/hasOfficialResults}}
{{^hasOfficialResults}}{{#selectedPoll}}<p class="gravity-notice">공식 결과가 아직 공개되지 않았습니다.</p>{{/selectedPoll}}{{/hasOfficialResults}}
{{#aggregationError}}<p role="status" class="gravity-notice">{{aggregationError}}</p>{{/aggregationError}}
{{#aggregation}}<section class="gravity-card"><h2 class="font-bold text-lg">Apollo 투표 집계</h2><p class="mt-3">투표 수 {{totalVoteCount}} · 사용 COMO {{totalComoCount}} · 공개된 투표 수 {{revealedVoteCount}}</p></section>{{/aggregation}}
{{#hasCandidateResults}}<section class="gravity-card space-y-3"><h2 class="font-bold">공개 완료된 후보별 COMO</h2>
{{#candidateResults}}<div class="flex gap-4 items-center border-t border-white/10 pt-3">{{#imageUrl}}<img src="{{imageUrl}}" alt="" loading="lazy" referrerpolicy="no-referrer" class="w-14 h-14 object-cover rounded">{{/imageUrl}}<span>{{name}}</span><strong class="ml-auto">{{comoAmount}} COMO</strong></div>{{/candidateResults}}</section>{{/hasCandidateResults}}
</main>{{>layout/footer}}</body></html>
