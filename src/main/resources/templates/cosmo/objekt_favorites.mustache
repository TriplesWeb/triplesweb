{{>layout/head-open}}<title>찜한 오브젝트</title></head><body class="site-page min-h-screen bg-[#0d0e12] text-white">{{>layout/header}}<main class="mx-auto max-w-7xl px-4 py-8"><nav class="site-back" aria-label="전체 오브젝트로"><a href="/cosmo/objekt">← 전체 오브젝트</a></nav><h1 class="mt-4 text-3xl font-bold">찜한 오브젝트</h1><div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">{{#favorites}}<article class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]"><a href="/cosmo/objekt/detail/{{objektKey}}"><img src="{{thumbnailImage}}" alt="{{collectionId}}" loading="lazy" class="aspect-[2/3] w-full object-contain"></a><div class="p-3"><a href="/cosmo/objekt/detail/{{objektKey}}" class="font-semibold hover:text-teal-300">{{collectionId}}</a><p class="mt-1 text-xs text-slate-400">{{memberDisplay}} · {{season}} · {{collectionNo}}</p><form method="post" action="/cosmo/objekt/favorites/remove" data-confirm="이 오브젝트의 찜을 해제하시겠습니까?" class="mt-3">{{#_csrf}}<input type="hidden" name="{{parameterName}}" value="{{token}}">{{/_csrf}}<input type="hidden" name="key" value="{{objektKey}}"><button type="submit" class="w-full rounded-xl border border-pink-400/40 px-3 py-2 text-sm font-semibold text-pink-200 hover:bg-pink-400/10">♥ 찜 해제</button></form></div></article>{{/favorites}}{{^favorites}}<p class="col-span-full py-12 text-center text-slate-400">아직 찜한 오브젝트가 없습니다.</p>{{/favorites}}</div></main>{{>layout/page-end}}
