{{>layout/head-open}}

    <link rel="stylesheet" href="{{#asset}}/css/event-detail.css{{/asset}}">
    <title>트리플에스 커뮤니티 - 역대 이벤트</title>
</head><body class="site-page bg-[#0d0e12] text-[#e3e2e8] min-h-screen">
{{>layout/header}}
<main class="main-content max-w-7xl mx-auto px-4 py-8">
    {{#event}}
<div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl shadow-xl overflow-hidden">
    <nav class="site-back site-back--bar" aria-label="이벤트 목록으로">
        <a href="/cosmo/event">← 이벤트 목록</a>
    </nav>
    <div class="p-6 lg:p-8 space-y-8">
    <div class="event-detail-hero grid grid-cols-1 md:grid-cols-12 gap-8 items-start min-w-0">
             <div class="md:col-span-4 lg:col-span-3 flex justify-center">
                 <img src="{{displayEventImage}}" width="300" height="300" alt="{{eventName}}" class="event-detail-poster w-full max-w-[260px] aspect-square object-cover rounded-2xl border border-[#3a4a46]/40 shadow-2xl" />
             </div>
        <div class="md:col-span-8 lg:col-span-9 space-y-5 min-w-0">
            <div>
                <h1 class="text-3xl lg:text-4xl font-extrabold text-[#e3e2e8] tracking-tight m-0">{{eventName}}</h1>
            </div>
            <dl class="event-detail-meta">
                {{#hasTourPeriodSummary}}
                <div class="event-detail-meta-row">
                    <dt>공연 기간</dt>
                    <dd class="font-mono">{{tourPeriodSummary}}</dd>
                </div>
                {{/hasTourPeriodSummary}}
                {{#hasTourLocationsSummary}}
                <div class="event-detail-meta-row">
                    <dt>위치</dt>
                    <dd id="eventMetaLocation">{{tourLocationsSummary}}</dd>
                </div>
                {{/hasTourLocationsSummary}}
                {{#hasStops}}
                <div class="event-detail-meta-row" id="eventMetaDateRow" hidden>
                    <dt>공연 일시</dt>
                    <dd class="font-mono" id="eventMetaDate"></dd>
                </div>
                {{/hasStops}}
            </dl>
            {{#hasEventInfo}}
            <div class="pt-1">
                <h3 class="text-xs font-semibold text-[#b9cac4] uppercase tracking-wider mb-2">소개</h3>
                <p id="eventInfoText" class="text-sm leading-relaxed text-[#e3e2e8]/90 whitespace-pre-wrap max-h-[9.75rem] overflow-hidden">{{eventInfo}}</p>
                <button type="button" id="eventInfoToggle" class="mt-2 text-sm font-semibold text-[#00f5d4] hover:text-[#7dffe8] transition-colors" hidden aria-expanded="false" aria-controls="eventInfoText">더 보기</button>
            </div>
            {{/hasEventInfo}}
        </div>
    </div>

    <section class="event-stop-section" aria-label="지역별 공연" id="eventStopSection">
        {{#hasStops}}
        {{#hasMultipleRegions}}
        <div class="site-section-tabs event-region-tabs" id="eventRegionTabs" role="tablist" aria-label="지역">
            {{#regionGroups}}
            <button type="button"
                    class="site-section-tab{{#firstRegion}} is-active{{/firstRegion}}"
                    role="tab"
                    id="tab-{{regionPanelId}}"
                    aria-controls="{{regionPanelId}}"
                    aria-selected="{{#firstRegion}}true{{/firstRegion}}{{^firstRegion}}false{{/firstRegion}}"
                    tabindex="{{#firstRegion}}0{{/firstRegion}}{{^firstRegion}}-1{{/firstRegion}}"
                    data-event-region-tab
                    data-target="{{regionPanelId}}">{{regionLabel}}</button>
            {{/regionGroups}}
        </div>
        {{/hasMultipleRegions}}

        <div class="event-region-panels" id="eventRegionPanels">
            {{#regionGroups}}
            <div class="event-region-panel"
                 id="{{regionPanelId}}"
                 data-event-region
                 data-region-key="{{regionKey}}"
                 {{#hasMultipleRegions}}role="tabpanel" aria-labelledby="tab-{{regionPanelId}}"{{/hasMultipleRegions}}
                 {{#regionHidden}}hidden{{/regionHidden}}>
                {{#hasMultipleDates}}
                <div class="site-section-tabs event-date-tabs" role="tablist" aria-label="{{regionLabel}} 회차">
                    {{#stops}}
                    <button type="button"
                            class="site-section-tab{{#firstDateInRegion}} is-active{{/firstDateInRegion}}"
                            role="tab"
                            id="tab-event-stop-{{stopId}}"
                            aria-controls="event-stop-{{stopId}}"
                            aria-selected="{{#firstDateInRegion}}true{{/firstDateInRegion}}{{^firstDateInRegion}}false{{/firstDateInRegion}}"
                            tabindex="{{#firstDateInRegion}}0{{/firstDateInRegion}}{{^firstDateInRegion}}-1{{/firstDateInRegion}}"
                            data-event-date-tab
                            data-target="event-stop-{{stopId}}"
                            data-event-date="{{eventDate}}"
                            data-event-location="{{locationSummary}}">{{dateTabLabel}}</button>
                    {{/stops}}
                </div>
                {{/hasMultipleDates}}

                <div class="event-stop-panels">
                    {{#stops}}
                    <div class="event-stop-panel"
                         id="event-stop-{{stopId}}"
                         role="tabpanel"
                         {{#hasMultipleDatesInRegion}}aria-labelledby="tab-event-stop-{{stopId}}"{{/hasMultipleDatesInRegion}}
                         data-event-date="{{eventDate}}"
                         data-event-location="{{locationSummary}}"
                         {{#stopPanelHidden}}hidden{{/stopPanelHidden}}>
                        <div class="event-stop-meta">
                            <div class="event-stop-date">{{eventDate}}</div>
                            {{#hasLocationSummary}}
                            <div class="event-stop-venue">{{locationSummary}}</div>
                            {{/hasLocationSummary}}
                        </div>

                        {{#hasDetail}}
                        <p class="event-stop-detail">{{detail}}</p>
                        {{/hasDetail}}

                        {{#hasSetlist}}
                        <div class="event-stop-block event-stop-block--setlist">
                            <h3 class="event-stop-block-title">
                                <span class="material-symbols-outlined" aria-hidden="true">graphic_eq</span>
                                셋리스트{{#hasSetlistSongCount}} {{setlistSongCount}}곡{{/hasSetlistSongCount}}
                            </h3>
                            <ol class="event-setlist-list">
                                {{#setlistRows}}
                                {{#section}}
                                <li class="event-setlist-section-item" aria-hidden="false">
                                    <span class="event-setlist-section-label">{{sectionLabel}}</span>
                                </li>
                                {{/section}}
                                {{^section}}
                                <li class="event-setlist-song-item">
                                    <span class="event-setlist-order" aria-hidden="true">{{#hasOrder}}{{orderNum}}{{/hasOrder}}</span>
                                    <div class="event-setlist-song-body">
                                        {{#split}}
                                        <div class="event-setlist-variants">
                                            {{#variants}}
                                            <div class="event-setlist-variant">
                                                <span class="event-setlist-song">{{title}}</span>
                                                {{#hasSubtitle}}
                                                <span class="event-setlist-album">{{subtitle}}</span>
                                                {{/hasSubtitle}}
                                                {{#hasNote}}
                                                <span class="event-setlist-album">{{note}}</span>
                                                {{/hasNote}}
                                            </div>
                                            {{/variants}}
                                        </div>
                                        {{/split}}
                                        {{^split}}
                                        <span class="event-setlist-song">{{title}}</span>
                                        {{#hasSubtitle}}
                                        <span class="event-setlist-album">{{subtitle}}</span>
                                        {{/hasSubtitle}}
                                        {{#hasNote}}
                                        <span class="event-setlist-note">{{note}}</span>
                                        {{/hasNote}}
                                        {{/split}}
                                    </div>
                                </li>
                                {{/section}}
                                {{/setlistRows}}
                            </ol>
                        </div>
                        {{/hasSetlist}}

                        {{^hasPanelContent}}
                        <p class="event-stop-detail event-stop-detail--empty">상세 안내·셋리스트가 아직 등록되지 않았습니다.</p>
                        {{/hasPanelContent}}
                    </div>
                    {{/stops}}
                </div>
            </div>
            {{/regionGroups}}
        </div>
        {{/hasStops}}
        {{^hasStops}}
        <p class="text-sm text-[#b9cac4]/70 py-6 text-center">등록된 지역 회차가 없습니다.</p>
        {{/hasStops}}
    </section>

    {{#hasShopLink}}
    <section class="event-goods-section" aria-label="콘서트 굿즈">
        <a href="/shop/{{shopId}}" class="event-stop-block event-stop-block--goods event-goods-link">
            <span class="event-goods-link-main">
                <span class="event-stop-block-title event-goods-link-title">
                    <span class="material-symbols-outlined" aria-hidden="true">shopping_bag</span>
                    콘서트 굿즈
                </span>
                <span class="event-goods-link-meta">MD 리스트 보기</span>
            </span>
            <span class="event-goods-link-go" aria-hidden="true">→</span>
        </a>
    </section>
    {{/hasShopLink}}
    </div>
</div>
            {{/event}}

</main>
<script src="{{#asset}}/js/about-tabs.js{{/asset}}"></script>
<script>
(function () {
  var text = document.getElementById("eventInfoText");
  var btn = document.getElementById("eventInfoToggle");
  if (text && btn && text.scrollHeight > text.clientHeight + 2) {
    var collapsed = true;
    btn.hidden = false;
    btn.addEventListener("click", function () {
      collapsed = !collapsed;
      text.classList.toggle("max-h-[9.75rem]", collapsed);
      text.classList.toggle("overflow-hidden", collapsed);
      btn.textContent = collapsed ? "더 보기" : "접기";
      btn.setAttribute("aria-expanded", collapsed ? "false" : "true");
    });
  }

  var regionRoot = document.getElementById("eventRegionTabs");
  var regionPanels = document.getElementById("eventRegionPanels");
  var metaDate = document.getElementById("eventMetaDate");
  var metaLocation = document.getElementById("eventMetaLocation");
  var metaDateRow = document.getElementById("eventMetaDateRow");

  function syncMetaFromPanel(panel) {
    if (!panel) return;
    var date = panel.getAttribute("data-event-date") || "";
    var location = panel.getAttribute("data-event-location") || "";
    if (metaDate) metaDate.textContent = date;
    if (metaDateRow) metaDateRow.hidden = !date;
    if (metaLocation && location) metaLocation.textContent = location;
  }

  function visibleStopInRegion(regionPanel) {
    if (!regionPanel) return null;
    var panels = regionPanel.querySelectorAll(".event-stop-panel");
    for (var i = 0; i < panels.length; i++) {
      if (!panels[i].hidden) return panels[i];
    }
    return panels[0] || null;
  }

  function activateDateTab(dateBtn, regionPanel) {
    if (!dateBtn || !regionPanel) return;
    var targetId = dateBtn.getAttribute("data-target");
    var tablist = dateBtn.closest('[role="tablist"]');
    if (tablist) {
      tablist.querySelectorAll('[role="tab"]').forEach(function (tab) {
        var selected = tab === dateBtn;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.toggle("is-active", selected);
      });
    }
    regionPanel.querySelectorAll(".event-stop-panel").forEach(function (panel) {
      panel.hidden = panel.id !== targetId;
    });
    var active = document.getElementById(targetId);
    syncMetaFromPanel(active);
  }

  function activateRegion(regionBtn) {
    if (!regionBtn || !regionPanels) return;
    var targetId = regionBtn.getAttribute("data-target");
    if (regionRoot) {
      regionRoot.querySelectorAll('[role="tab"]').forEach(function (tab) {
        var selected = tab === regionBtn;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.toggle("is-active", selected);
      });
    }
    regionPanels.querySelectorAll("[data-event-region]").forEach(function (panel) {
      panel.hidden = panel.id !== targetId;
    });
    var regionPanel = document.getElementById(targetId);
    if (!regionPanel) return;
    var dateTabs = regionPanel.querySelectorAll("[data-event-date-tab]");
    if (dateTabs.length) {
      var activeDate = regionPanel.querySelector("[data-event-date-tab].is-active") || dateTabs[0];
      activateDateTab(activeDate, regionPanel);
    } else {
      var only = visibleStopInRegion(regionPanel);
      if (only) only.hidden = false;
      syncMetaFromPanel(only);
    }
  }

  if (regionPanels) {
    regionPanels.querySelectorAll("[data-event-date-tab]").forEach(function (tab) {
      tab.addEventListener("click", function () {
        var regionPanel = tab.closest("[data-event-region]");
        activateDateTab(tab, regionPanel);
      });
    });
    regionPanels.querySelectorAll(".event-date-tabs").forEach(function (tablist) {
      if (window.AboutTabs && typeof window.AboutTabs.enhanceTabs === "function") {
        window.AboutTabs.enhanceTabs(tablist, {
          onActivate: function (btn) {
            activateDateTab(btn, btn.closest("[data-event-region]"));
          }
        });
      }
    });
  }

  if (regionRoot && regionPanels) {
    regionRoot.querySelectorAll('[role="tab"]').forEach(function (tab) {
      tab.addEventListener("click", function () {
        activateRegion(tab);
      });
    });
    if (window.AboutTabs && typeof window.AboutTabs.enhanceTabs === "function") {
      window.AboutTabs.enhanceTabs(regionRoot, { onActivate: activateRegion });
    }
    var initialRegion = regionRoot.querySelector('[role="tab"].is-active')
      || regionRoot.querySelector('[role="tab"]');
    activateRegion(initialRegion);
  } else if (regionPanels) {
    var firstRegion = regionPanels.querySelector("[data-event-region]");
    var firstStop = visibleStopInRegion(firstRegion) || regionPanels.querySelector(".event-stop-panel");
    syncMetaFromPanel(firstStop);
  }
})();
</script>
{{>layout/page-end}}
