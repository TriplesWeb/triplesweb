{{>layout/head-open}}

    <link rel="stylesheet" href="{{#asset}}/css/event-detail.css{{/asset}}">
    <title>트리플에스 커뮤니티 - 역대 이벤트</title>
</head><body class="site-page bg-[#0d0e12] text-[#e3e2e8] min-h-screen">
{{>layout/header}}
<main class="main-content max-w-7xl mx-auto px-4 py-8">
    {{#event}}
<div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl shadow-xl overflow-hidden">
    <nav class="site-back site-back--bar" aria-label="이벤트 목록으로">
        <a href="/cosmo/event">← 이벤트 목록</a>
    </nav>
    <div class="p-6 lg:p-8 space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start min-w-0">
             <div class="md:col-span-4 lg:col-span-3 flex justify-center">
                 <img src="{{displayEventImage}}" width="300" height="300" alt="{{eventName}}" class="w-full max-w-[260px] aspect-square object-cover rounded-2xl border border-[#3a4a46]/40 shadow-2xl" />
             </div>
        <div class="md:col-span-8 lg:col-span-9 space-y-5">
            <div>
                <h1 class="text-3xl lg:text-4xl font-extrabold text-[#e3e2e8] tracking-tight">{{eventName}}</h1>
            </div>
            {{#hasEventInfo}}
            <div class="pt-1">
                <h3 class="text-xs font-semibold text-[#b9cac4] uppercase tracking-wider mb-2">소개</h3>
                <p id="eventInfoText" class="text-sm leading-relaxed text-[#e3e2e8]/90 whitespace-pre-wrap max-h-[9.75rem] overflow-hidden">{{eventInfo}}</p>
                <button type="button" id="eventInfoToggle" class="mt-2 text-sm font-semibold text-[#00f5d4] hover:text-[#7dffe8] transition-colors" hidden aria-expanded="false" aria-controls="eventInfoText">더 보기</button>
            </div>
            {{/hasEventInfo}}
        </div>
    </div>

    <section class="event-stop-section" aria-label="지역별 공연">
        <h2 class="text-xl font-bold text-[#e3e2e8] flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-[1.25rem] text-[#00f5d4]" aria-hidden="true">location_on</span> 지역별 공연
        </h2>
        {{#hasStops}}
        {{#hasMultipleStops}}
        <div class="site-section-tabs event-stop-tabs" id="eventStopTabs" role="tablist" aria-label="지역 회차">
            {{#orderedStops}}
            <button type="button"
                    class="site-section-tab{{#firstOrderedStop}} is-active{{/firstOrderedStop}}"
                    role="tab"
                    id="tab-event-stop-{{stopId}}"
                    aria-controls="event-stop-{{stopId}}"
                    aria-selected="{{#firstOrderedStop}}true{{/firstOrderedStop}}{{^firstOrderedStop}}false{{/firstOrderedStop}}"
                    tabindex="{{#firstOrderedStop}}0{{/firstOrderedStop}}{{^firstOrderedStop}}-1{{/firstOrderedStop}}"
                    data-event-stop-tab
                    data-target="event-stop-{{stopId}}">{{tabLabel}}</button>
            {{/orderedStops}}
        </div>
        {{/hasMultipleStops}}
        <div class="event-stop-panels" id="eventStopPanels">
            {{#orderedStops}}
            <div class="event-stop-panel"
                 id="event-stop-{{stopId}}"
                 role="tabpanel"
                 {{#hasMultipleStops}}aria-labelledby="tab-event-stop-{{stopId}}"{{/hasMultipleStops}}
                 {{#stopPanelHidden}}hidden{{/stopPanelHidden}}>
                <div class="event-stop-meta">
                    <div class="event-stop-date">{{eventDate}}</div>
                    <div class="event-stop-title">{{displayTitle}}</div>
                    {{#hasVenue}}
                    <div class="event-stop-venue">{{venue}}</div>
                    {{/hasVenue}}
                </div>

                {{#hasDetail}}
                <p class="event-stop-detail">{{detail}}</p>
                {{/hasDetail}}

                {{#hasSetlist}}
                <div class="event-stop-block event-stop-block--setlist">
                    <h3 class="event-stop-block-title">
                        <span class="material-symbols-outlined" aria-hidden="true">graphic_eq</span>
                        셋리스트
                    </h3>
                    <div class="event-setlist-wrap">
                        <table class="event-setlist-table">
                            <thead>
                                <tr>
                                    <th scope="col" class="event-setlist-col-order">순서</th>
                                    <th scope="col" class="event-setlist-col-title">곡명</th>
                                    <th scope="col" class="event-setlist-col-note">비고</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#setlistRows}}
                                {{#section}}
                                <tr class="event-setlist-section">
                                    <td colspan="3">{{sectionLabel}}</td>
                                </tr>
                                {{/section}}
                                {{^section}}
                                {{#split}}
                                <tr class="event-setlist-split-row">
                                    <td class="event-setlist-col-order">{{#hasOrder}}{{orderNum}}{{/hasOrder}}</td>
                                    <td class="event-setlist-col-split" colspan="2">
                                        <div class="event-setlist-variants">
                                            {{#variants}}
                                            <div class="event-setlist-variant">
                                                <span class="event-setlist-song">{{title}}</span>
                                                {{#hasSubtitle}}
                                                <span class="event-setlist-album">{{subtitle}}</span>
                                                {{/hasSubtitle}}
                                                {{#hasNote}}
                                                <span class="event-setlist-album">{{note}}</span>
                                                {{/hasNote}}
                                            </div>
                                            {{/variants}}
                                        </div>
                                    </td>
                                </tr>
                                {{/split}}
                                {{^split}}
                                <tr>
                                    <td class="event-setlist-col-order">{{#hasOrder}}{{orderNum}}{{/hasOrder}}</td>
                                    <td class="event-setlist-col-title">
                                        <span class="event-setlist-song">{{title}}</span>
                                        {{#hasSubtitle}}
                                        <span class="event-setlist-album">{{subtitle}}</span>
                                        {{/hasSubtitle}}
                                    </td>
                                    <td class="event-setlist-col-note">{{#hasNote}}{{note}}{{/hasNote}}</td>
                                </tr>
                                {{/split}}
                                {{/section}}
                                {{/setlistRows}}
                            </tbody>
                        </table>
                    </div>
                </div>
                {{/hasSetlist}}

                {{^hasPanelContent}}
                <p class="event-stop-detail event-stop-detail--empty">상세 안내·셋리스트가 아직 등록되지 않았습니다.</p>
                {{/hasPanelContent}}
            </div>
            {{/orderedStops}}
        </div>
        {{/hasStops}}
        {{^hasStops}}
        <p class="text-sm text-[#b9cac4]/70 py-6 text-center">등록된 지역 회차가 없습니다.</p>
        {{/hasStops}}
    </section>

    {{#hasShopLink}}
    <section class="event-goods-section" aria-label="콘서트 굿즈">
        <a href="/shop/{{shopId}}" class="event-stop-block event-stop-block--goods event-goods-link">
            <span class="event-goods-link-main">
                <span class="event-stop-block-title event-goods-link-title">
                    <span class="material-symbols-outlined" aria-hidden="true">shopping_bag</span>
                    콘서트 굿즈
                </span>
                <span class="event-goods-link-meta">MD 리스트 보기</span>
            </span>
            <span class="event-goods-link-go" aria-hidden="true">→</span>
        </a>
    </section>
    {{/hasShopLink}}
    </div>
</div>
            {{/event}}

</main>
<script src="{{#asset}}/js/about-tabs.js{{/asset}}"></script>
<script>
(function () {
  var text = document.getElementById("eventInfoText");
  var btn = document.getElementById("eventInfoToggle");
  if (text && btn && text.scrollHeight > text.clientHeight + 2) {
    var collapsed = true;
    btn.hidden = false;
    btn.addEventListener("click", function () {
      collapsed = !collapsed;
      text.classList.toggle("max-h-[9.75rem]", collapsed);
      text.classList.toggle("overflow-hidden", collapsed);
      btn.textContent = collapsed ? "더 보기" : "접기";
      btn.setAttribute("aria-expanded", collapsed ? "false" : "true");
    });
  }

  var tabRoot = document.getElementById("eventStopTabs");
  var panelsRoot = document.getElementById("eventStopPanels");
  if (!tabRoot || !panelsRoot) return;

  function activateStopTab(btn) {
    if (!btn) return;
    var targetId = btn.getAttribute("data-target");
    tabRoot.querySelectorAll('[role="tab"]').forEach(function (tab) {
      var selected = tab === btn;
      tab.setAttribute("aria-selected", selected ? "true" : "false");
      tab.tabIndex = selected ? 0 : -1;
      tab.classList.toggle("is-active", selected);
    });
    panelsRoot.querySelectorAll('[role="tabpanel"]').forEach(function (panel) {
      panel.hidden = panel.id !== targetId;
    });
  }

  tabRoot.querySelectorAll('[role="tab"]').forEach(function (tab) {
    tab.addEventListener("click", function () {
      activateStopTab(tab);
    });
  });

  if (window.AboutTabs && typeof window.AboutTabs.enhanceTabs === "function") {
    window.AboutTabs.enhanceTabs(tabRoot, {
      onActivate: activateStopTab
    });
  } else {
    var initial = tabRoot.querySelector('[role="tab"].is-active')
      || tabRoot.querySelector('[role="tab"]');
    activateStopTab(initial);
  }
})();
</script>
{{>layout/page-end}}
