{{>layout/head-open}}
    <title>tripleS 커뮤</title>
    <link rel="stylesheet" href="/css/schedule-categories.css?v=6">
    <link rel="stylesheet" href="/css/main-page.css?v=2">
</head><body class="site-page main-page min-h-screen flex flex-col bg-background text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container">

<!-- 엠비언트 배경 은은한 빛 효과 -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-secondary-container/10 blur-[120px]"></div>
    <div class="absolute top-1/3 -right-32 w-[30rem] h-[30rem] rounded-full bg-primary-container/5 blur-[140px]"></div>
    <div class="absolute -bottom-32 left-1/3 w-[36rem] h-[36rem] rounded-full bg-primary-container/5 blur-[160px]"></div>
</div>

<!-- 헤더 레이아웃 포함 -->
{{>layout/header}}

<!-- 메인 레이아웃 컨테이너 -->
<main class="relative z-10 max-w-7xl w-full mx-auto px-4 py-6 flex flex-col gap-6">

    <!-- 1. 미디어 & 비디오 배너 섹션 -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-5">

        <!-- 비디오 영역 -->
        <div class="lg:col-span-7 bg-surface-container-low/80 border border-outline-variant/40 rounded-2xl p-4 backdrop-blur-md shadow-xl flex flex-col justify-between">
            <div class="flex items-center justify-between pb-3 mb-2 border-b border-outline-variant/30">
                <div class="flex items-center gap-2">
                    <span class="font-mono text-xs text-on-surface font-semibold tracking-wider">OFFICIAL MEDIA</span>
                </div>
                <span class="text-xs text-on-surface-variant font-mono">LOVE &amp; POP Pt.2 : Andless</span>
            </div>
            <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-black border border-outline-variant/30" id="home-yt-facade"
                 data-youtube-id="uqJ6GDJSyfY" data-youtube-title="tripleS LOVE &amp; POP Pt.2 : Andless">
                <button type="button" class="absolute inset-0 w-full h-full group cursor-pointer border-0 p-0 bg-transparent" aria-label="영상 재생">
                    <img src="https://i.ytimg.com/vi/uqJ6GDJSyfY/hqdefault.jpg" alt="" width="1280" height="720"
                         class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async">
                    <span class="absolute inset-0 bg-black/35 group-hover:bg-black/20 transition-colors"></span>
                    <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-red-600/95 text-white flex items-center justify-center shadow-lg">
                        <span class="material-symbols-outlined text-3xl leading-none" style="margin-left:2px">play_arrow</span>
                    </span>
                </button>
            </div>
            <script>
            (function () {
                var box = document.getElementById('home-yt-facade');
                if (!box) return;
                box.addEventListener('click', function () {
                    var id = box.getAttribute('data-youtube-id');
                    var title = box.getAttribute('data-youtube-title') || '';
                    var iframe = document.createElement('iframe');
                    iframe.className = 'w-full h-full';
                    iframe.title = title;
                    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
                    iframe.allowFullscreen = true;
                    iframe.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
                    box.replaceChildren(iframe);
                }, { once: true });
            })();
            </script>
        </div>

        <!-- 메인 이미지 캐러셀 배너 -->
        <a href="{{albumHref}}" class="main-hero-card lg:col-span-5 bg-surface-container-low/80 border border-outline-variant/40 rounded-2xl p-4 backdrop-blur-md shadow-xl flex flex-col relative overflow-hidden group no-underline">
            <div class="main-hero-visual relative w-full h-full min-h-[240px] rounded-xl overflow-hidden flex flex-col justify-end p-5 bg-cover bg-center" style="background-image: url('../../../uploads/images/andless.webp');">
                <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent"></div>
                <span class="main-hero-sheen" aria-hidden="true"></span>

                <div class="relative z-10 space-y-1.5">
                    <span class="inline-block px-2.5 py-0.5 rounded-full bg-primary-container/20 border border-primary-container text-primary-container text-[11px] font-semibold">컴백</span>
                    <h3 class="text-xl font-bold text-on-surface">LOVE &amp; POP Pt.2 : Andless</h3>
                    <p class="text-xs text-on-surface-variant line-clamp-2">끝나지 않을 영원한 트리플에스의 스토리</p>
                    <span class="main-hero-cta">발매 앨범 보기 <span class="material-symbols-outlined text-sm">arrow_forward</span></span>
                </div>
            </div>
        </a>
    </section>

    <!-- 2. 아티스트 소개 섹션 -->
    <section class="main-fade-up bg-surface-container-low/80 border border-outline-variant/40 rounded-2xl p-6 backdrop-blur-md shadow-xl">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
            <div class="md:col-span-4 rounded-xl overflow-hidden border border-outline-variant/30 aspect-video md:aspect-[4/3]">
                <img src="/../../uploads/images/tripleS.jpg" alt="tripleS" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
            </div>
            <div class="md:col-span-8 space-y-3">
                <div class="flex items-center gap-3">
                    <span class="w-1.5 h-6 bg-primary-container rounded-full"></span>
                    <a href="/artist" class="text-2xl font-bold text-on-surface hover:text-primary-container transition-colors">Who is tripleS?</a>
                </div>
                <p class="text-sm text-on-surface-variant leading-relaxed text-justify">
                    tripleS(트리플에스)는 모드하우스가 결성한 대한민국의 24인조 걸그룹이다. 팬들이 직접 멤버 조합과 활동을 결정하는 팬 참여형 투표 시스템 '디멘션(Dimension)'을 바탕으로 국내 최다 인원 걸그룹으로 활동하고 있다.
                </p>
                <div>
                    <a href="/triples/artist" class="inline-flex items-center gap-1 text-xs text-primary-container hover:underline font-medium">
                        트리플에스에 대해 더 알고 싶다면 <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. 스케줄: 미니 달력 + 다가오는 일정 -->
    <section class="main-fade-up bg-surface-container-low/80 border border-outline-variant/40 rounded-2xl p-5 backdrop-blur-md shadow-xl">
        <div class="flex items-center justify-between border-b border-outline-variant/30 pb-3 mb-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary-container text-xl">calendar_month</span>
                <h3 class="text-base font-bold text-on-surface">스케줄</h3>
            </div>
            <a href="/schedule" class="text-xs text-on-surface-variant hover:text-primary-container flex items-center gap-0.5 transition-colors">
                전체 달력 <span class="material-symbols-outlined text-sm">chevron_right</span>
            </a>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
            <div class="lg:col-span-5 flex">
                <div id="miniCalendar" class="main-mini-calendar w-full min-h-[12rem]" aria-label="이번 달 미니 캘린더"></div>
            </div>
            <div class="lg:col-span-7 flex flex-col min-w-0">
                <div class="flex items-center justify-between gap-3 mb-3">
                    <p class="text-xs font-semibold tracking-wide text-on-surface-variant">다가오는 일정</p>
                    <span class="text-[10px] font-mono text-on-surface-variant/70">오늘 기준</span>
                </div>
                <ul class="main-upcoming-list flex flex-col gap-2 flex-1">
                    {{#upcomingSchedules}}
                    <li>
                        <a href="/schedule" class="main-upcoming-item" style="--schedule-color: {{color}}">
                            <span class="main-upcoming-date">{{dateLabel}}</span>
                            <span class="main-upcoming-body">
                                <span class="main-upcoming-title">{{displayTitle}}</span>
                                {{#categoryLabel}}<span class="main-upcoming-category">{{categoryLabel}}</span>{{/categoryLabel}}
                            </span>
                            <span class="material-symbols-outlined main-upcoming-chevron" aria-hidden="true">chevron_right</span>
                        </a>
                    </li>
                    {{/upcomingSchedules}}
                    {{^upcomingSchedules}}
                    <li class="main-upcoming-empty">등록된 일정이 없습니다.</li>
                    {{/upcomingSchedules}}
                </ul>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <div class="main-fade-up bg-surface-container-low/80 border border-outline-variant/40 rounded-2xl p-5 backdrop-blur-md shadow-xl">
            <div class="flex items-center justify-between border-b border-outline-variant/30 pb-3 mb-4">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary-container text-xl">photo_library</span>
                    <h3 class="text-base font-bold text-on-surface">사진 아카이브</h3>
                </div>
                <a href="/archive/image_archive" class="text-xs text-on-surface-variant hover:text-primary-container flex items-center gap-0.5 transition-colors">
                    전체보기 <span class="material-symbols-outlined text-sm">chevron_right</span>
                </a>
            </div>
            <div class="grid grid-cols-2 gap-3">
                {{#recentPhotos}}
                    <a href="/archive/image_archive" class="main-archive-card group block rounded-xl overflow-hidden border border-outline-variant/30 bg-black/30 no-underline">
                        <img src="{{file.url}}" alt="{{title}}" referrerpolicy="no-referrer" loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105">
                        <span class="block truncate px-2.5 py-2 text-xs font-medium text-on-surface">{{title}}</span>
                    </a>
                {{/recentPhotos}}
                {{^recentPhotos}}
                    <p class="col-span-full py-6 text-center text-sm text-on-surface-variant/60">등록된 사진이 없습니다.</p>
                {{/recentPhotos}}
            </div>
        </div>
        <div class="main-fade-up bg-surface-container-low/80 border border-outline-variant/40 rounded-2xl p-5 backdrop-blur-md shadow-xl">
            <div class="flex items-center justify-between border-b border-outline-variant/30 pb-3 mb-4">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary-container text-xl">movie</span>
                    <h3 class="text-base font-bold text-on-surface">영상 아카이브</h3>
                </div>
                <a href="/archive/video_archive" class="text-xs text-on-surface-variant hover:text-primary-container flex items-center gap-0.5 transition-colors">
                    전체보기 <span class="material-symbols-outlined text-sm">chevron_right</span>
                </a>
            </div>
            <div class="grid grid-cols-2 gap-3">
                {{#recentVideos}}
                    <a href="/archive/video_archive" class="main-archive-card group block rounded-xl overflow-hidden border border-outline-variant/30 bg-black/30 no-underline">
                        {{#thumbnailUrl}}<img src="{{thumbnailUrl}}" alt="{{title}}" referrerpolicy="no-referrer" loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105">{{/thumbnailUrl}}
                        {{^thumbnailUrl}}<span class="main-video-placeholder aspect-[4/3] w-full flex items-center justify-center text-xs text-on-surface-variant">영상 아카이브</span>{{/thumbnailUrl}}
                        <span class="block truncate px-2.5 py-2 text-xs font-medium text-on-surface">{{title}}</span>
                    </a>
                {{/recentVideos}}
                {{^recentVideos}}
                    <p class="col-span-full py-6 text-center text-sm text-on-surface-variant/60">등록된 영상이 없습니다.</p>
                {{/recentVideos}}
            </div>
        </div>
    </section>

</main>

<!-- 푸터 레이아웃 포함 -->
<!-- FullCalendar: 홈 미니 캘린더 (컴팩트 · 일정은 점만 표시) -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales/ko.global.min.js"></script>
<script>
(function () {
    const calendarEl = document.getElementById("miniCalendar");
    if (!calendarEl || typeof FullCalendar === "undefined") return;
    const schedules = {{{schedulesJson}}} || [];

    const miniCalendar = new FullCalendar.Calendar(calendarEl, {
        initialView: "dayGridMonth",
        locale: "ko",
        height: "auto",
        contentHeight: 240,
        fixedWeekCount: false,
        showNonCurrentDates: false,
        dayMaxEvents: 3,
        eventDisplay: "list-item",
        headerToolbar: { left: "", center: "title", right: "prev,next" },
        events: (schedules || []).map(function (item) {
            const event = {
                id: item.id,
                title: item.displayTitle || item.title,
                start: item.start,
                color: item.color,
                display: "list-item",
                extendedProps: item
            };
            if (item.end) event.end = item.end;
            return event;
        }),
        eventDidMount: function (info) {
            info.el.style.setProperty("--schedule-color", info.event.extendedProps.color || "#00f5d4");
            info.el.title = info.event.title || "";
        },
        dateClick: function () { window.location.href = "/schedule"; },
        eventClick: function () { window.location.href = "/schedule"; }
    });
    miniCalendar.render();
})();
</script>
<script src="/js/main-page.js?v=1" defer></script>
{{>layout/page-end}}
