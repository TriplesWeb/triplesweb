<!DOCTYPE html>
<html class="dark" lang="en" data-chem-lang="en">
<head>
    {{>layout/triples-head}}
    <title>tripleS Community — Chemistry Names</title>
</head>
<body class="bg-[#0d0e12] text-[#ffffff] min-h-screen">
{{>layout/header}}

<main class="main-content chem-page-main">
    <div class="card-box chem-page-card bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-3 sm:p-4 shadow-xl">
        <div class="chem-page-head flex flex-col gap-2">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div class="chem-title-row">
                    <h2 class="text-xl sm:text-2xl font-bold text-[#ffffff] flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#00f5d4]"></span> tripleS Chemistry
                    </h2>
                    <div class="chem-legend-wrap">
                        <button type="button" id="chemLegendToggle" class="chem-legend-btn" aria-expanded="false" aria-controls="chemLegendPanel" title="Color legend" aria-label="Color legend">
                            <svg class="chem-legend-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                                <circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.5"/>
                                <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
                                      d="M9.15 13.35c-.55-.7-.9-1.55-.9-2.5A3.75 3.75 0 0 1 12 7.1a3.75 3.75 0 0 1 3.75 3.75c0 .95-.35 1.8-.9 2.5"/>
                                <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
                                      d="M10.15 13.55h3.7v1.35c0 .55-.35.95-.85 1.15v.75h-2v-.75c-.5-.2-.85-.6-.85-1.15z"/>
                                <path fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"
                                      d="M10.55 11.05h2.9M11.05 9.55h1.9"/>
                            </svg>
                        </button>
                        <div id="chemLegendPanel" class="chem-legend-panel hidden" role="dialog" aria-label="Chemistry name color legend">
                            <p class="chem-legend-title">Text color</p>
                            <ul class="chem-legend-list">
                                <li><span class="chem-legend-swatch chem-legend-swatch--none" aria-hidden="true"></span> Official (white)</li>
                                <li><span class="chem-legend-swatch chem-legend-swatch--undecided" aria-hidden="true"></span> Undecided (purple)</li>
                                <li><span class="chem-legend-swatch chem-legend-swatch--recent" aria-hidden="true"></span> Recently confirmed (pink)</li>
                                <li><span class="chem-legend-swatch chem-legend-swatch--fan" aria-hidden="true"></span> WAV pick (sky)</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2 chem-page-actions">
                    <div class="chem-mode-toggle" role="group" aria-label="Chemistry group size">
                        <button type="button" class="chem-mode-btn is-active" data-mode="pair" aria-pressed="true" onclick="window.__chemSetMode&&window.__chemSetMode('pair')">Pair</button>
                        <button type="button" class="chem-mode-btn" data-mode="trio" aria-pressed="false" onclick="window.__chemSetMode&&window.__chemSetMode('trio')">3+</button>
                    </div>
                    <a href="/triples/chemistry" class="chem-lang-btn" hreflang="ko" lang="ko" title="한국어로 보기">한국어</a>
                    <button type="button" id="chemAdminBtn" class="chem-admin-btn hidden" aria-pressed="false">Admin</button>
                </div>
            </div>
            <p class="text-base font-semibold text-[#ffffff]">English names/descriptions when set; otherwise Korean chemistry names are shown. Member names open profiles.</p>
            <p id="chemAdminHint" class="chem-admin-hint hidden">관리자 모드: 빈 칸을 눌러 추가하고, 케미를 연 뒤 수정할 수 있어요.</p>
            <div id="chemEmptyState" class="chem-empty-state hidden" role="status" aria-hidden="true">
                <p class="chem-empty-title">No English chemistry names yet</p>
                <p class="chem-empty-desc" data-chem-empty-hint>No English chemistry names have been registered.</p>
            </div>
        </div>

        <div id="chemPairView">
            <div class="chem-pair-filter" id="chemPairFilter">
                <label class="chem-pair-filter-label">
                    <span>Member A</span>
                    <select id="chemFilterA" class="chem-pair-filter-select" aria-label="First member"></select>
                </label>
                <label class="chem-pair-filter-label">
                    <span>Member B</span>
                    <select id="chemFilterB" class="chem-pair-filter-select" aria-label="Second member"></select>
                </label>
                <button type="button" id="chemFilterGo" class="chem-mode-btn">Go to cell</button>
                <p class="chem-pair-filter-hint">Scroll the table sideways, or pick two members to jump to their cell.</p>
            </div>
            <div class="chem-table-wrap">
                <table id="chemistryTable" class="chem-table" aria-label="Member chemistry name matrix">
                    <thead id="chemThead"></thead>
                    <tbody id="chemTbody">
                        <tr>
                            <td colspan="25" class="text-center text-[#b9cac4] py-10 text-sm">Loading chemistry table…</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="chem-trio-view hidden" id="chemTrioView" aria-live="polite">
            <div class="mpp-toolbar">
                <div>
                    <p class="mpp-toolbar-title">Select members</p>
                    <p class="mpp-toolbar-meta" id="chemTrioMeta">Select members to see related chemistry. 1, 2, or 3+ all work.</p>
                </div>
                <div class="mpp-toolbar-actions">
                    <button type="button" class="mpp-tool-btn" id="chemTrioClear">Clear</button>
                    <a href="#chemTrioResults" id="chemTrioJump" class="mpp-tool-btn chem-trio-jump hidden">View results</a>
                    <button type="button" class="chem-mode-btn chem-trio-back" data-mode="pair" onclick="window.__chemSetMode&&window.__chemSetMode('pair')">View pairs</button>
                </div>
            </div>
            <div class="member-portrait-picker" id="chemTrioPicker" role="group" aria-label="3+ chemistry member picker">
                {{>partials/member-portrait-picker}}
            </div>
            <div id="chemTrioResults" class="chem-trio-results" aria-live="polite"></div>
        </div>
    </div>
</main>

{{>triples/partials/chemistry-modals}}

{{>layout/footer}}
<script src="/js/about-admin-auth.js?v=2"></script>
<script src="/js/about-modal.js?v=1"></script>
<script src="/js/triples-members.js?v=1"></script>
<script src="/js/chemistry-sanitize.js?v=1"></script>
<script src="/js/member-portrait-picker.js?v=2"></script>
<script src="/js/chemistry.js?v=55"></script>
</body>
</html>
