<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        트리플에스 커뮤니티 -{{artist.name}}
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen">
{{>layout/header}}
<main class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 flex-1">

{{#artist}}
        <section id="triplesMemberProfileSection" class="bg-surface-container-low/70 backdrop-blur-2xl border border-outline-variant/30 rounded-2xl p-6 lg:p-10 mb-12 relative overflow-hidden shadow-2xl">
            <div id="triplesMemberProfile" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 shadow-xl">
                <div class="lg:col-span-4 relative group">
                    <div class="member-image relative w-full aspect-[4/5] rounded-2xl overflow-hidden border border-outline-variant/40 bg-black/50 shadow-inner">
                        <img src="/uploads/images/{{engName}}.jpg" class="w-full h-full object-cover transition-transform" alt="{{name}}" width=500px height=500px />
                    </div>
                </div>
                <div class="lg:col-span-8 space-y-6">
                    <div class="member-name-label border-b border-outline-variant/30 pb-4 font-bold text-[#e3e2e8] mb-6 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 inline-block rounded-full bg-[#00f5d4]"></span>
                        <h1 class="text-3xl font-extrabold text-on-surface tracking-tight">
                            {{name}}
                        </h1>
                        <span class="text-sm font-mono text-on-surface-variant pl-2">{{engName}}</span>
                    </div>
                    <div id="member-info" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="bg-surface-container-high/40 border border-outline-variant/30 rounded-xl p-3.5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-on-surface-variant">이름</span>
                            <span class="text-sm font-medium text-on-surface">{{name}}</span> </div>
                        <div class="bg-surface-container-high/40 border border-outline-variant/30 rounded-xl p-3.5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-on-surface-variant">출생</span>
                            <span class="text-sm font-medium text-on-surface font-mono">{{birthDate}}</span> </div>
                        <div class="bg-surface-container-high/40 border border-outline-variant/30 rounded-xl p-3.5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-on-surface-variant">출신지</span>
                            <span class="text-sm font-medium text-on-surface">{{birthPlace}}</span> </div>
                        <div class="bg-surface-container-high/40 border border-outline-variant/30 rounded-xl p-3.5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-on-surface-variant">국적</span>
                            <span class="text-sm font-medium text-on-surface">{{nationality}}</span> </div>
                        <div class="bg-surface-container-high/40 border border-outline-variant/30 rounded-xl p-3.5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-on-surface-variant">데뷔일</span>
                            <span class="text-sm font-medium text-primary-container font-mono">{{debutDate}}</span> </div> <!-- 상징 색 (컬러 칩 미리보기 적용) -->
                        <div class="bg-surface-container-high/40 border border-outline-variant/30 rounded-xl p-3.5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-on-surface-variant">상징 색</span>
                            <div class="flex items-center gap-2">
                            <span class="w-3.5 h-3.5 rounded-full border border-white/20 shadow-sm" style="background-color: {{color}};"></span>
                            <span class="text-sm font-medium text-on-surface font-mono">{{color}}</span>
                            </div>
                        </div>
                    </div>
                        <div class="bg-surface-container-high/40 border border-outline-variant/30 rounded-xl p-4 space-y-2.5">
                            <span class="text-xl font-semibold text-on-surface-variant block whitespace-nowrap">역대 소속 유닛</span> <!-- JS 연동용 타겟 컨테이너 -->
                            <div id="unit-list-container" class="flex flex-wrap gap-2"></div> <!-- 원본 히든 데이터 (Mustache 반복문 유지) -->
                            <div id="raw-unit-data" class="hidden">
                                {{#affiliatedUnit}}
                                    <a class="unit-item" href="/triples/unit/{{unit.unitId}}">{{unit.unitName}}</a>
                                {{/affiliatedUnit}}
                            </div>
                        </div>
                </div>
            </div>
        </section>
{{/artist}}
    <div class="member-activities text-xl text-[#b9cac4] space-y-2">
        <h2>멤버 단독 컨텐츠</h2>
        <h2>출연한 방송</h2>
    </div>
</main>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const unitElements = document.querySelectorAll('#raw-unit-data .unit-item');
        const targetContainer = document.getElementById('unit-list-container');
        if (unitElements.length > 0) {
            unitElements.forEach(el => {
                const a = document.createElement('a');
                a.href = el.getAttribute('href');
                a.textContent = el.textContent.trim();
                a.className = "inline-flex items-center whitespace-nowrap px-3 py-1 rounded-full bg-surface-container-highest/80 hover:bg-primary-container/20 border border-outline-variant/50 hover:border-primary-container/50 text-xl font-medium text-on-surface hover:text-primary-container transition-all";
                targetContainer.appendChild(a);
            });
        } else {
            const span = document.createElement('span');
            span.textContent = '소속 유닛 없음';
            span.className = "text-xs text-on-surface-variant/60 font-mono";
            targetContainer.appendChild(span); } });
</script>
</body>
</html>