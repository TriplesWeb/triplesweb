{{>layout/v2/head-open}}

    
    <title>트리플에스 커뮤니티 - 발매 앨범</title>
<link rel="stylesheet" href="/css/v2-pages.css?v=1">
</head><body class="v2-body site-page min-h-screen">
{{>layout/v2/header}}
<main class="main-content max-w-7xl mx-auto px-4 py-8">
    {{#album}}
<div class="card-box album-detail-card border rounded-2xl p-6 lg:p-8 space-y-8">
    <p class="album-detail-back"><a href="/triples/album">← 앨범 목록</a></p>

    <div id="albumDetailTable" class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start border-b pb-8 min-w-0">
             <div id="albumImage" class="md:col-span-4 lg:col-span-3 flex justify-center">
                 <img src="{{displayAlbumImage}}" width="300" height="300" alt="{{albumName}}" class="w-full max-w-[260px] aspect-square object-cover rounded-2xl border " />
             </div>
        <div class="md:col-span-8 lg:col-span-9 space-y-5">
            <div>
                <h1 class="text-3xl lg:text-4xl font-extrabold tracking-tight">{{albumName}}</h1>
            </div>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                    <span class="inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-base">calendar_today</span>
                        <span>발매일: <strong class="font-mono">{{releaseDate}}</strong></span>
                    </span>
                    {{#hasAlbumFormat}}
                    <span class="inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-base">album</span>
                        <span>규격: <strong class="">{{albumFormatLabel}}</strong></span>
                    </span>
                    {{/hasAlbumFormat}}
                </div>
        <div class="pt-2">
                <h3 class="text-xs font-semibold uppercase tracking-wider mb-2 ">참여 유닛</h3>
            {{#unit}}
                <div class="flex items-center gap-3 overflow-x-auto pb-1">
                    {{#subUnits}}
                        <a href="/triples/unit/{{unitId}}" class="bg-transparent border flex items-center gap-3 px-4 py-2 rounded-xl transition-all shrink-0 no-underline">
                            <img src="{{displayUnitImage}}" class="w-10 h-10 rounded-full object-cover border" alt="{{unitName}}">
                            <span class="unitMember-item text-xs font-bold">{{unitName}}</span>
                        </a>
                    {{/subUnits}}
                    {{^subUnits}}
                        <a href="/triples/unit/{{unitId}}" class="border flex items-center gap-3 px-4 py-2 rounded-xl transition-all shrink-0 no-underline">
                            <img src="{{displayUnitImage}}" class="w-10 h-10 rounded-full object-cover border" alt="{{unitName}}">
                            <span class="text-sm font-bold">{{unitName}}</span>
                        </a>
                    {{/subUnits}}
                </div>
            {{/unit}}
            {{^unit}}
                {{#full10}}
                    <div class="inline-flex items-center gap-2 border px-3 py-1.5 rounded-xl text-xs font-bold">
                        <span class="material-symbols-outlined text-base">groups</span>
                        <span>10인 완전체 앨범</span>
                    </div>
                {{/full10}}
                {{#full24}}
                <div class="inline-flex items-center gap-2 border px-3 py-1.5 rounded-xl text-xs font-bold">
                    <span class="material-symbols-outlined text-base">groups</span>
                    <span>24명 완전체 앨범</span>
                </div>
                {{/full24}}
            {{/unit}}
        </div>
            {{#hasAlbumInfo}}
            <div class="pt-1">
                <h3 class="text-xs font-semibold uppercase tracking-wider mb-2">소개</h3>
                <p id="albumInfoText" class="text-sm leading-relaxed whitespace-pre-wrap max-h-[9.75rem] overflow-hidden">{{albumInfo}}</p>
                <button type="button" id="albumInfoToggle" class="mt-2 text-sm font-semibold transition-colors" hidden aria-expanded="false" aria-controls="albumInfoText">더 보기</button>
            </div>
            {{/hasAlbumInfo}}
        </div>
    </div>

    <div class="space-y-4 album-track-section min-w-0">
    <h2 class="text-xl font-bold flex items-center gap-2">
        <span class="material-symbols-outlined">graphic_eq</span> 트랙리스트
    </h2>
    <div class="album-track-scroll rounded-xl border min-w-0">
        <table class="album-track-table w-full text-left text-sm">
            <thead class="text-xs font-semibold border-b">
            <tr>
                <th class="album-track-num py-3.5 px-3 text-center">#</th>
                <th class="album-track-title-col py-3.5 px-3">제목</th>
                <th class="album-track-dur py-3.5 px-3 text-center">시간</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-[#3a4a46]/20">
        {{#tracks}}
            <tr class="transition-colors group">
                <td class="album-track-num py-3 px-3 text-center font-mono text-xs">{{trackNum}}</td>
                <td class="album-track-title-col py-3 px-3 font-medium">
                    <div class="album-track-title-row">
                        <span class="album-track-name transition-colors">{{title}}</span>
                        {{#isTitle}}
                            <span class="album-track-badge text-[10px] font-extrabold border px-1.5 py-0.5 rounded tracking-wide">TITLE</span>
                        {{/isTitle}}
                    </div>
                    <div class="album-track-links">
                        {{#youtubeVideoId}}
                        <a href="https://www.youtube.com/watch?v={{youtubeVideoId}}" target="_blank" rel="noopener noreferrer" aria-label="{{title}} 유튜브 시청" class="album-track-link album-track-link-yt">YouTube</a>
                        {{/youtubeVideoId}}
                        {{#melonSongId}}
                        <a href="https://www.melon.com/song/detail.htm?songId={{melonSongId}}" target="_blank" rel="noopener noreferrer" aria-label="{{title}} 멜론 듣기" class="album-track-link">Melon</a>
                        {{/melonSongId}}
                    </div>
                </td>
                <td class="album-track-dur py-3 px-3 text-center font-mono text-xs">{{duration}}</td>
            </tr>
        {{/tracks}}
        {{^tracks}}
            <tr>
                <td colspan="3" class="py-8 px-4 text-center">등록된 트랙이 없습니다.</td>
            </tr>
        {{/tracks}}
        </tbody>
    </table>
    </div>
    </div>
</div>
            {{/album}}

</main>
<script>
(function () {
  var text = document.getElementById("albumInfoText");
  var btn = document.getElementById("albumInfoToggle");
  if (!text || !btn) return;
  if (text.scrollHeight <= text.clientHeight + 2) return;

  var collapsed = true;
  btn.hidden = false;
  btn.addEventListener("click", function () {
    collapsed = !collapsed;
    text.classList.toggle("max-h-[9.75rem]", collapsed);
    text.classList.toggle("overflow-hidden", collapsed);
    btn.textContent = collapsed ? "더 보기" : "접기";
    btn.setAttribute("aria-expanded", collapsed ? "false" : "true");
  });
})();
</script>
{{>layout/v2/footer}}
