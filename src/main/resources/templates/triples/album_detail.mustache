<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>트리플에스 커뮤니티 - 발매 앨범</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen">
{{>layout/header}}
<main class="main-content max-w-7xl mx-auto px-4 py-8">
    {{#album}}
<div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 lg:p-8 shadow-xl space-y-8">

    <div id="albumDetailTable" class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start border-b border-[#3a4a46]/30 pb-8">
             <div id="albumImage" class="md:col-span-4 lg:col-span-3 flex justify-center">
                 <img src="{{displayAlbumImage}}" width="300" height="300" alt="{{albumName}}" class="w-full max-w-[260px] aspect-square object-cover rounded-2xl border border-[#3a4a46]/40 shadow-2xl " />
             </div>
        <div class="md:col-span-8 lg:col-span-9 space-y-5">
            <div>
                <h1 class="text-3xl lg:text-4xl font-extrabold text-[#e3e2e8] tracking-tight">{{albumName}}</h1>
            </div>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[#b9cac4]">
                    <span class="inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-base text-[#00f5d4]">calendar_today</span>
                        <span>발매일: <strong class="text-[#e3e2e8] font-mono">{{releaseDate}}</strong></span>
                    </span>
                    {{#hasAlbumFormat}}
                    <span class="inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-base text-[#00f5d4]">album</span>
                        <span>규격: <strong class="text-[#e3e2e8]">{{albumFormatLabel}}</strong></span>
                    </span>
                    {{/hasAlbumFormat}}
                </div>
        <div class="pt-2">
                <h3 class="text-xs font-semibold text-[#b9cac4] uppercase tracking-wider mb-2 ">참여 유닛</h3>
            {{#unit}}
                <div class="flex items-center gap-3 overflow-x-auto pb-1">
                    {{#subUnits}}
                        <a href="/triples/unit/{{unitId}}" class="bg-transparent border border-[#3a4a46]/30 text-[#b9cac4] hover:text-[#00f5d4] flex items-center gap-3 px-4 py-2 rounded-xl transition-all shrink-0 no-underline">
                            <img src="{{displayUnitImage}}" class="w-10 h-10 rounded-full object-cover border border-[#3a4a46]/50" alt="{{unitName}}">
                            <span class="unitMember-item text-xs font-bold">{{unitName}}</span>
                        </a>
                    {{/subUnits}}
                    {{^subUnits}}
                        <a href="/triples/unit/{{unitId}}" class="bg-white/5 hover:bg-white/10 border border-[#3a4a46]/30 hover:border-[#00f5d4]/50 text-[#b9cac4] hover:text-[#00f5d4] flex items-center gap-3 px-4 py-2 rounded-xl transition-all shrink-0 no-underline">
                            <img src="{{displayUnitImage}}" class="w-10 h-10 rounded-full object-cover border border-[#3a4a46]/50" alt="{{unitName}}">
                            <span class="text-sm font-bold">{{unitName}}</span>
                        </a>
                    {{/subUnits}}
                </div>
            {{/unit}}
            {{^unit}}
                {{#full10}}
                    <div class="inline-flex items-center gap-2 bg-[#00f5d4]/10 text-[#00f5d4] border border-[#00f5d4]/30 px-3 py-1.5 rounded-xl text-xs font-bold">
                        <span class="material-symbols-outlined text-base">groups</span>
                        <span>10인 완전체 앨범</span>
                    </div>
                {{/full10}}
                {{#full24}}
                <div class="inline-flex items-center gap-2 bg-[#00f5d4]/10 text-[#00f5d4] border border-[#00f5d4]/30 px-3 py-1.5 rounded-xl text-xs font-bold">
                    <span class="material-symbols-outlined text-base">groups</span>
                    <span>24명 완전체 앨범</span>
                </div>
                {{/full24}}
            {{/unit}}
        </div>
            {{#hasAlbumInfo}}
            <div class="pt-1">
                <h3 class="text-xs font-semibold text-[#b9cac4] uppercase tracking-wider mb-2">소개</h3>
                <p id="albumInfoText" class="text-sm leading-relaxed text-[#e3e2e8]/90 whitespace-pre-wrap max-h-[9.75rem] overflow-hidden">{{albumInfo}}</p>
                <button type="button" id="albumInfoToggle" class="mt-2 text-sm font-semibold text-[#00f5d4] hover:text-[#7dffe8] transition-colors" hidden aria-expanded="false" aria-controls="albumInfoText">더 보기</button>
            </div>
            {{/hasAlbumInfo}}
        </div>
    </div>

    <div class="space-y-4">
    <h2 class="text-xl font-bold text-[#e3e2e8] flex items-center gap-2">
        <span class="material-symbols-outlined text-[#00f5d4]">graphic_eq</span> 트랙리스트
    </h2>
    <div class="rounded-xl border border-[#3a4a46]/30">
        <table class="w-full text-left text-sm text-[#b9cac4]">
            <thead class="bg-[#101116] text-[#e3e2e8] text-xs font-semibold border-b border-[#3a4a46]/30">
            <tr>
                <th class="py-3.5 px-4 w-14 text-center">트랙 순서</th>
                <th class="py-3.5 px-4 w-20">제목</th>
                <th class="py-3.5 px-6 w-28 text-center">재생 시간</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-[#3a4a46]/20 bg-[#16181f]/40">
        {{#tracks}}
            <tr class="hover:bg-[#202430]/60 transition-colors group">
                <td class="py-4 px-4 text-center font-mono text-xs text-[#8b9b95]">{{trackNum}}</td>
                <td class="py-4 px-4 font-medium text-[#e3e2e8]">
                    <div class="flex items-center gap-2">
                        <span class="group-hover:text-[#00f5d4] transition-colors">{{title}}</span>
                        {{#isTitle}}
                            <span class="text-[10px] font-extrabold bg-[#00f5d4]/20 text-[#00f5d4] border border-[#00f5d4]/40 px-1.5 py-0.5 rounded tracking-wide">TITLE</span>
                        {{/isTitle}}
                        <a href="https://www.youtube.com/results?search_query={{title}}+tripleS" target="_blank" rel="noopener noreferrer" aria-label="{{title}} 유튜브 검색" class="inline-flex items-center gap-1 rounded-lg border border-[#00f5d4]/30 px-2 py-1 text-xs text-[#00f5d4] no-underline">YouTube</a>
                        <a href="https://www.melon.com/search/total/index.htm?q={{title}}" target="_blank" rel="noopener noreferrer" aria-label="{{title}} 멜론 검색" class="inline-flex items-center rounded-lg border border-white/15 px-2 py-1 text-xs text-[#b9cac4] no-underline">Melon</a>
                    </div>
                </td>
                <td class="py-4 px-4 text-center font-mono text-xs text-[#8b9b95]">{{duration}}</td>
            </tr>
        {{/tracks}}
        {{^tracks}}
            <tr>
                <td colspan="3" class="py-8 px-4 text-center text-[#b9cac4]/60">등록된 트랙이 없습니다.</td>
            </tr>
        {{/tracks}}
        </tbody>
    </table>
    </div>
    </div>
</div>
            {{/album}}

</main>
{{>layout/footer}}
<script>
(function () {
  var text = document.getElementById("albumInfoText");
  var btn = document.getElementById("albumInfoToggle");
  if (!text || !btn) return;
  if (text.scrollHeight <= text.clientHeight + 2) return;

  var collapsed = true;
  btn.hidden = false;
  btn.addEventListener("click", function () {
    collapsed = !collapsed;
    text.classList.toggle("max-h-[9.75rem]", collapsed);
    text.classList.toggle("overflow-hidden", collapsed);
    btn.textContent = collapsed ? "더 보기" : "접기";
    btn.setAttribute("aria-expanded", collapsed ? "false" : "true");
  });
})();
</script>
</body>
</html>
