{{>layout/head-open}}

<link rel="stylesheet" href="{{#asset}}/css/about-admin.css{{/asset}}">
    <title>트리플에스 커뮤니티 - 발매 앨범</title>
<style>[data-album-edit][hidden], #albumAddBtn[hidden], #albumSectionBtn[hidden]{display:none!important}</style>
</head><body class="site-page bg-[#0d0e12] text-[#e3e2e8] min-h-screen about-admin-page">
{{>layout/header}}

<main class="main-content max-w-7xl mx-auto px-4 py-8">
    <div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 shadow-xl">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <h2 class="text-2xl font-bold text-[#e3e2e8] flex items-center gap-2 m-0">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00f5d4]"></span> 트리플에스의 발매 앨범
            </h2>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" id="albumSectionBtn" hidden class="about-mode-btn about-admin-only is-active btn btn-sm btn-outline btn-primary btn-active">구분 관리</button>
                <button type="button" id="albumAddBtn" hidden class="about-mode-btn about-admin-only is-active btn btn-sm btn-outline btn-primary btn-active">앨범 추가</button>
            </div>
        </div>
        <p id="albumAdminHint" class="about-admin-hint hidden mb-4">관리자 모드: 구분을 만들고 앨범을 배정하거나, 카드의 수정 버튼으로 편집할 수 있어요.</p>

        <ul class="site-section-tabs nav nav-tabs{{^albumSections}} hidden{{/albumSections}}" id="albumSectionTabs" role="tablist">
            {{#albumSections}}
            <button class="site-section-tab nav-tab-btn album-section-tab" id="tab-{{tabKey}}" data-target="#{{tabKey}}" type="button" role="tab" title="{{name}}">
                {{name}}
            </button>
            {{/albumSections}}
        </ul>

        <div class="tab-content mt-6" id="albumSectionTabContent">
            {{#albumSections}}
            <div class="tab-pane hidden" id="{{tabKey}}" role="tabpanel" aria-labelledby="tab-{{tabKey}}">
                <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 list-none p-0 m-0">
                    {{#albums}}
                    <li class="relative">
                        <a href="/triples/album/{{albumId}}" class="block text-center no-underline text-[#e3e2e8] hover:text-[#00f5d4] transition-colors">
                            <img src="{{displayAlbumImage}}" width="200" height="200" alt="{{albumName}}" loading="lazy" decoding="async" class="w-full aspect-square object-cover rounded-lg mb-2 border border-[#3a4a46]/30">
                            <div class="text-sm sm:text-base font-semibold">{{albumName}}</div>
                            <div class="text-xs text-[#8b9b95] mt-1 font-mono">{{releaseDate}}</div>
                            {{#unit}}
                            <div class="text-xs text-[#b9cac4] mt-0.5">{{unitName}}</div>
                            {{/unit}}
                            {{#hasAlbumFormat}}
                            <div class="text-[11px] text-[#8b9b95] mt-0.5">{{albumFormatLabel}}</div>
                            {{/hasAlbumFormat}}
                        </a>
                        <button type="button" class="about-edit-inline about-mode-btn is-card-edit btn btn-sm btn-outline btn-primary" hidden data-album-edit="{{albumId}}">수정</button>
                    </li>
                    {{/albums}}
                </ul>
            </div>
            {{/albumSections}}
        </div>

        {{^albumSections}}
        <p class="text-sm text-[#b9cac4]/70 py-8 text-center" role="status">등록된 앨범이 없습니다.</p>
        {{/albumSections}}
    </div>
</main>
{{>triples/partials/album-admin-modals}}
<script src="{{#asset}}/js/about-tabs.js{{/asset}}" defer></script>
<script src="{{#asset}}/js/about-modal.js{{/asset}}" defer></script>
<script src="{{#asset}}/js/album.js{{/asset}}" defer></script>
{{>layout/page-end}}
