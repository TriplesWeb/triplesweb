<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>트리플에스 커뮤니티 - 발매 앨범</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/about-admin.css?v=7">
<style>[data-album-edit][hidden], #albumAddBtn[hidden], #albumSectionBtn[hidden]{display:none!important}</style>
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen about-admin-page">
{{>layout/header}}

<main class="main-content max-w-7xl mx-auto px-4 py-8">
    <div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 shadow-xl">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <h2 class="text-2xl font-bold text-[#e3e2e8] flex items-center gap-2 m-0">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00f5d4]"></span> 트리플에스의 발매 앨범
            </h2>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" id="albumSectionBtn" hidden class="about-mode-btn about-admin-only is-active">구분 관리</button>
                <button type="button" id="albumAddBtn" hidden class="about-mode-btn about-admin-only is-active">앨범 추가</button>
                <button type="button" id="albumAdminBtn" class="about-admin-btn hidden" aria-pressed="false">관리자</button>
            </div>
        </div>
        <p id="albumAdminHint" class="about-admin-hint hidden mb-4">관리자 모드: 구분을 만들고 앨범을 배정하거나, 카드의 수정 버튼으로 편집할 수 있어요.</p>

        <ul class="nav nav-tabs border-b border-[#3a4a46]/40 flex overflow-x-auto items-center pb-2 gap-1.5{{^albumSections}} hidden{{/albumSections}}" id="albumSectionTabs" role="tablist">
            {{#albumSections}}
            <button class="nav-tab-btn album-section-tab bg-transparent border-0 border-b-2 border-transparent text-[#b9cac4] hover:text-[#00f5d4] px-3 py-2 text-sm font-semibold whitespace-nowrap rounded-none transition-colors shrink-0" id="tab-{{tabKey}}" data-target="#{{tabKey}}" type="button" role="tab" title="{{name}}">
                {{name}}
            </button>
            {{/albumSections}}
        </ul>

        <div class="tab-content mt-6" id="albumSectionTabContent">
            {{#albumSections}}
            <div class="tab-pane hidden" id="{{tabKey}}" role="tabpanel" aria-labelledby="tab-{{tabKey}}">
                <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 list-none p-0 m-0">
                    {{#albums}}
                    <li class="relative">
                        <a href="/triples/album/{{albumId}}" class="block text-center no-underline text-[#e3e2e8] hover:text-[#00f5d4] transition-colors">
                            <img src="{{displayAlbumImage}}" width="200" height="200" alt="{{albumName}}" class="w-full aspect-square object-cover rounded-lg mb-2 border border-[#3a4a46]/30">
                            <div class="text-sm sm:text-base font-semibold">{{albumName}}</div>
                        </a>
                        <button type="button" class="about-edit-inline about-mode-btn" hidden data-album-edit="{{albumId}}" style="position:absolute;top:0.5rem;right:0.5rem;">수정</button>
                    </li>
                    {{/albums}}
                </ul>
            </div>
            {{/albumSections}}
        </div>

        {{^albumSections}}
        <p class="text-sm text-[#b9cac4]/70 py-8 text-center" role="status">등록된 앨범이 없습니다.</p>
        {{/albumSections}}
    </div>
</main>
{{>triples/partials/album-admin-modals}}
{{>layout/footer}}
<script src="/js/about-admin-auth.js?v=1"></script>
<script src="/js/album.js?v=9"></script>
</body>
</html>
