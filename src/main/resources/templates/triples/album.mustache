<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>트리플에스 커뮤니티- 발매 앨범</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">

</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen">
{{>layout/header}}

<main class="main-content max-w-7xl mx-auto px-4 py-8">
    <div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 shadow-xl">
        <h2 class="text-2xl font-bold text-[#e3e2e8] mb-6 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#00f5d4]"></span> 트리플에스의 발매 앨범
        </h2>
        <table id="albumTable" class="w-full">
            <tr>
        <td class="flex flex-wrap gap-6 justify-start">
            {{#album}}
            <a href="/triples/album/{{albumId}}" class="text-decoration-none text-center w-48">
            <div>
                <img src= "{{albumImage}}" width="200" height="200" alt="{{albumName}}" class="w-full h-44 object-cover rounded-lg mb-2">
                <div class="caption text-lg text-[#e3e2e8] font-semibold" >{{albumName}}</div>
            </div>
            </a>
            {{/album}}
        </td>
    </tr>
        </table>
    </div>
</main>
</body>
</html>