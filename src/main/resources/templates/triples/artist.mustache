<!DOCTYPE html>
<html class="dark" lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 - ABOUT 트리플에스</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/artist.css?v=3">
    <style>
        .artist-page .artist-edit-inline[hidden] { display: none !important; }
    </style>
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen artist-page">

{{>layout/header}}

<main class="main-content max-w-7xl mx-auto px-4 py-8">
    <div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 shadow-xl">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <h2 class="text-2xl font-bold text-[#e3e2e8] flex items-center gap-2 m-0">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00f5d4]"></span>ABOUT 트리플에스
            </h2>
            <button type="button" id="artistAdminBtn" class="artist-admin-btn hidden" aria-pressed="false">관리자</button>
        </div>
        <p id="artistAdminHint" class="artist-admin-hint hidden mb-4">관리자 모드: 그룹/멤버 탭에서 수정 버튼으로 내용을 편집할 수 있어요.</p>

        <ul class="nav nav-tabs border-b border-[#3a4a46]/40 flex overflow-x-auto items-center pb-2 gap-2" id="triplesTabs">
            <button class="nav-tab-btn bg-transparent border-0 text-[#b9cac4] hover:text-[#00f5d4] flex flex-col items-center p-2 rounded-xl transition-all shrink-0" id="triples-tab" data-target="#triples" type="button">
                <img id="groupTabImageDisplay" src="{{groupTabImage}}" referrerpolicy="no-referrer" class="w-12 h-12 rounded-full border-2 border-[#00f5d4] object-cover mb-1" alt="tripleS">
                <span class="text-xs font-semibold">tripleS</span>
            </button>
            {{#artist}}
            <button class="nav-tab-btn bg-transparent border-0 text-[#b9cac4] hover:text-[#00f5d4] flex flex-col items-center p-2 rounded-xl transition-all shrink-0" id="{{engName}}-tab" data-target="#member-{{artistId}}" type="button">
                <img src="{{displayProfileImage}}" referrerpolicy="no-referrer" class="w-12 h-12 rounded-full border-2 border-transparent object-cover mb-1" alt="{{name}}">
                <span class="text-xs font-semibold">{{name}}</span>
            </button>
            {{/artist}}
        </ul>

        <div class="tab-content mt-6" id="memberTabContent">
            <div class="tab-pane" id="triples">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                    <img id="groupImageDisplay" src="{{groupImage}}" referrerpolicy="no-referrer" alt="트리플에스" class="w-full rounded-xl border border-[#3a4a46]/30 object-cover shadow-lg">
                    <div class="space-y-4">
                        <h3 id="groupTitleDisplay" class="text-xl font-bold text-[#00f5d4]">{{groupTitle}}</h3>
                        <p id="groupBodyDisplay" class="text-sm text-[#b9cac4] leading-relaxed whitespace-pre-wrap">{{groupBody}}</p>
                        <button type="button" id="artistGroupEditBtn" class="artist-mode-btn is-active artist-edit-inline">그룹 소개 수정</button>
                    </div>
                </div>
            </div>

            {{#artist}}
            <div class="tab-pane hidden" id="member-{{artistId}}">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    <div class="lg:col-span-4 relative group">
                        <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden border border-[#3a4a46]/40 bg-black/50 shadow-inner">
                            <img src="{{displayProfileImage}}" referrerpolicy="no-referrer" class="w-full h-full object-cover" alt="{{name}}" width="500" height="500">
                        </div>
                    </div>
                    <div class="lg:col-span-8 space-y-6">
                        <div class="border-b border-[#3a4a46]/30 pb-4 mb-2 flex flex-wrap items-center gap-2">
                            <span class="w-2.5 h-2.5 inline-block rounded-full bg-[#00f5d4] shrink-0"></span>
                            <h3 class="text-3xl font-extrabold text-[#e3e2e8] tracking-tight">{{name}}</h3>
                            <span class="text-sm font-mono text-[#b9cac4] pl-2">{{engName}}</span>
                            <button type="button" class="artist-mode-btn is-active artist-edit-inline ml-auto" data-artist-edit="{{artistId}}">멤버 수정</button>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between gap-3">
                                <span class="text-xs font-semibold text-[#b9cac4]">이름</span>
                                <span class="text-sm font-medium text-[#e3e2e8]">{{name}}</span>
                            </div>
                            <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-start justify-between gap-3">
                                <span class="text-xs font-semibold text-[#b9cac4] pt-0.5">출생</span>
                                <div class="text-right space-y-0.5 min-w-0">
                                    <div class="text-sm font-medium text-[#e3e2e8] font-mono">{{birthDate}}</div>
                                    {{#hasBornPlace}}
                                    <div class="text-sm font-medium text-[#e3e2e8]">{{bornPlace}}</div>
                                    {{/hasBornPlace}}
                                </div>
                            </div>
                            {{#hasRealName}}
                            <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between gap-3">
                                <span class="text-xs font-semibold text-[#b9cac4]">본명</span>
                                <span class="text-sm font-medium text-[#e3e2e8]">{{realName}}</span>
                            </div>
                            {{/hasRealName}}
                            {{#hasMbti}}
                            <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between gap-3">
                                <span class="text-xs font-semibold text-[#b9cac4]">MBTI</span>
                                <span class="text-sm font-medium text-[#e3e2e8] font-mono">{{mbti}}</span>
                            </div>
                            {{/hasMbti}}
                            {{#hasBirthPlace}}
                            <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between gap-3">
                                <span class="text-xs font-semibold text-[#b9cac4]">출신지</span>
                                <span class="text-sm font-medium text-[#e3e2e8]">{{birthPlace}}</span>
                            </div>
                            {{/hasBirthPlace}}
                            <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between gap-3">
                                <span class="text-xs font-semibold text-[#b9cac4]">국적</span>
                                <span class="text-sm font-medium text-[#e3e2e8]">{{nationality}}</span>
                            </div>
                            <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between gap-3">
                                <span class="text-xs font-semibold text-[#b9cac4]">데뷔일</span>
                                <span class="text-sm font-medium text-[#00f5d4] font-mono">{{debutDate}}</span>
                            </div>
                            <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between gap-3">
                                <span class="text-xs font-semibold text-[#b9cac4]">상징 색</span>
                                <div class="flex items-center gap-2">
                                    <span class="w-3.5 h-3.5 rounded-full border border-white/20 shadow-sm" style="background-color: {{color}};"></span>
                                    <span class="text-sm font-medium text-[#e3e2e8] font-mono">{{color}}</span>
                                </div>
                            </div>
                        </div>
                        <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-4 space-y-2.5">
                            <span class="text-xl font-semibold text-[#b9cac4] block whitespace-nowrap">역대 소속 유닛</span>
                            <div class="flex flex-wrap gap-2">
                                {{#displayAffiliatedUnit}}
                                <a href="/triples/unit/{{unit.unitId}}" class="inline-flex items-center whitespace-nowrap px-3 py-1 rounded-full bg-[#16181f]/80 hover:bg-[#00f5d4]/20 border border-[#3a4a46]/50 hover:border-[#00f5d4]/50 text-xl font-medium text-[#e3e2e8] hover:text-[#00f5d4] transition-all text-decoration-none">{{unit.unitName}}</a>
                                {{/displayAffiliatedUnit}}
                                {{^displayAffiliatedUnit}}
                                <span class="text-xs text-[#b9cac4]/60 font-mono">소속 유닛 없음</span>
                                {{/displayAffiliatedUnit}}
                            </div>
                        </div>
                        {{#hasSignatureImage}}
                        <div class="bg-[#0d0e12]/40 border border-[#3a4a46]/30 rounded-xl p-4 space-y-2.5">
                            <span class="text-xl font-semibold text-[#b9cac4] block whitespace-nowrap">싸인</span>
                            <div class="inline-flex items-center justify-center rounded-lg bg-[#f4f5f7] px-4 py-3">
                                <img src="{{signatureImage}}" alt="{{name}} 싸인" class="max-h-28 w-auto object-contain" loading="lazy" decoding="async">
                            </div>
                        </div>
                        {{/hasSignatureImage}}
                    </div>
                </div>
                <div class="member-activities mt-8 text-xl text-[#b9cac4] space-y-4">
                    <div>
                        <h2 class="text-xl font-normal m-0">멤버 단독 컨텐츠</h2>
                        {{#hasSoloLinks}}
                        <ul class="artist-link-list">
                            {{#soloLinks}}
                            <li>
                                {{#url}}
                                <a href="{{url}}" target="_blank" rel="noopener" class="artist-video-link">{{title}}</a>
                                {{/url}}
                                {{^url}}
                                <span>{{title}}</span>
                                {{/url}}
                            </li>
                            {{/soloLinks}}
                        </ul>
                        {{/hasSoloLinks}}
                    </div>
                    <div>
                        <h2 class="text-xl font-normal m-0">출연한 방송</h2>
                        {{#hasBroadcastLinks}}
                        <ul class="artist-link-list">
                            {{#broadcastLinks}}
                            <li>
                                {{#url}}
                                <a href="{{url}}" target="_blank" rel="noopener" class="artist-video-link">{{title}}</a>
                                {{/url}}
                                {{^url}}
                                <span>{{title}}</span>
                                {{/url}}
                            </li>
                            {{/broadcastLinks}}
                        </ul>
                        {{/hasBroadcastLinks}}
                    </div>
                </div>
            </div>
            {{/artist}}
        </div>
    </div>
</main>

<div id="artistLoginModal" class="artist-modal hidden" role="dialog" aria-modal="true" aria-labelledby="artistLoginTitle">
    <div class="artist-modal-panel">
        <button type="button" class="artist-close artist-login-close" aria-label="닫기">
            <span class="material-symbols-outlined">close</span>
        </button>
        <h3 id="artistLoginTitle" class="artist-modal-title">관리자 로그인</h3>
        <form id="artistLoginForm" class="artist-edit-form">
            <label class="artist-edit-label">비밀번호
                <span class="artist-password-field">
                    <input type="password" id="artistLoginPassword" name="password" required autocomplete="current-password">
                    <button type="button" id="artistLoginPasswordToggle" class="artist-password-toggle" aria-label="비밀번호 보기" aria-pressed="false">
                        <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                    </button>
                </span>
            </label>
            <p id="artistLoginError" class="artist-edit-error" hidden></p>
            <div class="artist-edit-actions">
                <button type="submit" class="artist-mode-btn is-active">로그인</button>
            </div>
        </form>
    </div>
</div>

<div id="artistGroupModal" class="artist-modal hidden" role="dialog" aria-modal="true" aria-labelledby="artistGroupTitleLabel">
    <div class="artist-modal-panel artist-edit-panel">
        <button type="button" class="artist-close artist-group-close" aria-label="닫기">
            <span class="material-symbols-outlined">close</span>
        </button>
        <h3 id="artistGroupTitleLabel" class="artist-modal-title">그룹 소개 수정</h3>
        <form id="artistGroupForm" class="artist-edit-form">
            <label class="artist-edit-label">제목
                <input type="text" id="artistGroupTitle" maxlength="120" required>
            </label>
            <label class="artist-edit-label">소개 본문
                <textarea id="artistGroupBody" rows="6"></textarea>
            </label>
            <label class="artist-edit-label">대표 이미지
                <input type="file" id="artistGroupImage" accept="image/*">
            </label>
            <img id="artistGroupImagePreview" class="artist-preview hidden" alt="그룹 이미지 미리보기">
            <label class="artist-edit-check">
                <input type="checkbox" id="artistGroupClearImage"> 대표 이미지를 기본값으로 되돌리기
            </label>
            <label class="artist-edit-label">탭 썸네일
                <input type="file" id="artistGroupTabImage" accept="image/*">
            </label>
            <img id="artistGroupTabImagePreview" class="artist-preview hidden" alt="탭 이미지 미리보기">
            <label class="artist-edit-check">
                <input type="checkbox" id="artistGroupClearTabImage"> 탭 이미지를 기본값으로 되돌리기
            </label>
            <p id="artistGroupError" class="artist-edit-error" hidden></p>
            <div class="artist-edit-actions">
                <button type="submit" class="artist-mode-btn is-active">저장</button>
                <button type="button" class="artist-mode-btn artist-group-close">취소</button>
            </div>
        </form>
    </div>
</div>

<div id="artistEditModal" class="artist-modal hidden" role="dialog" aria-modal="true" aria-labelledby="artistEditTitle">
    <div class="artist-modal-panel artist-edit-panel">
        <button type="button" class="artist-close artist-edit-close" aria-label="닫기">
            <span class="material-symbols-outlined">close</span>
        </button>
        <h3 id="artistEditTitle" class="artist-modal-title">멤버 수정</h3>
        <form id="artistEditForm" class="artist-edit-form">
            <input type="hidden" id="artistEditId">
            <div class="artist-edit-grid">
                <label class="artist-edit-label">이름
                    <input type="text" id="artistEditName" required maxlength="80">
                </label>
                <label class="artist-edit-label">영문명
                    <input type="text" id="artistEditEngName" required maxlength="80">
                </label>
                <label class="artist-edit-label">출생 (생년월일)
                    <input type="text" id="artistEditBirthDate" required maxlength="40" placeholder="YYYY-MM-DD">
                </label>
                <label class="artist-edit-label">국적
                    <input type="text" id="artistEditNationality" required maxlength="80">
                </label>
            </div>
            <div class="artist-edit-grid">
                <label class="artist-edit-label">출생지
                    <input type="text" id="artistEditBornPlace" maxlength="120" placeholder="예: 서울특별시 강남구 대치동">
                </label>
                <label class="artist-edit-label">출신지
                    <input type="text" id="artistEditBirthPlace" maxlength="120" placeholder="비워두면 프로필에 표시되지 않음">
                </label>
            </div>
            <div class="artist-edit-grid">
                <label class="artist-edit-label">본명
                    <input type="text" id="artistEditRealName" maxlength="120" placeholder="비워두면 프로필에 표시되지 않음">
                </label>
                <label class="artist-edit-label">MBTI
                    <input type="text" id="artistEditMbti" maxlength="16" placeholder="예: INFP">
                </label>
            </div>
            <div class="artist-edit-grid">
                <label class="artist-edit-label">데뷔일
                    <input type="text" id="artistEditDebutDate" required maxlength="40" placeholder="YYYY-MM-DD">
                </label>
                <label class="artist-edit-label">상징 색
                    <input type="text" id="artistEditColor" required maxlength="7" placeholder="#22aeff">
                </label>
            </div>
            <label class="artist-edit-label">프로필 사진
                <input type="file" id="artistEditImage" accept="image/*">
            </label>
            <img id="artistEditImagePreview" class="artist-preview hidden" alt="프로필 미리보기">
            <label class="artist-edit-check">
                <input type="checkbox" id="artistEditClearImage"> 프로필 사진 제거
            </label>
            <label class="artist-edit-label">싸인 이미지
                <input type="file" id="artistEditSignatureImage" accept="image/*">
            </label>
            <img id="artistEditSignaturePreview" class="artist-preview hidden" alt="싸인 미리보기">
            <label class="artist-edit-check">
                <input type="checkbox" id="artistEditClearSignatureImage"> 싸인 이미지 제거
            </label>
            <div class="artist-edit-label">역대 소속 유닛
                <div id="artistEditUnits" class="artist-unit-checks" role="group" aria-label="역대 소속 유닛">
                    {{#allUnits}}
                    <label class="artist-unit-chip">
                        <input type="checkbox" value="{{unitId}}">
                        <span>{{unitName}}</span>
                    </label>
                    {{/allUnits}}
                </div>
            </div>
            <div class="artist-edit-label">멤버 단독 컨텐츠
                <p class="artist-edit-field-hint">관련 영상 링크를 추가하세요. 표시 제목 + URL</p>
                <div id="artistEditSoloLinks" class="artist-link-rows"></div>
                <button type="button" id="artistAddSoloLink" class="artist-mode-btn">링크 추가</button>
            </div>
            <div class="artist-edit-label">출연한 방송
                <p class="artist-edit-field-hint">출연 방송/영상 링크를 추가하세요. 표시 제목 + URL</p>
                <div id="artistEditBroadcastLinks" class="artist-link-rows"></div>
                <button type="button" id="artistAddBroadcastLink" class="artist-mode-btn">링크 추가</button>
            </div>
            <p id="artistEditError" class="artist-edit-error" hidden></p>
            <div class="artist-edit-actions">
                <button type="submit" class="artist-mode-btn is-active">저장</button>
                <button type="button" class="artist-mode-btn artist-edit-close">취소</button>
            </div>
        </form>
    </div>
</div>

{{>layout/footer}}
<script src="/js/about-admin-auth.js?v=1"></script>
<script src="/js/artist.js?v=7"></script>
</body>
</html>
