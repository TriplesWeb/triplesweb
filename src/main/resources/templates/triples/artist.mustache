<!DOCTYPE html>
<html class="dark" lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티- ABOUT 트리플에스</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />


    <!-- Tailwind CSS Engine -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen">

{{>layout/header}}

<main class="main-content max-w-7xl mx-auto px-4 py-8">
    <div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 shadow-xl">
        <h2 class="text-2xl font-bold text-[#e3e2e8] mb-6 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#00f5d4]"></span>ABOUT 트리플에스
        </h2>

        <ul class="nav nav-tabs border-b border-[#3a4a46]/40 flex overflow-x-auto items-center pb-2 gap-2" id="triplesTabs">
                    <button class="nav-tab-btn bg-transparent border-0 text-[#b9cac4] hover:text-[#00f5d4] flex flex-col items-center p-2 rounded-xl transition-all shrink-0" id="triples-tab" data-target="#triples" type="button">
                        <img src="/uploads/images/triples2.jpg" class="w-12 h-12 rounded-full border-2 border-[#00f5d4] object-cover mb-1" alt="tripleS">
                        <span class="text-xs font-semibold">TripleS</span>
                    </button>
                {{#artist}}
                    <button class="nav-tab-btn bg-transparent border-0 text-[#b9cac4] hover:text-[#00f5d4] flex flex-col items-center p-2 rounded-xl transition-all shrink-0" id="{{engName}}-tab" data-target="#member-{{artistId}}" type="button">
                        <img src="{{profileImage}}" class="w-12 h-12 rounded-full border-2 border-transparent object-cover mb-1" alt="{{name}}">
                        <span class="text-xs font-semibold">{{name}}</span>
                    </button>
                {{/artist}}
        </ul>

        <div class="tab-content mt-6" id="memberTabContent">
            <div class="tab-pane" id="triples">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                    <img src="/uploads/images/tripleS.jpg" alt="트리플에스" class="w-full rounded-xl border border-[#3a4a46]/30 object-cover shadow-lg">
                    <div class="space-y-4">
                        <h3 class="text-xl font-bold text-[#00f5d4]">TripleS (트리플에스)</h3>
                        <p class="text-sm text-[#b9cac4] leading-relaxed">
                            tripleS(한국어: 트리플에스)는 모드하우스가 결성한 대한민국의 24인조 걸그룹이다. 2022년 5월 시작된 이래 정식 데뷔 9개월 이전의 프로젝트를 통하여 대중에게 소개되었다.
                            국내 최다인원 24명으로 이루어진 걸그룹으로 ASSEMBLE,ASSEMBLE24,ASSEMBLE25 등을 발매하였다.
                        </p>
                    </div>
                </div>
            </div>

            {{#artist}}
                <div class="tab-pane hidden" id="member-{{artistId}}">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                        <img src="{{profileImage}}" alt="{{name}}" class="w-full max-h-96 object-cover rounded-xl border border-[#3a4a46]/30 shadow-lg">
                        <div class="space-y-3">
                            <h3 class="text-xl font-bold text-[#e3e2e8]">
                                <span class="text-[#00f5d4] font-mono">S{{artistId}}</span> {{name}}
                            </h3>
                            <div class="text-xs text-[#b9cac4] space-y-2">
                                <p><strong class="text-[#e3e2e8]">생일: {{birthDate}}일 생 </strong></p>
                                <p><strong class="text-[#e3e2e8]">출생지: {{birthPlace}}</strong></p>
                            </div>
                            <div class="pt-2">
                                <a href="/triples/artist/{{artistId}}" class="inline-block px-4 py-2 text-xs font-semibold bg-[#00f5d4] text-[#0d0e12] rounded-xl hover:bg-[#00f5d4]/80 transition-all text-decoration-none shadow-md">
                                    자세히
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {{/artist}}
        </div>
    </div>
</main>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabButtons = document.querySelectorAll('.nav-tab-btn');
        const tabPanes = document.querySelectorAll('.tab-pane');

        tabButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-target');

                // 탭 버튼 스타일 초기화
                tabButtons.forEach(b => {
                    const img = b.querySelector('img');
                    const span = b.querySelector('span');
                    if (img) {
                        img.classList.remove('border-[#00f5d4]');
                        img.classList.add('border-transparent');
                    }
                    if (span) {
                        span.classList.remove('text-[#00f5d4]');
                        span.classList.add('text-[#b9cac4]');
                    }
                });

                // 선택된 버튼 활성화
                const activeImg = btn.querySelector('img');
                const activeSpan = btn.querySelector('span');
                if (activeImg) {
                    activeImg.classList.remove('border-transparent');
                    activeImg.classList.add('border-[#00f5d4]');
                }
                if (activeSpan) {
                    activeSpan.classList.remove('text-[#b9cac4]');
                    activeSpan.classList.add('text-[#00f5d4]');
                }
                // 탭 본문 전환
                tabPanes.forEach(pane => pane.classList.add('hidden'));
                const targetPane = document.querySelector(targetId);
                if (targetPane) {
                    targetPane.classList.remove('hidden');
                }
            });
        });
    });
</script>
</body>
</html>