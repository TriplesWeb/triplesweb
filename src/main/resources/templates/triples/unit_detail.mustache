<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 - {{#unit}}{{unitName}}{{/unit}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen">
{{>layout/header}}

<main class="main-content w-full max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8 space-y-8 flex-1">
    {{#unit}}
        <section id="triplesUnitProfileSection" class="bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 lg:p-10 mb-8 shadow-xl">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

                <!-- 유닛 프로필 이미지 -->
                <div class="lg:col-span-4 relative group">
                    <div class="unit-image relative w-full aspect-[4/5] rounded-2xl overflow-hidden border border-[#3a4a46]/40 bg-black/50 shadow-inner">
                        <img src="/uploads/images/{{smallName}}.jpg" class="w-full h-full object-cover" alt="{{unitName}}" />
                    </div>
                </div>

                <!-- 유닛 상세 정보 -->
                <div class="lg:col-span-8 space-y-6">
                    <!-- 유닛 이름 헤더 -->
                    <div class="unit-name-label border-b border-[#3a4a46]/30 pb-4 font-bold text-[#e3e2e8] flex items-center gap-2">
                        <span class="w-2.5 h-2.5 inline-block rounded-full bg-[#00f5d4]"></span>
                        <h1 class="text-3xl font-extrabold text-[#e3e2e8] tracking-tight">
                            {{unitName}}
                        </h1>
                        <span class="text-sm font-mono text-[#b9cac4] pl-2">{{smallName}}</span>
                    </div>

                    <!-- 결성일 & 데뷔일 (2열 너비 채우기) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="bg-white/5 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-[#b9cac4]">결성일</span>
                            <span class="text-sm font-medium text-[#e3e2e8] font-mono">{{formationDate}}</span>
                        </div>
                        <div class="bg-white/5 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-[#b9cac4]">데뷔일</span>
                            <span class="text-sm font-medium text-[#e3e2e8] font-mono">{{debutDate}}</span>
                        </div>
                    </div>
    {{/unit}}

                    <!-- 발매 앨범 목록 -->
                    <div class="space-y-2 pt-2 border-t border-[#3a4a46]/20">
                        <h3 class="font-semibold text-sm text-[#b9cac4]">발매 앨범</h3>
                        <div class="flex flex-wrap gap-3 pt-1">
                            {{#albums}}
                                <a href="/triples/album/{{albumId}}" class="bg-white/5 hover:bg-white/10 border border-[#3a4a46]/30 hover:border-[#00f5d4]/40 text-[#b9cac4] hover:text-[#00f5d4] flex flex-col items-center p-2 rounded-xl transition-all shrink-0 no-underline">
                                    <img src="{{albumImage}}" class="w-16 h-16 rounded-lg object-cover mb-1 border border-[#3a4a46]/30 shadow" alt="{{albumName}}">
                                    <span class="text-xs font-semibold text-center max-w-[80px] truncate">{{albumName}}</span>
                                </a>
                            {{/albums}}
                            {{^albums}}
                                <p class="text-sm text-[#b9cac4]/60 py-1">발매된 앨범이 없습니다.</p>
                            {{/albums}}
                        </div>
                    </div>
    {{#unit}}
                    <!-- 소속 멤버 목록 -->
                    <div class="space-y-2 pt-2 border-t border-[#3a4a46]/20">
                        <h3 class="font-semibold text-sm text-[#b9cac4]">소속 멤버</h3>
                        <div class="flex flex-wrap gap-3 pt-1">
                            {{#unitMembers}}
                                <a href="/triples/artist/{{artist.artistId}}" class="bg-white/5 hover:bg-white/10 border border-[#3a4a46]/30 hover:border-[#00f5d4]/40 text-[#b9cac4] hover:text-[#00f5d4] flex flex-col items-center p-2.5 rounded-xl transition-all no-underline shrink-0">
                                    <img src="{{artist.profileImage}}" class="w-12 h-12 rounded-full object-cover mb-1.5 border border-[#3a4a46]/40" alt="{{artist.name}}">
                                    <span class="unitMember-item text-xs font-semibold">{{artist.name}}</span>
                                </a>
                            {{/unitMembers}}
                            {{^unitMembers}}
                                <p class="text-sm text-[#b9cac4]/60 py-1">소속 멤버 정보가 없습니다.</p>
                            {{/unitMembers}}
                        </div>
                    </div>
    {{/unit}}
                </div>
            </div>
        </section>
</main>
{{>layout/footer}}
</body>
</html>
