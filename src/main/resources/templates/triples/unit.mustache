<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>트리플에스 커뮤니티 - 역대 유닛</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/about-admin.css?v=13">
</head>
<body class="bg-[#0d0e12] text-[#e3e2e8] min-h-screen about-admin-page">
{{>layout/header}}

<main class="main-content w-full max-w-7xl mx-auto px-4 py-8 min-w-0">
    <div class="card-box bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl p-6 shadow-xl min-w-0">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <h2 class="text-2xl font-bold text-[#e3e2e8] flex items-center gap-2 m-0">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00f5d4]"></span>트리플에스 역대 유닛
            </h2>
            <div class="flex flex-wrap items-center gap-2 shrink-0">
                <button type="button" id="unitAddBtn" class="about-mode-btn about-admin-only is-active">유닛 추가</button>
                <button type="button" id="unitAdminBtn" class="about-admin-btn hidden" aria-pressed="false">관리자</button>
            </div>
        </div>
        <p id="unitAdminHint" class="about-admin-hint hidden mb-4">관리자 모드: 유닛을 추가하거나 탭의 수정 버튼으로 편집할 수 있어요. 이미지는 나무위키 URL을 붙여넣어도 됩니다.</p>

        <div class="unit-tabs-scroller">
            <div class="unit-tabs" id="triplesUnitTabs" role="tablist">
                {{#unit}}
                    <button class="nav-tab-btn unit-tab-btn" id="unit-tab-{{unitId}}" data-target="#unit-{{unitId}}" type="button" role="tab" title="{{unitName}}">
                        <img src="{{displayUnitImage}}" alt="{{unitName}}" loading="lazy">
                        <span>{{smallName}}</span>
                    </button>
                {{/unit}}
            </div>
        </div>
        {{^unit}}
        <p class="text-sm text-[#b9cac4]/70 py-8 text-center" role="status">등록된 유닛이 없습니다.</p>
        {{/unit}}

        <div class="tab-content mt-6" id="unitTabContent">
            {{#unit}}
                <div class="tab-pane hidden" id="unit-{{unitId}}">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                        <div class="lg:col-span-4">
                            <div class="relative w-full rounded-2xl overflow-hidden border border-[#3a4a46]/40 bg-black/50 shadow-inner">
                                <img data-unit-src="{{displayUnitImage}}" alt="{{unitName}}" class="block w-full h-auto object-contain">
                            </div>
                        </div>
                        <div class="lg:col-span-8 space-y-6">
                            <div class="border-b border-[#3a4a46]/30 pb-4 flex flex-wrap items-center gap-2">
                                <span class="w-2.5 h-2.5 inline-block rounded-full bg-[#00f5d4]"></span>
                                <h3 class="text-2xl sm:text-3xl font-extrabold text-[#e3e2e8] tracking-tight m-0">{{unitName}}</h3>
                                <span class="text-sm font-mono text-[#b9cac4]">{{smallName}}</span>
                                <button type="button" class="about-mode-btn about-edit-inline is-active ml-auto" data-unit-edit="{{unitId}}">수정</button>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="bg-white/5 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between">
                                    <span class="text-xs font-semibold text-[#b9cac4]">결성일</span>
                                    <span class="text-sm font-medium text-[#e3e2e8] font-mono">{{formationDate}}</span>
                                </div>
                                <div class="bg-white/5 border border-[#3a4a46]/30 rounded-xl p-3.5 flex items-center justify-between">
                                    <span class="text-xs font-semibold text-[#b9cac4]">데뷔일</span>
                                    <span class="text-sm font-medium text-[#e3e2e8] font-mono">{{debutDate}}</span>
                                </div>
                            </div>

                            <div class="space-y-2 pt-2 border-t border-[#3a4a46]/20">
                                <h4 class="font-semibold text-sm text-[#b9cac4] m-0">발매 앨범</h4>
                                <div class="flex flex-wrap gap-3 pt-1">
                                    {{#displayAlbums}}
                                        <a href="/triples/album/{{albumId}}" class="bg-white/5 hover:bg-white/10 border border-[#3a4a46]/30 hover:border-[#00f5d4]/40 text-[#b9cac4] hover:text-[#00f5d4] flex flex-col items-center p-2 rounded-xl transition-all shrink-0 no-underline">
                                            <img data-unit-src="{{displayAlbumImage}}" class="w-16 h-16 rounded-lg object-cover mb-1 border border-[#3a4a46]/30 shadow" alt="{{albumName}}">
                                            <span class="text-xs font-semibold text-center max-w-[80px] truncate">{{albumName}}</span>
                                        </a>
                                    {{/displayAlbums}}
                                    {{^displayAlbums}}
                                        <p class="text-sm text-[#b9cac4]/60 py-1 m-0">발매된 앨범이 없습니다.</p>
                                    {{/displayAlbums}}
                                </div>
                            </div>

                            <div class="space-y-2 pt-2 border-t border-[#3a4a46]/20">
                                <h4 class="font-semibold text-sm text-[#b9cac4] m-0">소속 멤버</h4>
                                <div class="flex flex-wrap gap-3 pt-1">
                                    {{#unitMembers}}
                                        <a href="/triples/artist/{{artist.artistId}}" class="bg-white/5 hover:bg-white/10 border border-[#3a4a46]/30 hover:border-[#00f5d4]/40 text-[#b9cac4] hover:text-[#00f5d4] flex flex-col items-center p-2.5 rounded-xl transition-all no-underline shrink-0">
                                            <img data-unit-src="{{artist.displayProfileImage}}" class="w-12 h-12 rounded-full object-cover mb-1.5 border border-[#3a4a46]/40" alt="{{artist.name}}">
                                            <span class="text-xs font-semibold">{{artist.name}}</span>
                                        </a>
                                    {{/unitMembers}}
                                    {{^unitMembers}}
                                        <p class="text-sm text-[#b9cac4]/60 py-1 m-0">소속 멤버 정보가 없습니다.</p>
                                    {{/unitMembers}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {{/unit}}
        </div>
    </div>
</main>
{{>triples/partials/unit-admin-modals}}
{{>layout/footer}}
<script src="/js/about-admin-auth.js?v=1"></script>
<script src="/js/unit.js?v=9"></script>
</body>
</html>
