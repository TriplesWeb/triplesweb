<div class="ar-body">
    {{#hasHeadline}}<h3>{{headline}}</h3>{{/hasHeadline}}
    {{#hasBadgeRow}}
    <div class="ar-card-badges">
        {{#hasSource}}<div class="ar-source-badge" data-source="{{sourceValue}}" style="--source-color: {{sourceColor}}">{{sourceLabel}}</div>{{/hasSource}}
        {{#hasUnitBadge}}<div class="ar-unit-badge" style="--unit-color: {{unitBadgeColor}}" title="{{unitBadgeLabel}}">{{unitBadgeLabel}}</div>{{/hasUnitBadge}}
    </div>
    {{/hasBadgeRow}}
    <div class="ar-meta" style="--member-count: {{memberCount}}" title="{{memberNames}}">
        {{>partials/archive-member-badges}}
        {{#hasRegisteredOn}}<time class="ar-card-date" datetime="{{registeredOn}}">{{registeredOnDisplay}}</time>{{/hasRegisteredOn}}
    </div>
    <div class="ar-card-members" hidden>
        {{#imageCasts}}<div data-image-cast>{{>partials/archive-album-members}}</div>{{/imageCasts}}
        {{^imageCasts}}{{>partials/archive-album-members}}{{/imageCasts}}
    </div>
</div>
