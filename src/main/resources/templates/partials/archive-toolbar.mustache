<section class="ar-panel ar-toolbar">
    <form class="ar-filters" id="archiveFilterForm" method="get" action="{{archivePath}}">
        {{#videoArchive}}<input type="hidden" name="type" value="video">{{/videoArchive}}
        {{#folderKey}}<input type="hidden" name="folder" value="{{folderKey}}">{{/folderKey}}
        {{#hasCombo}}<input type="hidden" name="combo" value="{{comboValue}}">{{/hasCombo}}
        {{#hasSourceFilter}}<input type="hidden" name="source" value="{{sourceKey}}">{{/hasSourceFilter}}
        <input type="hidden" name="size" value="{{archiveSize}}" data-archive-filter-size>
        <div class="ar-filter-tools objekt-filter-bar">
            <div class="objekt-filter ar-sort relative">
                <span class="objekt-filter-label" id="archiveSortLabel">정렬</span>
                <span class="ar-sort-control objekt-filter-control objekt-filter-select-wrap">
                    <select id="archiveSort" name="sort" aria-labelledby="archiveSortLabel">
                        <option value="newest"{{#sortNewest}} selected{{/sortNewest}}>최신순</option>
                        <option value="oldest"{{#sortOldest}} selected{{/sortOldest}}>오래된 순</option>
                        {{#videoArchive}}
                        <option value="title"{{#sortTitle}} selected{{/sortTitle}}>제목순</option>
                        {{/videoArchive}}
                        {{^folderIsSolo}}
                        <option value="first-member" data-member-sort{{#sortFirstMember}} selected{{/sortFirstMember}}>멤버번호 낮은순</option>
                        <option value="last-member" data-member-sort{{#sortLastMember}} selected{{/sortLastMember}}>멤버번호 높은순</option>
                        {{/folderIsSolo}}
                    </select>
                    <span class="material-symbols-outlined objekt-filter-caret" aria-hidden="true">arrow_drop_down</span>
                </span>
            </div>
            {{>partials/date-range-filter}}
            {{#showChemistryFilter}}
            <select class="ar-chem-select" id="archiveChem" name="chem" aria-label="케미">
                <option value="">케미 전체</option>
                {{#chemistryOptions}}
                <option value="{{value}}" data-members="{{members}}" data-chem-name="{{shortLabel}}"{{#selected}} selected{{/selected}}>{{label}}</option>
                {{/chemistryOptions}}
            </select>
            {{/showChemistryFilter}}
            {{#showMemberFilter}}
            <div class="objekt-filter ar-member-filter relative{{#hasSelectedMembers}} is-filtered{{/hasSelectedMembers}}">
                <span class="objekt-filter-label">멤버</span>
                <button type="button" class="ar-member-toggle objekt-filter-control" id="archiveMemberToggle" aria-expanded="false" aria-controls="archiveMemberPanel">
                    <span data-member-toggle-label class="truncate">{{#showChemistryFilter}}멤버 · 케미{{/showChemistryFilter}}{{^showChemistryFilter}}멤버 선택{{/showChemistryFilter}}</span>
                    <span class="ar-member-count" id="archiveMemberCount" hidden>0</span>
                    <span class="material-symbols-outlined objekt-filter-caret ar-member-chevron" aria-hidden="true">expand_more</span>
                </button>
            </div>
            {{/showMemberFilter}}
            <div class="ar-search-row objekt-search-row">
                <div class="ar-search-wrap objekt-search site-search">
                    <span class="objekt-search-glyph" aria-hidden="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
                    </span>
                    <label class="ar-search-field">
                        <input class="ar-search objekt-search-input site-search__input" type="search" name="q" value="{{query}}" placeholder="{{#imageArchive}}사진 설명 검색{{/imageArchive}}{{^imageArchive}}영상 제목 검색{{/imageArchive}}" aria-label="{{#imageArchive}}사진 설명 검색{{/imageArchive}}{{^imageArchive}}영상 제목 검색{{/imageArchive}}" autocomplete="off">
                    </label>
                </div>
                <a class="site-btn site-btn--reset ar-reset objekt-reset-button" href="{{archiveHomePath}}"{{^hasActiveArchiveFilters}} hidden{{/hasActiveArchiveFilters}}>초기화</a>
            </div>
        </div>
    </form>
    {{#showMemberFilter}}
    <div class="ar-member-panel" id="archiveMemberPanel" hidden>
        {{#showChemistryFilter}}
        <div class="ar-chem-matches" data-chem-matches>
            <p class="ar-chem-matches-hint" data-chem-hint>멤버를 고르면 케미가 나타납니다</p>
        </div>
        {{/showChemistryFilter}}
        <div class="member-portrait-picker" id="archive-member-picker" role="group" aria-label="멤버 선택">
            {{>partials/member-portrait-picker}}
        </div>
    </div>
    {{/showMemberFilter}}
</section>
