<div class="ar-date-filter" data-date-filter>
    <button type="button" class="ar-date-toggle" data-date-toggle aria-expanded="false" aria-haspopup="dialog">
        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
        <span>{{#hasDateFilter}}{{#hasExactDate}}{{on}}{{/hasExactDate}}{{^hasExactDate}}{{from}} ~ {{to}}{{/hasExactDate}}{{/hasDateFilter}}{{^hasDateFilter}}{{#dateFilterLabel}}{{dateFilterLabel}}{{/dateFilterLabel}}{{^dateFilterLabel}}날짜{{/dateFilterLabel}}{{/hasDateFilter}}</span>
    </button>
    <div class="ar-date-popover" data-date-popover hidden role="dialog" aria-label="{{#dateFilterLabel}}{{dateFilterLabel}}{{/dateFilterLabel}}{{^dateFilterLabel}}날짜 선택{{/dateFilterLabel}}">
        {{#dateExactEnabled}}
        <label>{{#dateExactLabel}}{{dateExactLabel}}{{/dateExactLabel}}{{^dateExactLabel}}이 날짜{{/dateExactLabel}}<input type="date" name="on" value="{{on}}" data-date-exact></label>
        {{/dateExactEnabled}}
        <label>{{#dateFromLabel}}{{dateFromLabel}}{{/dateFromLabel}}{{^dateFromLabel}}시작 날짜{{/dateFromLabel}}<input type="date" name="from" value="{{from}}" data-date-from></label>
        <label>{{#dateToLabel}}{{dateToLabel}}{{/dateToLabel}}{{^dateToLabel}}마지막 날짜{{/dateToLabel}}<input type="date" name="to" value="{{to}}" data-date-to></label>
        {{#dateFilterHint}}<p class="ar-field-hint">{{dateFilterHint}}</p>{{/dateFilterHint}}
        <div class="ar-date-actions">
            <button type="button" class="ar-text-btn" data-date-clear>지우기</button>
            <button type="submit" class="ar-submit">적용</button>
        </div>
    </div>
</div>
