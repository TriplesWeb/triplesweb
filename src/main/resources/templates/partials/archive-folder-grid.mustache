<section class="ar-folders" aria-label="아카이브 폴더">
    {{#archiveFolders}}
    {{#selectable}}
    <button type="button" class="ar-folder{{#soloFolder}} is-solo{{/soloFolder}}{{#hasFolderArt}} has-art{{/hasFolderArt}}" data-member="{{memberName}}" aria-pressed="false" style="--folder-color: {{color}};">
        {{>partials/archive-folder-face}}
    </button>
    {{/selectable}}
    {{^selectable}}
    <a class="ar-folder{{#groupFolder}} is-group{{/groupFolder}}{{#soloFolder}} is-solo{{/soloFolder}}{{#comboFolder}} is-combo{{/comboFolder}}{{#parentFolder}} is-parent{{/parentFolder}}{{#hasFolderArt}} has-art{{/hasFolderArt}}" href="{{href}}" style="--folder-color: {{color}};">
        {{>partials/archive-folder-face}}
    </a>
    {{/selectable}}
    {{/archiveFolders}}
</section>
