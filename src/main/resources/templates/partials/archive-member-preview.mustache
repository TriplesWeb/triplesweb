{{#firstMemberBadge}}
<span class="archive-member-chip" style="--member-color: {{color}};">
    {{#hasImage}}<img src="{{image}}" alt="" referrerpolicy="no-referrer">{{/hasImage}}
    <span>{{name}}</span>
</span>
{{/firstMemberBadge}}
{{#hasOtherMembers}}<span class="archive-member-more" title="{{otherMemberNames}}">외 {{otherMemberCount}}명<span class="archive-member-rest">{{otherMemberNames}}</span></span>{{/hasOtherMembers}}
