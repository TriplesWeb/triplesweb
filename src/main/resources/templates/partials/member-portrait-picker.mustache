{{! 공유 멤버 초상화 피커. 컨텍스트에 memberPickerOptions: [{value,label,image,color,frame}] }}
{{#memberPickerOptions}}
<button type="button"
        class="mpp-item"
        data-value="{{value}}"
        data-name="{{label}}"
        data-frame="{{frame}}"
        style="--artist-color:{{color}}"
        aria-pressed="false"
        title="{{label}}">
    <span class="artist-tab-avatar">
        <img class="artist-tab-photo" src="{{image}}" referrerpolicy="no-referrer" alt="" loading="lazy">
        <img class="artist-tab-frame" src="" alt="" aria-hidden="true">
        <span class="artist-tab-shine" aria-hidden="true"></span>
    </span>
    <span class="artist-tab-label">{{label}}</span>
</button>
{{/memberPickerOptions}}
