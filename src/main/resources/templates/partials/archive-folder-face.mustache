<span class="ar-folder-icon" aria-hidden="true">
    {{#hasFolderArt}}
    <img class="ar-folder-art" src="{{folderArt}}" alt="">
    {{/hasFolderArt}}
    {{^hasFolderArt}}
    <span class="ar-folder-shape"></span>
    {{/hasFolderArt}}
