<span class="ar-folder-icon" aria-hidden="true">
    {{#hasFolderArt}}
    <img class="ar-folder-art{{#hasBundledFolderArt}} is-bundled-art{{/hasBundledFolderArt}}{{#illustratedFolder}} is-illustrated{{/illustratedFolder}}" src="{{folderArt}}" alt="" {{^eagerFolderArt}}loading="lazy" {{/eagerFolderArt}}decoding="async">
    {{/hasFolderArt}}
    {{^hasFolderArt}}
    <span class="ar-folder-shape"></span>
    {{/hasFolderArt}}
    {{#hasPreview}}<img class="ar-folder-preview" src="{{preview}}" alt="" loading="lazy" decoding="async">{{/hasPreview}}
</span>
{{#label}}<span class="ar-folder-label">{{label}}</span>{{/label}}
{{#hasCount}}<span class="ar-folder-count">{{count}}</span>{{/hasCount}}
