<article class="ar-panel ar-card" data-id="{{id}}" data-title="{{title}}" data-description="{{description}}" data-headline="{{headline}}" data-artists="{{artistNames}}" data-member-order="{{memberOrder}}" data-url="{{file.url}}" data-images="{{imageUrlsJson}}" data-view-images="{{viewUrlsJson}}" data-image-artists="{{imageArtistsJson}}" data-registered="{{registeredOn}}" data-source="{{sourceValue}}" data-source-label="{{sourceLabel}}" data-source-color="{{sourceColor}}" data-unit-ids="{{unitIds}}">
    <button type="button" class="ar-photo-link" data-archive-open aria-label="{{#hasHeadline}}{{headline}}{{/hasHeadline}}{{^hasHeadline}}사진{{/hasHeadline}} 자세히 보기">
        <img src="{{previewUrl}}" alt="{{#hasHeadline}}{{headline}}{{/hasHeadline}}{{^hasHeadline}}사진{{/hasHeadline}}" width="480" height="480" {{#eagerPreview}}loading="eager" fetchpriority="high"{{/eagerPreview}}{{^eagerPreview}}loading="lazy" fetchpriority="low"{{/eagerPreview}} decoding="async">
        {{#hasMultipleImages}}<span class="ar-card-count" aria-label="{{imageCount}}장">{{imageCount}}</span>{{/hasMultipleImages}}
    </button>
    {{>partials/archive-card-body}}
</article>
