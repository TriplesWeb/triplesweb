<article class="ar-panel ar-card" data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}" data-url="{{file.url}}" data-registered="{{registeredOn}}">
    <button type="button" class="ar-photo-link" data-archive-open aria-label="{{title}} 자세히 보기">
        <img src="{{file.url}}" alt="{{title}}" loading="lazy" decoding="async">
    </button>
    <div class="ar-body">
        <h3>{{title}}</h3>
        <div class="ar-meta" style="--member-count: {{memberCount}}" title="{{memberNames}}">{{>partials/archive-member-badges}}</div>
        {{#hasRegisteredOn}}<time class="ar-card-date" datetime="{{registeredOn}}">{{registeredOn}}</time>{{/hasRegisteredOn}}
    </div>
</article>
