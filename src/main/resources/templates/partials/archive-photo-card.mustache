<article class="ar-panel ar-card" data-id="{{id}}" data-title="{{title}}" data-description="{{description}}" data-headline="{{headline}}" data-artists="{{artistNames}}" data-member-order="{{memberOrder}}" data-url="{{file.url}}" data-images="{{imageUrlsJson}}" data-registered="{{registeredOn}}" data-source="{{sourceValue}}" data-source-label="{{sourceLabel}}" data-unit-label="{{unitBadgeLabel}}" data-unit-color="{{unitBadgeColor}}">
    <button type="button" class="ar-photo-link" data-archive-open aria-label="{{#hasHeadline}}{{headline}}{{/hasHeadline}}{{^hasHeadline}}사진{{/hasHeadline}} 자세히 보기">
        <img src="{{file.url}}" alt="{{#hasHeadline}}{{headline}}{{/hasHeadline}}{{^hasHeadline}}사진{{/hasHeadline}}" loading="lazy" decoding="async">
        {{#hasMultipleImages}}<span class="ar-card-count" aria-label="{{imageCount}}장">{{imageCount}}</span>{{/hasMultipleImages}}
    </button>
    {{>partials/archive-card-body}}
</article>
