<div class="ar-dialog" id="archiveDetail" hidden>
    <button type="button" class="ar-dialog-backdrop" data-ar-close aria-label="닫기"></button>
    <div class="ar-dialog-panel ar-detail-panel" role="dialog" aria-modal="true" aria-labelledby="archiveDetailTitle">
        <div class="ar-detail-photo">
            <img id="archiveDetailImage" alt="">
        </div>
        <div class="ar-detail-side">
            <div class="ar-dialog-head">
                <h2 id="archiveDetailTitle">사진</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-detail-body">
                <p class="ar-detail-date" id="archiveDetailDate" hidden></p>
                <div class="ar-meta ar-detail-members" id="archiveDetailMembers"></div>
                <a class="ar-text-btn" id="archiveDetailOriginal" href="#" target="_blank" rel="noopener noreferrer">원본 열기</a>
            </div>
            <div class="ar-dialog-foot ar-detail-actions" data-admin-only>
                <button type="button" class="ar-submit" data-archive-edit id="archiveDetailEdit">수정</button>
                <button type="button" class="ar-delete" data-archive-delete id="archiveDetailDelete">삭제</button>
            </div>
        </div>
    </div>
</div>
