<!DOCTYPE html>
<html lang="ko" class="dark">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>트리플에스 커뮤니티 스케줄</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { DEFAULT: '#00f5d4', dark: '#006c5c' },
                        darkbg: '#07080b',
                        cardbg: 'rgba(26, 27, 32, 0.75)',
                        bordercol: 'rgba(58, 74, 70, 0.4)'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        sora: ['Sora', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/schedule-categories.css?v=2">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css">

    <style>
        :root {
            --schedule-bg: #07080b;
            --schedule-panel: rgba(26, 27, 32, .75);
            --schedule-border: rgba(58, 74, 70, .4);
            --schedule-text: #e3e2e8;
            --schedule-muted: #b9cac4;
            --schedule-brand: #00f5d4;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
            background: var(--schedule-bg);
            color: var(--schedule-text);
            font-family: Inter, sans-serif !important;
        }

        .material-symbols-outlined {
            display: inline-block;
            font-family: 'Material Symbols Outlined' !important;
            font-size: 20px;
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            white-space: nowrap;
            direction: ltr;
            -webkit-font-feature-settings: 'liga';
            -webkit-font-smoothing: antialiased;
        }

        .ambient-glow-container {
            position: fixed;
            z-index: 0;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .glow-accent-1,
        .glow-accent-2 {
            position: absolute;
            border-radius: 9999px;
            filter: blur(140px);
        }

        .glow-accent-1 {
            top: -8rem;
            left: -8rem;
            width: 28rem;
            height: 28rem;
            background: rgba(104, 7, 186, .12);
        }

        .glow-accent-2 {
            top: 40%;
            right: -8rem;
            width: 32rem;
            height: 32rem;
            background: rgba(0, 245, 212, .06);
            filter: blur(160px);
        }

        .main-content {
            position: relative;
            z-index: 1;
            flex: 1;
            width: 100%;
            max-width: 80rem;
            margin: 0 auto;
            padding: 1.5rem 1rem 3rem;
        }

        #calendar {
            padding: 1.25rem;
            border: 1px solid var(--schedule-border);
            border-radius: 1.25rem;
            background: var(--schedule-panel);
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, .5);
            backdrop-filter: blur(16px);
        }

        .fc {
            color: var(--schedule-text);
            --fc-page-bg-color: transparent;
            --fc-neutral-bg-color: rgba(41, 42, 46, .4);
            --fc-border-color: rgba(58, 74, 70, .35);
            --fc-today-bg-color: rgba(0, 245, 212, .08);
            --fc-list-event-hover-bg-color: rgba(0, 245, 212, .08);
        }

        .fc .fc-toolbar-title {
            color: #fff;
            font-family: Sora, sans-serif;
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: -.02em;
        }

        .fc .fc-button {
            padding: .4rem .75rem !important;
            border: 1px solid rgba(58, 74, 70, .5) !important;
            border-radius: .6rem !important;
            background: rgba(41, 42, 46, .8) !important;
            color: var(--schedule-text) !important;
            font-family: Inter, sans-serif !important;
            font-size: .75rem !important;
            font-weight: 600 !important;
            box-shadow: none !important;
            transition: .2s ease;
        }

        .fc .fc-button:hover {
            border-color: var(--schedule-brand) !important;
            background: rgba(0, 245, 212, .16) !important;
            color: var(--schedule-brand) !important;
        }

        .fc .fc-button-primary:not(:disabled).fc-button-active,
        .fc .fc-button-primary:not(:disabled):active {
            border-color: var(--schedule-brand) !important;
            background: var(--schedule-brand) !important;
            color: var(--schedule-bg) !important;
        }

        .fc-theme-standard th {
            padding: 10px 0 !important;
            border: 1px solid rgba(58, 74, 70, .3) !important;
            background: rgba(19, 20, 26, .8);
        }

        .fc-theme-standard td {
            border: 1px solid rgba(58, 74, 70, .25) !important;
            transition: background-color .15s ease;
        }

        .fc-theme-standard td:hover {
            background: rgba(255, 255, 255, .03);
        }

        .fc .fc-daygrid-day-number {
            padding: 6px 8px !important;
            color: var(--schedule-text) !important;
            font-family: 'JetBrains Mono', monospace;
            font-size: .85rem;
            font-weight: 600;
            text-decoration: none !important;
        }

        .fc-col-header-cell-cushion {
            color: #9ca3af;
            font-family: 'JetBrains Mono', monospace;
            font-size: .8rem;
            font-weight: 700;
            text-decoration: none !important;
        }

        .fc-col-header-cell:nth-child(1) .fc-col-header-cell-cushion,
        .fc-day-sun .fc-daygrid-day-number {
            color: #f87171 !important;
        }

        .fc-col-header-cell:nth-child(7) .fc-col-header-cell-cushion,
        .fc-day-sat .fc-daygrid-day-number {
            color: #60a5fa !important;
        }

        .fc-event {
            padding: 3px 6px;
            border: 1px solid rgba(0, 245, 212, .45);
            border-radius: .45rem;
            background: rgba(0, 245, 212, .15);
            color: var(--schedule-brand);
            font-size: .78rem;
            font-weight: 600;
            cursor: pointer;
            transition: .15s ease;
        }

        .fc-event:hover {
            border-color: var(--schedule-brand);
            background: rgba(0, 245, 212, .3);
        }

        .fc .fc-day-today {
            background: rgba(0, 245, 212, .06) !important;
        }

        .fc .fc-day-today .fc-daygrid-day-number {
            color: var(--schedule-brand) !important;
            font-weight: 800;
            text-shadow: 0 0 8px rgba(0, 245, 212, .5);
        }

        .schedule-panel,
        .modal-content {
            border: 1px solid var(--schedule-border) !important;
            border-radius: 1.25rem !important;
            background: #13141a !important;
            color: var(--schedule-text) !important;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, .7);
        }

        .schedule-panel {
            padding: 1.25rem;
            backdrop-filter: blur(16px);
        }

        .modal-content {
            backdrop-filter: blur(24px);
        }

        .modal-header,
        .modal-footer {
            padding: 1.25rem 1.5rem;
            border-color: rgba(58, 74, 70, .3) !important;
        }

        .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

        .form-control {
            padding: .65rem .9rem;
            border: 1px solid rgba(58, 74, 70, .5) !important;
            border-radius: .65rem !important;
            background: rgba(7, 8, 11, .8) !important;
            color: var(--schedule-text) !important;
            font-size: .9rem;
        }

        .form-control:focus {
            border-color: var(--schedule-brand) !important;
            box-shadow: 0 0 0 3px rgba(0, 245, 212, .2) !important;
        }

        .form-label {
            margin-bottom: .4rem;
            color: var(--schedule-muted);
            font-size: .85rem;
            font-weight: 600;
        }

        .table-dark-custom {
            border-color: rgba(58, 74, 70, .3);
            background: transparent;
            color: var(--schedule-text);
        }

        .table-dark-custom th {
            background: rgba(26, 27, 32, .9);
            color: var(--schedule-brand);
            font-family: 'JetBrains Mono', monospace;
            font-size: .8rem;
            font-weight: 700;
        }

        .table-dark-custom td {
            font-size: .85rem;
            vertical-align: middle;
        }

        .btn-custom-primary,
        .btn-custom-secondary,
        .btn-custom-danger {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            padding: .55rem 1.15rem;
            border-radius: 9999px;
            font-size: .85rem;
            font-weight: 600;
            transition: .2s ease;
        }

        .btn-custom-primary {
            border: 0;
            background: var(--schedule-brand);
            color: var(--schedule-bg);
            box-shadow: 0 4px 14px rgba(0, 245, 212, .2);
            font-weight: 700;
        }

        .btn-custom-primary:hover {
            transform: translateY(-1px);
            background: #00dabf;
            color: var(--schedule-bg);
        }

        .btn-custom-secondary {
            border: 1px solid rgba(58, 74, 70, .5);
            background: rgba(41, 42, 46, .8);
            color: var(--schedule-text);
        }

        .btn-custom-secondary:hover {
            background: rgba(58, 74, 70, .8);
            color: #fff;
        }

        .btn-custom-danger {
            border: 1px solid rgba(239, 68, 68, .4);
            background: rgba(239, 68, 68, .15);
            color: #f87171;
        }

        .btn-custom-danger:hover {
            background: rgba(239, 68, 68, .3);
            color: #fff;
        }

        .schedule-detail-item {
            display: flex;
            flex-direction: column;
            gap: .55rem;
            padding: 1rem 1.05rem;
            border: 1px solid rgba(0, 245, 212, .18);
            border-radius: 1rem;
            background: linear-gradient(160deg, rgba(20, 24, 32, .95), rgba(10, 12, 16, .88));
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04);
            transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
        }

        .schedule-detail-item:hover {
            border-color: rgba(0, 245, 212, .42);
            box-shadow: 0 10px 24px rgba(0, 0, 0, .28), inset 0 1px 0 rgba(255, 255, 255, .05);
            transform: translateY(-1px);
        }

        .schedule-detail-item .detail-meta {
            display: flex;
            align-items: center;
            gap: .4rem;
            color: var(--schedule-muted);
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
        }

        .schedule-detail-item .detail-actions {
            display: flex;
            justify-content: flex-end;
            margin-top: .15rem;
        }

        .schedule-view-card {
            border: 1px solid rgba(0, 245, 212, .2);
            border-radius: 1rem;
            background: linear-gradient(165deg, rgba(18, 22, 30, .98), rgba(8, 10, 14, .92));
            padding: 1.1rem 1.2rem;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04);
        }

        .schedule-view-label {
            display: block;
            margin-bottom: .35rem;
            color: var(--schedule-muted);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .schedule-view-dates {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .75rem;
        }

        .schedule-view-date {
            border: 1px solid rgba(58, 74, 70, .55);
            border-radius: .85rem;
            background: rgba(0, 0, 0, .28);
            padding: .85rem .95rem;
        }

        .schedule-view-date strong {
            display: block;
            margin-top: .2rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: .92rem;
            font-weight: 700;
        }

        @media (max-width: 767px) {
            #calendar { padding: .5rem; }
            .fc .fc-toolbar { flex-wrap: wrap; gap: .5rem; }
            .fc .fc-toolbar-title { font-size: 1rem; }
            .fc .fc-button { padding: .35rem .5rem !important; }
            .main-content { padding: 1rem .75rem 2rem; }
        }
    </style>
</head>

<body class="dark selection:bg-brand selection:text-black">
    <div class="ambient-glow-container" aria-hidden="true">
        <div class="glow-accent-1"></div>
        <div class="glow-accent-2"></div>
    </div>

    {{>layout/header}}

    <main class="main-content space-y-6">
        <section class="flex flex-col gap-4 border-b border-white/10 pb-4 md:flex-row md:items-end md:justify-between">
            <div>
                <div class="mb-2 flex items-center gap-2">
                    <span class="rounded border border-brand/30 bg-brand/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-widest text-brand">OFFICIAL SCHEDULE</span>
                    <span class="font-mono text-xs text-[#b9cac4]">tripleS TIMELINE</span>
                </div>
                <h1 class="flex items-center gap-3 font-sora text-2xl font-extrabold text-white sm:text-3xl">
                    <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-brand shadow-[0_0_10px_#00f5d4]"></span>
                    공식 스케줄
                </h1>
                {{#selectedArtist}}<p class="mt-2 text-sm text-[#b9cac4]">{{selectedArtist}}만 보는 중입니다. <a class="text-[#00f5d4]" href="/schedule">전체 일정</a></p>{{/selectedArtist}}
            </div>

            <div class="flex shrink-0 items-center gap-2.5">
                <button type="button" class="btn-custom-secondary" data-bs-toggle="modal" data-bs-target="#scheduleListModal">
                    <span class="material-symbols-outlined">format_list_bulleted</span>
                    스케줄 목록
                </button>
                {{#isAdmin}}
                <button type="button" class="btn-custom-primary" onclick="showAddModal()">
                    <span class="material-symbols-outlined">add</span>
                    스케줄 추가
                </button>
                {{/isAdmin}}
            </div>
        </section>

        <section class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
            <div class="lg:col-span-8">
                <div class="schedule-legend" aria-label="일정 분류 색상"><span style="--schedule-color:#a78bfa">팬사인회</span><span style="--schedule-color:#fb923c">방송</span><span style="--schedule-color:#00f5d4">🎂 기념일 · 멤버색</span><span style="--schedule-color:#f87171">발매</span><span style="--schedule-color:#7dd3fc">행사</span></div><div id="calendar" aria-label="공식 스케줄 캘린더"></div>
            </div>

            <aside class="space-y-5 lg:col-span-4">
                <section class="schedule-panel space-y-4">
                    <div class="flex items-center justify-between border-b border-white/10 pb-3">
                        <div>
                            <span class="mb-1 block font-mono text-[10px] uppercase tracking-wider text-brand">SELECTED DATE</span>
                            <h2 id="sideSelectedDate" class="text-base font-bold text-white">날짜를 선택하세요</h2>
                        </div>
                        <button type="button" id="showTodayButton" class="btn-custom-secondary !px-3 !py-1.5 text-xs">오늘</button>
                    </div>
                    <div id="sideScheduleDetail" class="space-y-3" aria-live="polite">
                        <p class="py-4 text-sm text-[#b9cac4]">캘린더에서 날짜를 선택하면 해당 날짜의 일정이 표시됩니다.</p>
                    </div>
                </section>
            </aside>
        </section>
    </main>

    <!-- 전체 일정 목록 -->
    <div class="modal fade" id="scheduleListModal" tabindex="-1" aria-labelledby="scheduleListLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title flex items-center gap-2 font-sora text-brand" id="scheduleListLabel">
                        <span class="material-symbols-outlined">calendar_month</span>
                        전체 일정 목록
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="table-responsive overflow-hidden rounded-xl border border-white/10">
                        <table class="table table-dark table-bordered table-dark-custom mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3">제목</th>
                                    <th class="px-4 py-3" style="width: 25%">시작일</th>
                                    <th class="px-4 py-3" style="width: 25%">종료일</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#schedules}}
                                <tr>
                                    <td class="px-4 py-3 font-medium text-white"><span class="schedule-category-label" style="--schedule-color:{{color}}">{{categoryLabel}}</span> {{displayTitle}}</td>
                                    <td class="px-4 py-3 font-mono text-[#b9cac4]">{{startStr}}</td>
                                    <td class="px-4 py-3 font-mono text-[#b9cac4]">{{rawEnd}}</td>
                                </tr>
                                {{/schedules}}
                                {{^schedules}}
                                <tr>
                                    <td colspan="3" class="py-6 text-center text-[#b9cac4]">등록된 일정이 없습니다.</td>
                                </tr>
                                {{/schedules}}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-custom-secondary" data-bs-dismiss="modal">닫기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 일정 상세 -->
    <div class="modal fade" id="viewScheduleModal" tabindex="-1" aria-labelledby="viewScheduleLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title flex items-center gap-2 font-sora text-brand" id="viewScheduleLabel">
                        <span class="material-symbols-outlined">event</span>
                        스케줄 상세 정보
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                </div>
                <div class="modal-body space-y-3 p-4">
                    <div class="schedule-view-card">
                        <span class="schedule-view-label">일정 제목</span>
                        <span id="modalScheduleCategory" class="schedule-category-label"></span>
                        <h3 id="modalScheduleTitle" class="text-lg font-bold leading-snug text-white"></h3>
                    </div>
                    <div class="schedule-view-dates">
                        <div class="schedule-view-date">
                            <span class="schedule-view-label">시작</span>
                            <strong id="modalScheduleStart" class="text-brand"></strong>
                        </div>
                        <div class="schedule-view-date">
                            <span class="schedule-view-label">종료</span>
                            <strong id="modalScheduleEnd" class="text-white"></strong>
                        </div>
                    </div>
                </div>
                <div class="modal-footer flex justify-between">
                    <div>
                        {{#isAdmin}}
                        <form id="deleteForm" method="post" class="m-0 d-inline" data-confirm="이 일정을 삭제하시겠습니까? 삭제하면 되돌릴 수 없습니다.">
                            {{#_csrf}}<input type="hidden" name="{{parameterName}}" value="{{token}}">{{/_csrf}}
                            <button type="submit" class="btn-custom-danger">삭제</button>
                        </form>
                        {{/isAdmin}}
                    </div>
                    <div class="flex items-center gap-2">
                        {{#isAdmin}}
                        <button type="button" id="editBtn" class="btn-custom-primary">수정하기</button>
                        {{/isAdmin}}
                        <button type="button" class="btn-custom-secondary" data-bs-dismiss="modal">닫기</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 일정 등록 -->
    <div class="modal fade" id="addScheduleModal" tabindex="-1" aria-labelledby="addScheduleLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form id="addScheduleForm" method="post" action="/schedule/add" class="m-0 w-full">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title flex items-center gap-2 font-sora text-brand" id="addScheduleLabel">
                            <span class="material-symbols-outlined">add_circle</span>
                            새 스케줄 등록
                        </h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                    </div>
                    <div class="modal-body space-y-3 p-4">
                        <div>
                            <label for="titleInput" class="form-label">스케줄 제목</label>
                            <input type="text" class="form-control" id="titleInput" name="title" maxlength="200" required>
                        </div>
                        <div>
                            <label for="addScheduleCategory" class="form-label">일정 분류</label>
                            <select id="addScheduleCategory" name="category" class="form-control">
                                {{#scheduleCategories}}<option value="{{value}}" data-color="{{color}}">{{label}}</option>{{/scheduleCategories}}
                            </select>
                            <div class="schedule-category-preview" id="addSchedulePreview" aria-live="polite">일정 미리보기</div>
                        </div>
                        <div>
                            <label for="startInput" class="form-label">시작 날짜</label>
                            <input type="date" class="form-control font-mono" id="startInput" name="start" required>
                        </div>
                        <div>
                            <label for="endInput" class="form-label">종료 날짜 (선택)</label>
                            <input type="date" class="form-control font-mono" id="endInput" name="end">
                        </div>
                        <div>
                            <label for="addArtistNames" class="form-label">출연 멤버</label>
                            <select id="addArtistNames" class="form-control" name="artistNames" multiple size="5">
                                {{#artistOptions}}<option value="{{name}}" data-color="{{color}}">{{name}}</option>{{/artistOptions}}
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-custom-secondary" data-bs-dismiss="modal">취소</button>
                        <button type="submit" class="btn-custom-primary">추가하기</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 일정 수정 -->
    <div class="modal fade" id="editScheduleModal" tabindex="-1" aria-labelledby="editScheduleLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form id="editScheduleForm" class="m-0 w-full">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title flex items-center gap-2 font-sora text-brand" id="editScheduleLabel">
                            <span class="material-symbols-outlined">edit_calendar</span>
                            스케줄 수정
                        </h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                    </div>
                    <div class="modal-body space-y-3 p-4">
                        <input type="hidden" id="editScheduleId" name="id">
                        <div>
                            <label for="editTitleInput" class="form-label">스케줄 제목</label>
                            <input type="text" class="form-control" id="editTitleInput" name="title" maxlength="200" required>
                        </div>
                        <div>
                            <label for="editScheduleCategory" class="form-label">일정 분류</label>
                            <select id="editScheduleCategory" name="category" class="form-control">
                                {{#scheduleCategories}}<option value="{{value}}" data-color="{{color}}">{{label}}</option>{{/scheduleCategories}}
                            </select>
                            <div class="schedule-category-preview" id="editSchedulePreview" aria-live="polite">일정 미리보기</div>
                        </div>
                        <div>
                            <label for="editStartInput" class="form-label">시작 날짜</label>
                            <input type="date" class="form-control font-mono" id="editStartInput" name="start" required>
                        </div>
                        <div>
                            <label for="editEndInput" class="form-label">종료 날짜 (선택)</label>
                            <input type="date" class="form-control font-mono" id="editEndInput" name="end">
                        </div>
                        <div>
                            <label for="editArtistNames" class="form-label">출연 멤버</label>
                            <select id="editArtistNames" class="form-control" name="artistNames" multiple size="5">
                                {{#artistOptions}}<option value="{{name}}" data-color="{{color}}">{{name}}</option>{{/artistOptions}}
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-custom-secondary" data-bs-dismiss="modal">취소</button>
                        <button type="submit" class="btn-custom-primary">수정 저장</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {{>layout/footer}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales/ko.global.min.js"></script>

    <script>
        function scheduleModal(element) {
            return bootstrap.Modal.getInstance(element)||new bootstrap.Modal(element);
        }
        // Bootstrap은 열리는 중의 hide()를 무시하므로 열린 뒤 다시 닫는다.
        function hideScheduleModalThen(element, callback) {
            element.addEventListener('hidden.bs.modal', callback, {once:true});
            const modal = scheduleModal(element);
            modal.hide();
            if (element.classList.contains('show')) {
                element.addEventListener('shown.bs.modal', () => modal.hide(), {once:true});
            }
        }
        function showAddModal() {
            const modalElement = document.getElementById('addScheduleModal');
            scheduleModal(modalElement).show();
        }

        function formatDate(dateValue) {
            if (!dateValue) return '-';
            const value = String(dateValue).substring(0, 10);
            const parts = value.split('-');
            return parts.length === 3 ? `${parts[0]}.${parts[1]}.${parts[2]}` : value;
        }

        function addOneDay(dateValue) {
            if (!dateValue) return null;
            const parts = String(dateValue).substring(0, 10).split('-').map(Number);
            if (parts.length !== 3 || parts.some(Number.isNaN)) return null;

            const date = new Date(parts[0], parts[1] - 1, parts[2]);
            date.setDate(date.getDate() + 1);
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function getRawEnd(event) {
            return event.extendedProps?.rawEnd || event.endStr || '';
        }

        function toCalendarEvent(item) {
            return {
                id:item.id,title:item.displayTitle||item.title,start:item.start,end:item.end,
                borderColor:item.color,textColor:item.color,backgroundColor:'transparent',
                extendedProps:{...item,rawTitle:item.title}
            };
        }

        function scheduleHeaders() {
            const headers={'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'};
            return window.AboutAdminAuth?.applyAuthHeaders(headers)||headers;
        }

        function bindCategoryPreview(prefix,titleId,artistId) {
            const category=document.getElementById(prefix+'ScheduleCategory');
            const title=document.getElementById(titleId), artists=document.getElementById(artistId);
            const preview=document.getElementById(prefix+'SchedulePreview');
            if(!category||!preview)return;
            function update() {
                const option=category.selectedOptions[0];
                let color=option?.dataset.color||'#00f5d4';
                if(category.value==='ANNIVERSARY')color=artists.selectedOptions[0]?.dataset.color||color;
                preview.style.setProperty('--schedule-color',color);
                const label=title.value.trim()||option?.textContent||'일정 미리보기';
                preview.textContent=(category.value==='ANNIVERSARY'&&!label.includes('🎂')?'🎂 ':'')+label;
            }
            category.addEventListener('change',update);title.addEventListener('input',update);artists.addEventListener('change',update);
            category.form.addEventListener('reset',()=>requestAnimationFrame(update));update();
        }

        function getCalendarEvents() {
            try {
                const injectedEvents = {{{schedulesJson}}};
                return Array.isArray(injectedEvents) ? injectedEvents.map(toCalendarEvent) : [];
            } catch (error) {
                console.error('스케줄 데이터 파싱 실패:', error);
                return [];
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const calendarElement = document.getElementById('calendar');
            const selectedDateElement = document.getElementById('sideSelectedDate');
            const detailElement = document.getElementById('sideScheduleDetail');
            const todayButton = document.getElementById('showTodayButton');
            const viewModalElement = document.getElementById('viewScheduleModal');
            const editModalElement = document.getElementById('editScheduleModal');
            const addModalElement = document.getElementById('addScheduleModal');

            if (!calendarElement || typeof FullCalendar === 'undefined') {
                console.error('캘린더 요소 또는 FullCalendar를 찾을 수 없습니다.');
                return;
            }

            bindCategoryPreview('add','titleInput','addArtistNames');
            bindCategoryPreview('edit','editTitleInput','editArtistNames');
            let selectedEvent = null;

            function renderSelectedDate(dateString, dateObject) {
                if (dateObject) {
                    selectedDateElement.textContent = dateObject.toLocaleDateString('ko-KR', {
                        year: 'numeric', month: 'long', day: 'numeric', weekday: 'short'
                    });
                } else {
                    selectedDateElement.textContent = dateString || '날짜를 선택하세요';
                }

                const dayEvents = calendar.getEvents().filter(event => {
                    if (!event.start) return false;
                    const start = new Date(event.start.getFullYear(), event.start.getMonth(), event.start.getDate());
                    const selected = dateObject
                        ? new Date(dateObject.getFullYear(), dateObject.getMonth(), dateObject.getDate())
                        : new Date(`${dateString}T00:00:00`);
                    const endString = getRawEnd(event);
                    const end = endString ? new Date(`${String(endString).substring(0, 10)}T00:00:00`) : start;
                    return selected >= start && selected <= end;
                });

                detailElement.replaceChildren();

                if (dayEvents.length === 0) {
                    const empty = document.createElement('p');
                    empty.className = 'py-4 text-sm text-[#b9cac4]';
                    empty.textContent = '선택한 날짜에 등록된 일정이 없습니다.';
                    detailElement.appendChild(empty);
                    return;
                }

                dayEvents.forEach(event => {
                    const item = document.createElement('article');
                    item.className = 'schedule-detail-item';
                    item.style.setProperty('--schedule-color',event.extendedProps.color||'#00f5d4');

                    const title = document.createElement('h3');
                    title.className = 'text-sm font-bold leading-snug text-white';
                    title.textContent = event.title || '제목 없는 일정';

                    const dates = document.createElement('p');
                    dates.className = 'detail-meta';
                    const endText = getRawEnd(event) ? ` ~ ${formatDate(getRawEnd(event))}` : '';
                    dates.innerHTML = `<span class="material-symbols-outlined text-[14px] text-brand">calendar_today</span><span>${formatDate(event.startStr)}${endText}</span>`;

                    const actions = document.createElement('div');
                    actions.className = 'detail-actions';

                    const openButton = document.createElement('button');
                    openButton.type = 'button';
                    openButton.className = 'btn-custom-secondary !px-3 !py-1.5 text-xs';
                    openButton.textContent = '상세 보기';
                    openButton.addEventListener('click', () => openEventDetails(event));
                    actions.appendChild(openButton);

                    const category=document.createElement('span');
                    category.className='schedule-category-label';category.textContent=event.extendedProps.categoryLabel||'일정';
                    item.append(category, title, dates, actions);
                    detailElement.appendChild(item);
                });
            }

            function openEventDetails(event) {
                selectedEvent = event;
                viewModalElement.style.setProperty('--schedule-color',event.extendedProps.color||'#00f5d4');
                document.getElementById('modalScheduleCategory').textContent=event.extendedProps.categoryLabel||'일정';
                document.getElementById('modalScheduleTitle').textContent = event.title || '';
                document.getElementById('modalScheduleStart').textContent = formatDate(event.startStr);
                const endValue = formatDate(getRawEnd(event));
                document.getElementById('modalScheduleEnd').textContent = endValue === '-' ? '하루 일정' : endValue;

                const deleteForm = document.getElementById('deleteForm');
                if (deleteForm) deleteForm.action = `/delete/${encodeURIComponent(event.id)}`;

                const editButton = document.getElementById('editBtn');
                if (editButton) {
                    editButton.onclick = function () {
                        if (!selectedEvent) return;
                        document.getElementById('editScheduleId').value = selectedEvent.id;
                        document.getElementById('editTitleInput').value = selectedEvent.extendedProps.rawTitle || selectedEvent.title || '';
                        document.getElementById('editScheduleCategory').value=selectedEvent.extendedProps.category||'AUTO';
                        document.getElementById('editStartInput').value = String(selectedEvent.startStr || '').substring(0, 10);
                        document.getElementById('editEndInput').value = String(getRawEnd(selectedEvent)).substring(0, 10);
                        const selectedArtists = String(selectedEvent.extendedProps.artistNames || '').split(',').map(v => v.trim()).filter(Boolean);
                        document.querySelectorAll('#editArtistNames option').forEach(option => option.selected = selectedArtists.includes(option.value));

                        document.getElementById('editScheduleCategory').dispatchEvent(new Event('change'));
                        hideScheduleModalThen(viewModalElement, () => scheduleModal(editModalElement).show());
                    };
                }

                scheduleModal(viewModalElement).show();
            }

            const calendar = new FullCalendar.Calendar(calendarElement, {
                initialView: 'dayGridMonth',
                locale: 'ko',
                height: 'auto',
                dayMaxEvents: window.matchMedia('(max-width: 600px)').matches ? 2 : 3,
                fixedWeekCount: false,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth'
                },
                buttonText: {
                    today: '오늘',
                    month: '월간'
                },
                events: getCalendarEvents(),
                windowResize: function() {
                    const maximum=window.matchMedia('(max-width: 600px)').matches ? 2 : 3;
                    if(calendar.getOption('dayMaxEvents')!==maximum)calendar.setOption('dayMaxEvents',maximum);
                },
                eventDidMount: function(info) {
                    info.el.style.setProperty('--schedule-color',info.event.extendedProps.color||'#00f5d4');
                },
                dateClick: function (info) {
                    renderSelectedDate(info.dateStr, info.date);
                },
                eventClick: function (info) {
                    info.jsEvent.preventDefault();
                    renderSelectedDate(info.event.startStr, info.event.start);
                    openEventDetails(info.event);
                },
                datesSet: function () {
                    if (!selectedDateElement.dataset.initialized) {
                        selectedDateElement.dataset.initialized = 'true';
                        const today = new Date();
                        renderSelectedDate('', today);
                    }
                }
            });

            calendar.render();
            const focusId = new URLSearchParams(window.location.search).get('focus');
            if (focusId) {
                const focused = calendar.getEventById(focusId);
                if (focused) {
                    renderSelectedDate(focused.startStr, focused.start);
                    openEventDetails(focused);
                }
            }

            if (todayButton) {
                todayButton.addEventListener('click', function () {
                    calendar.today();
                    const today = new Date();
                    renderSelectedDate('', today);
                });
            }

            const addForm = document.getElementById('addScheduleForm');
            if (addForm) {
                addForm.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const title = document.getElementById('titleInput').value.trim();
                    const start = document.getElementById('startInput').value;
                    const end = document.getElementById('endInput').value;

                    if (!title || !start) {
                        alert('제목과 시작 날짜를 입력해 주세요.');
                        return;
                    }
                    if (end && end < start) {
                        alert('종료 날짜는 시작 날짜보다 빠를 수 없습니다.');
                        return;
                    }
                    if (!window.confirm('이 일정을 추가하시겠습니까?')) return;

                    const body = new URLSearchParams({ title, start, end, category:document.getElementById('addScheduleCategory').value });
                    document.querySelectorAll('#addArtistNames option:checked').forEach(option => body.append('artistNames', option.value));
                    try {
                        const response = await fetch('/schedule/add', {
                            method: 'POST',
                            headers: scheduleHeaders(),
                            credentials: 'same-origin',
                            body: body.toString()
                        });

                        if (!response.ok) {
                            alert('스케줄 추가에 실패했습니다.');
                            return;
                        }

                        const saved=await response.json();
                        calendar.addEvent(toCalendarEvent(saved));

                        scheduleModal(addModalElement).hide();
                        addForm.reset();
                        renderSelectedDate(start, new Date(`${start}T00:00:00`));
                    } catch (error) {
                        console.error('스케줄 추가 오류:', error);
                        alert('서버 통신 중 오류가 발생했습니다.');
                    }
                });
            }

            const editForm = document.getElementById('editScheduleForm');
            if (editForm) {
                editForm.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const id = document.getElementById('editScheduleId').value;
                    const title = document.getElementById('editTitleInput').value.trim();
                    const start = document.getElementById('editStartInput').value;
                    const end = document.getElementById('editEndInput').value;

                    if (!id || !title || !start) {
                        alert('제목과 시작 날짜를 입력해 주세요.');
                        return;
                    }
                    if (end && end < start) {
                        alert('종료 날짜는 시작 날짜보다 빠를 수 없습니다.');
                        return;
                    }
                    if (!window.confirm('이 일정을 수정하시겠습니까?')) return;

                    const body = new URLSearchParams({ title, startDate: start, endDate: end, category:document.getElementById('editScheduleCategory').value });
                    document.querySelectorAll('#editArtistNames option:checked').forEach(option => body.append('artistNames', option.value));
                    try {
                        const response = await fetch(`/edit/${encodeURIComponent(id)}`, {
                            method: 'POST',
                            headers: scheduleHeaders(),
                            credentials: 'same-origin',
                            body: body.toString()
                        });

                        if (!response.ok) {
                            alert('스케줄 수정에 실패했습니다.');
                            return;
                        }

                        const saved=toCalendarEvent(await response.json());
                        const eventToUpdate=calendar.getEventById(id);
                        if(eventToUpdate)eventToUpdate.remove();
                        calendar.addEvent(saved);

                        scheduleModal(editModalElement).hide();
                        renderSelectedDate(start, new Date(`${start}T00:00:00`));
                    } catch (error) {
                        console.error('스케줄 수정 오류:', error);
                        alert('서버 통신 중 오류가 발생했습니다.');
                    }
                });
            }
        });
    </script>
</body>
</html>
