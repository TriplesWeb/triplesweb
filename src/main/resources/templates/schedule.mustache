{{>layout/head-open}}

    <title>트리플에스 커뮤니티 스케줄</title>
    <link rel="stylesheet" href="{{#asset}}/css/triples.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/schedule-categories.css{{/asset}}">
</head><body class="site-page dark selection:bg-brand selection:text-black">
    <div class="ambient-glow-container" aria-hidden="true">
        <div class="glow-accent-1"></div>
        <div class="glow-accent-2"></div>
    </div>

    {{>layout/header}}

    <main class="main-content mx-auto w-full max-w-7xl space-y-6 px-4 py-8">
        <section class="schedule-page-header">
            <div class="schedule-page-header__body">
                <div class="mb-2 flex items-center gap-2">
                    <span class="rounded border border-brand/30 bg-brand/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-widest text-brand">OFFICIAL SCHEDULE</span>
                    <span class="font-mono text-xs text-[#b9cac4]">tripleS TIMELINE</span>
                </div>
                <h1 class="flex items-center gap-3 font-sora text-2xl font-extrabold text-white sm:text-3xl">
                    <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-brand shadow-[0_0_10px_#00f5d4]"></span>
                    공식 스케줄
                </h1>
                {{#selectedArtist}}<p class="mt-2 text-sm text-[#b9cac4]">{{selectedArtist}}만 보는 중입니다. <a class="text-[#00f5d4]" href="/schedule">전체 일정</a></p>{{/selectedArtist}}
            </div>

            {{#isAdmin}}
            <div class="schedule-page-actions">
                <button type="button" class="md-btn md-btn-tonal btn-custom-secondary" id="openDecorationManager">
                    <span class="material-symbols-outlined">image</span>
                    유닛·기념일 관리
                </button>
                <button type="button" class="md-btn md-btn-filled btn-custom-primary" onclick="showAddModal()">
                    <span class="material-symbols-outlined">add</span>
                    스케줄 추가
                </button>
            </div>
            {{/isAdmin}}
        </section>

        <section class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
            <div class="lg:col-span-8">
                <div class="schedule-legend" aria-label="일정 분류 색상"><span style="--schedule-color:#a78bfa">팬사인회</span><span style="--schedule-color:#fb923c">방송</span><span style="--schedule-color:#00f5d4">🎂 기념일 · 멤버색</span><span style="--schedule-color:#f87171">발매</span><span style="--schedule-color:#7dd3fc">행사</span></div>
                <div id="calendar" aria-label="공식 스케줄 캘린더" data-initial-date="{{scheduleInitialDate}}" data-initial-start="{{scheduleInitialStart}}" data-initial-end="{{scheduleInitialEnd}}"{{#selectedArtist}} data-selected-artist="{{selectedArtist}}"{{/selectedArtist}}></div>
            </div>

            <aside class="space-y-5 lg:col-span-4">
                <section class="schedule-panel space-y-4">
                    <div class="flex items-center justify-between border-b border-white/10 pb-3">
                        <div>
                            <span class="mb-1 block font-mono text-[10px] uppercase tracking-wider text-brand">SELECTED DATE</span>
                            <h2 id="sideSelectedDate" class="text-base font-bold text-white">날짜를 선택하세요</h2>
                        </div>
                        <button type="button" id="showTodayButton" class="md-btn md-btn-tonal btn-custom-secondary !px-3 !py-1.5 text-xs">오늘</button>
                    </div>
                    <div id="sideScheduleDetail" class="space-y-3" aria-live="polite">
                        <p class="py-4 text-sm text-[#b9cac4]">캘린더에서 날짜를 선택하면 해당 날짜의 일정이 표시됩니다.</p>
                    </div>
                </section>
            </aside>
        </section>
    </main>

    <!-- 일정 상세 -->
    <div class="site-modal" id="viewScheduleModal" tabindex="-1" aria-labelledby="viewScheduleLabel" aria-hidden="true">
        <div class="site-modal-dialog">
            <div class="site-modal-panel">
                <div class="site-modal-header">
                    <h2 class="site-modal-title flex items-center gap-2 font-sora text-brand" id="viewScheduleLabel">
                        <span class="material-symbols-outlined">event</span>
                        스케줄 상세 정보
                    </h2>
                    <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="닫기"></button>
                </div>
                <div class="site-modal-body space-y-3 p-4">
                    <div class="schedule-view-card">
                        <span class="schedule-view-label">일정 제목</span>
                        <span id="modalScheduleCategory" class="schedule-category-label"></span>
                        <h3 id="modalScheduleTitle" class="text-lg font-bold leading-snug text-white"></h3>
                        <img id="modalScheduleImage" class="hidden mt-3 max-h-64 w-full rounded-xl object-contain" alt="일정 이미지">
                        <p id="modalScheduleDescription" class="hidden whitespace-pre-wrap text-sm leading-relaxed text-[#b9cac4]"></p>
                    </div>
                    <div class="schedule-view-dates">
                        <div class="schedule-view-date">
                            <span class="schedule-view-label">시작</span>
                            <strong id="modalScheduleStart" class="text-brand"></strong>
                        </div>
                        <div class="schedule-view-date">
                            <span class="schedule-view-label">종료</span>
                            <strong id="modalScheduleEnd" class="text-white"></strong>
                        </div>
                    </div>
                </div>
                <div class="modal-footer flex justify-between">
                    <div>
                        {{#isAdmin}}
                        <form id="deleteForm" method="post" class="m-0 d-inline" data-confirm="이 일정을 삭제하시겠습니까? 삭제하면 되돌릴 수 없습니다.">
                            {{#_csrf}}<input type="hidden" name="{{parameterName}}" value="{{token}}">{{/_csrf}}
                            <button type="submit" class="btn-custom-danger">삭제</button>
                        </form>
                        {{/isAdmin}}
                    </div>
                    <div class="flex items-center gap-2">
                        {{#isAdmin}}
                        <button type="button" id="editBtn" class="md-btn md-btn-filled btn-custom-primary">수정하기</button>
                        {{/isAdmin}}
                        <button type="button" class="btn-custom-secondary" data-site-dismiss="modal">닫기</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 일정 등록 -->
    <div class="site-modal" id="addScheduleModal" tabindex="-1" aria-labelledby="addScheduleLabel" aria-hidden="true">
        <div class="site-modal-dialog">
            <form id="addScheduleForm" method="post" action="/schedule/add" class="m-0 w-full">
                <div class="site-modal-panel">
                    <div class="site-modal-header">
                        <h2 class="site-modal-title flex items-center gap-2 font-sora text-brand" id="addScheduleLabel">
                            <span class="material-symbols-outlined">add_circle</span>
                            새 스케줄 등록
                        </h2>
                        <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="닫기"></button>
                    </div>
                    <div class="site-modal-body space-y-3 p-4">
                        <div>
                            <label for="titleInput" class="site-label">스케줄 제목</label>
                            <input type="text" class="site-field" id="titleInput" name="title" maxlength="200" required>
                        </div>
                        <div>
                            <label for="addScheduleCategory" class="site-label">일정 분류</label>
                            <select id="addScheduleCategory" name="category" class="site-field">
                                {{#scheduleCategories}}<option value="{{value}}" data-color="{{color}}">{{label}}</option>{{/scheduleCategories}}
                            </select>
                            <div class="schedule-category-preview" id="addSchedulePreview" aria-live="polite">일정 미리보기</div>
                        </div>
                        <div>
                            <label for="startInput" class="site-label">시작 날짜</label>
                            <input type="date" class="site-field font-mono" id="startInput" name="start" required>
                        </div>
                        <div>
                            <label for="endInput" class="site-label">종료 날짜 (선택)</label>
                            <input type="date" class="site-field font-mono" id="endInput" name="end">
                        </div>
                        <div>
                            <div class="flex items-center justify-between gap-2">
                                <label for="addArtistNames" class="site-label">출연 멤버</label>
                                <button type="button" class="md-btn md-btn-text" data-picker-all="#addArtistNames">전체 선택</button>
                            </div>
                            <select id="addArtistNames" class="site-field" name="artistNames" multiple size="5">
                                {{#artistOptions}}<option value="{{name}}" data-color="{{color}}">{{name}}</option>{{/artistOptions}}
                            </select>
                        </div>
                    </div>
                    <div class="site-modal-footer">
                        <button type="button" class="md-btn md-btn-text btn-custom-secondary" data-site-dismiss="modal">취소</button>
                        <button type="submit" class="md-btn md-btn-filled btn-custom-primary">추가하기</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 일정 수정 -->
    <div class="site-modal" id="editScheduleModal" tabindex="-1" aria-labelledby="editScheduleLabel" aria-hidden="true">
        <div class="site-modal-dialog">
            <form id="editScheduleForm" class="m-0 w-full">
                <div class="site-modal-panel">
                    <div class="site-modal-header">
                        <h2 class="site-modal-title flex items-center gap-2 font-sora text-brand" id="editScheduleLabel">
                            <span class="material-symbols-outlined">edit_calendar</span>
                            스케줄 수정
                        </h2>
                        <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="닫기"></button>
                    </div>
                    <div class="site-modal-body space-y-3 p-4">
                        <input type="hidden" id="editScheduleId" name="id">
                        <div>
                            <label for="editTitleInput" class="site-label">스케줄 제목</label>
                            <input type="text" class="site-field" id="editTitleInput" name="title" maxlength="200" required>
                        </div>
                        <div>
                            <label for="editScheduleCategory" class="site-label">일정 분류</label>
                            <select id="editScheduleCategory" name="category" class="site-field">
                                {{#scheduleCategories}}<option value="{{value}}" data-color="{{color}}">{{label}}</option>{{/scheduleCategories}}
                            </select>
                            <div class="schedule-category-preview" id="editSchedulePreview" aria-live="polite">일정 미리보기</div>
                        </div>
                        <div>
                            <label for="editStartInput" class="site-label">시작 날짜</label>
                            <input type="date" class="site-field font-mono" id="editStartInput" name="start" required>
                        </div>
                        <div>
                            <label for="editEndInput" class="site-label">종료 날짜 (선택)</label>
                            <input type="date" class="site-field font-mono" id="editEndInput" name="end">
                        </div>
                        <div>
                            <div class="flex items-center justify-between gap-2">
                                <label for="editArtistNames" class="site-label">출연 멤버</label>
                                <button type="button" class="md-btn md-btn-text" data-picker-all="#editArtistNames">전체 선택</button>
                            </div>
                            <select id="editArtistNames" class="site-field" name="artistNames" multiple size="5">
                                {{#artistOptions}}<option value="{{name}}" data-color="{{color}}">{{name}}</option>{{/artistOptions}}
                            </select>
                        </div>
                    </div>
                    <div class="site-modal-footer">
                        <button type="button" class="md-btn md-btn-text btn-custom-secondary" data-site-dismiss="modal">취소</button>
                        <button type="submit" class="md-btn md-btn-filled btn-custom-primary">수정 저장</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 유닛·기념일 이미지 관리 -->
    {{#isAdmin}}
    <div class="site-modal" id="decorationModal" tabindex="-1" aria-labelledby="decorationLabel" aria-hidden="true">
        <div class="site-modal-dialog">
            <div class="site-modal-panel">
                <div class="site-modal-header">
                    <h2 id="decorationLabel" class="site-modal-title flex items-center gap-2 text-brand">
                        <span class="material-symbols-outlined">image</span> 유닛·기념일 관리
                    </h2>
                    <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="닫기"></button>
                </div>
                <form id="decorationForm" class="m-0">
                    <div class="site-modal-body space-y-3 p-4">
                        <input type="hidden" id="decorationId">
                        <div><label class="site-label" for="decorationTitle">제목</label><input id="decorationTitle" name="title" class="site-field" maxlength="120" required></div>
                        <div class="grid grid-cols-2 gap-3">
                            <div><label class="site-label" for="decorationKind">구분</label><select id="decorationKind" name="kind" class="site-field"><option value="UNIT">유닛 일정</option><option value="ANNIVERSARY">기념일</option></select></div>
                            <div><label class="site-label" for="decorationDate">날짜</label><input id="decorationDate" name="eventDate" type="date" class="site-field" required></div>
                        </div>
                        <div><label class="site-label" for="decorationUnit">유닛명 (선택)</label><input id="decorationUnit" name="unitName" class="site-field" maxlength="80"></div>
                        <label class="flex items-center gap-2 text-sm text-[#b9cac4]"><input id="decorationRepeatYearly" name="repeatYearly" type="checkbox" value="true"> 매년 반복</label>
                        <div><label class="site-label" for="decorationDescription">설명</label><textarea id="decorationDescription" name="description" class="site-field" rows="3" maxlength="500"></textarea></div>
                        <div class="grid grid-cols-2 items-end gap-3">
                            <div><label class="site-label" for="decorationColor">표시 색상</label><input id="decorationColor" name="color" type="color" value="#00f5d4" class="site-field h-11"></div>
                            <div><label class="site-label" for="decorationImage">스티커 이미지</label><input id="decorationImage" name="image" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" class="site-field"></div>
                        </div>
                        <img id="decorationPreview" class="hidden max-h-40 rounded-xl object-contain" alt="업로드 이미지 미리보기">
                        <label class="flex items-center gap-2 text-sm text-[#b9cac4]"><input id="decorationClearImage" type="checkbox"> 기존 이미지 제거</label>
                    </div>
                    <div class="site-modal-footer">
                        <button type="button" id="decorationReset" class="btn-custom-secondary">새로 등록</button>
                        <button type="submit" class="md-btn md-btn-filled btn-custom-primary">저장</button>
                    </div>
                </form>
                <div class="border-t border-white/10 p-4">
                    <h3 class="mb-3 text-sm font-bold text-white">등록된 항목</h3>
                    <div id="decorationList" class="space-y-2"><p class="text-sm text-[#b9cac4]">불러오는 중...</p></div>
                </div>
            </div>
        </div>
    </div>
    {{/isAdmin}}

    <script src="{{#asset}}/js/site-ui.js{{/asset}}"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales/ko.global.min.js"></script>

    <script>
        {{#isAdmin}}
        function bindDecorationManager(refreshDecorations) {
            const modal = document.getElementById('decorationModal');
            const form = document.getElementById('decorationForm');
            const imageInput = document.getElementById('decorationImage');
            const preview = document.getElementById('decorationPreview');
            const list = document.getElementById('decorationList');
            let previewUrl;

            function showPreview(url) {
                if (previewUrl) URL.revokeObjectURL(previewUrl);
                previewUrl = url?.startsWith('blob:') ? url : undefined;
                preview.classList.toggle('hidden', !url);
                if (url) preview.src = url;
                else preview.removeAttribute('src');
            }

            document.getElementById('openDecorationManager').addEventListener('click', () => {
                scheduleModal(modal).show();
                loadDecorations();
            });

            function decorationHeaders() {
                const headers = {};
                return window.AboutAdminAuth?.applyAuthHeaders(headers) || headers;
            }
            function resetDecorationForm() {
                form.reset();
                document.getElementById('decorationId').value = '';
                showPreview();
            }
            async function loadDecorations() {
                try {
                    const response = await fetch('/api/calendar-decorations', {credentials:'same-origin'});
                    if (!response.ok) throw new Error('목록을 불러오지 못했습니다.');
                    const decorationItems = await response.json();
                    list.replaceChildren();
                    if (!decorationItems.length) {
                        const empty = document.createElement('p'); empty.className='text-sm text-[#b9cac4]'; empty.textContent='등록된 유닛·기념일이 없습니다.'; list.appendChild(empty); return;
                    }
                    decorationItems.forEach(item => {
                        const row = document.createElement('div'); row.className='flex items-center gap-3 rounded-lg border border-white/10 p-2';
                        if (item.imageUrl) { const img=document.createElement('img'); img.src=item.imageUrl; img.className='h-12 w-12 rounded object-contain'; img.alt=''; row.appendChild(img); }
                        const label=document.createElement('div'); label.className='min-w-0 flex-1';
                        const name=document.createElement('p'); name.className='truncate text-sm font-semibold text-white'; name.textContent=item.title;
                        const date=document.createElement('p'); date.className='text-xs text-[#b9cac4]'; date.textContent=item.eventDate + (item.unitName ? ' · '+item.unitName : '') + (item.repeatYearly ? ' · 매년 반복' : '');
                        label.append(name,date); row.appendChild(label);
                        const edit=document.createElement('button'); edit.type='button'; edit.className='btn-custom-secondary text-xs'; edit.textContent='수정'; edit.addEventListener('click',()=>editDecoration(item));
                        const remove=document.createElement('button'); remove.type='button'; remove.className='btn-custom-danger text-xs'; remove.textContent='삭제'; remove.addEventListener('click',()=>deleteDecoration(item.id));
                        row.append(edit,remove); list.appendChild(row);
                    });
                } catch(error) { list.textContent=error.message; }
            }
            function editDecoration(item) {
                resetDecorationForm();
                document.getElementById('decorationId').value=item.id;
                document.getElementById('decorationTitle').value=item.title;
                document.getElementById('decorationKind').value=item.kind;
                document.getElementById('decorationDate').value=item.eventDate;
                document.getElementById('decorationUnit').value=item.unitName||'';
                document.getElementById('decorationDescription').value=item.description||'';
                document.getElementById('decorationColor').value=item.color||'#00f5d4';
                document.getElementById('decorationRepeatYearly').checked=Boolean(item.repeatYearly);
                showPreview(item.imageUrl);
            }
            async function deleteDecoration(id) {
                if(!confirm('이 항목을 삭제할까요?')) return;
                try {
                    const response = await fetch('/api/calendar-decorations/' + id, {
                        method:'DELETE', headers:decorationHeaders(), credentials:'same-origin'
                    });
                    if (!response.ok) throw new Error('삭제하지 못했습니다.');
                    if (document.getElementById('decorationId').value === String(id)) resetDecorationForm();
                    refreshDecorations();
                    await loadDecorations();
                } catch (error) {
                    alert('삭제하지 못했습니다.');
                    console.error(error);
                }
            }
            document.getElementById('decorationReset').addEventListener('click',resetDecorationForm);
            imageInput.addEventListener('change', () => {
                const file = imageInput.files[0];
                if (file && file.size > 10 * 1024 * 1024) {
                    alert('이미지는 10MB 이하만 가능합니다.');
                    imageInput.value = '';
                }
                showPreview(imageInput.files[0] ? URL.createObjectURL(file) : undefined);
            });
            form.addEventListener('submit', async event => {
                event.preventDefault();
                const id = document.getElementById('decorationId').value;
                const data = new FormData(form);
                if (!imageInput.files[0]) data.delete('image');
                data.set('clearImage', String(document.getElementById('decorationClearImage').checked));
                const submit = form.querySelector('button[type="submit"]');
                submit.disabled = true;
                try {
                    const response = await fetch('/api/calendar-decorations' + (id ? '/' + id : ''), {
                        method:'POST', headers:decorationHeaders(), credentials:'same-origin', body:data
                    });
                    if (!response.ok) {
                        const problem = await response.json().catch(() => ({}));
                        alert(problem.message || '저장하지 못했습니다.');
                        return;
                    }
                    resetDecorationForm();
                    refreshDecorations();
                    await loadDecorations();
                } catch (error) {
                    alert('저장하지 못했습니다.');
                    console.error(error);
                } finally {
                    submit.disabled = false;
                }
            });
        }
        {{/isAdmin}}

        function scheduleModal(element) {
            return window.SiteUi.modal(element);
        }
        function hideScheduleModalThen(element, callback = () => {}) {
            window.SiteUi.hideThen(element, callback);
        }
        function showAddModal() {
            const modalElement = document.getElementById('addScheduleModal');
            scheduleModal(modalElement).show();
        }

        function formatDate(dateValue) {
            if (!dateValue) return '-';
            const value = String(dateValue).substring(0, 10);
            const parts = value.split('-');
            return parts.length === 3 ? `${parts[0]}.${parts[1]}.${parts[2]}` : value;
        }

        function calendarDate(date) {
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${date.getFullYear()}-${month}-${day}`;
        }

        function getRawEnd(event) {
            return event.extendedProps?.rawEnd || event.endStr || '';
        }

        function toCalendarEvent(item) {
            return {
                id:item.id,title:item.displayTitle||item.title,start:item.start,end:item.end,
                borderColor:item.color,textColor:item.color,backgroundColor:'transparent',
                extendedProps:{...item,rawTitle:item.title}
            };
        }

        function scheduleHeaders() {
            const headers={'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'};
            return window.AboutAdminAuth?.applyAuthHeaders(headers)||headers;
        }

        function bindCategoryPreview(prefix,titleId,artistId) {
            const category=document.getElementById(prefix+'ScheduleCategory');
            const title=document.getElementById(titleId), artists=document.getElementById(artistId);
            const preview=document.getElementById(prefix+'SchedulePreview');
            if(!category||!preview)return;
            function update() {
                const option=category.selectedOptions[0];
                let color=option?.dataset.color||'#00f5d4';
                if(category.value==='ANNIVERSARY')color=artists.selectedOptions[0]?.dataset.color||color;
                preview.style.setProperty('--schedule-color',color);
                const label=title.value.trim()||option?.textContent||'일정 미리보기';
                preview.textContent=(category.value==='ANNIVERSARY'&&!label.includes('🎂')?'🎂 ':'')+label;
            }
            category.addEventListener('change',update);title.addEventListener('input',update);artists.addEventListener('change',update);
            category.form.addEventListener('reset',()=>requestAnimationFrame(update));update();
        }

        function getCalendarEvents() {
            try {
                const injectedEvents = {{{schedulesJson}}};
                return Array.isArray(injectedEvents) ? injectedEvents : [];
            } catch (error) {
                console.error('스케줄 데이터 파싱 실패:', error);
                return [];
            }
        }

        async function fetchCalendarItems(url) {
            const response = await fetch(url, { credentials: 'same-origin' });
            if (!response.ok) throw new Error('추가 일정을 불러오지 못했습니다.');
            const items = await response.json();
            if (!Array.isArray(items)) throw new Error('일정 목록 형식이 올바르지 않습니다.');
            return items;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const calendarElement = document.getElementById('calendar');
            const selectedDateElement = document.getElementById('sideSelectedDate');
            const detailElement = document.getElementById('sideScheduleDetail');
            const todayButton = document.getElementById('showTodayButton');
            const viewModalElement = document.getElementById('viewScheduleModal');
            const editModalElement = document.getElementById('editScheduleModal');
            const addModalElement = document.getElementById('addScheduleModal');

            if (!calendarElement || typeof FullCalendar === 'undefined') {
                console.error('캘린더 요소 또는 FullCalendar를 찾을 수 없습니다.');
                return;
            }

            const selectedArtist = calendarElement.dataset.selectedArtist;
            const query = new URLSearchParams(window.location.search);
            const initialDate = calendarElement.dataset.initialDate || calendarDate(new Date());
            let initialEvents = getCalendarEvents();
            let pendingFocus = query.get('focus');

            bindCategoryPreview('add','titleInput','addArtistNames');
            bindCategoryPreview('edit','editTitleInput','editArtistNames');
            // 모달 닫기 버튼과 Escape 처리 (배경 클릭은 닫지 않음).
            document.querySelectorAll('.site-modal').forEach(element => {
                element.addEventListener('click', event => {
                    if (event.target.closest('[data-site-dismiss="modal"]')) {
                        event.preventDefault();
                        event.stopPropagation();
                        hideScheduleModalThen(element);
                    }
                }, true);
                element.addEventListener('keydown', event => {
                    if (event.key === 'Escape' && element.classList.contains('is-open')) {
                        event.preventDefault();
                        event.stopPropagation();
                        hideScheduleModalThen(element);
                    }
                }, true);
            });
            let selectedDay = new Date(initialDate + 'T00:00:00');

            function renderSelectedDate(dateObject) {
                selectedDay = dateObject;
                selectedDateElement.textContent = selectedDay.toLocaleDateString('ko-KR', {
                    year: 'numeric', month: 'long', day: 'numeric', weekday: 'short'
                });
                const selected = calendarDate(selectedDay);

                const dayEvents = calendar.getEvents().filter(event => {
                    if (!event.start) return false;
                    const start = calendarDate(event.start);
                    const end = getRawEnd(event).slice(0,10) || start;
                    return selected >= start && selected <= end;
                });

                detailElement.replaceChildren();

                if (dayEvents.length === 0) {
                    const empty = document.createElement('p');
                    empty.className = 'py-4 text-sm text-[#b9cac4]';
                    empty.textContent = '선택한 날짜에 등록된 일정이 없습니다.';
                    detailElement.appendChild(empty);
                    return;
                }

                dayEvents.forEach(event => {
                    const item = document.createElement('article');
                    item.className = 'schedule-detail-item';
                    item.style.setProperty('--schedule-color',event.extendedProps.color||'#00f5d4');

                    const title = document.createElement('h3');
                    title.className = 'text-sm font-bold leading-snug text-white';
                    title.textContent = event.title || '제목 없는 일정';

                    const dates = document.createElement('p');
                    dates.className = 'detail-meta';
                    const endText = getRawEnd(event) ? ` ~ ${formatDate(getRawEnd(event))}` : '';
                    dates.innerHTML = `<span class="material-symbols-outlined text-[14px] text-brand">calendar_today</span><span>${formatDate(event.startStr)}${endText}</span>`;

                    const actions = document.createElement('div');
                    actions.className = 'detail-actions';

                    const openButton = document.createElement('button');
                    openButton.type = 'button';
                    openButton.className = 'btn-custom-secondary !px-3 !py-1.5 text-xs';
                    openButton.textContent = '상세 보기';
                    openButton.addEventListener('click', () => openEventDetails(event));
                    actions.appendChild(openButton);

                    const category=document.createElement('span');
                    category.className='schedule-category-label';category.textContent=event.extendedProps.categoryLabel||'일정';
                    const imageUrl = event.extendedProps.imageUrl;
                    if (imageUrl) {
                        const image = document.createElement('img');
                        image.src = imageUrl; image.alt = event.title || '일정 이미지';
                        image.className = 'mb-2 max-h-24 rounded-lg object-contain';
                        item.appendChild(image);
                    }
                    const description = event.extendedProps.description;
                    if (description) {
                        const summary = document.createElement('p');
                        summary.className = 'mb-2 whitespace-pre-wrap text-xs text-[#b9cac4]';
                        summary.textContent = description;
                        item.appendChild(summary);
                    }
                    item.append(category, title, dates, actions);
                    detailElement.appendChild(item);
                });
            }

            function fillEditForm(event) {
                document.getElementById('editScheduleId').value = event.id;
                document.getElementById('editTitleInput').value = event.extendedProps.rawTitle || event.title || '';
                document.getElementById('editScheduleCategory').value = event.extendedProps.category || 'AUTO';
                document.getElementById('editStartInput').value = event.startStr.slice(0, 10);
                document.getElementById('editEndInput').value = getRawEnd(event).slice(0, 10);
                const artists = String(event.extendedProps.artistNames || '').split(',').map(name => name.trim());
                document.querySelectorAll('#editArtistNames option').forEach(option => option.selected = artists.includes(option.value));
                document.getElementById('editScheduleCategory').dispatchEvent(new Event('change'));
            }

            function openEventDetails(event) {
                viewModalElement.style.setProperty('--schedule-color',event.extendedProps.color||'#00f5d4');
                document.getElementById('modalScheduleCategory').textContent=event.extendedProps.categoryLabel||'일정';
                document.getElementById('modalScheduleTitle').textContent = event.title || '';
                const modalImage = document.getElementById('modalScheduleImage');
                const modalDescription = document.getElementById('modalScheduleDescription');
                if (modalImage) {
                    const imageUrl = event.extendedProps.imageUrl;
                    modalImage.classList.toggle('hidden', !imageUrl);
                    if (imageUrl) modalImage.src = imageUrl; else modalImage.removeAttribute('src');
                }
                if (modalDescription) {
                    const description = event.extendedProps.description || '';
                    modalDescription.textContent = description;
                    modalDescription.classList.toggle('hidden', !description);
                }
                document.getElementById('modalScheduleStart').textContent = formatDate(event.startStr);
                const endValue = formatDate(getRawEnd(event));
                document.getElementById('modalScheduleEnd').textContent = endValue === '-' ? '하루 일정' : endValue;

                const isCalendarDecoration = Boolean(event.extendedProps.kind);
                const deleteForm = document.getElementById('deleteForm');
                if (deleteForm) {
                    deleteForm.action = `/delete/${encodeURIComponent(event.id)}`;
                    deleteForm.classList.toggle('hidden', isCalendarDecoration);
                }

                const editButton = document.getElementById('editBtn');
                if (editButton) {
                    editButton.classList.toggle('hidden', isCalendarDecoration);
                    editButton.onclick = isCalendarDecoration ? null : () => {
                        fillEditForm(event);
                        hideScheduleModalThen(viewModalElement, () => scheduleModal(editModalElement).show());
                    };
                }

                scheduleModal(viewModalElement).show();
            }

            const decorationSource = {
                id: 'decorations',
                async events(fetchInfo) {
                    const start = calendarDate(fetchInfo.start);
                    const endDate = new Date(fetchInfo.end);
                    endDate.setDate(endDate.getDate() - 1);
                    const end = calendarDate(endDate);
                    const params = new URLSearchParams({ start, end });
                    const items = await fetchCalendarItems('/api/calendar-decorations/events?' + params);
                    return items.map(item => toCalendarEvent({
                        ...item,
                        id: item.id,
                        title: (item.kind === 'UNIT' ? '★ ' : '🎉 ') + item.title,
                        start: item.start,
                        categoryLabel: item.kind === 'UNIT' ? '유닛' : '기념일'
                    }));
                }
            };
            const eventSources = [
                {
                    id: 'schedules',
                    async events(fetchInfo) {
                        const start = calendarDate(fetchInfo.start);
                        const end = calendarDate(fetchInfo.end);
                        if (initialEvents && start >= calendarElement.dataset.initialStart
                                && end <= calendarElement.dataset.initialEnd) {
                            return initialEvents.filter(item => item.start < end && (item.end
                                ? item.end > start : item.start >= start)).map(toCalendarEvent);
                        }
                        const params = new URLSearchParams({ start, end });
                        if (selectedArtist) params.set('artist', selectedArtist);
                        return (await fetchCalendarItems('/api/schedule/events?' + params)).map(toCalendarEvent);
                    }
                },
                {
                    async events(fetchInfo) {
                        // FullCalendar의 종료일은 제외되지만 생일 API는 종료일까지 조회한다.
                        const end = new Date(fetchInfo.end);
                        end.setDate(end.getDate() - 1);
                        const params = new URLSearchParams({ start: calendarDate(fetchInfo.start), end: calendarDate(end) });
                        const birthdays = await fetchCalendarItems('/api/calendar-decorations/birthdays?' + params);
                        return birthdays.filter(item => !selectedArtist || item.artistName === selectedArtist)
                            .map(item => toCalendarEvent({ ...item, displayTitle: '🎂 ' + item.title }));
                    }
                }
            ];
            if (!selectedArtist) eventSources.push(decorationSource);

            const calendar = new FullCalendar.Calendar(calendarElement, {
                initialView: 'dayGridMonth',
                initialDate,
                locale: 'ko',
                height: 'auto',
                dayMaxEvents: window.matchMedia('(max-width: 600px)').matches ? 2 : 3,
                fixedWeekCount: false,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth'
                },
                buttonText: {
                    today: '오늘',
                    month: '월간'
                },
                eventSources,
                progressiveEventRendering: true,
                eventSourceFailure: error => console.error('추가 일정 조회 실패:', error),
                windowResize: function() {
                    const maximum=window.matchMedia('(max-width: 600px)').matches ? 2 : 3;
                    if(calendar.getOption('dayMaxEvents')!==maximum)calendar.setOption('dayMaxEvents',maximum);
                },
                eventDidMount: function(info) {
                    info.el.style.setProperty('--schedule-color',info.event.extendedProps.color||'#00f5d4');
                },
                eventContent: function(arg) {
                    const imageUrl = arg.event.extendedProps.imageUrl;
                    if (!imageUrl) return true;
                    const wrap = document.createElement('span');
                    wrap.className = 'inline-flex min-w-0 items-center gap-1';
                    const image = document.createElement('img');
                    image.src = imageUrl;
                    image.alt = '';
                    image.loading = 'lazy';
                    image.className = 'h-4 w-4 shrink-0 rounded object-contain';
                    const label = document.createElement('span');
                    label.className = 'fc-event-title min-w-0';
                    label.textContent = arg.event.title || '';
                    wrap.append(image, label);
                    return { domNodes: [wrap] };
                },
                dateClick: function (info) {
                    renderSelectedDate(info.date);
                },
                datesSet: function (info) {
                    if (selectedDay < info.view.currentStart || selectedDay >= info.view.currentEnd) {
                        renderSelectedDate(info.view.currentStart);
                    }
                },
                eventClick: function (info) {
                    info.jsEvent.preventDefault();
                    renderSelectedDate(info.event.start);
                    openEventDetails(info.event);
                },
                eventsSet: () => {
                    const focused = pendingFocus && calendar.getEventById(pendingFocus);
                    if (focused) {
                        pendingFocus = null;
                        renderSelectedDate(focused.start);
                        if (query.get('edit') === 'true' && document.getElementById('editBtn')) {
                            fillEditForm(focused);
                            scheduleModal(editModalElement).show();
                        } else {
                            openEventDetails(focused);
                        }
                    } else {
                        renderSelectedDate(selectedDay);
                    }
                }
            });

            calendar.render();
            renderSelectedDate(selectedDay);

            function refreshSchedules(date) {
                initialEvents = null;
                const current = calendar.getDate();
                if (current.getFullYear() === date.getFullYear() && current.getMonth() === date.getMonth()) {
                    calendar.getEventSourceById('schedules').refetch();
                } else {
                    calendar.gotoDate(date);
                }
                renderSelectedDate(date);
            }
            {{#isAdmin}}
            if (query.get('add') === 'true') showAddModal();
            bindDecorationManager(() => calendar.getEventSourceById('decorations')?.refetch());
            {{/isAdmin}}

            if (todayButton) {
                todayButton.addEventListener('click', function () {
                    calendar.today();
                    const today = new Date();
                    renderSelectedDate(today);
                });
            }

            const addForm = document.getElementById('addScheduleForm');
            if (addForm) {
                addForm.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const title = document.getElementById('titleInput').value.trim();
                    const start = document.getElementById('startInput').value;
                    const end = document.getElementById('endInput').value;

                    if (!title || !start) {
                        window.SiteFeedback.alert('제목과 시작 날짜를 입력해 주세요.');
                        return;
                    }
                    if (end && end < start) {
                        window.SiteFeedback.alert('종료 날짜는 시작 날짜보다 빠를 수 없습니다.');
                        return;
                    }
                    if (!await window.SiteFeedback.confirm('이 일정을 추가하시겠습니까?')) return;

                    const body = new URLSearchParams({ title, start, end, category:document.getElementById('addScheduleCategory').value });
                    document.querySelectorAll('#addArtistNames option:checked').forEach(option => body.append('artistNames', option.value));
                    const doneBusy = window.SiteFeedback.beginBusy();
                    try {
                        const response = await fetch('/schedule/add', {
                            method: 'POST',
                            headers: scheduleHeaders(),
                            credentials: 'same-origin',
                            body: body.toString()
                        });

                        if (!response.ok) {
                            window.SiteFeedback.alert('스케줄 추가에 실패했습니다.');
                            return;
                        }

                        hideScheduleModalThen(addModalElement);
                        addForm.reset();
                        refreshSchedules(new Date(`${start}T00:00:00`));
                    } catch (error) {
                        console.error('스케줄 추가 오류:', error);
                        window.SiteFeedback.alert('서버 통신 중 오류가 발생했습니다.');
                    } finally {
                        doneBusy();
                    }
                });
            }

            const editForm = document.getElementById('editScheduleForm');
            if (editForm) {
                editForm.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const id = document.getElementById('editScheduleId').value;
                    const title = document.getElementById('editTitleInput').value.trim();
                    const start = document.getElementById('editStartInput').value;
                    const end = document.getElementById('editEndInput').value;

                    if (!id || !title || !start) {
                        window.SiteFeedback.alert('제목과 시작 날짜를 입력해 주세요.');
                        return;
                    }
                    if (end && end < start) {
                        window.SiteFeedback.alert('종료 날짜는 시작 날짜보다 빠를 수 없습니다.');
                        return;
                    }
                    if (!await window.SiteFeedback.confirm('이 일정을 수정하시겠습니까?')) return;

                    const body = new URLSearchParams({ title, startDate: start, endDate: end, category:document.getElementById('editScheduleCategory').value });
                    document.querySelectorAll('#editArtistNames option:checked').forEach(option => body.append('artistNames', option.value));
                    const doneBusy = window.SiteFeedback.beginBusy();
                    try {
                        const response = await fetch(`/edit/${encodeURIComponent(id)}`, {
                            method: 'POST',
                            headers: scheduleHeaders(),
                            credentials: 'same-origin',
                            body: body.toString()
                        });

                        if (!response.ok) {
                            window.SiteFeedback.alert('스케줄 수정에 실패했습니다.');
                            return;
                        }

                        hideScheduleModalThen(editModalElement);
                        refreshSchedules(new Date(`${start}T00:00:00`));
                    } catch (error) {
                        console.error('스케줄 수정 오류:', error);
                        window.SiteFeedback.alert('서버 통신 중 오류가 발생했습니다.');
                    } finally {
                        doneBusy();
                    }
                });
            }
        });
    </script>
{{>layout/page-end}}
