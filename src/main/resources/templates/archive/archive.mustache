                </div>
                <p class="ar-preview-error" data-thumbnail-error role="alert" hidden></p>
                <div class="ar-preview" id="editPreview" hidden>
                    <div><p>현재 영상</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습</p><div class="ar-preview-card"></div></div>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">저장</button>
            </div>
        </form>
    </div>
</div>

<dialog class="ar-video-player ar-dialog-panel ar-detail-panel" id="archiveVideoPlayer" aria-labelledby="archiveVideoTitle">
    <div class="ar-detail-photo ar-video-pane">
        <video id="archiveVideoElement" controls playsinline preload="none"></video>
        <div class="ar-video-player-foot">
            <p id="archiveVideoStatus" role="status" aria-live="polite" hidden></p>
            <a id="archiveVideoOriginal" target="_blank" rel="noopener noreferrer">원본 영상 열기 ↗</a>
        </div>
    </div>
    <div class="ar-detail-side">
        <button type="button" class="ar-close ar-detail-close" id="archiveVideoClose" aria-label="영상 닫기" autofocus>&times;</button>
        <div class="ar-detail-body">
            <h2 class="ar-detail-desc" id="archiveVideoTitle">영상 재생</h2>
            <div class="ar-detail-meta" id="archiveVideoMeta" hidden>
                <p class="ar-detail-date" id="archiveVideoDate" hidden>
                    <span class="ar-detail-kicker">{{mediaDateLabel}}</span>
                    <time></time>
                </p>
                <div class="ar-source-badge" id="archiveVideoSource" hidden></div>
            </div>
            <section class="ar-detail-cast" aria-label="출연 멤버" hidden>
                <p class="ar-detail-kicker">출연 멤버</p>
                <div class="ar-detail-members" id="archiveVideoMembers"></div>
            </section>
        </div>
        <div class="ar-dialog-foot ar-detail-actions" data-admin-only>
            <button type="button" class="site-btn site-btn--primary" data-archive-edit id="archiveVideoEdit">수정하기</button>
            <button type="button" class="site-btn site-btn--danger ar-delete" data-archive-delete id="archiveVideoDelete">삭제하기</button>
        </div>
    </div>
</dialog>
{{/videoArchive}}

