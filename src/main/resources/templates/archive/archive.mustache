{{>layout/head-open}}
    <title>트리플에스 커뮤니티 - 아카이브</title>

    <link rel="stylesheet" href="{{#asset}}/css/site-tab-manager.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/archive-page.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/archive-cover-picker.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/unit-checks.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/member-portrait-picker.css{{/asset}}">
    {{^archiveFolderHome}}
    <link rel="stylesheet" href="{{#asset}}/css/objekt-filter.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/chemistry.css{{/asset}}">
    {{/archiveFolderHome}}
    {{#_csrf}}
    <meta name="_csrf" content="{{token}}">
    <meta name="_csrf_header" content="{{headerName}}">
    {{/_csrf}}
</head><body class="site-page bg-surface text-on-surface min-h-screen flex flex-col">
{{>layout/header}}

<main class="archive-page{{#archiveBrowse}} is-browse{{/archiveBrowse}}{{#archiveFolderHome}} is-folder-home{{/archiveFolderHome}}{{#archiveFolderIndex}} is-folder-index{{/archiveFolderIndex}}{{#archiveFolderView}} is-folder-view{{/archiveFolderView}}" data-archive-kind="{{#imageArchive}}image{{/imageArchive}}{{#videoArchive}}video{{/videoArchive}}" data-date-label="{{mediaDateLabel}}" data-default-artists="{{defaultUploadArtists}}">
    <section class="ar-hero{{#archiveBrowse}} ar-hero-browse{{/archiveBrowse}}">
        <div class="ar-panel ar-headline{{#archiveFolderView}} is-member-space{{/archiveFolderView}}{{#archiveFolderIndex}} is-member-space{{/archiveFolderIndex}}"{{#folderAccent}} style="--folder-color: {{folderAccent}}"{{/folderAccent}}>
            {{#hasArchiveBack}}
            <div class="ar-headline-toolbar">
                <a class="site-back-link site-back-link--chip ar-back-folders" href="{{archiveBackHref}}">← 목록으로</a>
            </div>
            {{/hasArchiveBack}}
            <div class="ar-headline-body{{^archiveFolderHome}} is-copy-only{{/archiveFolderHome}}">
                <div class="ar-headline-copy">
                    <div class="ar-kicker"><span class="material-symbols-outlined">{{#archiveFolderHome}}folder{{/archiveFolderHome}}{{^archiveFolderHome}}{{#imageArchive}}photo_library{{/imageArchive}}{{#videoArchive}}play_circle{{/videoArchive}}{{/archiveFolderHome}}</span> Archive</div>
                    {{>partials/archive-folder-title}}
                    {{#archiveFolderIndex}}
                    <h1 class="ar-folder-title">{{folderTitle}}</h1>
                    {{/archiveFolderIndex}}
                    {{^archiveFolderView}}{{^archiveFolderIndex}}
                    <h1>아카이브</h1>
                    {{#archiveBrowse}}<p>사진 전체</p>{{/archiveBrowse}}
                    {{/archiveFolderIndex}}{{/archiveFolderView}}
                </div>
                {{#archiveFolderHome}}
                <div class="ar-stats" id="archiveStats">
                    <article class="ar-stat"><div class="ar-stat-label"><span>등록된 사진</span><span class="material-symbols-outlined">image</span></div><strong>{{archiveTotal}}<em>장</em></strong></article>
                    <article class="ar-stat"><div class="ar-stat-label"><span>등록된 영상</span><span class="material-symbols-outlined">movie</span></div><strong>{{archiveVideoTotal}}<em>개</em></strong></article>
                    <article class="ar-stat"><div class="ar-stat-label"><span>폴더</span><span class="material-symbols-outlined">folder</span></div><strong>{{archiveFolderCount}}<em>개</em></strong></article>
                </div>
                {{/archiveFolderHome}}
            </div>
        </div>
    </section>

    {{#archiveFolderHome}}
    <div class="ar-folders-head tab-manager-toolbar">
        <button type="button" class="site-btn site-btn--primary site-btn--sm ar-home-upload" data-admin-only data-archive-add>{{#imageArchive}}사진 추가{{/imageArchive}}{{^imageArchive}}영상 추가{{/imageArchive}}</button>
    </div>
    {{>partials/archive-folder-grid}}
    {{/archiveFolderHome}}

    {{^archiveFolderHome}}
    {{>partials/archive-toolbar}}
    <div class="ar-folder-tabs">
        {{>partials/archive-type-tabs}}
        <div class="ar-source-bar">
            {{>partials/archive-source-tabs}}
            <div class="ar-source-tools tab-manager-toolbar">
                <button type="button" class="site-btn site-btn--ghost site-btn--sm ar-source-manage" data-admin-only id="archiveSourceManageBtn">출처 관리</button>
                <button type="button" class="site-btn site-btn--ghost site-btn--sm ar-source-bulk" data-admin-only id="archiveSourceBulkBtn" aria-pressed="false">출처 바꾸기</button>
                <button type="button" class="site-btn site-btn--primary site-btn--sm ar-home-upload" data-admin-only data-archive-add>{{#imageArchive}}사진 추가{{/imageArchive}}{{^imageArchive}}영상 추가{{/imageArchive}}</button>
                <label class="ar-density">
                    {{>partials/archive-page-size}}
                </label>
            </div>
        </div>
        <div id="archiveBulkMount" hidden></div>
    </div>

    {{>partials/archive-results}}
    {{/archiveFolderHome}}
</main>

{{#imageArchive}}{{^archiveFolderHome}}{{>partials/archive-photo-detail}}{{/archiveFolderHome}}{{/imageArchive}}
{{#videoArchive}}
<dialog class="ar-video-player ar-detail-panel" id="archiveVideoPlayer" aria-labelledby="archiveVideoTitle">
    <div class="ar-detail-photo" id="archiveVideoPane">
        <video id="archiveVideoElement" controls playsinline preload="none"></video>
        <p class="ar-video-status" id="archiveVideoStatus" role="status" aria-live="polite" hidden></p>
    </div>
    <div class="ar-detail-side">
        <button type="button" class="ar-close ar-detail-close" id="archiveVideoClose" aria-label="닫기">&times;</button>
        <div class="ar-detail-body">
            <h2 class="ar-detail-desc" id="archiveVideoTitle">영상 재생</h2>
            <div class="ar-detail-meta" id="archiveVideoMeta" hidden>
                <p class="ar-detail-date" id="archiveVideoDate" hidden>
                    <span class="ar-detail-kicker">{{mediaDateLabel}}</span>
                    <time></time>
                </p>
                <div class="ar-card-badges ar-detail-badges">
                    <div class="ar-source-badge" id="archiveVideoSource" hidden></div>
                    <div class="ar-unit-badge" id="archiveVideoUnit" hidden></div>
                </div>
            </div>
            <section class="ar-detail-cast" aria-label="출연 멤버" hidden>
                <p class="ar-detail-kicker">출연 멤버</p>
                <div class="ar-detail-members" id="archiveVideoMembers"></div>
            </section>
        </div>
        <div class="ar-dialog-foot ar-detail-actions" data-admin-only>
            <button type="button" class="site-btn site-btn--primary" data-archive-edit id="archiveVideoEdit">수정하기</button>
            <button type="button" class="site-btn site-btn--danger ar-delete" data-archive-delete id="archiveVideoDelete">삭제하기</button>
        </div>
    </div>
</dialog>
{{/videoArchive}}

{{#chemistryNamesJson}}
<script type="application/json" id="archiveChemistryNames">{{{chemistryNamesJson}}}</script>
{{/chemistryNamesJson}}
{{^archiveFolderHome}}
{{>triples/partials/chemistry-modals}}
{{/archiveFolderHome}}
<script src="{{#asset}}/js/member-portrait-picker.js{{/asset}}"></script>
<script src="{{#asset}}/js/date-range-filter.js{{/asset}}"></script>
<script src="{{#asset}}/js/archive-browse.js{{/asset}}"></script>
{{^archiveFolderHome}}
<script src="{{#asset}}/js/triples-members.js{{/asset}}"></script>
<script src="{{#asset}}/js/chemistry-sanitize.js{{/asset}}"></script>
<script src="{{#asset}}/js/chemistry.js{{/asset}}"></script>
{{#imageArchive}}
<script src="{{#asset}}/js/archive-detail.js{{/asset}}"></script>
{{/imageArchive}}
{{#videoArchive}}
<script src="{{#asset}}/js/archive-video-player.js{{/asset}}"></script>
{{/videoArchive}}
{{/archiveFolderHome}}
<div id="archiveAdminMount">
    <span data-admin-script="{{#asset}}/js/unit-checkbox-group.js{{/asset}}" hidden></span>
    <span data-admin-script="{{#asset}}/js/archive-manage.js{{/asset}}" hidden></span>
    <span data-admin-script="{{#asset}}/js/site-tab-manager.js{{/asset}}" hidden></span>
    <span data-admin-script="{{#asset}}/js/archive-source-admin.js{{/asset}}" hidden></span>
    <span data-admin-script="{{#asset}}/js/archive-bulk-source.js{{/asset}}" hidden></span>
</div>
<script src="{{#asset}}/js/archive-admin-loader.js{{/asset}}" defer></script>
{{>layout/page-end}}
