<dialog class="ar-video-player" id="archiveVideoPlayer" aria-labelledby="archiveVideoTitle">
    <div class="ar-detail-panel ar-video-detail">
        <div class="ar-detail-photo ar-video-pane">
            <video id="archiveVideoElement" controls playsinline preload="none"></video>
            <div class="ar-video-player-foot">
                <p id="archiveVideoStatus" role="status" aria-live="polite" hidden></p>
                <a id="archiveVideoOriginal" target="_blank" rel="noopener noreferrer">원본 영상 열기 ↗</a>
            </div>
        </div>
        <div class="ar-detail-side">
            <div class="ar-dialog-head">
                <h2 id="archiveVideoTitle">영상 재생</h2>
                <button type="button" class="ar-close" id="archiveVideoClose" aria-label="영상 닫기">&times;</button>
            </div>
            <div class="ar-detail-body">
                <p class="ar-detail-date" id="archiveVideoDate" hidden></p>
                <div class="ar-source-badge" id="archiveVideoSource" hidden></div>
                <section class="ar-detail-cast" aria-label="출연 멤버">
                    <div class="ar-detail-members" id="archiveVideoMembers"></div>
                </section>
            </div>
            <div class="ar-dialog-foot ar-detail-actions" data-admin-only>
                <button type="button" class="site-btn site-btn--primary" data-archive-edit id="archiveVideoEdit">수정하기</button>
                <button type="button" class="site-btn site-btn--danger ar-delete" data-archive-delete id="archiveVideoDelete">삭제하기</button>
            </div>
        </div>
    </div>
</dialog>
