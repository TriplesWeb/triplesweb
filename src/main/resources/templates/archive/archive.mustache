{{>layout/head-open}}
    <title>트리플에스 커뮤니티 - 아카이브</title>

    <link rel="stylesheet" href="{{#asset}}/css/archive-page.css{{/asset}}">
    <link rel="stylesheet" href="{{#asset}}/css/member-portrait-picker.css{{/asset}}">
    {{#_csrf}}
    <meta name="_csrf" content="{{token}}">
    <meta name="_csrf_header" content="{{headerName}}">
    {{/_csrf}}
</head><body class="site-page bg-surface text-on-surface min-h-screen flex flex-col">
<div class="ar-glow ar-glow-violet"></div>
<div class="ar-glow ar-glow-mint"></div>
{{>layout/header}}

<main class="archive-page{{#archiveBrowse}} is-browse{{/archiveBrowse}}{{#archiveFolderHome}} is-folder-home{{/archiveFolderHome}}{{#archiveFolderIndex}} is-folder-index{{/archiveFolderIndex}}{{#archiveFolderView}} is-folder-view{{/archiveFolderView}}" data-archive-kind="{{#imageArchive}}image{{/imageArchive}}{{#videoArchive}}video{{/videoArchive}}" data-date-label="{{mediaDateLabel}}">
    <section class="ar-hero{{#archiveBrowse}} ar-hero-browse{{/archiveBrowse}}">
        <div class="ar-panel ar-headline{{#archiveFolderView}} is-member-space{{/archiveFolderView}}{{#archiveFolderIndex}} is-member-space{{/archiveFolderIndex}}"{{#folderAccent}} style="--folder-color: {{folderAccent}}"{{/folderAccent}}>
            <button type="button" class="ar-stats-toggle" data-stats-toggle aria-expanded="true" aria-controls="archiveStats" aria-label="통계 접기">
                <span data-stats-icon aria-hidden="true">−</span>
            </button>
            {{#hasArchiveBack}}<a class="site-btn site-btn--reset ar-back-folders" href="{{archiveBackHref}}">←목록으로</a>{{/hasArchiveBack}}
            <div class="ar-headline-copy">
                <div class="ar-kicker"><span class="material-symbols-outlined">{{#archiveFolderHome}}folder{{/archiveFolderHome}}{{^archiveFolderHome}}{{#imageArchive}}photo_library{{/imageArchive}}{{#videoArchive}}play_circle{{/videoArchive}}{{/archiveFolderHome}}</span> Archive</div>
                <h1>아카이브</h1>
                {{#archiveBrowse}}<p>사진 전체</p>{{/archiveBrowse}}
                {{#archiveFolderView}}<p class="ar-folder-title{{#folderIsSolo}} is-solo{{/folderIsSolo}}" data-base-title="{{folderBaseTitle}}">{{#folderIsSolo}}<span class="ar-folder-num">{{folderTitleNumber}}</span> <span class="ar-folder-name">{{folderTitleName}}</span>{{/folderIsSolo}}{{^folderIsSolo}}{{folderTitle}}{{/folderIsSolo}}</p>{{/archiveFolderView}}
                {{#archiveFolderIndex}}<p class="ar-folder-title">{{folderTitle}}</p>{{/archiveFolderIndex}}
                {{#archiveFolderHome}}{{^archiveFolderIndex}}<p>폴더를 선택하세요</p>{{/archiveFolderIndex}}{{/archiveFolderHome}}
            </div>
            <button type="button" class="ar-submit ar-home-upload" data-admin-only onclick="showAddModal()">{{#imageArchive}}사진 추가{{/imageArchive}}{{^imageArchive}}영상 추가{{/imageArchive}}</button>
            <div class="ar-stats" id="archiveStats">
                {{#archiveFolderHome}}
                <article class="ar-stat"><div class="ar-stat-label"><span>등록된 사진</span><span class="material-symbols-outlined">image</span></div><strong>{{archiveTotal}}<em>장</em></strong></article>
                <article class="ar-stat"><div class="ar-stat-label"><span>등록된 영상</span><span class="material-symbols-outlined">movie</span></div><strong>{{archiveVideoTotal}}<em>개</em></strong></article>
                <article class="ar-stat"><div class="ar-stat-label"><span>폴더</span><span class="material-symbols-outlined">folder</span></div><strong>{{archiveFolderCount}}<em>개</em></strong></article>
                {{/archiveFolderHome}}
                {{^archiveFolderHome}}
                <article class="ar-stat"><div class="ar-stat-label"><span>{{#imageArchive}}등록된 사진{{/imageArchive}}{{#videoArchive}}등록된 영상{{/videoArchive}}</span><span class="material-symbols-outlined">{{#imageArchive}}image{{/imageArchive}}{{#videoArchive}}movie{{/videoArchive}}</span></div><strong>{{archiveTotal}}<em>{{#imageArchive}}장{{/imageArchive}}{{#videoArchive}}개{{/videoArchive}}</em></strong></article>
                <article class="ar-stat ar-stat-date"><div class="ar-stat-label"><span>날짜</span><span class="material-symbols-outlined">calendar_month</span></div><strong>{{#hasDateStat}}{{dateStatLabel}}{{/hasDateStat}}{{^hasDateStat}}전체{{/hasDateStat}}</strong></article>
                <article class="ar-stat"><div class="ar-stat-label"><span>페이지</span><span class="material-symbols-outlined">layers</span></div><strong>{{archivePageDisplay}}<em>/ {{archiveTotalPages}}</em></strong></article>
                {{>partials/archive-filter-stat}}
                {{/archiveFolderHome}}
            </div>
        </div>
    </section>

    {{#archiveFolderHome}}
    {{>partials/archive-folder-grid}}
    {{/archiveFolderHome}}

    {{^archiveFolderHome}}
    {{>partials/archive-toolbar}}
    <div class="ar-folder-tabs">
        {{>partials/archive-type-tabs}}
        {{>partials/archive-source-tabs}}
    </div>

    <section class="ar-grid{{#archiveBrowse}} ar-grid-browse{{/archiveBrowse}}" id="archiveGrid" aria-label="{{#imageArchive}}사진 목록{{/imageArchive}}{{#videoArchive}}영상 목록{{/videoArchive}}" data-number-offset="{{archiveOffset}}">
        {{#archiveCards}}
        {{#imageArchive}}
        {{>partials/archive-photo-card}}
        {{/imageArchive}}
        {{#videoArchive}}
        <article class="ar-panel ar-card" data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}" data-member-order="{{memberOrder}}" data-registered="{{registeredOn}}" data-url="{{file.url}}" data-source="{{sourceValue}}" data-source-label="{{sourceLabel}}">
            <a class="ar-video-thumb" href="{{file.url}}" data-archive-video data-title="{{title}}" data-poster="{{thumbnailUrl}}" aria-label="{{title}} 자세히 보기">
                {{#thumbnailUrl}}<img src="{{thumbnailUrl}}" alt="{{title}} 썸네일" loading="lazy" decoding="async">{{/thumbnailUrl}}
                {{^thumbnailUrl}}<span class="ar-video-placeholder">영상</span>{{/thumbnailUrl}}
                <span class="ar-video-play" aria-hidden="true">▶</span>
            </a>
            <div class="ar-body">
                <h3>{{title}}</h3>
                <div class="ar-meta" style="--member-count: {{memberCount}}">
                    {{>partials/archive-member-badges}}
                    {{#hasRegisteredOn}}<time class="ar-card-date" datetime="{{registeredOn}}">{{registeredOnDisplay}}</time>{{/hasRegisteredOn}}
                </div>
                <div class="ar-card-members" hidden>{{>partials/archive-album-members}}</div>
                <div class="ar-actions" data-admin-only>
                    <button type="button" class="site-btn site-btn--primary site-btn--sm" data-archive-edit data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}" data-url="{{file.url}}" data-thumbnail-url="{{thumbnailUrl}}" data-registered="{{registeredOn}}" data-source="{{sourceValue}}">수정하기</button>
                    <button type="button" class="site-btn site-btn--danger site-btn--sm ar-delete" data-archive-delete data-id="{{id}}" data-title="{{title}}">삭제하기</button>
                </div>
            </div>
        </article>
        {{/videoArchive}}
        {{/archiveCards}}
    </section>
    {{^hasArchives}}
    <p class="ar-panel ar-empty">{{#hasQuery}}검색 결과가 없습니다.{{/hasQuery}}{{^hasQuery}}등록된 {{#imageArchive}}사진{{/imageArchive}}{{#videoArchive}}영상{{/videoArchive}}이 없습니다.{{/hasQuery}}</p>
    {{/hasArchives}}

    {{>partials/archive-pager}}
    {{/archiveFolderHome}}
</main>

{{#imageArchive}}
<div class="ar-dialog" id="uploadModal" hidden>
    <button type="button" class="ar-dialog-backdrop" data-ar-close aria-label="닫기"></button>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="uploadModalLabel">
        <form id="archiveUploadForm" enctype="multipart/form-data" data-upload-url="/archive/upload/image" novalidate>
            <div class="ar-dialog-head">
                <h2 id="uploadModalLabel">사진 추가</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <label class="ar-field">제목
                    <input type="text" name="title" placeholder="사진 제목을 입력하세요" required>
                </label>
                {{>partials/archive-date-field}}
                <label class="ar-field">출처
                    <select name="source" required aria-label="출처">
                        <option value="">출처를 선택하세요</option>
                        {{#archiveSources}}
                        <option value="{{value}}">{{label}}</option>
                        {{/archiveSources}}
                    </select>
                </label>
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="archive-upload-picker" role="group" aria-label="출연 멤버">
                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></div>
                    <div class="ar-artist-editor" data-artist-tags>
                        <div class="ar-artist-chips" data-artist-chips aria-label="선택한 출연자"></div>
                    </div>
                </div>
                <div class="ar-field">사진 파일
                    <span class="ar-file">
                        <input type="file" id="archiveUploadFile" name="file" accept="image/*,.jpg,.jpeg,.jfif,.png,.webp,.gif,.bmp" required>
                        <label for="archiveUploadFile" class="ar-file-pick">파일 선택</label>
                        <span class="ar-file-name" data-file-name>선택된 파일 없음</span>
                    </span>
                    <span class="ar-field-hint">JPG · JPEG · JFIF · PNG · WebP · GIF · BMP</span>
                </div>
                <div class="ar-preview" id="uploadPreview" hidden>
                    <p class="ar-preview-info" data-preview-file></p>
                    <div><p>원본</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습 · 카드/슬라이드</p><div class="ar-preview-card"></div></div>
                    <p class="ar-preview-error" data-preview-error role="alert" hidden></p>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">추가하기</button>
            </div>
        </form>
    </div>
</div>
{{^archiveFolderHome}}
<div class="ar-dialog" id="editModal" hidden>
    <button type="button" class="ar-dialog-backdrop" data-ar-close aria-label="닫기"></button>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="editModalLabel">
        <form id="archiveEditForm" enctype="multipart/form-data" novalidate>
            <div class="ar-dialog-head">
                <h2 id="editModalLabel">사진 수정</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <label class="ar-field">제목
                    <input type="text" name="title" required>
                </label>
                {{>partials/archive-date-field}}
                {{>partials/archive-source-field}}
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="archive-edit-picker" role="group" aria-label="출연 멤버">
                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></div>
                    <div class="ar-artist-editor" data-artist-tags>
                        <div class="ar-artist-chips" data-artist-chips aria-label="선택한 출연자"></div>
                    </div>
                </div>
                <div class="ar-field">파일 교체 (선택)
                    <span class="ar-file">
                        <input type="file" id="archiveEditFile" name="file" accept="image/*,.jpg,.jpeg,.jfif,.png,.webp,.gif,.bmp">
                        <label for="archiveEditFile" class="ar-file-pick">파일 선택</label>
                        <span class="ar-file-name" data-file-name>선택된 파일 없음</span>
                    </span>
                    <span class="ar-field-hint">JFIF · WebP 포함 · 새 파일을 선택하지 않으면 현재 사진을 유지합니다.</span>
                </div>
                <div class="ar-preview" id="editPreview" hidden>
                    <p class="ar-preview-info" data-preview-file></p>
                    <div><p>현재 사진</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습 · 카드/슬라이드</p><div class="ar-preview-card"></div></div>
                    <p class="ar-preview-error" data-preview-error role="alert" hidden></p>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">저장</button>
            </div>
        </form>
    </div>
</div>
{{>partials/archive-photo-detail}}
{{/archiveFolderHome}}
{{/imageArchive}}

{{#videoArchive}}
<div class="ar-dialog" id="uploadModal" hidden>
    <button type="button" class="ar-dialog-backdrop" data-ar-close aria-label="닫기"></button>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="uploadModalLabel">
        <form id="archiveUploadForm" enctype="multipart/form-data" data-upload-url="/archive/upload/video" novalidate>
            <div class="ar-dialog-head">
                <h2 id="uploadModalLabel">영상 추가</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <label class="ar-field">제목
                    <input type="text" name="title" placeholder="영상 제목을 입력하세요" required>
                </label>
                {{>partials/archive-date-field}}
                <label class="ar-field">출처
                    <select name="source" required aria-label="출처">
                        <option value="">출처를 선택하세요</option>
                        {{#archiveSources}}
                        <option value="{{value}}">{{label}}</option>
                        {{/archiveSources}}
                    </select>
                </label>
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="archive-upload-picker" role="group" aria-label="출연 멤버">
                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></div>
                    <div class="ar-artist-editor" data-artist-tags>
                        <div class="ar-artist-chips" data-artist-chips aria-label="선택한 출연자"></div>
                    </div>
                </div>
                <div class="ar-field">영상 파일
                    <span class="ar-file">
                        <input type="file" id="archiveUploadFile" name="file" accept="video/*" required>
                        <label for="archiveUploadFile" class="ar-file-pick">파일 선택</label>
                        <span class="ar-file-name" data-file-name>선택된 파일 없음</span>
                    </span>
                </div>
                <div class="ar-field">썸네일 이미지 (선택)
                    <span class="ar-file">
                        <input type="file" id="archiveUploadThumb" name="thumbnail" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.jfif,.png,.webp,.gif,.bmp">
                        <label for="archiveUploadThumb" class="ar-file-pick">파일 선택</label>
                        <span class="ar-file-name" data-file-name>선택된 파일 없음</span>
                    </span>
                    <span class="ar-field-hint">영상 재생 전에 표시할 사진을 선택하세요. 세로·가로 이미지 모두 잘리지 않게 표시됩니다.</span>
                </div>
                <div class="ar-thumbnail-preview" data-thumbnail-preview hidden>
                    <img alt="영상 썸네일 미리보기">
                    <div><p data-thumbnail-info></p><button type="button" class="ar-text-btn" data-thumbnail-clear>썸네일 해제</button></div>
                </div>
                <p class="ar-preview-error" data-thumbnail-error role="alert" hidden></p>
                <div class="ar-preview" id="uploadPreview" hidden>
                    <div><p>원본</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습</p><div class="ar-preview-card"></div></div>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">추가하기</button>
            </div>
        </form>
    </div>
</div>

