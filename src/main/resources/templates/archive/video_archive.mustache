<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 - 영상 아카이브</title>

    <!-- 폰트 및 아이콘 연결 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS 스크립트 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/archive-page.css?v=3">
    <link rel="stylesheet" href="/css/member-portrait-picker.css?v=3">
    {{#_csrf}}
    <meta name="_csrf" content="{{token}}">
    <meta name="_csrf_header" content="{{headerName}}">
    {{/_csrf}}
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col">
<div class="ar-glow ar-glow-violet"></div>
<div class="ar-glow ar-glow-mint"></div>
{{>layout/header}}

<main class="archive-page">
    <section class="ar-hero">
        <div class="ar-panel ar-headline">
            <div>
                <div class="ar-kicker"><span class="material-symbols-outlined">play_circle</span> Video Archive</div>
                <h1>영상 아카이브</h1>
                <p>등록된 영상과 출연 표기를 확인하세요.</p>
            </div>
            <div class="ar-pills">
                <a class="ar-pill" href="/archive/image_archive">사진</a>
                <a class="ar-pill is-active" href="/archive/video_archive"><span class="ar-dot"></span>영상</a>
            </div>
        </div>
        <div class="ar-stats">
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>등록된 영상</span><span class="material-symbols-outlined">movie</span></div><strong>{{archiveTotal}}<em>개</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>이 페이지</span><span class="material-symbols-outlined">grid_view</span></div><strong>{{archivePageCount}}<em>개</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>페이지</span><span class="material-symbols-outlined">layers</span></div><strong>{{archivePageDisplay}}<em>/ {{archiveTotalPages}}</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>검색</span><span class="material-symbols-outlined">search</span></div><strong class="is-violet">{{#hasQuery}}{{query}}{{/hasQuery}}{{^hasQuery}}전체{{/hasQuery}}</strong></article>
        </div>
    </section>

    {{#hasArchives}}
    <section class="ar-block">
        <div class="ar-section-title">
            <h2>최근 영상</h2>
            <div>
                <button type="button" class="ar-icon-btn" id="archivePrev" aria-label="이전"><span class="material-symbols-outlined">arrow_back</span></button>
                <button type="button" class="ar-icon-btn" id="archiveNext" aria-label="다음"><span class="material-symbols-outlined">arrow_forward</span></button>
            </div>
        </div>
        <div class="ar-track" id="archiveTrack">
            {{#archiveHighlights}}
            <article class="ar-panel ar-highlight">
                <video controls preload="metadata"><source src="{{file.url}}" type="video/mp4"></video>
                <div>
                    <span class="ar-id">#{{id}}</span>
                    <h3>{{title}}</h3>
                    {{#artistNames}}<p class="ar-muted">{{artistNames}}</p>{{/artistNames}}
                    <div class="ar-actions" data-admin-only>
                        <button type="button" data-archive-edit data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}">수정</button>
                        <button type="button" class="ar-delete" data-archive-delete data-id="{{id}}">삭제</button>
                    </div>
                </div>
            </article>
            {{/archiveHighlights}}
        </div>
    </section>
    {{/hasArchives}}

    <section class="ar-panel ar-toolbar">
        <form class="ar-filters" id="archiveFilterForm" method="get" action="{{archivePath}}">
            <label class="ar-select">
                <select id="archiveSort" aria-label="정렬">
                    <option value="newest">정렬: 최신순</option>
                    <option value="oldest">정렬: 오래된 순</option>
                    <option value="title">정렬: 제목순</option>
                </select>
                <span class="material-symbols-outlined">sort</span>
            </label>
            <label class="ar-search-wrap">
                <span class="material-symbols-outlined">search</span>
                <input class="ar-search" type="search" name="q" value="{{query}}" placeholder="영상 제목 검색" aria-label="영상 제목 검색">
            </label>
            <button class="ar-submit" type="submit">검색</button>
            <button type="button" class="ar-submit" data-admin-only onclick="showAddModal()">영상 추가</button>
        </form>
        <div class="ar-member-row">
            <button type="button" class="ar-text-btn" id="archiveMemberToggle" aria-expanded="false" aria-controls="archiveMemberPanel">멤버 선택</button>
            <div id="archiveMemberPanel" hidden>
                <div class="member-portrait-picker" id="archive-member-picker" role="group" aria-label="멤버 선택">
                    {{>partials/member-portrait-picker}}
                </div>
            </div>
        </div>
        <div class="ar-toolbar-meta">
            <span>이 페이지 <strong id="archiveVisible">{{archivePageCount}}</strong>개</span>
            <a class="ar-text-btn" href="{{archivePath}}"><span class="material-symbols-outlined">refresh</span>필터 초기화</a>
        </div>
    </section>

    <section class="ar-grid" id="archiveGrid">
        {{#archives.content}}
        <article class="ar-panel ar-card" data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}">
            <video controls preload="metadata"><source src="{{file.url}}" type="video/mp4"></video>
            <div class="ar-body">
                <div class="ar-meta"><span class="ar-id">#{{id}}</span>{{#artistNames}}<span class="ar-badge">{{artistNames}}</span>{{/artistNames}}</div>
                <h3>{{title}}</h3>
                <div class="ar-actions" data-admin-only>
                    <button type="button" data-archive-edit data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}">수정</button>
                    <button type="button" class="ar-delete" data-archive-delete data-id="{{id}}">삭제</button>
                </div>
            </div>
        </article>
        {{/archives.content}}
    </section>
    <p id="archiveNone" class="ar-panel ar-empty" hidden>이 페이지에서 조건에 맞는 영상이 없습니다.</p>
    {{^hasArchives}}
    <p class="ar-panel ar-empty">{{#hasQuery}}검색 결과가 없습니다.{{/hasQuery}}{{^hasQuery}}등록된 영상이 없습니다.{{/hasQuery}}</p>
    {{/hasArchives}}

    {{#archiveTotalPages}}
    <nav class="ar-panel ar-pager" aria-label="영상 페이지">
        <span>총 {{archiveTotal}}개 중 {{archivePageCount}}개 표시 (페이지 {{archivePageDisplay}} / {{archiveTotalPages}})</span>
        <div class="ar-pager-controls">
            {{#hasArchivePrev}}<a href="{{archivePath}}?page={{archivePrevPage}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}">이전</a>{{/hasArchivePrev}}
            {{^hasArchivePrev}}<a class="is-disabled" aria-disabled="true">이전</a>{{/hasArchivePrev}}
            <div class="ar-pages">
                {{#archivePages}}<a class="{{#active}}is-current{{/active}}" href="{{archivePath}}?page={{num}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}">{{label}}</a>{{/archivePages}}
            </div>
            {{#hasArchiveNext}}<a href="{{archivePath}}?page={{archiveNextPage}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}">다음</a>{{/hasArchiveNext}}
            {{^hasArchiveNext}}<a class="is-disabled" aria-disabled="true">다음</a>{{/hasArchiveNext}}
        </div>
    </nav>
    {{/archiveTotalPages}}
</main>

<!-- 업로드 모달 창 (Tailwind 스타일 적용) -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-surface-container border border-outline-variant/50 rounded-3xl shadow-2xl text-on-surface overflow-hidden">
            <form id="uploadForm" enctype="multipart/form-data">
                <div class="modal-header border-b border-outline-variant/30 px-6 py-4">
                    <h5 class="font-headline-md font-bold text-on-surface" id="uploadModalLabel">영상 아카이브 업로드</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="닫기"></button>
                </div>
                <div class="modal-body px-6 py-6 space-y-4">
                    <!-- 제목 -->
                    <div class="space-y-1.5">
                        <label for="title" class="block font-label-md text-sm text-on-surface-variant font-medium">제목</label>
                        <input type="text" class="w-full px-4 py-2.5 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl text-sm text-black placeholder:text-outline/60 focus:outline-none focus:border-primary-container" id="title" name="title" placeholder="영상 제목을 입력하세요" required />
                    </div>

                    <div class="space-y-1.5">
                        <label class="block font-label-md text-sm text-on-surface-variant font-medium">출연 멤버</label>
                        <div id="archiveArtistPicker" class="grid max-h-36 grid-cols-3 gap-2 overflow-y-auto rounded-xl border border-outline-variant/40 p-3 sm:grid-cols-4">
                            {{#artistOptions}}<label class="flex cursor-pointer items-center gap-2 rounded-lg border border-outline-variant/30 px-2 py-2 text-xs hover:border-primary-container"><input type="checkbox" name="artistNames" value="{{name}}"><span>{{name}}</span></label>{{/artistOptions}}
                        </div>
                        <div class="flex items-center justify-between text-xs"><span><span id="archiveArtistCount">0</span>명 선택</span><button type="button" id="clearArchiveArtists" class="rounded-lg border border-outline-variant/40 px-3 py-1.5">전체 해제</button></div>
                    </div>
                    <!-- 파일 -->
                    <div class="space-y-1.5">
                        <label for="file" class="block font-label-md text-sm text-on-surface-variant font-medium">동영상 파일 선택</label>
                        <input type="file" class="w-full py-2 px-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl text-sm text-on-surface-variant file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary-container file:text-on-primary hover:file:opacity-90 cursor-pointer" id="file" name="file" accept="video/*" required onchange="previewFile()" />
                    </div>

                    <!-- 미리보기 -->
                    <div id="previewArea" class="mt-2"></div>
                </div>
                <div class="modal-footer border-t border-outline-variant/30 px-6 py-4 flex items-center justify-end gap-2">
                    <button type="button" class="px-5 py-2.5 rounded-xl bg-surface-container-high/40 hover:bg-surface-container-high border border-outline-variant/40 text-on-surface text-sm font-medium transition-all" data-bs-dismiss="modal">취소</button>
                    <button type="submit" class="px-6 py-2.5 rounded-full bg-primary-container text-on-primary font-headline-sm text-sm font-bold tracking-tight transition-all duration-200 btn-glow">추가하기</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="archiveEditForm" enctype="multipart/form-data">
    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-surface-container border border-outline-variant/50 rounded-3xl text-on-surface overflow-hidden">
                <div class="modal-header border-b border-outline-variant/30 px-6 py-4">
                    <h5 class="font-bold">영상 수정</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="닫기"></button>
                </div>
                <div class="modal-body px-6 py-6 space-y-4">
                    <label class="block text-sm text-on-surface-variant">제목
                        <input type="text" name="title" required class="mt-1 w-full px-4 py-2.5 rounded-xl border border-outline-variant/60 bg-surface-container-lowest/70 text-black">
                    </label>
                    <label class="block text-sm text-on-surface-variant">출연 표기
                        <input type="text" name="artistNames" class="mt-1 w-full px-4 py-2.5 rounded-xl border border-outline-variant/60 bg-surface-container-lowest/70 text-black" placeholder="비워 두면 표기를 지웁니다">
                    </label>
                    <label class="block text-sm text-on-surface-variant">파일 교체 (선택)
                        <input type="file" name="file" accept="video/*" class="mt-1 w-full text-sm">
                    </label>
                </div>
                <div class="modal-footer border-t border-outline-variant/30 px-6 py-4 flex justify-end gap-2">
                    <button type="button" class="px-5 py-2.5 rounded-xl border border-outline-variant/40" data-bs-dismiss="modal">취소</button>
                    <button type="submit" class="px-6 py-2.5 rounded-full bg-primary-container font-bold text-sm">저장</button>
                </div>
            </div>
        </div>
    </div>
</form>

{{>layout/footer}}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const picker = document.getElementById('archiveArtistPicker');
        const count = document.getElementById('archiveArtistCount');
        const refresh = () => { if (picker && count) count.textContent = String(picker.querySelectorAll('input:checked').length); };
        picker?.addEventListener('change', refresh);
        document.getElementById('clearArchiveArtists')?.addEventListener('click', () => { picker?.querySelectorAll('input').forEach(input => input.checked = false); refresh(); });
        refresh();
    });
    // 모달 열기
    function showAddModal() {
        const modal = new bootstrap.Modal(document.getElementById('uploadModal'));
        document.getElementById('uploadForm').reset();
        document.getElementById('previewArea').innerHTML = "";
        modal.show();
    }

    // 파일 미리보기
    function previewFile() {
        const previewArea = document.getElementById("previewArea");
        const fileInput = document.getElementById("file");
        const file = fileInput.files[0];
        previewArea.innerHTML = "";

        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                if (file.type.startsWith("video/")) {
                    const thumbBox = document.createElement("div");
                    thumbBox.className = "w-full rounded-xl overflow-hidden border border-outline-variant/30 bg-black max-h-48 flex items-center justify-center";

                    const video = document.createElement("video");
                    video.src = e.target.result;
                    video.controls = true;
                    video.className = "w-full max-h-48 object-contain";

                    thumbBox.appendChild(video);
                    previewArea.appendChild(thumbBox);
                } else {
                    alert("동영상 파일만 선택 가능합니다.");
                    fileInput.value = "";
                }
            };
            reader.readAsDataURL(file);
        }
    }

    // 업로드 요청
    document.getElementById("uploadForm")?.addEventListener("submit", function(e) {
        e.preventDefault();

        const formData = new FormData(this);

        const headers = window.AboutAdminAuth ? AboutAdminAuth.applyAuthHeaders() : {};
        fetch("/archive/upload/video", {
            method: "POST",
            body: formData,
            headers,
            credentials: "same-origin"
        })
                .then(res => {
                    if (res.ok) {
                        alert("업로드 완료!");
                        location.reload();
                    } else {
                        alert("업로드 실패!");
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert("업로드 중 오류 발생");
                });
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/archive-manage.js?v=1"></script>
<script src="/js/member-portrait-picker.js?v=2"></script>
<script src="/js/archive-browse.js?v=2"></script>
</body>
</html>