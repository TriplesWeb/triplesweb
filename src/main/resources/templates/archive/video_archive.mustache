<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 - 영상 아카이브</title>

    <!-- 폰트 및 아이콘 연결 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS 스크립트 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/archive-page.css?v=11">
    <link rel="stylesheet" href="/css/member-portrait-picker.css?v=14">
    {{#_csrf}}
    <meta name="_csrf" content="{{token}}">
    <meta name="_csrf_header" content="{{headerName}}">
    {{/_csrf}}
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col">
<div class="ar-glow ar-glow-violet"></div>
<div class="ar-glow ar-glow-mint"></div>
{{>layout/header}}

<main class="archive-page" data-archive-kind="video">
    <section class="ar-hero">
        <div class="ar-panel ar-headline">
            <div>
                <div class="ar-kicker"><span class="material-symbols-outlined">play_circle</span> Video Archive</div>
                <h1>영상 아카이브</h1>
                <p>등록된 영상과 출연 표기를 확인하세요.</p>
            </div>
            <div class="ar-pills">
                <a class="ar-pill" href="/archive/image_archive">사진</a>
                <a class="ar-pill is-active" href="/archive/video_archive"><span class="ar-dot"></span>영상</a>
            </div>
        </div>
        <div class="ar-stats">
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>등록된 영상</span><span class="material-symbols-outlined">movie</span></div><strong>{{archiveTotal}}<em>개</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>이 페이지</span><span class="material-symbols-outlined">grid_view</span></div><strong>{{archivePageCount}}<em>개</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>페이지</span><span class="material-symbols-outlined">layers</span></div><strong>{{archivePageDisplay}}<em>/ {{archiveTotalPages}}</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>검색</span><span class="material-symbols-outlined">search</span></div><strong class="is-violet">{{#hasQuery}}{{query}}{{/hasQuery}}{{^hasQuery}}전체{{/hasQuery}}</strong></article>
        </div>
    </section>

    {{#hasArchives}}
    <section class="ar-block">
        <div class="ar-section-title">
            <h2>최근 영상</h2>
            <div>
                <button type="button" class="ar-icon-btn" id="archivePrev" aria-label="이전"><span class="material-symbols-outlined">arrow_back</span></button>
                <button type="button" class="ar-icon-btn" id="archiveNext" aria-label="다음"><span class="material-symbols-outlined">arrow_forward</span></button>
            </div>
        </div>
        <div class="ar-track" id="archiveTrack">
            {{#archiveHighlights}}
            <article class="ar-panel ar-highlight" data-archive-ref="{{id}}">
                <a class="ar-video-thumb" href="{{file.url}}" data-archive-video data-title="{{title}}" data-poster="{{thumbnailUrl}}" aria-label="{{title}} 재생">
                    {{#thumbnailUrl}}<img src="{{thumbnailUrl}}" alt="{{title}} 썸네일" loading="lazy" decoding="async">{{/thumbnailUrl}}
                    {{^thumbnailUrl}}<span class="ar-video-placeholder">영상 아카이브</span>{{/thumbnailUrl}}
                    <span class="ar-video-play" aria-hidden="true">▶</span>
                </a>
                <div>
                    <span class="ar-id" data-archive-number>{{displayNumber}}</span>
                    <h3>{{title}}</h3>
                    <div class="ar-meta">{{>partials/archive-member-badges}}</div>
                </div>
            </article>
            {{/archiveHighlights}}
        </div>
    </section>
    {{/hasArchives}}

    <section class="ar-panel ar-toolbar">
        <form class="ar-filters" id="archiveFilterForm" method="get" action="{{archivePath}}">
            <label class="ar-select">
                <select id="archiveSort" aria-label="정렬">
                    <option value="newest">정렬: 최신순</option>
                    <option value="oldest">정렬: 오래된 순</option>
                    <option value="title">정렬: 제목순</option>
                </select>
                <span class="material-symbols-outlined">sort</span>
            </label>
            <label class="ar-search-wrap">
                <span class="material-symbols-outlined">search</span>
                <input class="ar-search" type="search" name="q" value="{{query}}" placeholder="영상 제목 검색" aria-label="영상 제목 검색">
            </label>
            {{>partials/date-range-filter}}
            <button class="ar-submit" type="submit">검색</button>
            <button type="button" class="ar-submit" data-admin-only onclick="showAddModal()">영상 추가</button>
        </form>
        <div class="ar-member-row">
            <button type="button" class="ar-member-toggle" id="archiveMemberToggle" aria-expanded="false" aria-controls="archiveMemberPanel">
                <span class="material-symbols-outlined" aria-hidden="true">group</span>
                <span>멤버 선택</span>
                <span class="ar-member-count" id="archiveMemberCount" hidden>0</span>
                <span class="material-symbols-outlined ar-member-chevron" aria-hidden="true">expand_more</span>
            </button>
            <div class="ar-member-panel" id="archiveMemberPanel" hidden>
                <div class="member-portrait-picker" id="archive-member-picker" role="group" aria-label="멤버 선택">
                    {{>partials/member-portrait-picker}}
                </div>
            </div>
        </div>
        <div class="ar-toolbar-meta">
            <span>이 페이지 <strong id="archiveVisible">{{archivePageCount}}</strong>개</span>
            <a class="ar-text-btn" href="{{archivePath}}"><span class="material-symbols-outlined">refresh</span>필터 초기화</a>
        </div>
    </section>

    <section class="ar-grid" id="archiveGrid" data-number-offset="{{archiveOffset}}">
        {{#archiveCards}}
        <article class="ar-panel ar-card" data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}">
            <a class="ar-video-thumb" href="{{file.url}}" data-archive-video data-title="{{title}}" data-poster="{{thumbnailUrl}}" aria-label="{{title}} 재생">
                {{#thumbnailUrl}}<img src="{{thumbnailUrl}}" alt="{{title}} 썸네일" loading="lazy" decoding="async">{{/thumbnailUrl}}
                {{^thumbnailUrl}}<span class="ar-video-placeholder">영상 아카이브</span>{{/thumbnailUrl}}
                <span class="ar-video-play" aria-hidden="true">▶</span>
            </a>
            <div class="ar-body">
                <div class="ar-meta"><span class="ar-id" data-archive-number>{{displayNumber}}</span>{{>partials/archive-member-badges}}</div>
                <h3>{{title}}</h3>
                <div class="ar-actions" data-admin-only>
                    <button type="button" data-archive-edit data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}" data-url="{{file.url}}" data-thumbnail-url="{{thumbnailUrl}}" data-registered="{{registeredOn}}">수정</button>
                    <button type="button" class="ar-delete" data-archive-delete data-id="{{id}}" data-title="{{title}}">삭제</button>
                </div>
            </div>
        </article>
        {{/archiveCards}}
    </section>
    <p id="archiveNone" class="ar-panel ar-empty" hidden>이 페이지에서 조건에 맞는 영상이 없습니다.</p>
    {{^hasArchives}}
    <p class="ar-panel ar-empty">{{#hasQuery}}검색 결과가 없습니다.{{/hasQuery}}{{^hasQuery}}등록된 영상이 없습니다.{{/hasQuery}}</p>
    {{/hasArchives}}

    {{#archiveTotalPages}}
    <nav class="ar-panel ar-pager" aria-label="영상 페이지">
        <span>총 {{archiveTotal}}개 중 {{archivePageCount}}개 표시 (페이지 {{archivePageDisplay}} / {{archiveTotalPages}})</span>
        <div class="ar-pager-controls">
            {{#hasArchivePrev}}<a href="{{archivePath}}?page={{archivePrevPage}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}{{dateQuery}}">이전</a>{{/hasArchivePrev}}
            {{^hasArchivePrev}}<a class="is-disabled" aria-disabled="true">이전</a>{{/hasArchivePrev}}
            <div class="ar-pages">
                {{#archivePages}}<a class="{{#active}}is-current{{/active}}" href="{{archivePath}}?page={{num}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}{{dateQuery}}">{{label}}</a>{{/archivePages}}
            </div>
            {{#hasArchiveNext}}<a href="{{archivePath}}?page={{archiveNextPage}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}{{dateQuery}}">다음</a>{{/hasArchiveNext}}
            {{^hasArchiveNext}}<a class="is-disabled" aria-disabled="true">다음</a>{{/hasArchiveNext}}
        </div>
    </nav>
    {{/archiveTotalPages}}
</main>

<div class="ar-dialog" id="uploadModal" hidden>
    <button type="button" class="ar-dialog-backdrop" data-ar-close aria-label="닫기"></button>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="uploadModalLabel">
        <form id="archiveUploadForm" enctype="multipart/form-data" data-upload-url="/archive/upload/video">
            <div class="ar-dialog-head">
                <h2 id="uploadModalLabel">영상 추가</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <label class="ar-field">제목
                    <input type="text" name="title" placeholder="영상 제목을 입력하세요" required>
                </label>
                <label class="ar-field">등록일
                    <input type="date" name="registeredOn" required>
                </label>
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="archive-upload-picker" role="group" aria-label="출연 멤버">
                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></div>
                    <input type="text" name="extraArtists" placeholder="목록에 없는 이름은 쉼표로 추가">
                </div>
                <label class="ar-field">영상 파일
                    <input type="file" name="file" accept="video/*" required>
                </label>
                <label class="ar-field">썸네일 이미지 (선택)
                    <input type="file" name="thumbnail" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.jfif,.png,.webp,.gif,.bmp">
                    <span class="ar-field-hint">영상 재생 전에 표시할 사진을 선택하세요. 세로·가로 이미지 모두 잘리지 않게 표시됩니다.</span>
                </label>
                <div class="ar-thumbnail-preview" data-thumbnail-preview hidden>
                    <img alt="영상 썸네일 미리보기">
                    <div><p data-thumbnail-info></p><button type="button" class="ar-text-btn" data-thumbnail-clear>썸네일 해제</button></div>
                </div>
                <p class="ar-preview-error" data-thumbnail-error role="alert" hidden></p>
                <div class="ar-preview" id="uploadPreview" hidden>
                    <div><p>원본</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습</p><div class="ar-preview-card"></div></div>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">추가하기</button>
            </div>
        </form>
    </div>
</div>

<div class="ar-dialog" id="editModal" hidden>
    <button type="button" class="ar-dialog-backdrop" data-ar-close aria-label="닫기"></button>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="editModalLabel">
        <form id="archiveEditForm" enctype="multipart/form-data">
            <div class="ar-dialog-head">
                <h2 id="editModalLabel">영상 수정</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <label class="ar-field">제목
                    <input type="text" name="title" required>
                </label>
                <label class="ar-field">등록일
                    <input type="date" name="registeredOn" required>
                </label>
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="archive-edit-picker" role="group" aria-label="출연 멤버">
                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></div>
                    <input type="text" name="extraArtists" placeholder="목록에 없는 이름은 쉼표로 추가">
                </div>
                <label class="ar-field">파일 교체 (선택)
                    <input type="file" name="file" accept="video/*">
                </label>
                <label class="ar-field">썸네일 이미지 교체 (선택)
                    <input type="file" name="thumbnail" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.jfif,.png,.webp,.gif,.bmp">
                    <span class="ar-field-hint">새 사진을 선택하지 않으면 현재 썸네일을 유지합니다.</span>
                </label>
                <input type="hidden" name="clearThumbnail" value="false">
                <div class="ar-thumbnail-preview" data-thumbnail-preview hidden>
                    <img alt="영상 썸네일 미리보기">
                    <div><p data-thumbnail-info></p><button type="button" class="ar-text-btn" data-thumbnail-clear>썸네일 해제</button></div>
                </div>
                <p class="ar-preview-error" data-thumbnail-error role="alert" hidden></p>
                <div class="ar-preview" id="editPreview" hidden>
                    <div><p>현재 영상</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습</p><div class="ar-preview-card"></div></div>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">저장</button>
            </div>
        </form>
    </div>
</div>

<dialog class="ar-video-player" id="archiveVideoPlayer" aria-labelledby="archiveVideoTitle">
    <div class="ar-video-player-inner">
        <div class="ar-dialog-head">
            <h2 id="archiveVideoTitle">영상 재생</h2>
            <button type="button" class="ar-close" id="archiveVideoClose" aria-label="영상 닫기">&times;</button>
        </div>
        <video id="archiveVideoElement" controls playsinline preload="none"></video>
        <div class="ar-video-player-foot">
            <p id="archiveVideoStatus" role="status" aria-live="polite" hidden></p>
            <a id="archiveVideoOriginal" target="_blank" rel="noopener noreferrer">원본 영상 열기 ↗</a>
        </div>
    </div>
</dialog>

{{>layout/footer}}

<script src="/js/member-portrait-picker.js?v=4"></script>
<script src="/js/archive-manage.js?v=5"></script>
<script src="/js/date-range-filter.js?v=1"></script>
<script src="/js/archive-browse.js?v=6"></script>
<script src="/js/archive-video-player.js?v=1"></script>
</body>
</html>
