<div id="archiveAdminForms">
{{#imageArchive}}
<div class="ar-dialog" id="uploadModal" hidden>
    <div class="ar-dialog-backdrop" aria-hidden="true"></div>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="uploadModalLabel">
        <form id="archiveUploadForm" enctype="multipart/form-data" data-upload-url="/archive/upload/image" novalidate>
            <div class="ar-dialog-head">
                <h2 id="uploadModalLabel">사진 추가</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                {{>partials/archive-date-field}}
                <label class="ar-field">출처
                    <select name="source" required aria-label="출처">
                        <option value="">출처를 선택하세요</option>
                        {{#archiveSources}}
                        <option value="{{value}}">{{label}}</option>
                        {{/archiveSources}}
                    </select>
                </label>
                {{>partials/archive-unit-field}}
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="archive-upload-picker" role="group" aria-label="출연 멤버">
                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-artist-editor" data-artist-tags>
                        <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><span class="ar-picker-meta-actions"><button type="button" class="ar-text-btn" data-picker-all>전체 선택</button><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></span></div>
                        <div class="ar-artist-chips" data-artist-chips aria-label="선택한 멤버"></div>
                    </div>
                </div>
                <label class="ar-field">설명 (선택)
                    <textarea name="description" rows="3" placeholder="사진 설명을 입력하세요"></textarea>
                </label>
                <div class="ar-field">사진 파일
                    <div class="file-drop" data-file-drop="multi" data-sortable data-primary data-selectable data-file-label="사진">
                        <input type="file" id="archiveUploadFile" name="file" accept="image/*,.jpg,.jpeg,.jfif,.png,.webp,.gif,.bmp" multiple required>
                    </div>
                    <span class="ar-field-hint">손잡이를 끌거나 ↑↓ 버튼으로 순서 변경 · 이름을 누르면 아래에서 미리보기·편집 · 파일 선택, 끌어다 놓기 또는 붙여넣기(Ctrl/⌘+V)</span>
                </div>
                <div class="ar-preview" id="uploadPreview" hidden>
                    <p class="ar-preview-info" data-preview-file></p>
                    <div class="ar-preview-tools" data-image-edit-tools hidden>
                        <span class="ar-preview-tools-label">사진 편집</span>
                        <button type="button" class="ar-edit-tool" data-image-edit="rotate-ccw" title="왼쪽으로 90°" aria-label="왼쪽으로 90° 회전">
                            <svg class="ar-edit-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.5 3a9 9 0 1 0 8.66 11.5h-2.13A7 7 0 1 1 12.5 5V8l4-3.5L12.5 1v2Z"/></svg>
                        </button>
                        <button type="button" class="ar-edit-tool" data-image-edit="rotate-cw" title="오른쪽으로 90°" aria-label="오른쪽으로 90° 회전">
                            <svg class="ar-edit-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.5 3a9 9 0 1 1-8.66 11.5h2.13A7 7 0 1 0 11.5 5V8L7.5 4.5 11.5 1v2Z"/></svg>
                        </button>
                        <button type="button" class="ar-edit-tool" data-image-edit="flip-h" title="좌우 뒤집기" aria-label="좌우 뒤집기">
                            <svg class="ar-edit-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5a.75.75 0 0 1 .75.75v17.5a.75.75 0 0 1-1.5 0V3.25A.75.75 0 0 1 12 2.5Zm-2.2 4.05L3.6 12l6.2 5.45V6.55Zm4.4 0v10.9L20.4 12l-6.2-5.45Z"/></svg>
                        </button>
                        <button type="button" class="ar-edit-tool" data-image-edit="flip-v" title="상하 뒤집기" aria-label="상하 뒤집기">
                            <svg class="ar-edit-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M2.5 12a.75.75 0 0 1 .75-.75h17.5a.75.75 0 0 1 0 1.5H3.25A.75.75 0 0 1 2.5 12Zm4.05-2.2L12 3.6l5.45 6.2H6.55Zm0 4.4h10.9L12 20.4l-5.45-6.2Z"/></svg>
                        </button>
                    </div>
                    <div><p>원본</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습</p><div class="ar-preview-card"></div></div>
                    <p class="ar-preview-error" data-preview-error role="alert" hidden></p>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">추가하기</button>
            </div>
        </form>
    </div>
</div>
