                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-artist-editor" data-artist-tags>
                        <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><span class="ar-picker-meta-actions"><button type="button" class="ar-text-btn" data-picker-all>전체 선택</button><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></span></div>
                        <div class="ar-artist-chips" data-artist-chips aria-label="선택한 멤버"></div>
                    </div>
                </div>
                <div class="ar-field">파일 교체 (선택)
                    <div class="file-drop" data-file-drop="single" data-dnd-only data-file-label="영상">
                        <span class="ar-file">
                            <input type="file" id="archiveEditFile" name="file" accept="video/*">
                            <label for="archiveEditFile" class="ar-file-pick">파일 선택</label>
                            <span class="ar-file-name" data-file-name>선택된 파일 없음</span>
                        </span>
                    </div>
                </div>
                <input type="hidden" name="clearThumbnail" value="false">
                {{>partials/archive-cover-picker}}
                <div class="ar-preview" id="editPreview" hidden>
                    <div><p>현재 영상</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습</p><div class="ar-preview-card"></div></div>
