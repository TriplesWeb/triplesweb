{{^archiveFolderHome}}
        <div class="ar-source-bulk-bar" id="archiveSourceBulkBar" hidden>
            <p class="ar-source-bulk-count" id="archiveSourceBulkCount" aria-live="polite">0개 선택</p>
            <div class="ar-source-bulk-controls">
                <label class="ar-source-bulk-field" for="archiveSourceBulkSelect">바꿀 출처</label>
                <select id="archiveSourceBulkSelect">
                    <option value="">출처를 선택하세요</option>
                    {{#archiveSources}}
                    <option value="{{value}}" data-color="{{color}}">{{label}}</option>
                    {{/archiveSources}}
                </select>
                <button type="button" class="site-btn site-btn--primary site-btn--sm" id="archiveSourceBulkApply" disabled>적용</button>
                <button type="button" class="site-btn site-btn--ghost site-btn--sm" id="archiveSourceBulkCancel">취소</button>
            </div>
        </div>
{{/archiveFolderHome}}
{{>partials/archive-source-admin-modal}}
</div>
