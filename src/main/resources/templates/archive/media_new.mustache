<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">
<div class="container py-4">
    <form method="post" action="/media_new" class="row g-3">
        <div class="col-md-3">
            <label class="form-label">탭</label>
            <select class="form-select bg-dark text-light" name="tab">
                <option value="mv" {{#tab_mv}}selected{{/tab_mv}}>MV</option>
                <option value="signal" {{#tab_signal}}selected{{/tab_signal}}>SIGNAL</option>
                <option value="behind" {{#tab_behind}}selected{{/tab_behind}}>비하인드</option>
                <option value="secret" {{#tab_secret}}selected{{/tab_secret}}>시크릿베이스</option>
                <option value="contents" {{#tab_contents}}selected{{/tab_contents}}>기타 컨텐츠</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">YouTube ID</label>
            <input class="form-control bg-dark text-light" name="youtubeId" readonly>
        </div>
        <div class="col-md-6">
            <label class="form-label">제목</label>
            <input class="form-control bg-dark text-light" name="title" readonly>
        </div>
        <div class="col-md-3">
            <label class="form-label">길이</label>
                <input class="form-control bg-dark text-light" name="duration" readonly>
        </div>
        <div class="col-12">
            <label class="form-label">유튜브 URL 또는 ID 입력</label>
            <div class="input-group">
                <input id="ytUrl" class="form-control bg-dark text-light" placeholder="https://youtu.be/… 또는 dQw4w9WgXcQ">
                <button class="btn btn-outline-light" type="button" id="btnFetch">영상 정보 보기</button>
            </div>
            <input type="hidden" name="views">
            <div id="ytThumb" class="mt-2"></div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-success">저장</button>
        </div>
    </form>
</div>
<script>
    document.getElementById('btnFetch').addEventListener('click', async () => {
      const url = document.getElementById('ytUrl').value.trim();
      if (!url) return;
      const res = await fetch('/api/media/resolve?urlOrId=' + encodeURIComponent(url));
      if (!res.ok) { alert('가져오기 실패'); return; }
      const d = await res.json();
      const set = (sel, val)=>{ const el=document.querySelector(sel); if(el && val!=null) el.value = val; };

      set('input[name="youtubeId"]', d.youtubeId);
      set('input[name="title"]', d.title);
      set('input[name="duration"]', d.duration);
      set('input[name="views"]', d.views);
      if (d.thumbnail) document.getElementById('ytThumb').innerHTML =
          `<img src="${d.thumbnail}" style="max-width:240px;border-radius:8px;border:1px solid #333">`;
    });
</script>
</body>
</html>