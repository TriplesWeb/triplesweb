<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <title>{{video.title}} - 트리플에스 미디어</title>
    <style>
        body{
        background:#000;
        color:#fff;
        overflow-x:hidden}
        .video-title{
        font-size:1.25rem;
        font-weight:700;
        margin-top:12px
        }
        .video-meta{
        color:#9aa0a6;
        font-size:.9rem}
        .desc{white-space:pre-wrap;color:#ddd}
    </style>
</head>
<body class="other-page">
{{>layout/header}}

<div class="container py-3">
    {{#video}}
        <div class="ratio ratio-16x9">
            <iframe
                    src="https://www.youtube.com/embed/{{youtubeId}}?rel=0"
                    title="{{title}}" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>

        <div class="video-title">{{title}}</div>
        <div class="video-meta">조회수 {{viewCountFmt}}{{#publishedAtFmt}} · {{publishedAtFmt}}{{/publishedAtFmt}}</div>

        {{#description}}<div class="desc mt-3">{{.}}</div>{{/description}}
    {{/video}}

    <hr class="border-secondary my-4"/>

    <h5 class="mb-3">다른 영상</h5>
    <div class="row g-3">
        {{#related}}
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a class="text-decoration-none" href="/media/{{../currentTab}}/{{youtubeId}}" style="color:#fff">
                    <div class="position-relative rounded overflow-hidden" style="padding-top:56.25%">
                        <img src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg"
                             class="position-absolute top-0 start-0 w-100 h-100" style="object-fit:cover" alt="{{title}}">
                    </div>
                    <div class="mt-2" style="font-size:.95rem">{{title}}</div>
                    <div class="video-meta">조회수 {{viewCountFmt}}</div>
                </a>
            </div>
        {{/related}}
        {{^related}}<div class="text-muted">관련 영상이 없습니다.</div>{{/related}}
    </div>

    <div class="mt-4">
        <a class="btn btn-outline-light btn-sm" href="/media?tab={{currentTab}}">목록으로</a>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
