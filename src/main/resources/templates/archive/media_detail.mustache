<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="stylesheet" href="/css/site-ui.css?v=1"/>
    <title>{{video.title}} - 트리플에스 미디어</title>
    <style>
        body{ background:#000; color:#fff; overflow-x:hidden }
        .video-title{ font-size:1.25rem; font-weight:700; margin-top:12px }
        .video-meta{ color:#9aa0a6; font-size:.9rem }
        .desc{ white-space:pre-wrap; color:#ddd; margin-top:1rem }
        .tag-link { display:inline-block; margin:.35rem .35rem 0 0; padding:.25rem .55rem; border:1px solid #38bdf8; border-radius:.4rem; color:#7dd3fc; text-decoration:none; font-size:.85rem }
        .related-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(12rem,1fr)); gap:1rem; }
        .related-card { color:#fff; text-decoration:none }
        .related-thumb { position:relative; border-radius:.65rem; overflow:hidden; padding-top:56.25%; background:#111 }
        .related-thumb img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover }
        .schedule-box { margin-top:1rem; padding:1rem; border:1px solid #444; border-radius:.75rem }
        .back-link { display:inline-flex; margin-top:1.25rem; padding:.4rem .75rem; border:1px solid #666; border-radius:.5rem; color:#eee; text-decoration:none; font-size:.85rem }
    </style>
</head>
<body class="other-page">
{{>layout/header}}

<div class="site-container">
    {{#video}}
        <div class="site-ratio-16x9">
            <iframe
                    src="https://www.youtube.com/embed/{{youtubeId}}?rel=0"
                    title="{{title}}" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>

        <div class="video-title">{{title}}</div>
        <div class="video-meta">조회수 {{viewCountFmt}}{{#publishedAtFmt}} · {{publishedAtFmt}}{{/publishedAtFmt}}</div>

        {{#description}}<div class="desc">{{.}}</div>{{/description}}
        {{#taggedArtists}}
        <a class="tag-link" href="/triples/artist/{{artistId}}">{{name}}</a>
        {{/taggedArtists}}
        {{#relatedSchedules}}
        <div class="schedule-box">
            <strong>{{title}}</strong>
            <div class="video-meta">{{start}} {{#end}}~ {{end}}{{/end}}</div>
            <a class="tag-link" href="/schedule?focus={{id}}">연결된 일정 보기</a>
        </div>
        {{/relatedSchedules}}
    {{/video}}

    <hr style="border-color:#333;margin:1.5rem 0"/>

    <h5 style="margin-bottom:1rem">다른 영상</h5>
    <div class="related-grid">
        {{#related}}
            <a class="related-card" href="/media/{{../currentTab}}/{{youtubeId}}">
                <div class="related-thumb">
                    <img src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg" alt="{{title}}">
                </div>
                <div style="margin-top:.5rem;font-size:.95rem">{{title}}</div>
                <div class="video-meta">조회수 {{viewCountFmt}}</div>
            </a>
        {{/related}}
        {{^related}}<div class="video-meta">관련 영상이 없습니다.</div>{{/related}}
    </div>

    <a class="back-link" href="/media?tab={{currentTab}}">목록으로</a>
</div>
{{>layout/footer}}
</body>
</html>
