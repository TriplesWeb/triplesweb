<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 - 사진 아카이브</title>

    <!-- 폰트 및 아이콘 연결 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS 스크립트 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/archive-page.css?v=4">
    <link rel="stylesheet" href="/css/member-portrait-picker.css?v=3">
    {{#_csrf}}
    <meta name="_csrf" content="{{token}}">
    <meta name="_csrf_header" content="{{headerName}}">
    {{/_csrf}}
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col">
<div class="ar-glow ar-glow-violet"></div>
<div class="ar-glow ar-glow-mint"></div>
{{>layout/header}}

<main class="archive-page" data-archive-kind="image">
    <section class="ar-hero">
        <div class="ar-panel ar-headline">
            <div>
                <div class="ar-kicker"><span class="material-symbols-outlined">photo_library</span> Photo Archive</div>
                <h1>사진 아카이브</h1>
                <p>등록된 사진과 출연 표기를 확인하세요.</p>
            </div>
            <div class="ar-pills">
                <a class="ar-pill is-active" href="/archive/image_archive"><span class="ar-dot"></span>사진</a>
                <a class="ar-pill" href="/archive/video_archive">영상</a>
            </div>
        </div>
        <div class="ar-stats">
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>등록된 사진</span><span class="material-symbols-outlined">image</span></div><strong>{{archiveTotal}}<em>장</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>이 페이지</span><span class="material-symbols-outlined">grid_view</span></div><strong>{{archivePageCount}}<em>장</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>페이지</span><span class="material-symbols-outlined">layers</span></div><strong>{{archivePageDisplay}}<em>/ {{archiveTotalPages}}</em></strong></article>
            <article class="ar-panel ar-stat"><div class="ar-stat-label"><span>검색</span><span class="material-symbols-outlined">search</span></div><strong class="is-violet">{{#hasQuery}}{{query}}{{/hasQuery}}{{^hasQuery}}전체{{/hasQuery}}</strong></article>
        </div>
    </section>

    {{#hasArchives}}
    <section class="ar-block">
        <div class="ar-section-title">
            <h2>최근 사진</h2>
            <div>
                <button type="button" class="ar-icon-btn" id="archivePrev" aria-label="이전"><span class="material-symbols-outlined">arrow_back</span></button>
                <button type="button" class="ar-icon-btn" id="archiveNext" aria-label="다음"><span class="material-symbols-outlined">arrow_forward</span></button>
            </div>
        </div>
        <div class="ar-track" id="archiveTrack">
            {{#archiveHighlights}}
            <article class="ar-panel ar-highlight">
                <img src="{{file.url}}" alt="{{title}}">
                <div>
                    <span class="ar-id">#{{id}}</span>
                    <h3>{{title}}</h3>
                    {{#artistNames}}<p class="ar-muted">{{artistNames}}</p>{{/artistNames}}
                </div>
            </article>
            {{/archiveHighlights}}
        </div>
    </section>
    {{/hasArchives}}

    <section class="ar-panel ar-toolbar">
        <form class="ar-filters" id="archiveFilterForm" method="get" action="{{archivePath}}">
            <label class="ar-select">
                <select id="archiveSort" aria-label="정렬">
                    <option value="newest">정렬: 최신순</option>
                    <option value="oldest">정렬: 오래된 순</option>
                    <option value="title">정렬: 제목순</option>
                </select>
                <span class="material-symbols-outlined">sort</span>
            </label>
            <label class="ar-search-wrap">
                <span class="material-symbols-outlined">search</span>
                <input class="ar-search" type="search" name="q" value="{{query}}" placeholder="사진 제목 검색" aria-label="사진 제목 검색">
            </label>
            <button class="ar-submit" type="submit">검색</button>
            <button type="button" class="ar-submit" data-admin-only onclick="showAddModal()">사진 추가</button>
        </form>
        <div class="ar-member-row">
            <button type="button" class="ar-text-btn" id="archiveMemberToggle" aria-expanded="false" aria-controls="archiveMemberPanel">멤버 선택</button>
            <div id="archiveMemberPanel" hidden>
                <div class="member-portrait-picker" id="archive-member-picker" role="group" aria-label="멤버 선택">
                    {{>partials/member-portrait-picker}}
                </div>
            </div>
        </div>
        <div class="ar-toolbar-meta">
            <span>이 페이지 <strong id="archiveVisible">{{archivePageCount}}</strong>장</span>
            <a class="ar-text-btn" href="{{archivePath}}"><span class="material-symbols-outlined">refresh</span>필터 초기화</a>
        </div>
    </section>

    <section class="ar-grid" id="archiveGrid">
        {{#archives.content}}
        <article class="ar-panel ar-card" data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}">
            <img src="{{file.url}}" alt="{{title}}">
            <div class="ar-body">
                <div class="ar-meta"><span class="ar-id">#{{id}}</span>{{#artistNames}}<span class="ar-badge">{{artistNames}}</span>{{/artistNames}}</div>
                <h3>{{title}}</h3>
                <div class="ar-actions" data-admin-only>
                    <button type="button" data-archive-edit data-id="{{id}}" data-title="{{title}}" data-artists="{{artistNames}}" data-url="{{file.url}}">수정</button>
                    <button type="button" class="ar-delete" data-archive-delete data-id="{{id}}" data-title="{{title}}">삭제</button>
                </div>
            </div>
        </article>
        {{/archives.content}}
    </section>
    <p id="archiveNone" class="ar-panel ar-empty" hidden>이 페이지에서 조건에 맞는 사진이 없습니다.</p>
    {{^hasArchives}}
    <p class="ar-panel ar-empty">{{#hasQuery}}검색 결과가 없습니다.{{/hasQuery}}{{^hasQuery}}등록된 사진이 없습니다.{{/hasQuery}}</p>
    {{/hasArchives}}

    {{#archiveTotalPages}}
    <nav class="ar-panel ar-pager" aria-label="사진 페이지">
        <span>총 {{archiveTotal}}장 중 {{archivePageCount}}장 표시 (페이지 {{archivePageDisplay}} / {{archiveTotalPages}})</span>
        <div class="ar-pager-controls">
            {{#hasArchivePrev}}<a href="{{archivePath}}?page={{archivePrevPage}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}">이전</a>{{/hasArchivePrev}}
            {{^hasArchivePrev}}<a class="is-disabled" aria-disabled="true">이전</a>{{/hasArchivePrev}}
            <div class="ar-pages">
                {{#archivePages}}<a class="{{#active}}is-current{{/active}}" href="{{archivePath}}?page={{num}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}">{{label}}</a>{{/archivePages}}
            </div>
            {{#hasArchiveNext}}<a href="{{archivePath}}?page={{archiveNextPage}}{{#hasQuery}}&amp;q={{query}}{{/hasQuery}}{{memberQuery}}">다음</a>{{/hasArchiveNext}}
            {{^hasArchiveNext}}<a class="is-disabled" aria-disabled="true">다음</a>{{/hasArchiveNext}}
        </div>
    </nav>
    {{/archiveTotalPages}}
</main>

<div class="ar-dialog" id="uploadModal" hidden>
    <button type="button" class="ar-dialog-backdrop" data-ar-close aria-label="닫기"></button>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="uploadModalLabel">
        <form id="archiveUploadForm" enctype="multipart/form-data" data-upload-url="/archive/upload">
            <input type="hidden" name="type" value="IMAGE">
            <div class="ar-dialog-head">
                <h2 id="uploadModalLabel">사진 추가</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <label class="ar-field">제목
                    <input type="text" name="title" placeholder="사진 제목을 입력하세요" required>
                </label>
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="archive-upload-picker" role="group" aria-label="출연 멤버">
                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></div>
                    <input type="text" name="extraArtists" placeholder="목록에 없는 이름은 쉼표로 추가">
                </div>
                <label class="ar-field">사진 파일
                    <input type="file" name="file" accept="image/*" required>
                </label>
                <div class="ar-preview" id="uploadPreview" hidden>
                    <div><p>원본</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습</p><div class="ar-preview-card"></div></div>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">추가하기</button>
            </div>
        </form>
    </div>
</div>

<div class="ar-dialog" id="editModal" hidden>
    <button type="button" class="ar-dialog-backdrop" data-ar-close aria-label="닫기"></button>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="editModalLabel">
        <form id="archiveEditForm" enctype="multipart/form-data">
            <div class="ar-dialog-head">
                <h2 id="editModalLabel">사진 수정</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <label class="ar-field">제목
                    <input type="text" name="title" required>
                </label>
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="archive-edit-picker" role="group" aria-label="출연 멤버">
                        {{>partials/member-portrait-picker}}
                    </div>
                    <div class="ar-picker-meta"><span><span data-picker-count>0</span>명 선택</span><button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button></div>
                    <input type="text" name="extraArtists" placeholder="목록에 없는 이름은 쉼표로 추가">
                </div>
                <label class="ar-field">파일 교체 (선택)
                    <input type="file" name="file" accept="image/*">
                </label>
                <div class="ar-preview" id="editPreview" hidden>
                    <div><p>현재 사진</p><div class="ar-preview-full"></div></div>
                    <div><p>목록에서 보이는 모습</p><div class="ar-preview-card"></div></div>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">저장</button>
            </div>
        </form>
    </div>
</div>

{{>layout/footer}}

<script src="/js/member-portrait-picker.js?v=2"></script>
<script src="/js/archive-manage.js?v=2"></script>
<script src="/js/archive-browse.js?v=3"></script>
</body>
</html>