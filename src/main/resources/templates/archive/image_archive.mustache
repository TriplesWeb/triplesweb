<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>트리플에스 커뮤니티 - 사진 아카이브</title>

    <!-- 폰트 및 아이콘 연결 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS 스크립트 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind.config.js"></script>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* 아카이브 그리드 레이아웃 스타일 */
        .media-section {
            display: grid;
            gap: 1.5rem;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        }
        @media (min-width: 576px) {
            .media-section { grid-template-columns: repeat(3, 1fr); }
        }
        @media (min-width: 992px) {
            .media-section { grid-template-columns: repeat(4, 1fr); }
        }
    </style>
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col">

{{>layout/header}}

<input type="hidden" name="type" value="{{type}}">

<main class="flex-1 flex items-start justify-center px-4 sm:px-6 py-8 z-10 relative">
    <div class="w-full max-w-6xl relative">
        <!-- 배경 글로우 효과 -->
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-b from-primary-container/20 via-transparent to-secondary-container/30 blur-xl opacity-75 pointer-events-none"></div>

        <!-- 메인 컨테이너 카드 -->
        <div class="relative bg-surface-container/95 border border-outline-variant/50 rounded-3xl p-6 sm:p-10 backdrop-blur-2xl shadow-2xl">

            <!-- 상단 헤더 타이틀 -->
            <div class="flex items-center justify-between mb-8 pb-4 border-b border-outline-variant/30">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary-container text-3xl" data-icon="photo_library">photo_library</span>
                    <h1 class="font-headline-lg text-headline-md font-bold text-on-surface tracking-tight">
                        사진 아카이브
                    </h1>
                </div>
            </div>

            <!-- 사진 갤러리 그리드 영역 -->
            <div class="media-section">
                {{#archives.content}}
                    <div class="group bg-surface-container-lowest/50 border border-outline-variant/30 rounded-2xl overflow-hidden shadow-lg hover:border-primary-container/60 hover:-translate-y-1 transition-all duration-200">
                        <div class="aspect-square w-full overflow-hidden bg-black/40 flex items-center justify-center relative">
                            <img src="{{file.url}}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="{{title}}">
                        </div>
                        <div class="p-3 bg-surface-container-high/40">
                            <p class="text-sm font-medium text-on-surface truncate" title="{{title}}">{{title}}</p>
                        </div>
                    </div>
                {{/archives.content}}

                {{^archives.content}}
                    <div class="col-span-full py-20 text-center">
                        <span class="material-symbols-outlined text-outline text-5xl mb-3" data-icon="image_not_supported">image_not_supported</span>
                        <p class="text-on-surface-variant font-medium text-base">등록된 사진이 없습니다.</p>
                    </div>
                {{/archives.content}}
            </div>

            {{#_csrf}}
                <input type="hidden" name="{{parameterName}}" value="{{token}}">
            {{/_csrf}}
        </div>
    </div>
</main>

<!-- 하단 고정 사진 추가 버튼 (관리자만 노출) -->
{{#isAdmin}}
    <div class="fixed bottom-6 right-6 z-50">
        <button type="button" onclick="showAddModal()" class="py-3 px-6 rounded-full bg-primary-container text-on-primary font-headline-sm text-sm text-black font-bold tracking-tight transition-all duration-200 btn-glow active:scale-[0.98] flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-[20px]" data-icon="add_a_photo">add_a_photo</span>
            <span>사진 추가</span>
        </button>
    </div>
{{/isAdmin}}

<!-- 업로드 모달 창 (Tailwind 스타일 적용) -->
{{#isAdmin}}
<form id="archiveUploadForm" enctype="multipart/form-data">
    <div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-surface-container border border-outline-variant/50 rounded-3xl shadow-2xl text-on-surface overflow-hidden">
                <div class="modal-header border-b border-outline-variant/30 px-6 py-4">
                    <h5 class="font-headline-md font-bold text-on-surface" id="uploadModalLabel">아카이브 업로드</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="닫기"></button>
                </div>
                <div class="modal-body px-6 py-6 space-y-4">
                    <!-- 제목 -->
                    <div class="space-y-1.5">
                        <label for="title" class="block font-label-md text-sm text-on-surface-variant font-medium">제목</label>
                        <input type="text" class="w-full px-4 py-2.5 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl text-sm placeholder:text-outline/60 focus:outline-none focus:border-primary-container text-black" id="title" name="title" placeholder="사진 제목을 입력하세요" required />
                    </div>

                    <!-- 파일 -->
                    <div class="space-y-1.5">
                        <label for="file" class="block font-label-md text-sm text-on-surface-variant font-medium">파일 선택</label>
                        <input type="file" class="w-full py-2 px-3 bg-surface-container-lowest/70 border border-outline-variant/60 rounded-xl text-sm text-on-surface-variant file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary-container file:text-on-primary hover:file:opacity-90 cursor-pointer" id="file" name="file" accept="image/*" required onchange="previewFile()" />
                    </div>

                    <!-- 미리보기 -->
                    <div id="previewArea" class="flex flex-wrap gap-2 mt-2"></div>
                </div>
                <div class="modal-footer border-t border-outline-variant/30 px-6 py-4 flex items-center justify-end gap-2">
                    <button type="button" class="px-5 py-2.5 rounded-xl bg-surface-container-high/40 hover:bg-surface-container-high border border-outline-variant/40 text-on-surface text-sm font-medium transition-all" data-bs-dismiss="modal">취소</button>
                    <button type="submit" class="px-6 py-2.5 rounded-full bg-primary-container text-on-primary font-headline-sm text-sm font-bold tracking-tight transition-all duration-200 btn-glow">추가하기</button>
                </div>
            </div>
        </div>
    </div>
</form>
{{/isAdmin}}

{{>layout/footer}}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('archiveUploadForm');
        if (!form) return;

        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(form);
            formData.set('type', '{{type}}' || 'IMAGE');

            const headers = {};
            const csrf = document.querySelector('meta[name="_csrf"]');
            const csrfHeader = document.querySelector('meta[name="_csrf_header"]');
            if (csrf && csrfHeader) headers[csrfHeader.content] = csrf.content;

            try {
                const res = await fetch('/archive/upload', { method: 'POST', body: formData, headers });
                if (res.ok) {
                    location.reload();
                } else if (res.status === 403) {
                    alert('관리자만 업로드할 수 있습니다.');
                } else {
                    const msg = await res.text();
                    alert('업로드 실패\n' + msg);
                }
            } catch (err) {
                console.error(err);
                alert('업로드 중 오류 발생');
            }
        });
    });

    // 모달 열기
    function showAddModal() {
        const modal = new bootstrap.Modal(document.getElementById('uploadModal'));
        document.getElementById('archiveUploadForm').reset();
        document.getElementById('previewArea').innerHTML = "";
        modal.show();
    }

    // 파일 미리보기
    function previewFile() {
        const previewArea = document.getElementById("previewArea");
        const fileInput = document.getElementById("file");
        const file = fileInput.files[0];
        previewArea.innerHTML = "";

        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                if (file.type.startsWith("image/")) {
                    const thumbBox = document.createElement("div");
                    thumbBox.className = "relative w-24 h-24 rounded-xl overflow-hidden border border-outline-variant/30 bg-black";

                    const img = document.createElement("img");
                    img.src = e.target.result;
                    img.className = "w-full h-full object-cover";

                    thumbBox.appendChild(img);
                    previewArea.appendChild(thumbBox);
                } else {
                    alert("이미지 파일만 선택 가능합니다.");
                    fileInput.value = "";
                }
            };
            reader.readAsDataURL(file);
        }
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>