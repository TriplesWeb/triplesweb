{{>layout/head-open}}

<link rel="stylesheet" href="{{#asset}}/css/bootstrap-compat.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/archive-page.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/objekt-filter.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/member-portrait-picker.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/unit-checks.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/media-page.css{{/asset}}">
{{#_csrf}}
<meta name="_csrf" content="{{token}}">
<meta name="_csrf_header" content="{{headerName}}">
{{/_csrf}}

<title>트리플에스 커뮤니티 - 공식 미디어</title>
</head><body class="site-page media-page">

{{>layout/header}}

<main class="media-shell">
    <header class="media-intro">
        <p class="media-crumb">미디어  /  공식 미디어</p>
        <div class="media-intro__row">
            <div class="media-intro__copy">
                <h1>공식 미디어</h1>
            </div>
            <div class="media-intro__actions">
                <a class="site-btn site-btn--secondary media-channel" href="https://www.youtube.com/@triplescosmos" target="_blank" rel="noopener noreferrer" aria-label="YouTube 채널">
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                        <rect x="1.6" y="5.2" width="20.8" height="13.6" rx="4.2" fill="#ff0033"></rect>
                        <path d="M10 9.15v5.7l5.4-2.85L10 9.15z" fill="#fff"></path>
                    </svg>
                </a>
                <button type="button" class="ar-submit" id="mediaAddOpen" data-admin-only>미디어 추가</button>
            </div>
        </div>
    </header>

    <section class="media-filters" aria-label="미디어 분류">
        <nav class="site-section-tabs media-tabs" aria-label="미디어 카테고리">
            <a class="site-section-tab{{#isAll}} is-active{{/isAll}}" href="/media?tab=all" {{#isAll}}aria-current="page"{{/isAll}}>전체</a>
            <a class="site-section-tab{{#isMV}} is-active{{/isMV}}" href="/media?tab=mv" {{#isMV}}aria-current="page"{{/isMV}}>MV</a>
            <a class="site-section-tab{{#isSIGNAL}} is-active{{/isSIGNAL}}" href="/media?tab=signal" {{#isSIGNAL}}aria-current="page"{{/isSIGNAL}}>SIGNAL</a>
            <a class="site-section-tab{{#isBehind}} is-active{{/isBehind}}" href="/media?tab=behind" {{#isBehind}}aria-current="page"{{/isBehind}}>비하인드</a>
            <a class="site-section-tab{{#isSecret}} is-active{{/isSecret}}" href="/media?tab=secret" {{#isSecret}}aria-current="page"{{/isSecret}}>시크릿베이스</a>
            <a class="site-section-tab{{#isShorts}} is-active{{/isShorts}}" href="/media?tab=shorts" {{#isShorts}}aria-current="page"{{/isShorts}}>Shorts &amp; 릴스</a>
            <a class="site-section-tab{{#isMusic}} is-active{{/isMusic}}" href="/media?tab=music" {{#isMusic}}aria-current="page"{{/isMusic}}>음방</a>
            <a class="site-section-tab{{#isFancam}} is-active{{/isFancam}}" href="/media?tab=fancam" {{#isFancam}}aria-current="page"{{/isFancam}}>직캠</a>
            <a class="site-section-tab{{#isContents}} is-active{{/isContents}}" href="/media?tab=contents" {{#isContents}}aria-current="page"{{/isContents}}>기타 콘텐츠</a>
            <a class="site-section-tab{{#isExternal}} is-active{{/isExternal}}" href="/media?tab=external" {{#isExternal}}aria-current="page"{{/isExternal}}>외부 콘텐츠</a>
        </nav>
        {{#isSIGNAL}}
        <nav class="site-section-tabs media-era-tabs" aria-label="SIGNAL 시기">
            {{#signalEras}}
            <a class="site-section-tab{{#active}} is-active{{/active}}" href="{{href}}" {{#active}}aria-current="page"{{/active}}>{{label}}</a>
            {{/signalEras}}
        </nav>
        {{/isSIGNAL}}

        <section class="ar-panel ar-toolbar media-toolbar">
            <form class="ar-filters" id="mediaFilterForm" method="get" action="/media">
                <input type="hidden" name="tab" value="{{currentTab}}">
                {{#legacyShortsFilter}}<input type="hidden" name="kind" value="shorts">{{/legacyShortsFilter}}
                {{#hasSignalEra}}<input type="hidden" name="era" value="{{signalEra}}">{{/hasSignalEra}}
                <div id="mediaMemberInputs">
                    {{#selectedMembers}}
                    <input type="hidden" name="members" value="{{.}}">
                    {{/selectedMembers}}
                </div>
                <div class="ar-filter-tools media-filter-tools">
                    <div class="media-filter-cluster">
                        <div class="objekt-filter ar-sort">
                            <span class="objekt-filter-label" id="mediaSortLabel">정렬</span>
                            <span class="ar-sort-control">
                                <select id="mediaSort" name="sort" aria-labelledby="mediaSortLabel">
                                    {{#sortOptions}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                    {{/sortOptions}}
                                </select>
                                <span class="material-symbols-outlined" aria-hidden="true">arrow_drop_down</span>
                            </span>
                        </div>
                        {{>partials/date-range-filter}}
                        <div class="objekt-filter ar-member-filter relative{{#hasSelectedMembers}} is-filtered{{/hasSelectedMembers}}">
                            <span class="objekt-filter-label">멤버</span>
                            <button type="button" class="ar-member-toggle objekt-filter-control" id="mediaMemberToggle" aria-expanded="false" aria-controls="mediaMemberPanel">
                                <span class="truncate" data-member-toggle-label>{{memberToggleLabel}}</span>
                                <span class="ar-member-count" id="mediaMemberCount"{{^hasSelectedMembers}} hidden{{/hasSelectedMembers}}>{{selectedMemberCount}}</span>
                                <span class="material-symbols-outlined objekt-filter-caret ar-member-chevron" aria-hidden="true">expand_more</span>
                            </button>
                        </div>
                    </div>
                    <div class="ar-search-row media-filter-search">
                        <label class="ar-search-wrap">
                            <span class="material-symbols-outlined objekt-search-glyph" aria-hidden="true">search</span>
                            <input class="ar-search" type="search" name="q" value="{{query}}" placeholder="영상 제목 검색" aria-label="영상 제목 검색" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="search">
                        </label>
                    </div>
                    <div class="media-filter-end">
                        <a class="site-btn site-btn--reset ar-reset" href="/media?tab={{currentTab}}{{#hasSignalEra}}&amp;era={{signalEra}}{{/hasSignalEra}}"{{^hasActiveFilters}} hidden{{/hasActiveFilters}}>초기화</a>
                    </div>
                </div>
            </form>
            <div class="ar-member-panel" id="mediaMemberPanel" hidden>
                <div class="member-portrait-picker" id="media-member-picker" role="group" aria-label="출연 멤버">
                    {{>partials/member-portrait-picker}}
                </div>
            </div>
        </section>
    </section>

    {{#isAll}}{{^shortsOnly}}
    <section class="media-feature" aria-label="재생목록">
        <div class="media-feature__head">
            <h2>재생목록</h2>
            <span>FEATURED</span>
        </div>
        <div class="media-feature__layout">
            <a class="media-feature__hero is-empty" href="/media">
                <img class="media-feature__still" alt="" data-yt-still="" data-no-placeholder="1">
                <span class="media-feature__shade"></span>
                <img class="media-feature__play" src="{{#asset}}/images/media/play-featured.svg{{/asset}}" width="60" height="60" alt="">
                <span class="media-feature__caption">
                    <strong id="mediaFeatureTitle"></strong>
                    <span class="media-feature__meta">
                        <em id="mediaFeatureMeta"></em>
                        <b id="mediaFeatureDuration"></b>
                    </span>
                </span>
            </a>
            <aside class="media-playlist" id="mediaPlaylist">
                <div class="media-playlist__head">
                    <h3 id="mediaPlaylistTitle">재생목록</h3>
                    <button type="button" class="media-playlist-add media-playlist-add--head" data-playlist-add
                            aria-pressed="false"
                            aria-label="재생목록 추가">재생목록 추가</button>
                    <span id="mediaPlaylistCount">00</span>
                </div>
                <div class="media-playlist__list" id="mediaPlaylistList"></div>
            </aside>
        </div>
        <div class="media-suggest is-collapsed" id="mediaSuggest" hidden>
            <h2 class="media-suggest__title">추천 동영상</h2>
            <div class="media-suggest__list" id="mediaSuggestList" aria-label="추천 동영상"></div>
        </div>
    </section>
    {{/shortsOnly}}{{/isAll}}

    {{^shortsOnly}}
    <section class="media-archive" aria-label="유튜브 및 미디어 아카이브">
        <div class="media-archive__head">
            <h2>유튜브 아카이브</h2>
            <div class="media-cols" data-media-cols-filter>
                <button type="button" class="media-cols-toggle" data-media-cols-toggle
                        aria-label="한 줄에 볼 영상 수" aria-expanded="false" aria-haspopup="listbox"
                        aria-controls="mediaArchiveColsMenu">
                    <span class="media-cols-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="media-sr" data-media-cols-label>3줄</span>
                </button>
                <div id="mediaArchiveColsMenu" class="media-cols-menu" data-media-cols-menu hidden role="listbox" aria-label="한 줄에 볼 영상 수">
                    <button type="button" class="media-cols-option" data-media-cols-option="3" role="option">3줄</button>
                    <button type="button" class="media-cols-option" data-media-cols-option="4" role="option">4줄</button>
                    <button type="button" class="media-cols-option" data-media-cols-option="5" role="option">5줄</button>
                </div>
            </div>
        </div>
        <div class="media-grid" data-cols="3">
            {{#videos}}
            <article class="media-card">
                <a class="media-card__link"
                   href="/media/{{tab}}/{{youtubeId}}"
                   data-site-toggle="modal"
                   data-site-target="#ytModal"
                   data-ytid="{{youtubeId}}">
                    <span class="media-card__thumb">
                        <img src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg" alt="" loading="lazy" decoding="async">
                        <img class="media-card__play" src="{{#asset}}/images/media/play-card.svg{{/asset}}" width="44" height="44" alt="" decoding="async">
                        {{#duration}}<span class="media-card__time">{{duration}}</span>{{/duration}}
                    </span>
                    <span class="media-card__body">
                        <small class="media-card__kind">{{tabLabel}}</small>
                        <span class="media-card__title">{{title}}</span>
                    </span>
                </a>
                {{#hasMembers}}
                <div class="media-card__members">
                    {{#memberBadges}}
                    <span class="archive-member-chip{{#fullLineup}} media-full-lineup{{/fullLineup}}{{#hasSymbol}} archive-symbol-chip{{/hasSymbol}}" style="--member-color: {{color}};" title="{{#fullLineup}}{{title}}{{/fullLineup}}{{^fullLineup}}{{name}}{{/fullLineup}}" aria-label="{{name}}">
                        {{#hasImage}}<img src="{{image}}" alt="" referrerpolicy="no-referrer" loading="lazy" decoding="async">{{/hasImage}}
                        <span class="archive-chip-name">{{name}}</span>
                    </span>
                    {{/memberBadges}}
                </div>
                {{/hasMembers}}
                <div class="media-card__foot">
                    <span class="media-card__meta">
                        <span class="media-card__views">조회수 {{viewCountFmt}}</span>
                        {{#publishedLabel}}<span class="media-card__date">{{publishedLabel}}</span>{{/publishedLabel}}
                    </span>
                    <button type="button" class="site-btn site-btn--primary site-btn--sm media-card__edit" data-media-edit data-admin-only
                            data-ytid="{{youtubeId}}"
                            data-tab="{{tab}}"
                            data-kind="{{tabLabel}}"
                            data-title="{{title}}"
                            data-duration="{{duration}}"
                            data-views="{{viewCountFmt}}"
                            data-published="{{publishedLabel}}"
                            aria-label="영상 정보 수정">수정</button>
                </div>
            </article>
            {{/videos}}
        </div>
        {{^videos}}
        <div class="media-empty">
            <p>등록된 영상이 없습니다.</p>
        </div>
        {{/videos}}
        {{>partials/media-pager}}
    </section>
    {{/shortsOnly}}

    {{#hasShorts}}
    <section class="media-shorts{{#shortsPreview}} is-preview{{/shortsPreview}}" aria-label="Shorts와 릴스">
        <div class="media-shorts__head">
            <h2>Shorts &amp; 릴스</h2>
        </div>
        <div class="media-shorts__grid">
            {{#shorts}}
            <article class="media-short">
                <a class="media-short__open"
                   href="/media/{{tab}}/{{youtubeId}}"
                   data-site-toggle="modal"
                   data-site-target="#ytModal"
                   data-ytid="{{youtubeId}}"
                   data-tab="{{tab}}"
                   data-kind=""
                   data-title="{{title}}"
                   data-duration="{{duration}}"
                   data-views="{{viewCountFmt}}"
                   data-published="{{publishedLabel}}">
                    <img class="media-short__still" src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg" alt="" loading="lazy" decoding="async">
                    <img class="media-short__play" src="{{#asset}}/images/media/play-short.svg{{/asset}}" width="46" height="46" alt="" decoding="async">
                    <span class="media-short__caption">
                        <strong>{{title}}</strong>
                        {{#duration}}<span class="media-short__meta"><span aria-label="재생시간 {{duration}}">{{duration}}</span>{{#publishedLabel}}<time datetime="{{publishedOn}}" aria-label="유튜브 등록일 {{publishedLabel}}">{{publishedLabel}}</time>{{/publishedLabel}}</span>{{/duration}}
                        {{^duration}}{{#publishedLabel}}<span class="media-short__meta"><time datetime="{{publishedOn}}" aria-label="유튜브 등록일 {{publishedLabel}}">{{publishedLabel}}</time></span>{{/publishedLabel}}{{/duration}}
                    </span>
                </a>
            </article>
            {{/shorts}}
        </div>
        {{#shortsPreview}}
        <div class="media-shorts__more">
            <a href="{{shortsTabHref}}">더보기</a>
        </div>
        {{/shortsPreview}}
        {{#shortsOnly}}
        {{>partials/media-pager}}
        {{/shortsOnly}}
    </section>
    {{/hasShorts}}
</main>

<div class="site-modal" id="mediaPickModal" tabindex="-1" aria-hidden="true">
    <div class="site-modal-dialog media-pick-dialog">
        <div class="site-modal-panel">
            <div class="site-modal-header">
                <h5 class="site-modal-title">재생목록에 담기</h5>
                <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="닫기">×</button>
            </div>
            <div class="site-modal-body">
                <div class="ar-toolbar media-toolbar media-pick-toolbar">
                    <form class="ar-filter-tools media-filter-tools media-pick-mini" id="mediaPickMini">
                        <div class="objekt-filter ar-sort">
                            <span class="objekt-filter-label">정렬</span>
                            <span class="ar-sort-control">
                                <select id="mediaPickSort" aria-label="정렬">
                                    {{#sortOptions}}
                                    <option value="{{value}}">{{label}}</option>
                                    {{/sortOptions}}
                                </select>
                                <span class="material-symbols-outlined" aria-hidden="true">arrow_drop_down</span>
                            </span>
                        </div>
                        {{#pickDateFilter}}{{>partials/date-range-filter}}{{/pickDateFilter}}
                        <div class="objekt-filter ar-member-filter relative">
                            <span class="objekt-filter-label">멤버</span>
                            <button type="button" class="ar-member-toggle objekt-filter-control" id="mediaPickMemberToggle" aria-expanded="false" aria-controls="mediaPickMemberModal" aria-haspopup="dialog">
                                <span class="truncate" data-member-toggle-label>멤버 선택</span>
                                <span class="ar-member-count" id="mediaPickMemberCount" hidden>0</span>
                                <span class="material-symbols-outlined objekt-filter-caret ar-member-chevron" aria-hidden="true">expand_more</span>
                            </button>
                        </div>
                        <label class="ar-search-wrap">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                            <input class="ar-search" id="mediaPickSearch" type="search" placeholder="영상 제목 검색" aria-label="재생목록 영상 검색" autocomplete="off" autocapitalize="off" spellcheck="false">
                        </label>
                        <div class="objekt-filter ar-sort">
                            <span class="objekt-filter-label">분류</span>
                            <span class="ar-sort-control">
                                <select id="mediaPickTab" aria-label="분류">
                                    <option value="">전체</option>
                                    <option value="mv">MV</option>
                                    <option value="signal">SIGNAL</option>
                                    <option value="behind">비하인드</option>
                                    <option value="secret">시크릿베이스</option>
                                    <option value="shorts">Shorts &amp; 릴스</option>
                                    <option value="music">음방</option>
                                    <option value="fancam">직캠</option>
                                    <option value="contents">기타 콘텐츠</option>
                                    <option value="external">외부 콘텐츠</option>
                                </select>
                                <span class="material-symbols-outlined" aria-hidden="true">arrow_drop_down</span>
                            </span>
                        </div>
                    </form>
                </div>
                <div class="media-pick-grid" id="mediaPickGrid"></div>
                <div id="mediaPickPager"></div>
            </div>
            <div class="site-modal-footer">
                <button type="button" class="site-btn site-btn--primary" id="mediaPickConfirm">선택 완료</button>
            </div>
        </div>
    </div>
</div>

<div class="site-modal" id="mediaPickMemberModal" tabindex="-1" aria-hidden="true">
    <div class="site-modal-dialog media-pick-member-dialog">
        <div class="site-modal-panel">
            <div class="site-modal-header">
                <h5 class="site-modal-title">멤버 선택</h5>
                <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="닫기">×</button>
            </div>
            <div class="site-modal-body">
                <div class="member-portrait-picker" id="media-pick-picker" role="group" aria-label="재생목록 멤버 선택">
                    {{#editMemberOptions}}
                    <button type="button" class="mpp-item" data-value="{{value}}" data-name="{{label}}" data-frame="{{frame}}" style="--artist-color:{{color}}" aria-pressed="false" title="{{label}}">
                        <span class="artist-tab-avatar">
                            <img class="artist-tab-photo" src="{{image}}" referrerpolicy="no-referrer" alt="" loading="lazy">
                            <img class="artist-tab-frame" src="" alt="" aria-hidden="true">
                            <span class="artist-tab-shine" aria-hidden="true"></span>
                        </span>
                        <span class="artist-tab-label">{{label}}</span>
                    </button>
                    {{/editMemberOptions}}
                </div>
            </div>
            <div class="site-modal-footer">
                <button type="button" class="site-btn site-btn--primary" data-site-dismiss="modal">확인</button>
            </div>
        </div>
    </div>
</div>

<div class="site-modal" id="ytModal" tabindex="-1" aria-labelledby="ytModalTitle" aria-hidden="true">
    <div class="site-modal-dialog media-player-dialog">
        <div class="site-modal-panel">
            <div class="site-modal-header">
                <h5 class="site-modal-title" id="ytModalTitle">영상 재생</h5>
                <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="닫기">×</button>
            </div>
            <div class="site-modal-body media-player-body">
                <div class="media-player-stage">
                    <div class="media-player-frame">
                        <iframe id="ytPlayer" src="" title="YouTube video player"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen></iframe>
                    </div>
                </div>
                <aside class="media-player-detail" aria-label="영상 상세">
                    <p class="media-player-kicker" id="ytModalKind"></p>
                    <h6 id="ytModalHeading"></h6>
                    <p class="media-player-meta" id="ytModalMeta"></p>
                    <section class="ar-detail-cast" id="ytModalCast" hidden>
                        <p class="ar-detail-kicker">출연 멤버</p>
                        <div class="ar-unit-badge" id="ytModalUnit" hidden></div>
                        <div class="ar-detail-members" id="ytModalMembers"></div>
                    </section>
                    <div class="media-player-copy" id="ytModalDesc"></div>
                    <a class="media-player-source" id="ytModalSource" target="_blank" rel="noopener noreferrer" hidden>YouTube에서 보기</a>
                </aside>
            </div>
            <div class="site-modal-footer ar-detail-actions media-player-actions" data-admin-only>
                <button type="button" class="media-player-edit" id="ytModalEdit">수정</button>
                <form id="ytModalDelete" method="post" action="/media_delete" data-admin-fetch data-confirm="삭제 하시겠습니까?" data-confirm-accept="삭제" data-confirm-compact>
                    <input type="hidden" name="tab" id="ytDeleteTab" value="">
                    <input type="hidden" name="youtubeId" id="ytDeleteId" value="">
                    <button type="submit">삭제</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="ar-dialog" id="mediaAddModal" hidden>
    <div class="ar-dialog-backdrop" aria-hidden="true"></div>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="mediaAddLabel">
        <form id="mediaAddForm" method="post" action="/media_new" novalidate>
            {{#_csrf}}<input type="hidden" name="{{parameterName}}" value="{{token}}">{{/_csrf}}
            <div class="ar-dialog-head">
                <h2 id="mediaAddLabel">미디어 추가</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <label class="ar-field">탭 분류
                    <select name="tab" id="mediaAddTab" aria-label="탭 분류">
                        <option value="mv" {{#isMV}}selected{{/isMV}}{{^isMV}}{{#isAll}}selected{{/isAll}}{{/isMV}}>MV</option>
                        <option value="signal" {{#isSIGNAL}}selected{{/isSIGNAL}}>SIGNAL</option>
                        <option value="behind" {{#isBehind}}selected{{/isBehind}}>비하인드</option>
                        <option value="secret" {{#isSecret}}selected{{/isSecret}}>시크릿베이스</option>
                        <option value="shorts" {{#isShorts}}selected{{/isShorts}}>Shorts &amp; 릴스</option>
                        <option value="music" {{#isMusic}}selected{{/isMusic}}>음방</option>
                        <option value="fancam" {{#isFancam}}selected{{/isFancam}}>직캠</option>
                        <option value="contents" {{#isContents}}selected{{/isContents}}>기타 컨텐츠</option>
                        <option value="external" {{#isExternal}}selected{{/isExternal}}>외부 콘텐츠</option>
                    </select>
                </label>
                <label class="ar-field">유튜브 URL 또는 ID
                    <span class="media-add-url">
                        <input id="mediaAddUrl" name="youtubeId" type="text" placeholder="https://youtu.be/... 또는 영상 ID" required>
                        <button class="ar-text-btn" type="button" id="mediaAddFetch">정보 가져오기</button>
                    </span>
                    <span class="ar-field-hint" id="mediaAddStatus" aria-live="polite"></span>
                </label>
                <label class="ar-field ar-date-field">공개일
                    <input type="date" name="publishedOn" id="mediaAddDate" lang="ko" data-ar-cal>
                    <span class="ar-field-hint">실제로 올라온 날짜를 선택하세요.</span>
                </label>
                {{>partials/archive-unit-field}}
                <div class="ar-field">출연 멤버
                    <div class="member-portrait-picker" id="media-add-picker" role="group" aria-label="출연 멤버">
                        {{#editMemberOptions}}
                        <button type="button" class="mpp-item" data-value="{{value}}" data-name="{{label}}" data-frame="{{frame}}" style="--artist-color:{{color}}" aria-pressed="false" title="{{label}}">
                            <span class="artist-tab-avatar">
                                <img class="artist-tab-photo" src="{{image}}" referrerpolicy="no-referrer" alt="" loading="lazy">
                                <img class="artist-tab-frame" src="" alt="" aria-hidden="true">
                                <span class="artist-tab-shine" aria-hidden="true"></span>
                            </span>
                            <span class="artist-tab-label">{{label}}</span>
                        </button>
                        {{/editMemberOptions}}
                    </div>
                    <div class="ar-artist-editor" data-artist-tags>
                        <div class="ar-picker-meta">
                            <span><span data-picker-count>0</span>명 선택<span data-picker-summary hidden></span></span>
                            <span class="ar-picker-meta-actions">
                                <button type="button" class="ar-text-btn" data-picker-all>전체 선택</button>
                                <button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button>
                            </span>
                        </div>
                        <div class="ar-artist-chips" data-artist-chips aria-label="선택한 멤버"></div>
                    </div>
                    <div id="mediaAddMembers" data-artist-inputs></div>
                </div>
                <label class="ar-field">제목
                    <input type="text" name="title" id="mediaAddTitle" maxlength="200" placeholder="정보 가져오기 후 자동 입력">
                </label>
                <label class="ar-field">영상 길이
                    <input type="text" name="duration" id="mediaAddDuration" placeholder="자동 입력" readonly>
                </label>
                <label class="ar-field">조회수
                    <input type="hidden" name="views" id="mediaAddViewsHidden" value="">
                    <input type="text" id="mediaAddViews" placeholder="자동 입력" readonly>
                </label>
                <div id="mediaAddThumb"></div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">추가하기</button>
            </div>
        </form>
    </div>
</div>

<div class="ar-dialog" id="mediaEditModal" hidden>
    <div class="ar-dialog-backdrop" aria-hidden="true"></div>
    <div class="ar-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="mediaEditLabel">
        <form id="mediaEditForm" method="post" action="/media_update" data-admin-fetch>
            {{#_csrf}}<input type="hidden" name="{{parameterName}}" value="{{token}}">{{/_csrf}}
            <div class="ar-dialog-head">
                <h2 id="mediaEditLabel">영상 정보 수정</h2>
                <button type="button" class="ar-close" data-ar-close aria-label="닫기">&times;</button>
            </div>
            <div class="ar-dialog-body">
                <input type="hidden" name="youtubeId" id="mediaEditId" value="">
                <label class="ar-field">미디어 카테고리
                    <select name="tab" id="mediaEditTab">
                        <option value="mv">MV</option>
                        <option value="signal">SIGNAL</option>
                        <option value="behind">비하인드</option>
                        <option value="secret">시크릿베이스</option>
                        <option value="shorts">Shorts &amp; 릴스</option>
                        <option value="music">음방</option>
                        <option value="fancam">직캠</option>
                        <option value="contents">기타 컨텐츠</option>
                        <option value="external">외부 콘텐츠</option>
                    </select>
                </label>
                <label class="ar-field ar-date-field">영상이 올라온 날짜
                    <input type="date" name="publishedOn" id="mediaEditDate" data-ar-cal lang="ko">
                </label>
                <label class="ar-field">상세 설명
                    <textarea name="description" id="mediaEditDesc" rows="6" maxlength="60000"></textarea>
                </label>
                {{>partials/archive-unit-field}}
                <div class="ar-field">참여 멤버
                    <div class="member-portrait-picker is-compact" id="media-edit-picker" role="group" aria-label="참여 멤버">
                        {{#editMemberOptions}}
                        <button type="button" class="mpp-item" data-value="{{value}}" data-name="{{label}}" data-frame="{{frame}}" style="--artist-color:{{color}}" aria-pressed="false" title="{{label}}">
                            <span class="artist-tab-avatar">
                                <img class="artist-tab-photo" src="{{image}}" referrerpolicy="no-referrer" alt="" loading="lazy">
                                <img class="artist-tab-frame" src="" alt="" aria-hidden="true">
                                <span class="artist-tab-shine" aria-hidden="true"></span>
                            </span>
                            <span class="artist-tab-label">{{label}}</span>
                        </button>
                        {{/editMemberOptions}}
                    </div>
                    <div class="ar-artist-editor" data-artist-tags>
                        <div class="ar-picker-meta">
                            <span><span data-picker-count>0</span>명 선택<span data-picker-summary hidden></span></span>
                            <span class="ar-picker-meta-actions">
                                <button type="button" class="ar-text-btn" data-picker-all>전체 선택</button>
                                <button type="button" class="ar-text-btn" data-picker-clear>전체 해제</button>
                            </span>
                        </div>
                        <div class="ar-artist-chips" data-artist-chips aria-label="선택한 멤버"></div>
                    </div>
                    <div id="mediaEditMembers" data-artist-inputs></div>
                </div>
            </div>
            <div class="ar-dialog-foot">
                <button type="button" class="ar-text-btn" data-ar-close>취소</button>
                <button type="submit" class="ar-submit">저장</button>
            </div>
        </form>
    </div>
</div>

