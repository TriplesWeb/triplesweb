{{>layout/v2/head-open}}


    
    

    <title>트리플에스 커뮤니티 - 트리플에스 미디어</title>

    
<link rel="stylesheet" href="/css/v2-pages.css?v=1">
</head><body class="v2-body site-page">

{{>layout/v2/header}}

<div class="container py-4 flex-1">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold tracking-tight m-0">공식 미디어</h2>
        <a href="/media_new?tab={{currentTab}}" class="site-btn site-btn--primary btn-glow" data-admin-only>
            <span class="material-symbols-outlined">add_box</span>
            <span>미디어 추가</span>
        </a>
    </div>

    <!-- 미디어 카테고리 탭 -->
    <div class="media-tab">
        <a class="media-mv {{#isMV}}active{{/isMV}}" href="/media?tab=mv">MV</a>
        <a class="media-signal {{#isSIGNAL}}active{{/isSIGNAL}}" href="/media?tab=signal">SIGNAL</a>
        <a class="media-behind {{#isBehind}}active{{/isBehind}}" href="/media?tab=behind">비하인드</a>
        <a class="media-secret {{#isSecret}}active{{/isSecret}}" href="/media?tab=secret">시크릿베이스</a>
        <a class="media-contents {{#isContents}}active{{/isContents}}" href="/media?tab=contents">기타 컨텐츠</a>
    </div>

    <form class="mb-4 flex flex-wrap items-center justify-center gap-3" method="get" action="/media">
        <input type="hidden" name="tab" value="{{currentTab}}">
        <label class="text-sm" for="artist-filter">출연 멤버</label>
        <select id="artist-filter" name="artist" class="site-field" style="width:auto;min-width:9rem;">
            <option value="">전체 멤버</option>
            {{#artistOptions}}<option value="{{name}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/artistOptions}}
        </select>
        {{>partials/date-range-filter}}
        <button type="submit" class="ar-submit">필터 적용</button>
        {{#selectedArtist}}<a class="text-xs" href="/media?tab={{currentTab}}">필터 초기화</a>{{/selectedArtist}}
    </form>

    <!-- 영상 그리드 리스트 -->
    <div class="site-media-grid">
        {{#videos}}
            <div class="site-media-card">
                <div class="video-card-box">
                    <a class="video-card text-decoration-none"
                       href="/media/{{currentTab}}/{{youtubeId}}"
                       data-site-toggle="modal"
                       data-site-target="#ytModal"
                       data-ytid="{{youtubeId}}"
                       title="{{title}}">
                        <div class="video-thumb">
                            <img src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg" alt="{{title}}">
                            {{#duration}}<span class="badge-duration">{{duration}}</span>{{/duration}}
                        </div>
                        <div class="video-title">{{title}}</div>
                        <div class="video-meta">조회수 {{viewCountFmt}}</div>
                    </a>

                    <form method="post" action="/media_delete" data-admin-only data-admin-fetch data-confirm="이 영상을 삭제하시겠습니까? 삭제하면 되돌릴 수 없습니다." class="mt-3">
                        <input type="hidden" name="tab" value="{{currentTab}}">
                        <input type="hidden" name="youtubeId" value="{{youtubeId}}">
                        <button type="submit" class="w-full py-1.5 px-3 rounded-lg bg-red-500/10 border border-red-500/30 hover:bg-red-500/20 text-xs font-semibold transition-all">삭제</button>
                    </form>
                </div>
            </div>
        {{/videos}}
    </div>

    {{^videos}}
        <div class="text-center py-20">
            <span class="material-symbols-outlined text-5xl mb-3">videocam_off</span>
            <p class="font-medium">등록된 영상이 없습니다.</p>
        </div>
    {{/videos}}

    <!-- 페이지네이션 -->
    {{#totalPages}}
        <nav class="mt-5" aria-label="미디어 페이지">
            <ul class="site-pagination">
                {{#hasPrev}}
                    <li><a href="/media?tab={{currentTab}}&page={{prevPage}}{{#selectedArtist}}&artist={{selectedArtist}}{{/selectedArtist}}{{dateQuery}}">&laquo;</a></li>
                {{/hasPrev}}
                {{#pages}}
                    <li class="{{#active}}is-active{{/active}}"><a href="/media?tab={{currentTab}}&page={{num}}{{#selectedArtist}}&artist={{selectedArtist}}{{/selectedArtist}}{{dateQuery}}">{{num}}</a></li>
                {{/pages}}
                {{#hasNext}}
                    <li><a href="/media?tab={{currentTab}}&page={{nextPage}}{{#selectedArtist}}&artist={{selectedArtist}}{{/selectedArtist}}{{dateQuery}}">&raquo;</a></li>
                {{/hasNext}}
            </ul>
        </nav>
    {{/totalPages}}
</div>

<!-- 유튜브 재생 모달 창 -->
<div class="site-modal" id="ytModal" tabindex="-1" aria-hidden="true">
    <div class="site-modal-dialog site-modal-lg">
        <div class="site-modal-panel">
            <div class="site-modal-header">
                <h5 class="site-modal-title">영상 재생</h5>
                <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="Close">×</button>
            </div>
            <div class="site-modal-body" style="padding:0">
                <div class="site-ratio-16x9">
                    <iframe id="ytPlayer" src="" title="YouTube video player"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/date-range-filter.js?v=1"></script>
<script src="/js/bootstrap-compat.js?v=1"></script>
<script src="/js/site-ui.js?v=1"></script>
<script>
    const artistFilter = document.getElementById('artist-filter');
    if (artistFilter) artistFilter.value = '{{selectedArtist}}';

    const ytModal = document.getElementById('ytModal');
    const ytPlayer = document.getElementById('ytPlayer');

    if (ytModal && ytPlayer) {
        document.querySelectorAll('[data-site-target="#ytModal"][data-ytid]').forEach((card) => {
            card.addEventListener('click', (event) => {
                event.preventDefault();
                const id = card.getAttribute('data-ytid');
                if (!id) return;
                ytPlayer.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
                window.SiteUi.modal(ytModal).show();
            });
        });
        ytModal.addEventListener('site-modal:hidden', function () {
            ytPlayer.src = '';
        });
    }
</script>
{{>layout/v2/footer}}
