<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
    <title>트리플에스 커뮤니티- 트리플에스 미디어</title>
    <style>
        .media-tab {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-bottom: 20px;
            }
        .media-tab a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 16px;
            height: 42px;
            border-radius: 9999px;
            border: 1px solid #ddd;
            color: #fff;
            text-decoration: none;
            font-size: 0.9rem;
            transition:.2s;
        }
        .media-tab a:hover {
            border-color: #aaa;
            background-color: #222;
        }
        .media-tab a.active {
           border-color:#0d6efd; color:#0d6efd;
        }
    .video-card { display:block;
    position:relative;
    overflow:hidden;
    border-radius:10px;
    text-decoration:none;
    }
    .video-thumb {
    width:100%;
    height:0;
    padding-top:56.25%;
    position:relative;
    background:#000;
    }
    .video-thumb img {
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover; }

    .badge-duration {
      position:absolute;
      right:8px;
      bottom:8px;
      background:rgba(0,0,0,.7); color:#fff;
      padding:2px 6px; border-radius:6px; font-size:.8rem;
    }
    .video-title {
    font-size:.95rem;
    margin-top:8px;
    color:#fff;
    }
    .video-meta {
    font-size:.8rem;
    color:#aaa;
    }
    .grid-gap {
    row-gap:18px;
    }

.container {
    background: transparent;
}

.pagination {
    background: transparent;
}

.pagination .page-link {
    background-color: transparent;
    border: none;
    color: #fff;
}

.pagination .page-item.active .page-link {
    background-color: #0d6efd;
    border-radius: 6px;
}
</style>

</head>
<body class="other-page">
{{>layout/header}}
<div class="container py-3">
<h2 class="mb-4">공식 미디어</h2>

<div class="media-tab">
    <a class="media-mv {{#isMV}}active{{/isMV}}" href="/media?tab=mv">
        MV
    </a>
    <a class="media-signal {{#isSIGNAL}}active{{/isSIGNAL}}" href="/media?tab=signal">
        SIGNAL
    </a>
    <a class="media-behind {{#isBehind}}active{{/isBehind}}" href="/media?tab=behind">
        비하인드
    </a>
    <a class="media-secret {{#isSecret}}active{{/isSecret}}" href="/media?tab=secret">
        시크릿베이스
    </a>
    <a class="media-contents {{#isContents}}active{{/isContents}}" href="/media?tab=contents">
        기타 컨텐츠
    </a>
</div>
    {{#isAdmin}}
        <div class="mb-3 text-end">
            <a href="/media_new" class="btn btn-sm btn-outline-light">새 영상 등록</a>
        </div>
    {{/isAdmin}}

        <div class="row grid-gap">
            {{#videos}}
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <a class="video-card text-decoration-none"
                       href="/media/{{currentTab}}/{{youtubeId}}"
                       data-ytid="{{youtubeId}}"
                       title="{{title}}">
                        <div class="video-thumb">
                            <img src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg" alt="{{title}}">
                            {{#duration}}<span class="badge-duration">{{duration}}</span>{{/duration}}
                        </div>
                        <div class="video-title">{{title}}</div>
                        <div class="video-meta">조회수 {{viewCountFmt}}</div>
                    </a>
                    {{#isAdmin}}
                        <form method="post" action="/media_delete" class="mt-2">
                            <input type="hidden" name="tab" value="{{currentTab}}">
                            <input type="hidden" name="youtubeId" value="{{youtubeId}}">
                            <button type="submit" class="btn btn-sm btn-danger w-100">삭제</button>
                        </form>
                    {{/isAdmin}}
                </div>
            {{/videos}}
        </div>
    {{^videos}}
        <div class="text-center text-muted py-5">등록된 영상이 없습니다.</div>
    {{/videos}}

    {{#totalPages}}
        <nav class="mt-4 d-flex justify-content-center">
            <ul class="pagination mb-0">
                {{#hasPrev}}
                    <li class="page-item">
                        <a class="page-link" href="/media?tab={{currentTab}}&page={{prevPage}}">&laquo;</a>
                    </li>
                {{/hasPrev}}
                {{#pages}}
                    <li class="page-item {{#active}}active{{/active}}">
                        <a class="page-link" href="/media?tab={{currentTab}}&page={{num}}">
                        {{num}}
                        </a>
                    </li>
                {{/pages}}
                {{#hasNext}}
                    <li class="page-item">
                        <a class="page-link" href="/media?tab={{currentTab}}&page={{nextPage}}">&raquo;</a>
                    </li>
                {{/hasNext}}
            </ul>
        </nav>
    {{/totalPages}}
</div>

<div class="modal fade" id="ytModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <h5 class="modal-title text-light">재생</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0">
                <div class="ratio ratio-16x9">
                    <iframe id="ytPlayer" src="" title="YouTube video player"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
<script>
    const ytModal = document.getElementById('ytModal');
    const ytPlayer = document.getElementById('ytPlayer');

    ytModal.addEventListener('show.bs.modal', function (e) {
      const card = e.relatedTarget;
      const id = card?.getAttribute('data-ytid');
      if (!id) return;
      ytPlayer.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
    });

    ytModal.addEventListener('hidden.bs.modal', function () {
      ytPlayer.src = ''; // 닫을 때 재생 중지
    });
</script>
</body>
</html>