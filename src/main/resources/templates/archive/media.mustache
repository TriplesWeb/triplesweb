{{>layout/head-open}}

<link rel="stylesheet" href="{{#asset}}/css/bootstrap-compat.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/archive-page.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/member-portrait-picker.css{{/asset}}">
<link rel="stylesheet" href="{{#asset}}/css/media-page.css{{/asset}}">

<title>트리플에스 커뮤니티 - 공식 미디어</title>
</head><body class="site-page media-page">

{{>layout/header}}

<main class="media-shell">
    <header class="media-intro">
        <p class="media-crumb">미디어  /  공식 미디어</p>
        <div class="media-intro__row">
            <div class="media-intro__copy">
                <h1>공식 미디어</h1>
                <p>tripleS의 모든 순간을 한곳에서. 뮤직비디오부터 매일의 SIGNAL까지 만나보세요.</p>
            </div>
            <div class="media-intro__actions">
                <a class="media-channel" href="https://www.youtube.com/@tripleS_official" target="_blank" rel="noopener noreferrer">YouTube 채널 ↗</a>
                <a class="media-add" href="/media_new?tab={{#isAll}}mv{{/isAll}}{{^isAll}}{{currentTab}}{{/isAll}}" data-admin-only>미디어 추가</a>
            </div>
        </div>
    </header>

    <section class="media-filters" aria-label="미디어 분류">
        <nav class="site-section-tabs media-tabs" aria-label="미디어 카테고리">
            <a class="site-section-tab{{#isAll}} is-active{{/isAll}}" href="/media?tab=all" {{#isAll}}aria-current="page"{{/isAll}}>전체</a>
            <a class="site-section-tab{{#isMV}} is-active{{/isMV}}" href="/media?tab=mv" {{#isMV}}aria-current="page"{{/isMV}}>MV</a>
            <a class="site-section-tab{{#isSIGNAL}} is-active{{/isSIGNAL}}" href="/media?tab=signal" {{#isSIGNAL}}aria-current="page"{{/isSIGNAL}}>SIGNAL</a>
            <a class="site-section-tab{{#isBehind}} is-active{{/isBehind}}" href="/media?tab=behind" {{#isBehind}}aria-current="page"{{/isBehind}}>비하인드</a>
            <a class="site-section-tab{{#isSecret}} is-active{{/isSecret}}" href="/media?tab=secret" {{#isSecret}}aria-current="page"{{/isSecret}}>시크릿베이스</a>
            <a class="site-section-tab{{#isContents}} is-active{{/isContents}}" href="/media?tab=contents" {{#isContents}}aria-current="page"{{/isContents}}>기타 콘텐츠</a>
        </nav>

        <section class="ar-panel ar-toolbar media-toolbar">
            <form class="ar-filters" id="mediaFilterForm" method="get" action="/media">
                <input type="hidden" name="tab" value="{{currentTab}}">
                <input type="hidden" name="artist" id="mediaArtist" value="{{selectedArtist}}">
                <div class="ar-filter-tools">
                    <div class="ar-sort">
                        <span class="ar-sort-label" id="mediaSortLabel">정렬</span>
                        <span class="ar-sort-control">
                            <select id="mediaSort" name="sort" aria-labelledby="mediaSortLabel">
                                {{#sortOptions}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/sortOptions}}
                            </select>
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_drop_down</span>
                        </span>
                    </div>
                    {{>partials/date-range-filter}}
                    <button type="button" class="ar-member-toggle{{#selectedArtist}} has-selection{{/selectedArtist}}" id="mediaMemberToggle" aria-expanded="false" aria-controls="mediaMemberPanel">
                        <span class="material-symbols-outlined" aria-hidden="true">group</span>
                        <span data-member-toggle-label>{{#selectedArtist}}{{selectedArtist}}{{/selectedArtist}}{{^selectedArtist}}멤버 선택{{/selectedArtist}}</span>
                        <span class="material-symbols-outlined ar-member-chevron" aria-hidden="true">expand_more</span>
                    </button>
                    <a class="site-btn site-btn--reset ar-reset" href="/media?tab={{currentTab}}"{{^hasActiveFilters}} hidden{{/hasActiveFilters}}>초기화</a>
                </div>
            </form>
            <div class="ar-member-panel" id="mediaMemberPanel" hidden>
                <div class="member-portrait-picker" id="media-member-picker" role="group" aria-label="출연 멤버">
                    {{>partials/member-portrait-picker}}
                </div>
            </div>
        </section>
    </section>

    {{#hasFeatured}}
    <section class="media-feature" aria-label="지금 주목할 영상">
        <div class="media-feature__head">
            <h2>지금 주목할 영상</h2>
            <span>FEATURED</span>
        </div>
        <div class="media-feature__layout {{^hasRecommendations}}is-solo{{/hasRecommendations}}">
            <a class="media-feature__hero"
               href="/media/{{featured.tab}}/{{featured.youtubeId}}"
               data-site-toggle="modal"
               data-site-target="#ytModal"
               data-ytid="{{featured.youtubeId}}">
                <img class="media-feature__still" src="https://img.youtube.com/vi/{{featured.youtubeId}}/hqdefault.jpg" alt="">
                <span class="media-feature__shade"></span>
                <span class="media-feature__badge">{{featured.tabLabel}}</span>
                <img class="media-feature__play" src="{{#asset}}/images/media/play-featured.svg{{/asset}}" width="60" height="60" alt="">
                <span class="media-feature__caption">
                    <strong>{{featured.title}}</strong>
                    <span class="media-feature__meta">
                        <em>조회수 {{featured.viewCountFmt}}{{#featured.publishedLabel}} · {{featured.publishedLabel}}{{/featured.publishedLabel}}</em>
                        {{#featured.duration}}<b>{{featured.duration}}</b>{{/featured.duration}}
                    </span>
                </span>
            </a>
            {{#hasRecommendations}}
            <aside class="media-playlist">
                <div class="media-playlist__head">
                    <h3>추천 재생목록</h3>
                    <span>{{recommendationCount}}</span>
                </div>
                <div class="media-playlist__list">
                    {{#recommendations}}
                    <a class="media-playlist__item"
                       href="/media/{{tab}}/{{youtubeId}}"
                       data-site-toggle="modal"
                       data-site-target="#ytModal"
                       data-ytid="{{youtubeId}}">
                        <span class="media-playlist__thumb">
                            <img src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg" alt="">
                            {{#duration}}<em>{{duration}}</em>{{/duration}}
                        </span>
                        <span class="media-playlist__copy">
                            <small>{{tabLabel}}</small>
                            <strong>{{title}}</strong>
                            <em>조회수 {{viewCountFmt}}</em>
                        </span>
                    </a>
                    {{/recommendations}}
                </div>
            </aside>
            {{/hasRecommendations}}
        </div>
    </section>
    {{/hasFeatured}}

    <section class="media-archive" aria-label="영상 아카이브">
        <div class="media-archive__head">
            <h2>영상 아카이브</h2>
            <p>{{archiveScope}}</p>
            <span>{{archiveSortLabel}}</span>
        </div>
        <div class="media-grid">
            {{#videos}}
            <article class="media-card">
                <a class="media-card__link"
                   href="/media/{{tab}}/{{youtubeId}}"
                   data-site-toggle="modal"
                   data-site-target="#ytModal"
                   data-ytid="{{youtubeId}}">
                    <span class="media-card__thumb">
                        <img src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg" alt="">
                        <img class="media-card__play" src="{{#asset}}/images/media/play-card.svg{{/asset}}" width="44" height="44" alt="">
                        {{#duration}}<span class="media-card__time">{{duration}}</span>{{/duration}}
                    </span>
                    <span class="media-card__body">
                        <small class="media-card__kind">{{tabLabel}}</small>
                        <span class="media-card__title">{{title}}</span>
                        <span class="media-card__meta">조회수 {{viewCountFmt}}{{#publishedLabel}} · {{publishedLabel}}{{/publishedLabel}}</span>
                    </span>
                </a>
                <form class="media-card__delete" method="post" action="/media_delete" data-admin-only data-admin-fetch data-confirm="이 영상을 삭제하시겠습니까? 삭제하면 되돌릴 수 없습니다.">
                    <input type="hidden" name="tab" value="{{tab}}">
                    <input type="hidden" name="youtubeId" value="{{youtubeId}}">
                    <button type="submit">삭제</button>
                </form>
            </article>
            {{/videos}}
        </div>
        {{^videos}}
        <div class="media-empty">
            <p>등록된 영상이 없습니다.</p>
        </div>
        {{/videos}}
    </section>

    {{#hasShorts}}
    <section class="media-shorts" aria-label="Shorts와 릴스">
        <div class="media-shorts__head">
            <h2>Shorts &amp; 릴스</h2>
            <p>짧게 만나는 tripleS의 순간</p>
            <a href="https://www.youtube.com/@tripleS_official/shorts" target="_blank" rel="noopener noreferrer">YouTube Shorts ↗</a>
        </div>
        <div class="media-shorts__grid">
            {{#shorts}}
            <a class="media-short"
               href="/media/{{tab}}/{{youtubeId}}"
               data-site-toggle="modal"
               data-site-target="#ytModal"
               data-ytid="{{youtubeId}}">
                <img class="media-short__still" src="https://img.youtube.com/vi/{{youtubeId}}/hqdefault.jpg" alt="">
                <span class="media-short__badge">SHORTS</span>
                <img class="media-short__play" src="{{#asset}}/images/media/play-short.svg{{/asset}}" width="46" height="46" alt="">
                <span class="media-short__caption">
                    <small>{{tabLabel}}</small>
                    <strong>{{title}}</strong>
                </span>
            </a>
            {{/shorts}}
        </div>
    </section>
    {{/hasShorts}}
</main>

<div class="site-modal" id="ytModal" tabindex="-1" aria-hidden="true">
    <div class="site-modal-dialog site-modal-lg">
        <div class="site-modal-panel">
            <div class="site-modal-header">
                <h5 class="site-modal-title">영상 재생</h5>
                <button type="button" class="site-modal-close" data-site-dismiss="modal" aria-label="Close">×</button>
            </div>
            <div class="site-modal-body" style="padding:0">
                <div class="site-ratio-16x9">
                    <iframe id="ytPlayer" src="" title="YouTube video player"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="{{#asset}}/js/bootstrap-compat.js{{/asset}}"></script>
<script src="{{#asset}}/js/site-ui.js{{/asset}}"></script>
<script src="{{#asset}}/js/member-portrait-picker.js{{/asset}}"></script>
<script>
    (function () {
        const form = document.getElementById('mediaFilterForm');
        const sort = document.getElementById('mediaSort');
        const panel = document.getElementById('mediaMemberPanel');
        const toggle = document.getElementById('mediaMemberToggle');
        const artist = document.getElementById('mediaArtist');
        const label = toggle?.querySelector('[data-member-toggle-label]');
        if (!form || !sort) return;

        function enhanceSort(select) {
            const control = select.closest('.ar-sort-control');
            if (!control || control.classList.contains('is-enhanced')) return;
            control.classList.add('is-enhanced');
            select.setAttribute('aria-hidden', 'true');
            select.tabIndex = -1;
            const trigger = document.createElement('button');
            trigger.type = 'button';
            trigger.className = 'ar-sort-trigger';
            trigger.setAttribute('aria-haspopup', 'listbox');
            trigger.setAttribute('aria-expanded', 'false');
            trigger.setAttribute('aria-label', '정렬');
            const menu = document.createElement('div');
            menu.className = 'ar-sort-menu';
            menu.hidden = true;
            menu.setAttribute('role', 'listbox');
            function sync() {
                const selected = [...select.options].find((option) => option.value === select.value);
                trigger.textContent = selected ? selected.textContent.trim() : '';
                [...menu.querySelectorAll('.ar-sort-option')].forEach((option) => {
                    option.setAttribute('aria-selected', option.dataset.value === select.value ? 'true' : 'false');
                });
            }
            function setOpen(open) {
                menu.hidden = !open;
                trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
            [...select.options].forEach((option) => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'ar-sort-option';
                item.setAttribute('role', 'option');
                item.dataset.value = option.value;
                item.textContent = option.textContent.trim();
                item.addEventListener('click', () => {
                    if (select.value !== option.value) {
                        select.value = option.value;
                        select.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    sync();
                    setOpen(false);
                });
                menu.appendChild(item);
            });
            trigger.addEventListener('click', () => {
                const willOpen = menu.hidden;
                window.closeArchiveOverlays?.(trigger);
                setOpen(willOpen);
            });
            select.after(trigger);
            control.appendChild(menu);
            sync();
        }

        function dateSnapshot() {
            return ['from', 'to'].map((name) => {
                const input = form.querySelector('[data-date-filter] input[name="' + name + '"]');
                return name + '=' + (input ? input.value : '');
            }).join('&');
        }

        let appliedDates = dateSnapshot();
        enhanceSort(sort);
        sort.addEventListener('change', () => form.requestSubmit());
        toggle?.addEventListener('click', () => {
            if (!panel) return;
            const willOpen = panel.hidden;
            window.closeArchiveOverlays?.(toggle);
            panel.hidden = !willOpen;
            toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
            toggle.classList.toggle('is-open', willOpen);
        });
        if (window.MemberPortraitPicker && panel) {
            MemberPortraitPicker.bindMultiSelect(panel, {
                multi: false,
                onChange: (values) => {
                    const name = values[0] || '';
                    if (artist) artist.value = name;
                    if (label) label.textContent = name || '멤버 선택';
                    toggle?.classList.toggle('has-selection', Boolean(name));
                    form.requestSubmit();
                }
            });
        }
        form.addEventListener('archive-date-close', () => {
            const next = dateSnapshot();
            if (next === appliedDates) return;
            appliedDates = next;
            form.requestSubmit();
        });
        form.addEventListener('submit', () => {
            if (artist && !artist.value.trim()) artist.disabled = true;
            form.querySelectorAll('[data-date-filter] input').forEach((input) => {
                if (!input.value.trim()) input.disabled = true;
            });
        });
    })();

    const ytModal = document.getElementById('ytModal');
    const ytPlayer = document.getElementById('ytPlayer');

    if (ytModal && ytPlayer) {
        document.querySelectorAll('[data-site-target="#ytModal"][data-ytid]').forEach((card) => {
            card.addEventListener('click', (event) => {
                event.preventDefault();
                const id = card.getAttribute('data-ytid');
                if (!id) return;
                ytPlayer.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
                window.SiteUi.modal(ytModal).show();
            });
        });
        ytModal.addEventListener('site-modal:hidden', function () {
            ytPlayer.src = '';
        });
    }
</script>
{{>layout/page-end}}
