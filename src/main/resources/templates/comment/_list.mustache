<div id="comments-list">
    {{#commentDtos}}
            <div class="card m-2" id="comments-{{id}}">
                <div class="card-header">
                    {{userId}}
                    {{#isOwner}}
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#commentEditModal-{{id}}">수정하기
                    </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#commentDeleteModal-{{id}}">삭제하기
                        </button>
                    {{/isOwner}}
                </div>
                <div class="card-body">
                    {{body}}
                </div>
            </div>
            <div class="modal fade" id="commentEditModal-{{id}}" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5"
                                id="exampleModalLabel">댓글 수정</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                        </div>
                        <div class="modal-body">
                            <form>
                                <div class="mb-3">
                                    <label class="form-label">닉네임</label>
                                    <p>{{userId}}</p>
                                    <input type="hidden" id="new-comment-userId" value="{{userId}}" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">내용</label>
                                    <textarea class="form-control" rows="3" id="edit-comment-body-{{id}}" data-original-body="{{body}}">{{body}}</textarea>
                                </div>
                                <button type="button" class="btn btn-primary comment-edit-btn" data-comment-id="{{id}}" data-article-id="{{articleId}}" {{^isLoggedIn}}disabled{{/isLoggedIn}}>수정하기</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        <div class="modal fade" id="commentDeleteModal-{{id}}" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">댓글 삭제</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                    </div>
                    <div class="modal-body">
                        <p>댓글을 정말 삭제하시겠습니까?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                        <button type="button" class="btn btn-danger comment-delete-btn" data-comment-id="{{id}}" data-article-id="{{articleId}}">삭제</button>
                    </div>
                </div>
            </div>
        </div>

    {{/commentDtos}}
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const editButtons = document.querySelectorAll(".comment-edit-btn");

        editButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                const commentId = this.getAttribute("data-comment-id");
                const articleId = this.getAttribute("data-article-id");

                const textarea = document.querySelector(`#edit-comment-body-${commentId}`);
                const newBody = textarea.value.trim();
                const originalBody = textarea.getAttribute("data-original-body").trim();

        if (!newBody) {
            alert("내용을 입력해주세요.");
        return;
        }

            // ✅ 내용이 바뀌지 않았으면 경고
        if (newBody === originalBody) {
            alert("내용이 변경되지 않았습니다.");
        return;
        }
                const url = `/api/articles/${articleId}/comments/${commentId}`;

                fetch(url, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        id: commentId,
                        body: newBody
                    })
                })
                .then(res => {
                    if (!res.ok) {
                        return res.text().then(text => { throw new Error(text || "댓글 수정 실패"); });
                    }
                    return res.json();
                })
                        .then(data => {
                            alert("댓글이 수정되었습니다.");
                            window.location.reload();
                        })
                        .catch(err => {
                            alert(err.message || "오류가 발생했습니다.");
                            console.error("수정 에러", err);
                });
            });
        });
        const deleteButtons = document.querySelectorAll(".comment-delete-btn");
        deleteButtons.forEach(btn => {
        btn.addEventListener("click", function () {

            const commentId = this.getAttribute("data-comment-id");
            const articleId = this.getAttribute("data-article-id");

            const url = `/api/articles/${articleId}/comments/${commentId}`;

            fetch(url, {
                method: "DELETE"
            })
                    .then(res => {
                        if (!res.ok) {
                            throw new Error("댓글 삭제 실패");
                        }
                        const msg = `댓글을 삭제했습니다.`
                        alert(msg);
                        window.location.reload();
                    })
                    .catch(err => {
                        alert("댓글 삭제 중 오류 발생");
                        console.error(err);
                    });
        });
    });
});
</script>
