<!DOCTYPE html>
<html lang="ko" xmlns="http://www.w3.org/1999/html">
<head>
{{>layout/site-head}}
<link rel="stylesheet" href="/css/bootstrap-compat.css?v=2">
<meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>굿즈샵 작성폼</title>
    <style>
    #content {
    min-height: 150px;
    font-family: inherit;
    border: 1px solid #ccc;
    padding: 10px;
    border-radius: 5px;
    }
    .content-media {
    position: relative;
    display: inline-block;
    margin: 5px 0;
    width: auto;
    }
    .content-media img,
    .content-media video {
    max-width: 100%;
    display: block;
    border-radius: 5px;
    height: auto;
    }
</style>
</head>
<body class="other_page">
<form id="editForm" class="container" action="/shop/shop_new" method="post" enctype="multipart/form-data" onsubmit="return beforeSubmit()">
    {{#errorMessage}}<p class="alert alert-danger" role="alert">{{errorMessage}}</p>{{/errorMessage}}
    <div class="col-md-3">
        <label class="form-label">탭</label>
        <label>
            <select class="form-select bg-dark text-light" name="category">
                <option value="album" {{#category_album}}selected{{/category_album}}>앨범</option>
                <option value="merch" {{#category_merch}}selected{{/category_merch}}>상품(MERCH)</option>
                <option value="photobook" {{#category_photobook}}selected{{/category_photobook}}>포토북</option>
                <option value="magazine" {{#category_magazine}}selected{{/category_magazine}}>매거진</option>
                <option value="tour" {{#category_tour}}selected{{/category_tour}}>콘서트 굿즈</option>
            </select>
        </label>
    </div>
    <div class="mb-3">
        <label class="form-label">제목</label>
        <input type="text" class="form-control" name="name" required>
    </div>
    <div class="mb-3">
        <label class="form-label">가격</label>
        <input type="number" min="0" step="1" class="form-control" name="price" required>
    </div>
    <div class="mb-3">
        <label class="form-label">내용 (상세 정보)</label>
        <div id="content" contenteditable="true" class="form-control" aria-multiline="true"></div>
        <input type="hidden" name="description" id="hiddenContent" />
    </div>
    <div class="mb-3">
        <label class="form-label">첨부 파일 (이미지 또는 영상)</label>
        <input type="file" name="files" id="imageUpload" multiple accept="image/*,video/*" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">작성하기</button>
</form>
<script>
    document.getElementById("imageUpload").addEventListener("change", function () {
        let file = this.files[0];
        if (!file) return;

        let formData = new FormData();
        formData.append("file", file);

        fetch("/shop/uploadFile", {
            method: "POST",
            body: formData
        })
        .then(async response => {
            if (!response.ok) {
                const text = await response.text().catch(() => "");
                throw new Error(text.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 180) || "이미지 업로드에 실패했습니다.");
            }
            return response.json();
        })
        .then(data => {
            if (!data || !data.url) throw new Error("업로드 응답에 주소가 없습니다.");
            const contentDiv = document.getElementById("content");
            const img = document.createElement("img");
            img.src = data.url;
            img.alt = "상품 이미지";
            const wrap = document.createElement("div");
            wrap.className = "content-media";
            wrap.appendChild(img);
            contentDiv.appendChild(wrap);
        })
        .catch(err => {
            console.error(err);
            alert(err.message || "이미지 업로드에 실패했습니다. 네트워크 연결을 확인해 주세요.");
        });
        });
    function beforeSubmit() {
        const name = document.querySelector('[name="name"]')?.value.trim();
        const price = document.querySelector('[name="price"]')?.value.trim();
        const content = document.getElementById("content");
        document.getElementById("hiddenContent").value = content ? content.innerHTML : "";
        if (!name) { alert("제목을 입력해 주세요."); return false; }
        if (!price) { alert("가격을 입력해 주세요."); return false; }
        return window.confirm("이 상품을 등록하시겠습니까?");
    }
</script>

<script src="/js/bootstrap-compat.js?v=1" defer></script>
</body>
</html>