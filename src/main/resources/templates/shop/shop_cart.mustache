{{>layout/v2/head-open}}

<title>장바구니 - 굿즈샵</title>

<link rel="stylesheet" href="/css/v2-pages.css?v=1">
</head>
<body class="v2-body site-page other-page">
{{>layout/v2/header}}

<div class="site-container">
    <h2>장바구니</h2>
    {{#items}}
        <div class="cart-row">
            <img src="{{imageUrl}}" alt="">
            <div>
                <div>{{name}}</div>
                <div class="cart-price">{{price}}원</div>
            </div>
        </div>
    {{/items}}
    {{^items}}
        <p class="cart-empty">장바구니가 비어 있습니다.</p>
    {{/items}}
</div>
<script src="/js/bootstrap-compat.js?v=1" defer></script>
{{>layout/v2/footer}}
