<!DOCTYPE html>
<html lang="ko">
<head>
{{>layout/site-head}}
<link rel="stylesheet" href="/css/bootstrap-compat.css?v=2">
<meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>장바구니 - 굿즈샵</title>
    </head>
<body class="other-page">
{{>layout/header}}

<div class="container py-4">
    <h2>장바구니</h2>
    {{#items}}
        <div class="d-flex align-items-center border-bottom py-2">
            <img src="{{imageUrl}}" style="width:80px; height:80px; object-fit:cover" class="me-3 rounded">
            <div>
                <div>{{name}}</div>
                <div class="text-primary">{{price}}원</div>
            </div>
        </div>
    {{/items}}
    {{^items}}
        <p class="text-muted">장바구니가 비어 있습니다.</p>
    {{/items}}
</div>
<script src="/js/bootstrap-compat.js?v=1" defer></script>
</body>
</html>
