{{>layout/head-open}}
<link rel="stylesheet" href="{{#asset}}/css/bootstrap-compat.css{{/asset}}">
<title>장바구니 - 굿즈샵</title>
<style>
    body.other-page { background: #0d0e12; color: #e3e2e8; }
    .cart-row { display: flex; align-items: center; gap: .85rem; padding: .75rem 0; border-bottom: 1px solid #ffffff14; }
    .cart-row img { width: 80px; height: 80px; object-fit: cover; border-radius: .65rem; }
    .cart-price { color: #8decd9; }
    .cart-empty { color: #b9cac4; }
</style>
</head>
<body class="site-page other-page">
{{>layout/header}}

<div class="site-container">
    <h2>장바구니</h2>
    {{#items}}
        <div class="cart-row">
            <img src="{{imageUrl}}" alt="">
            <div>
                <div>{{name}}</div>
                <div class="cart-price">{{price}}원</div>
            </div>
        </div>
    {{/items}}
    {{^items}}
        <p class="cart-empty">장바구니가 비어 있습니다.</p>
    {{/items}}
</div>
<script src="{{#asset}}/js/bootstrap-compat.js{{/asset}}" defer></script>
{{>layout/page-end}}
