{{>layout/head-open}}

    <title>트리플에스 커뮤니티 - 굿즈샵</title>
</head><body class="site-page other-page">
{{>layout/header}}

<div class="site-container">
    <div class="site-carousel shop-banner" data-site-carousel data-autoplay="5000">
        <div class="site-carousel-track">
            <div class="site-carousel-slide"><img src="/uploads/images/lightstick.png" alt="배너 1"></div>
            <div class="site-carousel-slide"><img src="/uploads/images/banner2.jpg" alt="배너 2"></div>
        </div>
        <button type="button" class="site-carousel-btn prev" data-site-carousel-prev aria-label="이전">‹</button>
        <button type="button" class="site-carousel-btn next" data-site-carousel-next aria-label="다음">›</button>
    </div>

    <div class="category-tabs">
        <a href="?category=album" class="{{#isAlbum}}active{{/isAlbum}}">ALBUM</a>
        <a href="?category=merch" class="{{#isMerch}}active{{/isMerch}}">MERCH</a>
        <a href="?category=photobook" class="{{#isPhotobook}}active{{/isPhotobook}}">PHOTOBOOK</a>
        <a href="?category=magazine" class="{{#isMagazine}}active{{/isMagazine}}">MAGAZINE</a>
        <a href="?category=tour" class="{{#isTour}}active{{/isTour}}">TOUR MERCH</a>
    </div>

    <div class="product-grid">
       {{#items}}
            <div class="product-card">
                <a href="/shop/item/{{category}}/{{id}}">
                    <img src="{{mainImageUrl}}" alt="{{name}}">
                    <div class="product-name">{{name}}</div>
                </a>
                {{#soldout}}<div class="product-soldout">품절</div>{{/soldout}}
                <div class="product-price">{{price}}원</div>
            </div>
        {{/items}}
        {{^items}}
            <div class="shop-empty">상품이 없습니다.</div>
        {{/items}}
    </div>

    {{#isAdmin}}
        <div class="shop-admin">
            <a href="/shop/shop_new" class="btn-add-goods">새 상품 등록</a>
        </div>
    {{/isAdmin}}
</div>
<script src="/js/site-ui.js?v=1"></script>
{{>layout/page-end}}
