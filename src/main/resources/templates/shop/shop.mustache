<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>트리플에스 커뮤니티 - 굿즈샵</title>
    <link rel="stylesheet" href="/css/site-ui.css?v=1"/>
    <style>
        body.other-page { background: #0d0e12; color: #e3e2e8; }
        .shop-banner img { border-radius: 12px; max-height: 500px; width: 100%; object-fit: cover; }
        .category-tabs { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
        .category-tabs a {
          border-radius: 20px; padding: 6px 16px; font-weight: 600;
          color: #e3e2e8; text-decoration: none; border: 1px solid #3a4a4680;
        }
        .category-tabs a.active { background: #8decd9; color: #071310; border-color: #8decd9; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 1rem; }
        .product-card img { border-radius: 10px; width: 100%; display: block; }
        .product-name { font-size: .95rem; font-weight: 600; margin-top: 8px; color: #e3e2e8; text-decoration: none; }
        .product-price { color: #8decd9; font-weight: 700; font-size: .9rem; }
        .product-soldout { color: #f87171; font-size: .85rem; }
        .btn-add-goods {
         display: inline-flex; align-items: center; border-radius: 12px; padding: .6rem 1.2rem;
         background: #8decd9; color: #071310; font-weight: 700; text-decoration: none;
        }
        .shop-admin { margin: 1rem 0; text-align: right; }
        .shop-empty { color: #b9cac4; }
    </style>
</head>
<body class="other-page">
{{>layout/header}}

<div class="site-container">
    <div class="site-carousel shop-banner" data-site-carousel data-autoplay="5000">
        <div class="site-carousel-track">
            <div class="site-carousel-slide"><img src="/uploads/images/lightstick.png" alt="배너 1"></div>
            <div class="site-carousel-slide"><img src="/uploads/images/banner2.jpg" alt="배너 2"></div>
        </div>
        <button type="button" class="site-carousel-btn prev" data-site-carousel-prev aria-label="이전">‹</button>
        <button type="button" class="site-carousel-btn next" data-site-carousel-next aria-label="다음">›</button>
    </div>

    <div class="category-tabs">
        <a href="?category=album" class="{{#isAlbum}}active{{/isAlbum}}">ALBUM</a>
        <a href="?category=merch" class="{{#isMerch}}active{{/isMerch}}">MERCH</a>
        <a href="?category=photobook" class="{{#isPhotobook}}active{{/isPhotobook}}">PHOTOBOOK</a>
        <a href="?category=magazine" class="{{#isMagazine}}active{{/isMagazine}}">MAGAZINE</a>
        <a href="?category=tour" class="{{#isTour}}active{{/isTour}}">TOUR MERCH</a>
    </div>

    <div class="product-grid">
       {{#items}}
            <div class="product-card">
                <a href="/shop/item/{{category}}/{{id}}">
                    <img src="{{mainImageUrl}}" alt="{{name}}">
                    <div class="product-name">{{name}}</div>
                </a>
                {{#soldout}}<div class="product-soldout">품절</div>{{/soldout}}
                <div class="product-price">{{price}}원</div>
            </div>
        {{/items}}
        {{^items}}
            <div class="shop-empty">상품이 없습니다.</div>
        {{/items}}
    </div>

    {{#isAdmin}}
        <div class="shop-admin">
            <a href="/shop/shop_new" class="btn-add-goods">새 상품 등록</a>
        </div>
    {{/isAdmin}}
</div>
<script src="/js/site-ui.js?v=1"></script>
{{>layout/footer}}
</body>
</html>
