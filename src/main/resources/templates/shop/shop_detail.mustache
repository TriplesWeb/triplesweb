{{>layout/head-open}}

    <link rel="stylesheet" href="{{#asset}}/css/shop-detail.css{{/asset}}">
    <title>트리플에스 커뮤니티 - 굿즈리스트</title>
</head><body class="site-page bg-[#0d0e12] text-[#e3e2e8] min-h-screen">
{{>layout/header}}
<main class="main-content max-w-7xl mx-auto px-4 py-8">
    {{#shop}}
<div class="card-box shop-detail-card bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl shadow-xl overflow-hidden">
    <nav class="site-back site-back--bar" aria-label="굿즈리스트로">
        <a href="/shop">← 굿즈리스트</a>
    </nav>
    <div class="shop-detail-body p-6 lg:p-8 space-y-8">
        <div class="shop-detail-hero grid grid-cols-1 md:grid-cols-12 gap-8 items-start min-w-0">
            <div class="md:col-span-4 lg:col-span-3 flex justify-center">
                <img src="{{displayCoverImage}}" width="300" height="300" alt="{{eventName}}" class="shop-detail-poster w-full max-w-[260px] aspect-square object-cover rounded-2xl border border-[#3a4a46]/40 shadow-2xl" />
            </div>
            <div class="md:col-span-8 lg:col-span-9 space-y-5 min-w-0">
                <h1 class="text-3xl lg:text-4xl font-extrabold text-[#e3e2e8] tracking-tight m-0">{{eventName}}</h1>
                <dl class="shop-detail-meta">
                    {{#hasSalesPeriod}}
                    <div class="shop-detail-meta-row">
                        <dt>판매 기간</dt>
                        <dd class="font-mono">{{salesPeriod}}</dd>
                    </div>
                    {{/hasSalesPeriod}}
                    {{#eventId}}
                    <div class="shop-detail-meta-row">
                        <dt>공연</dt>
                        <dd><a href="/cosmo/event/{{eventId}}" class="shop-detail-event-link">공연 상세 보기 →</a></dd>
                    </div>
                    {{/eventId}}
                </dl>
            </div>
        </div>

        {{#hasMdPhotos}}
        <section class="shop-md-section space-y-4 min-w-0" aria-label="MD 리스트">
            <h2 class="text-xl font-bold text-[#e3e2e8] flex items-center gap-2 m-0">
                <span class="material-symbols-outlined text-[#00f5d4]" aria-hidden="true">photo_library</span>
                MD 리스트
            </h2>
            {{#hasMultipleMdRegions}}
            <div class="site-section-tabs shop-md-region-tabs" id="shopMdRegionTabs" role="tablist" aria-label="MD 지역">
                {{#mdRegions}}
                <button type="button"
                        class="site-section-tab{{#firstRegion}} is-active{{/firstRegion}}"
                        role="tab"
                        id="tab-{{regionPanelId}}"
                        aria-controls="{{regionPanelId}}"
                        aria-selected="{{#firstRegion}}true{{/firstRegion}}{{^firstRegion}}false{{/firstRegion}}"
                        tabindex="{{#firstRegion}}0{{/firstRegion}}{{^firstRegion}}-1{{/firstRegion}}"
                        data-shop-md-region-tab
                        data-target="{{regionPanelId}}">{{label}}</button>
                {{/mdRegions}}
            </div>
            {{/hasMultipleMdRegions}}
            <div class="shop-md-region-panels" id="shopMdRegionPanels">
                {{#mdRegions}}
                <div class="shop-md-region-panel"
                     id="{{regionPanelId}}"
                     data-shop-md-region
                     {{#hasMultipleMdRegions}}role="tabpanel" aria-labelledby="tab-{{regionPanelId}}"{{/hasMultipleMdRegions}}
                     {{#regionHidden}}hidden{{/regionHidden}}>
                    {{#hasSalesPeriod}}
                    <p class="shop-md-region-period font-mono">{{salesPeriod}}</p>
                    {{/hasSalesPeriod}}
                    {{#categories}}
                    {{#hasPhotos}}
                    <div class="shop-md-category">
                        {{#hasMultipleCategories}}
                        <h3 class="shop-md-category-title">{{title}}</h3>
                        {{/hasMultipleCategories}}
                        <div class="shop-md-notices">
                            {{#photos}}
                            <figure class="shop-md-notice">
                                <img src="{{.}}" alt="{{title}} MD 공지" loading="lazy" decoding="async" data-img-fallback>
                            </figure>
                            {{/photos}}
                        </div>
                    </div>
                    {{/hasPhotos}}
                    {{/categories}}
                </div>
                {{/mdRegions}}
            </div>
        </section>
        {{/hasMdPhotos}}
        {{^hasMdPhotos}}
        <p class="text-sm text-[#b9cac4]/70 py-4" role="status">등록된 MD 공지 사진이 없습니다.</p>
        {{/hasMdPhotos}}
    </div>
</div>
    {{/shop}}
</main>
<script src="{{#asset}}/js/about-tabs.js{{/asset}}"></script>
<script>
(function () {
  var tabRoot = document.getElementById("shopMdRegionTabs");
  var panelsRoot = document.getElementById("shopMdRegionPanels");
  if (!tabRoot || !panelsRoot) return;

  function activateRegion(btn) {
    if (!btn) return;
    var targetId = btn.getAttribute("data-target");
    tabRoot.querySelectorAll('[role="tab"]').forEach(function (tab) {
      var selected = tab === btn;
      tab.setAttribute("aria-selected", selected ? "true" : "false");
      tab.tabIndex = selected ? 0 : -1;
      tab.classList.toggle("is-active", selected);
    });
    panelsRoot.querySelectorAll("[data-shop-md-region]").forEach(function (panel) {
      panel.hidden = panel.id !== targetId;
    });
  }

  tabRoot.querySelectorAll('[role="tab"]').forEach(function (tab) {
    tab.addEventListener("click", function () {
      activateRegion(tab);
    });
  });

  if (window.AboutTabs && typeof window.AboutTabs.enhanceTabs === "function") {
    window.AboutTabs.enhanceTabs(tabRoot, { onActivate: activateRegion });
  } else {
    activateRegion(tabRoot.querySelector('[role="tab"].is-active') || tabRoot.querySelector('[role="tab"]'));
  }
})();
</script>
{{>layout/page-end}}
