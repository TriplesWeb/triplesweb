<!DOCTYPE html>
<html lang="ko">
<head>
    {{>layout/favicon}}
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{{item.name}} - 굿즈샵</title>
    <link rel="stylesheet" href="/css/site-ui.css?v=1"/>
    <style>
        body.other-page { background: #0d0e12; color: #e3e2e8; }
        .desc-body img, .desc-body figure, .desc-body picture { display: none !important; }
        .shop-detail { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.5rem; }
        .shop-detail h2 { margin: 0 0 .5rem; font-size: 1.6rem; }
        .shop-price { color: #8decd9; font-size: 1.35rem; font-weight: 750; margin: 0 0 .75rem; }
        .shop-badge { display: inline-block; padding: .25rem .55rem; border-radius: 999px; background: #7f1d1d55; color: #fecaca; font-size: .8rem; }
        .shop-detail .site-carousel-slide img { border-radius: .75rem; max-height: 28rem; }
    </style>
</head>
<body class="other-page">
{{>layout/header}}

<div class="site-container">
    <div class="shop-detail">
        <div class="site-carousel" data-site-carousel>
            <div class="site-carousel-track">
                {{#itemImages}}
                    <div class="site-carousel-slide"><img src="/{{imagePath}}" alt="메인사진"></div>
                {{/itemImages}}
                {{^itemImages}}
                    <div class="site-carousel-slide"><img src="/images/no-image.png" alt="no image"></div>
                {{/itemImages}}
            </div>
            <button type="button" class="site-carousel-btn prev" data-site-carousel-prev aria-label="이전">‹</button>
            <button type="button" class="site-carousel-btn next" data-site-carousel-next aria-label="다음">›</button>
        </div>
        <div>
            <h2>{{item.name}}</h2>
            <p class="shop-price">{{item.price}}원</p>
            {{#item.soldout}}<span class="shop-badge">품절</span>{{/item.soldout}}
            <div class="desc-body mt-3">{{{item.description}}}</div>
            {{^item.soldout}}
                <form method="post" action="/shop/cart/add/{{item.id}}" style="margin-top:1rem">
                    <button class="site-btn site-btn-dark" type="submit">장바구니 담기</button>
                </form>
            {{/item.soldout}}
        </div>
    </div>
</div>
<script src="/js/site-ui.js?v=1"></script>
{{>layout/footer}}
</body>
</html>
