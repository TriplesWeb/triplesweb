<!DOCTYPE html>
<html lang="ko">
<head>
{{>layout/site-head}}
<link rel="stylesheet" href="/css/bootstrap-compat.css?v=2">
<meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{{item.name}} - 굿즈샵</title>
    <style>
        /* 설명 박스 안의 이미지는 전부 숨김 */
        .desc-body img,
        .desc-body figure,
        .desc-body picture { display:none !important; }
    </style>

</head>
<body class="other-page">
{{>layout/header}}

<div class="container py-4">
    <div class="row">
        <div class="col-md-6">
            <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    {{#itemImages}}
                        <div class="carousel-item {{#first}}active{{/first}}">
                            <img src="/{{imagePath}}" class="d-block w-100 rounded" alt="메인사진">
                        </div>
                    {{/itemImages}}
                    {{^itemImages}}
                        <div class="carousel-item active">
                            <img src="/images/no-image.png" class="d-block w-100 rounded" alt="no image">
                        </div>
                    {{/itemImages}}
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <h2>{{item.name}}</h2>
            <p class="text-primary fs-4">{{item.price}}원</p>
            {{#item.soldout}}<span class="badge bg-danger">품절</span>{{/item.soldout}}
            <p class="mt-3">{{{item.description}}}</p>
            {{^item.soldout}}
                <form method="post" action="/shop/cart/add/{{item.id}}">
                    <button class="btn btn-dark mt-3">장바구니 담기</button>
                </form>
            {{/item.soldout}}
        </div>
    </div>

</div>
<script src="/js/bootstrap-compat.js?v=1" defer></script>
</body>
</html>
