{{>layout/v2/head-open}}


    <title>{{item.name}} - 굿즈샵</title>
    
<link rel="stylesheet" href="/css/v2-pages.css?v=1">
</head><body class="v2-body site-page other-page">
{{>layout/v2/header}}

<div class="site-container">
    <div class="shop-detail">
        <div class="site-carousel" data-site-carousel>
            <div class="site-carousel-track">
                {{#itemImages}}
                    <div class="site-carousel-slide"><img src="/{{imagePath}}" alt="메인사진"></div>
                {{/itemImages}}
                {{^itemImages}}
                    <div class="site-carousel-slide"><img src="/images/no-image.png" alt="no image"></div>
                {{/itemImages}}
            </div>
            <button type="button" class="site-carousel-btn prev" data-site-carousel-prev aria-label="이전">‹</button>
            <button type="button" class="site-carousel-btn next" data-site-carousel-next aria-label="다음">›</button>
        </div>
        <div>
            <h2>{{item.name}}</h2>
            <p class="shop-price">{{item.price}}원</p>
            {{#item.soldout}}<span class="shop-badge">품절</span>{{/item.soldout}}
            <div class="desc-body mt-3">{{{item.description}}}</div>
            {{^item.soldout}}
                <form method="post" action="/shop/cart/add/{{item.id}}" style="margin-top:1rem">
                    <button class="site-btn site-btn-dark" type="submit">장바구니 담기</button>
                </form>
            {{/item.soldout}}
        </div>
    </div>
</div>
<script src="/js/bootstrap-compat.js?v=1" defer></script>
<script src="/js/site-ui.js?v=1"></script>
{{>layout/v2/footer}}
