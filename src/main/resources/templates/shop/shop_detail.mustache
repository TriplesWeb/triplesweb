{{>layout/head-open}}

    <link rel="stylesheet" href="{{#asset}}/css/shop-detail.css{{/asset}}">
    <title>트리플에스 커뮤니티 - 굿즈리스트</title>
</head><body class="site-page bg-[#0d0e12] text-[#e3e2e8] min-h-screen">
{{>layout/header}}
<main class="main-content max-w-7xl mx-auto px-4 py-8">
    {{#shop}}
<div class="card-box shop-detail-card bg-[#16181f]/80 backdrop-blur-md border border-[#3a4a46]/30 rounded-2xl shadow-xl overflow-hidden">
    <nav class="site-back site-back--bar" aria-label="굿즈리스트로">
        <a href="/shop">← 굿즈리스트</a>
    </nav>
    <div class="shop-detail-body p-6 lg:p-8 space-y-8">
        <header class="shop-detail-head">
            <h1 class="text-3xl lg:text-4xl font-extrabold text-[#e3e2e8] tracking-tight m-0">{{eventName}}</h1>
            {{#hasSalesPeriod}}
            <p class="shop-detail-period">
                <span class="material-symbols-outlined text-base text-[#00f5d4]" aria-hidden="true">calendar_today</span>
                <span>판매 기간: <strong class="font-mono text-[#e3e2e8]">{{salesPeriod}}</strong></span>
            </p>
            {{/hasSalesPeriod}}
            {{#eventId}}
            <p class="shop-detail-event-link">
                <a href="/cosmo/event/{{eventId}}">공연 상세 보기 →</a>
            </p>
            {{/eventId}}
        </header>

        {{#hasMdPhotos}}
        <section class="shop-md-section space-y-4 min-w-0" aria-label="MD 리스트">
            <h2 class="text-xl font-bold text-[#e3e2e8] flex items-center gap-2 m-0">
                <span class="material-symbols-outlined text-[#00f5d4]" aria-hidden="true">photo_library</span>
                MD 리스트
            </h2>
            <div class="shop-md-scroll rounded-xl border border-[#3a4a46]/30 min-w-0 overflow-hidden">
                <div class="shop-md-head bg-[#101116] text-[#e3e2e8] text-xs font-semibold border-b border-[#3a4a46]/30">
                    <span class="shop-md-num">#</span>
                    <span class="shop-md-title-col">구역</span>
                    <span class="shop-md-mark-col" aria-hidden="true"></span>
                </div>
                <ul class="shop-md-rows list-none m-0 p-0 divide-y divide-[#3a4a46]/20 bg-[#16181f]/40">
                    {{#mdRegions}}
                    <li class="shop-md-item">
                        <button type="button"
                                class="shop-md-row group"
                                aria-expanded="false"
                                aria-controls="shop-md-panel-{{regionKey}}"
                                id="shop-md-tab-{{regionKey}}"
                                data-shop-md-toggle>
                            <span class="shop-md-num font-mono text-xs text-[#8b9b95]"></span>
                            <span class="shop-md-title-col">
                                <span class="shop-md-name group-hover:text-[#00f5d4] transition-colors">{{label}}</span>
                                {{#hasSalesPeriod}}
                                <span class="shop-md-meta font-mono">{{salesPeriod}}</span>
                                {{/hasSalesPeriod}}
                            </span>
                            <span class="shop-md-mark material-symbols-outlined" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="shop-md-panel"
                             id="shop-md-panel-{{regionKey}}"
                             role="region"
                             aria-labelledby="shop-md-tab-{{regionKey}}"
                             hidden
                             data-shop-md-panel>
                            {{#categories}}
                            {{#hasPhotos}}
                            <div class="shop-md-category">
                                <h3 class="shop-md-category-title">{{title}}</h3>
                                <div class="shop-md-notices">
                                    {{#photos}}
                                    <figure class="shop-md-notice">
                                        <img src="{{.}}" alt="{{title}} MD 공지" loading="lazy" decoding="async" data-img-fallback>
                                    </figure>
                                    {{/photos}}
                                </div>
                            </div>
                            {{/hasPhotos}}
                            {{/categories}}
                        </div>
                    </li>
                    {{/mdRegions}}
                </ul>
            </div>
        </section>
        {{/hasMdPhotos}}
        {{^hasMdPhotos}}
        <p class="text-sm text-[#b9cac4]/70 py-4" role="status">등록된 MD 공지 사진이 없습니다.</p>
        {{/hasMdPhotos}}
    </div>
</div>
    {{/shop}}
</main>
<script>
(function () {
  document.querySelectorAll("[data-shop-md-toggle]").forEach(function (toggle) {
    toggle.addEventListener("click", function () {
      var item = toggle.closest(".shop-md-item");
      if (!item) return;
      var panel = item.querySelector("[data-shop-md-panel]");
      var open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
      item.classList.toggle("is-open", !open);
      if (panel) panel.hidden = open;
    });
  });
})();
</script>
{{>layout/page-end}}
