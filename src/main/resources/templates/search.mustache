{{>layout/head-open}}
    <title>{{#keyword}}‘{{keyword}}’ 검색 결과{{/keyword}}{{^keyword}}검색{{/keyword}} - 트리플에스 커뮤니티</title>
    <link rel="stylesheet" href="{{#asset}}/css/search-page.css{{/asset}}">
</head><body class="site-page bg-surface text-on-surface min-h-screen flex flex-col">
{{>layout/header}}

<main class="flex-1 flex items-start justify-center px-4 sm:px-6 py-6 z-10 relative">
    <div class="w-full max-w-4xl relative">
        <div class="relative bg-surface-container/95 border border-outline-variant/50 rounded-3xl p-6 sm:p-10 backdrop-blur-2xl shadow-2xl">

            <div class="flex flex-col gap-5 mb-8 pb-5 border-b border-outline-variant/30 sm:flex-row sm:items-end sm:justify-between">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary-container text-3xl mt-0.5" data-icon="search">search</span>
                    <div>
                        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-primary-container">SITE SEARCH</p>
                        <h1 class="font-headline-lg text-headline-md font-bold text-on-surface tracking-tight mt-1">
                            {{#keyword}}‘{{keyword}}’ 검색 결과{{/keyword}}{{^keyword}}사이트 전체 검색{{/keyword}}
                        </h1>
                        <p class="mt-1.5 text-sm text-on-surface-variant">About · 코스모 · 미디어 · 정보 · 일정을 탭별로 찾습니다.</p>
                    </div>
                </div>

                <form action="/search" method="get" class="flex w-full sm:w-auto items-center gap-2">
                    {{#activeTab}}<input type="hidden" name="tab" value="{{activeTab}}">{{/activeTab}}
                    <div class="site-search flex-1 sm:w-64">
                        <input type="search" name="keyword" value="{{keyword}}" placeholder="사이트 전체 검색" aria-label="사이트 검색어" class="site-field site-search__input" autocomplete="off">
                        <button type="submit" class="site-search__submit" aria-label="검색">
                            <span class="material-symbols-outlined" data-icon="search">search</span>
                        </button>
                    </div>
                </form>
            </div>

            {{#errorMessage}}
            <div class="mb-6 p-3.5 rounded-xl bg-error-container/20 border border-error/40 flex items-start gap-3">
                <span class="material-symbols-outlined text-error text-[20px] flex-shrink-0 mt-0.5" data-icon="error">error</span>
                <p class="font-body-sm text-body-sm text-error font-medium">{{errorMessage}}</p>
            </div>
            {{/errorMessage}}

            {{#keyword}}
            <nav class="search-tabs" aria-label="검색 결과 탭">
                {{#tabs}}
                <a href="{{{href}}}" class="search-tabs__item{{#active}} is-active{{/active}}">
                    <span>{{label}}</span>
                    <em>{{count}}</em>
                </a>
                {{/tabs}}
            </nav>

            {{#tabs}}
            {{#active}}
            <section class="search-tab-panel" aria-label="{{label}} 검색 결과">
                {{#hasHits}}
                <ul class="search-hits">
                    {{#hits}}
                    <li>
                        <a href="{{{href}}}" class="search-hit">
                            <span class="search-hit__kind">{{kind}}</span>
                            <strong class="search-hit__label">{{label}}</strong>
                            {{#snippet}}<p class="search-hit__snippet">{{snippet}}</p>{{/snippet}}
                        </a>
                    </li>
                    {{/hits}}
                </ul>
                {{#hasMore}}
                <p class="search-more"><a href="{{{moreHref}}}">{{label}}에서 더 보기</a></p>
                {{/hasMore}}
                {{/hasHits}}
                {{^hasHits}}
                <div class="search-empty">
                    <span class="material-symbols-outlined" data-icon="search_off">search_off</span>
                    <p>이 탭에서 일치하는 결과가 없습니다.</p>
                </div>
                {{/hasHits}}
            </section>
            {{/active}}
            {{/tabs}}

            {{^hasAnyResults}}
            <div class="mt-8 rounded-2xl border border-dashed border-outline-variant/50 bg-surface-container-lowest/20 p-8 text-center">
                <span class="material-symbols-outlined text-outline text-4xl mb-2" data-icon="search_off">search_off</span>
                <p class="text-sm text-on-surface-variant font-medium">사이트 전체에서 검색 결과가 없습니다.</p>
                <p class="mt-1 text-xs text-outline">다른 검색어를 입력해 보세요.</p>
            </div>
            {{/hasAnyResults}}
            {{/keyword}}

        </div>
    </div>
</main>

{{>layout/page-end}}
