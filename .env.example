# Copy to .env and fill in values. Never commit .env.

IMAGE=ghcr.io/triplesweb/triplesweb:latest

APP_PORT=8090

# bootRun / Compose → SPRING_DATASOURCE_* (호스트·계정·비밀번호는 .env에만 둠)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=triples
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

YOUTUBE_API_KEY=

SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 케미 페이지 관리자 (추가/수정). 비우면 관리 기능 비활성
CHEMISTRY_ADMIN_PASSWORD=change-me
# 케미 시드 JSON을 DB에 넣으려면 true (기본 false, 필요 시 한 번만)
CHEMISTRY_SEED_ENABLED=false

# 로컬 bootRun ↔ 서버 uploads 실시간 동기화 (공유 DB일 때 권장)
# Tailscale(100.x) 연결이 필요. 끊기면 sync는 백그라운드에서 실패만 로그하고 저장 API는 막지 않음.
# 오프라인만 쓸 때는 UPLOAD_SYNC_ENABLED=false + 로컬 MariaDB(docker compose) 권장.
# 서버 Docker compose에서는 UPLOAD_SYNC_ENABLED=false
UPLOAD_SYNC_ENABLED=true
UPLOAD_SYNC_HOST=100.x.x.x
UPLOAD_SYNC_USER=pi
UPLOAD_SYNC_REMOTE_DIR=/opt/stacks/triplesweb/uploads
UPLOAD_SYNC_SSH_KEY=/Users/you/.ssh/pi_ed25519
UPLOAD_SYNC_PULL_ON_STARTUP=true
