# Copy to .env and fill in values. Never commit .env.

IMAGE=ghcr.io/triplesweb/triplesweb:latest

# 운영 Pi 단일 앱 포트: 8090
APP_PORT=8090

# IntelliJ / bootRun / Compose → SPRING_DATASOURCE_* (호스트·계정·비밀번호는 .env에만 둠. 저장소에 실값 금지)
# 공유(운영) DB: MYSQL_HOST에 Tailscale 주소, MYSQL_USER/MYSQL_PASSWORD에 해당 계정
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=triples
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# 서버에서 MariaDB 튜닝을 적용할 때 호스트의 설정 파일 경로를 지정한다.
# MARIADB_TUNING_CNF=/etc/triplesweb/mariadb-tuning.cnf

YOUTUBE_API_KEY=
# 공식 채널. 비우면 기본 @triplescosmos
# YOUTUBE_CHANNEL_HANDLE=triplescosmos
# YOUTUBE_CHANNEL_ID=UCJnL-TBcsYrF2SLs7tmiC8Q

# 케미/사이트 관리자 비밀번호 — BCrypt 해시만 저장 (평문 금지)
# 생성: printf '%s' 'your-password' | ./scripts/hash-admin-password.sh
# Docker Compose .env 는 $ 를 변수로 읽으므로 해시는 $$ 로 이스케이프한다.
#   printf '%s' 'pw' | ./scripts/hash-admin-password.sh | sed 's/\$/$$/g'
CHEMISTRY_ADMIN_PASSWORD=

# 로컬 IntelliJ/bootRun ↔ 서버 uploads 실시간 동기화 (공유 DB일 때 권장)
# Tailscale(100.x) 연결이 필요. 끊기면 sync는 백그라운드에서 실패만 로그하고 저장 API는 막지 않음.
# 오프라인만 쓸 때는 UPLOAD_SYNC_ENABLED=false + 로컬 MariaDB(docker compose) 권장.
# 서버 Docker compose에서는 UPLOAD_SYNC_ENABLED=false
UPLOAD_SYNC_ENABLED=true
UPLOAD_SYNC_HOST=100.x.x.x
UPLOAD_SYNC_USER=pi
UPLOAD_SYNC_REMOTE_DIR=/opt/stacks/triplesweb/uploads
UPLOAD_SYNC_SSH_KEY=/Users/you/.ssh/pi_ed25519
UPLOAD_SYNC_PULL_ON_STARTUP=true

# 로컬·협업자: 디스크에 없는 /uploads(멤버·유닛 이미지 등)는 운영으로 리다이렉트 (기본값 동일)
# 서버 Docker에서는 반드시 비울 것(compose가 이미 UPLOAD_FALLBACK_BASE_URL=)
# UPLOAD_FALLBACK_BASE_URL=https://triples.eht3r.cloud

# COSMO Gravity. Tokens are never sent to browsers. Prefer scripts/setup-cosmo.py.
COSMO_ACCESS_TOKEN=
COSMO_REFRESH_TOKEN=
# Optional override of the public COSMO protocol key if the app rotates it.
COSMO_KEY=
COSMO_CREDENTIALS_FILE=./data/cosmo/credentials.json
